@page "/admin"
@using MudBlazor
@using WildForgeLabs.Core.DTOs
@inject HttpClient Http
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.False" Class="pa-0">
  <MudAppBar Color="Color.Default" Elevation="0">
    <MudIconButton Icon="@Icons.Material.Filled.Menu" OnClick="@ToggleDrawer" />
    <MudText Typo="Typo.h6" Class="ml-2 font-bold">WildForgeLabs Admin</MudText>
    <MudSpacer />
    <MudIconButton Icon="@Icons.Material.Filled.Notifications" />
    <MudAvatar>JD</MudAvatar>
  </MudAppBar>

  <MudDrawer Open="_drawerOpen" Dock="true">
    <MudDrawerHeader>
      <MudText Typo="Typo.h6">Menú</MudText>
    </MudDrawerHeader>
    <MudNavMenu>
      <MudNavLink Text="Dashboard" Icon="@Icons.Material.Filled.Analytics" Href="/admin" />
      <MudNavLink Text="Productos" Icon="@Icons.Material.Filled.Inventory" Href="/admin/products" />
      <MudNavLink Text="Pedidos" Icon="@Icons.Material.Filled.Receipt" Href="/admin/orders" />
      <MudNavLink Text="Clientes" Icon="@Icons.Material.Filled.Group" Href="/admin/customers" />
      <MudNavLink Text="Inventario" Icon="@Icons.Material.Filled.Stock" Href="/admin/inventory" />
      <MudNavLink Text="Reportes" Icon="@Icons.Material.Filled.BarChart" Href="/admin/reports" />
    </MudNavMenu>
  </MudDrawer>

  <MudMainContent>
    <MudPaper Class="pa-6">
      <MudText Typo="Typo.h4" Class="mb-6">Dashboard</MudText>
      
      <MudGrid>
        <MudItem xs={12} md={6} lg={3}>
          <MudCard Class="h-full">
            <MudCardContent Class="d-flex align-center">
              <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Large" Color="Color.Secondary" />
              <MudSpacer />
              <MudText Typo="Typo.h6" Color="Color.TextSecondary">Ventas Hoy</MudText>
              <MudText Typo="Typo.h3" Class="font-weight-bold">$2,450.00</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>

        <MudItem xs={12} md={6} lg={3}>
          <MudCard Class="h-full">
            <MudCardContent Class="d-flex align-center">
              <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Large" Color="Color.Secondary" />
              <MudSpacer />
              <MudText Typo="Typo.h6" Color="Color.TextSecondary">Pedidos</MudText>
              <MudText Typo="Typo.h3" Class="font-weight-bold">24</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>

        <MudItem xs={12} md={6} lg={3}>
          <MudCard Class="h-full">
            <MudCardContent Class="d-flex align-center">
              <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Large" Color="Color.Secondary" />
              <MudSpacer />
              <MudText Typo="Typo.h6" Color="Color.TextSecondary">Stock Crítico</MudText>
              <MudText Typo="Typo.h3" Class="font-weight-bold">8</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>

        <MudItem xs={12} md={6} lg={3}>
          <MudCard Class="h-full">
            <MudCardContent Class="d-flex align-center">
              <MudIcon Icon="@Icons.Material.Filled.Group" Size="Size.Large" Color="Color.Secondary" />
              <MudSpacer />
              <MudText Typo="Typo.h6" Color="Color.TextSecondary">Clientes</MudText>
              <MudText Typo="Typo.h3" Class="font-weight-bold">156</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>
      </MudGrid>

      <MudCard Class="mt-6">
        <MudCardHeader>
          <MudCardTitle>Pedidos Recientes</MudCardTitle>
        </MudCardHeader>
        <MudCardContent>
          <MudTable Items="_orders" Hoverable="true" Bordered="true">
            <HeaderContent>
              <MudTh>ID</MudTh>
              <MudTh>Cliente</MudTh>
              <MudTh>Total</MudTh>
              <MudTh>Estado</MudTh>
              <MudTh>Fecha</MudTh>
            </HeaderContent>
            <RowTemplate>
              <MudTd>@context.Id.ToString().Substring(0, 8)</MudTd>
              <MudTd>@context.Customer?.FirstName @context.Customer?.LastName</MudTd>
              <MudTd>$@context.TotalAmount.ToString("F2")</MudTd>
              <MudTd>
                <MudChip Color="GetStatusColor(context.Status)" Variant="Variant.Filled">
                  @{
                    var status = context.Status switch
                    {
                      "pending" => "Pendiente",
                      "confirmed" => "Confirmado",
                      "preparing" => "Preparando",
                      "shipped" => "Enviado",
                      "delivered" => "Entregado",
                      "cancelled" => "Cancelado",
                      _ => context.Status
                    };
                    @status
                  }
                </MudChip>
              </MudTd>
              <MudTd>@context.CreatedAt.ToString("dd/MM/yyyy")</MudTd>
            </RowTemplate>
          </MudTable>
        </MudCardContent>
      </MudCard>
    </MudMainContent>
  </MudDrawer>
</MudContainer>

@code {
  private bool _drawerOpen = true;
  private List<Order> _orders = new();

  protected override async Task OnInitializedAsync()
  {
    await LoadOrders();
  }

  private async Task LoadOrders()
  {
    try
    {
      var response = await Http.GetAsync("api/v1/orders");
      if (response.IsSuccessStatusCode)
      {
        _orders = await response.Content.ReadFromJsonAsync<List<Order>>() ?? new();
      }
    }
    catch (Exception ex)
    {
      Console.WriteLine($"Error loading orders: {ex.Message}");
    }
  }

  private void ToggleDrawer()
  {
    _drawerOpen = !_drawerOpen;
  }

  private MudColor GetStatusColor(string status)
  {
    return status.ToLower() switch
    {
      "pending" => MudColor.Warning,
      "confirmed" => MudColor.Info,
      "preparing" => MudColor.Primary,
      "shipped" => MudColor.Secondary,
      "delivered" => MudColor.Success,
      "cancelled" => MudColor.Error,
      _ => MudColor.Default
    };
  }
}