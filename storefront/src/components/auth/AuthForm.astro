---
/**
 * AuthForm.astro - Formulario único para login y registro.
 * Mismo layout, mismos campos base y mismas validaciones
 * para email/password y Google.
 *
 * Todos los textos salen de `lib/i18n.ts`; los mensajes del script viajan en
 * el JSON `#auth-ui` para que el navegador no tenga cadenas en español fijas.
 */
import GoogleButton from './GoogleButton.astro';
import { getCopy, type Lang } from '../../lib/i18n';

export interface Props {
  mode: 'login' | 'register';
}

const { mode } = Astro.props;
const isRegister = mode === 'register';

const lang = (Astro.locals.lang ?? 'es') as Lang;
const t = getCopy(lang);

const ui = {
  processing: t.account.processing,
  missingName: t.account.missingName,
  shortPassword: t.account.shortPassword,
  passwordMismatch: t.account.passwordMismatch,
  mustAccept: t.account.mustAccept,
  confirmEmail: t.account.confirmEmail,
  invalidCredentials: t.account.invalidCredentials,
  alreadyRegistered: t.account.alreadyRegistered,
  generic: t.common.error,
};
---

<section class="min-h-[calc(100dvh-8rem)] flex items-start sm:items-center justify-center px-5 sm:px-6 py-10 sm:py-16 bg-noise">
  <script type="application/json" id="auth-ui" set:html={JSON.stringify(ui)} />

  <div class="w-full max-w-lg">
    <!-- Encabezado -->
    <div class="text-center mb-8 sm:mb-10">
      <p class="section-label mb-3">{isRegister ? t.account.joinLabel : t.account.accountLabel}</p>
      <h1 class="font-titulos text-3xl sm:text-4xl lg:text-5xl text-blancoRoto mb-4">
        {isRegister ? t.account.registerTitle : t.account.loginTitle}
      </h1>
      <div class="gold-line mx-auto"></div>
      <p class="mt-5 text-sm text-muted">
        {isRegister ? t.account.registerIntro : t.account.loginIntro}
      </p>
    </div>

    <!-- Google (mismo en ambos modos) -->
    <GoogleButton />

    <div class="flex items-center gap-4 my-7">
      <div class="flex-1 h-px bg-white/35"></div>
      <span class="font-acentos text-xs uppercase tracking-[0.2em] text-blancoRoto">
        {t.account.or}
      </span>
      <div class="flex-1 h-px bg-white/35"></div>
    </div>

    <!-- Formulario -->
    <form id="auth-form" class="space-y-4" data-mode={mode} novalidate>
      {
        isRegister && (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <label class="block">
              <span class="field-label">{t.account.name} *</span>
              <input
                type="text"
                name="firstName"
                placeholder={t.account.name}
                required
                class="input-dark"
                autocomplete="given-name"
              />
            </label>

            <label class="block">
              <span class="field-label">{t.account.lastName} *</span>
              <input
                type="text"
                name="lastName"
                placeholder={t.account.lastName}
                required
                class="input-dark"
                autocomplete="family-name"
              />
            </label>
          </div>
        )
      }

      <label class="block">
        <span class="field-label">{t.account.email} *</span>
        <input
          type="email"
          name="email"
          placeholder={t.account.emailPlaceholder}
          required
          class="input-dark"
          autocomplete="email"
          inputmode="email"
        />
      </label>

      {
        isRegister && (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <label class="block">
              <span class="field-label">{t.account.phone}</span>
              <input
                type="tel"
                name="phone"
                placeholder={t.checkout.phonePlaceholder}
                class="input-dark"
                autocomplete="tel"
                inputmode="tel"
              />
            </label>

            <label class="block">
              <span class="field-label">{t.account.birthDate}</span>
              <input
                type="date"
                name="birthdate"
                class="input-dark"
                max={new Date(Date.now() - 18 * 365 * 24 * 3600 * 1000)
                  .toISOString()
                  .slice(0, 10)}
              />
              <span class="field-hint">{t.account.birthDateHint}</span>
            </label>
          </div>
        )
      }

      <label class="block">
        <span class="field-label">{t.account.password} *</span>
        <div class="relative">
          <input
            type="password"
            name="password"
            placeholder={isRegister ? t.account.passwordNewPlaceholder : t.account.passwordPlaceholder}
            required
            minlength={isRegister ? 8 : 6}
            class="input-dark pr-16"
            autocomplete={isRegister ? 'new-password' : 'current-password'}
          />
          <button
            type="button"
            id="toggle-password"
            class="absolute right-2 top-1/2 -translate-y-1/2 w-11 h-11 flex items-center justify-center text-blancoRoto hover:text-oro-brillo transition-colors"
            aria-label={t.account.togglePassword}
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
              <circle cx="12" cy="12" r="3" />
            </svg>
          </button>
        </div>
        {
          isRegister && (
            <span class="field-hint">{t.account.passwordHint}</span>
          )
        }
        {
          !isRegister && (
            <p class="mt-2 text-right">
              <a href="/recuperar" class="text-sm text-oro-brillo hover:text-white transition-colors">
                {t.account.forgot}
              </a>
            </p>
          )
        }
      </label>

      {
        isRegister && (
          <>
            <label class="block">
              <span class="field-label">{t.account.confirmPassword} *</span>
              <input
                type="password"
                name="confirmPassword"
                placeholder={t.account.confirmPasswordPlaceholder}
                required
                class="input-dark"
                autocomplete="new-password"
              />
            </label>

            <label class="flex items-start gap-3 pt-1 cursor-pointer">
              <input
                type="checkbox"
                name="marketing"
                class="mt-1 w-5 h-5 accent-[#ffe28a] shrink-0"
              />
              <span class="text-sm text-muted leading-relaxed">
                {t.account.marketing}
              </span>
            </label>

            <label class="flex items-start gap-3 cursor-pointer">
              <input
                type="checkbox"
                name="terms"
                required
                class="mt-1 w-5 h-5 accent-[#ffe28a] shrink-0"
              />
              <span class="text-sm text-muted leading-relaxed">
                {t.account.acceptTerms}
                <a href="/terminos" class="text-oro-brillo hover:text-white underline underline-offset-2">
                  {t.checkout.termsLink}
                </a>
                {t.account.andThe}
                <a href="/privacidad" class="text-oro-brillo hover:text-white underline underline-offset-2">
                  {t.checkout.privacyLink}
                </a>.
              </span>
            </label>
          </>
        )
      }

      <button type="submit" id="auth-submit" class="btn-gold w-full mt-2">
        {isRegister ? t.account.create : t.account.enter}
      </button>

      <p id="auth-error" role="alert" class="hidden text-sm text-red-400 text-center leading-relaxed"></p>
      <p id="auth-info" role="status" class="hidden text-sm text-oro-brillo text-center leading-relaxed"></p>
    </form>

    <!-- Cambio de modo -->
    <p class="mt-8 text-center text-sm text-muted">
      {
        isRegister ? (
          <>
            {t.account.hasAccount}{' '}
            <a href="/entrar" class="text-oro-brillo font-semibold hover:text-white transition-colors">
              {t.account.goLogin}
            </a>
          </>
        ) : (
          <>
            {t.account.noAccount}{' '}
            <a href="/registro" class="text-oro-brillo font-semibold hover:text-white transition-colors">
              {t.account.goRegister}
            </a>
          </>
        )
      }
    </p>
  </div>
</section>

<style>
  .field-label {
    display: block;
    margin-bottom: 0.5rem;
    font-family: 'Space Grotesk', Inter, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ffe28a;
  }

  .field-hint {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.8125rem;
    line-height: 1.5;
  }
</style>

<script>
  import { signIn, signUp } from '../../lib/auth';

  const ui = JSON.parse(document.getElementById('auth-ui')?.textContent || '{}') as Record<string, string>;
  const uiText = (key: string) => ui[key] ?? '';

  const form = document.getElementById('auth-form') as HTMLFormElement;
  const submitBtn = document.getElementById('auth-submit') as HTMLButtonElement;
  const errorEl = document.getElementById('auth-error')!;
  const infoEl = document.getElementById('auth-info')!;
  const toggleBtn = document.getElementById('toggle-password');
  const isRegister = form?.dataset.mode === 'register';

  function show(el: HTMLElement, message: string) {
    el.textContent = message;
    el.classList.remove('hidden');
  }

  function clearMessages() {
    errorEl.classList.add('hidden');
    infoEl.classList.add('hidden');
  }

  // Mostrar / ocultar contraseña
  function togglePassword() {
    const input = form.elements.namedItem('password') as HTMLInputElement;
    if (!input) return;
    input.type = input.type === 'password' ? 'text' : 'password';
  }

  toggleBtn?.addEventListener('click', togglePassword);
  toggleBtn?.addEventListener('keydown', (e) => {
    const key = (e as KeyboardEvent).key;
    if (key === 'Enter' || key === ' ') {
      e.preventDefault();
      togglePassword();
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearMessages();

    const data = new FormData(form);
    const email = String(data.get('email') ?? '').trim();
    const password = String(data.get('password') ?? '');

    submitBtn.disabled = true;
    const original = submitBtn.textContent;
    submitBtn.textContent = uiText('processing');

    try {
      if (isRegister) {
        const firstName = String(data.get('firstName') ?? '').trim();
        const lastName = String(data.get('lastName') ?? '').trim();
        const confirm = String(data.get('confirmPassword') ?? '');
        const phone = String(data.get('phone') ?? '').trim();
        const birthdate = String(data.get('birthdate') ?? '');

        if (!firstName || !lastName) {
          show(errorEl, uiText('missingName'));
          return;
        }

        if (password.length < 8) {
          show(errorEl, uiText('shortPassword'));
          return;
        }

        if (password !== confirm) {
          show(errorEl, uiText('passwordMismatch'));
          return;
        }

        if (!form.querySelector<HTMLInputElement>('input[name="terms"]')?.checked) {
          show(errorEl, uiText('mustAccept'));
          return;
        }

        const { data: result, error } = await signUp(email, password, {
          firstName,
          lastName,
          phone,
          birthdate,
          marketing: Boolean(data.get('marketing')),
        });

        if (error) {
          // Con "Confirm email" activo Supabase devuelve un usuario falso en
          // vez de un error; solo se avisa cuando el correo ya está en uso.
          if (/already registered|already exists/i.test(error.message)) {
            show(infoEl, uiText('alreadyRegistered'));
            return;
          }

          show(errorEl, error.message);
          return;
        }

        if (result.user && !result.session) {
          show(infoEl, uiText('confirmEmail'));
          return;
        }

        window.location.href = '/cuenta';
      } else {
        const { error } = await signIn(email, password);

        if (error) {
          show(
            errorEl,
            error.message === 'Invalid login credentials'
              ? uiText('invalidCredentials')
              : error.message
          );
          return;
        }

        const next = new URLSearchParams(window.location.search).get('next');
        const safeNext = next && next.startsWith('/') && !next.startsWith('//') ? next : '/cuenta';
        window.location.href = safeNext;
      }
    } catch (err: any) {
      show(errorEl, err?.message ?? uiText('generic'));
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = original;
    }
  });
</script>
