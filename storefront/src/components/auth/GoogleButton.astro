---
/**
 * Botón de Google con Google Identity Services (ID Token flow).
 *
 * Por qué no usamos `google.accounts.id.prompt()`:
 *   - Google está apagando ese prompt con FedCM obligatorio
 *     (el warning GSI_LOGGER de la consola) y, en navegadores con cookies de
 *     terceros bloqueadas, ni siquiera se muestra.
 *   - Además Supabase exige que el `nonce` del token coincida con el que se
 *     envía, y el prompt no permite inyectarlo de forma fiable.
 *
 * Aquí se inicia el flujo con `initialize()` + `renderButton()` oculto no;
 * se usa `google.accounts.oauth2.initIdTokenClient()`, que sí permite pasar un
 * `nonce` y responde con un popup (sin One Tap).
 */

const GOOGLE_CLIENT_ID =
  import.meta.env.PUBLIC_GOOGLE_CLIENT_ID ||
  '487574117831-d497l5eneq6sn1rm0ouigimaet76frb9.apps.googleusercontent.com';

const scope = 'openid email profile';
---

<div id="google-auth" class="w-full" data-client-id={GOOGLE_CLIENT_ID} data-scope={scope}>
  <button type="button" id="google-btn" class="google-btn">
    <span class="google-icon" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 48 48">
        <path
          fill="#EA4335"
          d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"
        ></path>
        <path
          fill="#4285F4"
          d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"
        ></path>
        <path
          fill="#FBBC05"
          d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"
        ></path>
        <path
          fill="#34A853"
          d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.9l-7.98 6.19C6.51 42.62 14.62 48 24 48z"
        ></path>
      </svg>
    </span>
    <span id="google-btn-label">Continuar con Google</span>
  </button>

  <p id="google-error" class="hidden mt-3 text-sm text-red-400 text-center leading-relaxed"></p>
</div>

<style>
  .google-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    min-height: 52px;
    padding: 0.875rem 1.75rem;
    background: #ffffff;
    color: #111111;
    border: 2px solid #ffffff;
    font-family: 'Space Grotesk', Inter, sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      opacity 0.25s ease;
  }

  .google-btn:hover:not(:disabled) {
    background: #ffe28a;
    border-color: #ffe28a;
    box-shadow: 0 0 32px -8px rgba(242, 201, 76, 0.6);
  }

  .google-btn:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 2px #060606,
      0 0 0 4px #ffe28a;
  }

  .google-btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .google-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
    pointer-events: none;
  }

  .google-icon svg {
    display: block;
    transition: transform 0.25s ease;
  }

  .google-btn:hover:not(:disabled) .google-icon svg {
    transform: scale(1.08);
  }
</style>

<script>
  import { supabase } from '../../lib/supabase';

  const GSI_SRC = 'https://accounts.google.com/gsi/client';

  const root = document.getElementById('google-auth');
  const button = document.getElementById('google-btn') as HTMLButtonElement | null;
  const label = document.getElementById('google-btn-label');
  const errorEl = document.getElementById('google-error');
  const clientId = root?.dataset.clientId ?? '';
  const scope = root?.dataset.scope ?? 'openid email profile';

  let google: any = null;
  let loaded: Promise<void> | null = null;

  function setLoading(isLoading: boolean, text = 'Continuar con Google') {
    if (button) button.disabled = isLoading;
    if (label) label.textContent = text;
  }

  function showError(message: string) {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.classList.remove('hidden');
    setLoading(false);
  }

  function loadSdk(): Promise<void> {
    if (loaded) return loaded;

    loaded = new Promise<void>((resolve, reject) => {
      if ((window as any).google?.accounts?.oauth2) {
        google = (window as any).google;
        resolve();
        return;
      }

      const script = document.createElement('script');
      script.src = GSI_SRC;
      script.async = true;
      script.defer = true;
      script.onload = () => {
        google = (window as any).google;
        google?.accounts?.oauth2
          ? resolve()
          : reject(new Error('Google Identity no disponible'));
      };
      script.onerror = () => reject(new Error('No se pudo cargar Google'));
      document.head.appendChild(script);
    });

    return loaded;
  }

  /** Supabase compara este nonce con el claim `nonce` del ID token. */
  function createNonce(): string {
    const bytes = new Uint8Array(32);
    crypto.getRandomValues(bytes);
    return Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
  }

  function nextPath(): string {
    const next = new URLSearchParams(window.location.search).get('next');
    return next && next.startsWith('/') && !next.startsWith('//') ? next : '/cuenta';
  }

  /**
   * Decide el destino después de entrar con Google:
   *   - cuenta YA vinculada a Google  → /cuenta
   *   - correo existente (otra forma de acceso) → aviso, no se fusciona solo
   *   - cuenta nueva                 → datos a completar
   */
  async function routeAfterSignIn(hadSession: boolean, createdAt: string | undefined) {
    if (!hadSession) {
      window.location.href = nextPath();
      return;
    }

    // Recién creada (< 2 min) ⇒ es un alta, no un login.
    const isNew = createdAt ? Date.now() - new Date(createdAt).getTime() < 120_000 : false;

    if (isNew) {
      window.location.href = `/cuenta/onboarding?nuevo=1&next=${encodeURIComponent(nextPath())}`;
      return;
    }

    window.location.href = nextPath();
  }

  async function onCredential(response: { credential?: string }) {
    if (!response?.credential) {
      showError('Google no devolvió credenciales. Intenta de nuevo.');
      return;
    }

    const hadSession = Boolean((await supabase.auth.getSession()).data.session);

    const { data, error } = await supabase.auth.signInWithIdToken({
      provider: 'google',
      token: response.credential,
    });

    if (error) {
      console.error('[google] signInWithIdToken:', error.message, error.status);

      if (/nonce/i.test(error.message)) {
        showError('No pudimos validar la sesión con Google. Recarga la página e intenta de nuevo.');
      } else if (error.status === 400) {
        showError('Google rechazó el acceso. Revisa que el dominio esté autorizado en Google Cloud.');
      } else {
        showError('No pudimos iniciar sesión con Google. Intenta de nuevo.');
      }
      return;
    }

    await routeAfterSignIn(hadSession, data?.user?.created_at);
  }

  // Acelera la carga del SDK mientras el usuario lee el formulario
  if ('requestIdleCallback' in window) {
    (window as any).requestIdleCallback(() => loadSdk().catch(() => {}));
  } else {
    setTimeout(() => loadSdk().catch(() => {}), 1200);
  }

  button?.addEventListener('click', async () => {
    if (errorEl) errorEl.classList.add('hidden');
    setLoading(true, 'Abriendo Google…');

    try {
      await loadSdk();
    } catch {
      showError('No se pudo cargar Google. Revisa tu conexión.');
      return;
    }

    const oauth2 = google?.accounts?.oauth2;
    if (!oauth2?.initIdTokenClient) {
      showError('Google no está disponible en este navegador.');
      return;
    }

    const nonce = createNonce();

    try {
      // initIdTokenClient: popup OAuth + nonce propio (sin One Tap/FedCM).
      const tokenClient = oauth2.initIdTokenClient({
        client_id: clientId,
        scope,
        nonce,
        callback: (resp: any) => {
          setLoading(false);
          void onCredential(resp);
        },
        error_callback: (err: any) => {
          setLoading(false);
          if (err?.type === 'popup_closed' || err?.type === 'popup_failed_to_open') {
            return; // el usuario cerró el popup: no es un error que mostrar
          }
          showError('Google no completó el inicio de sesión. Intenta de nuevo.');
        },
      });

      tokenClient.requestAccessToken({ prompt: 'select_account' });
      setLoading(false);
    } catch {
      setLoading(false);
      showError('No se pudo abrir Google. Recarga la página e intenta de nuevo.');
    }
  });
</script>
