---
/**
 * Botón de Google — flujo de CÓDIGO con redirección (GIS `initCodeClient`).
 *
 * Historial de por qué no se usan otras APIs:
 *   - `google.accounts.id.prompt()` (One Tap): Google lo apaga con FedCM
 *     obligatorio y el warning GSI_LOGGER de la consola viene de ahí.
 *   - `initIdTokenClient`/`initTokenClient` (popup): requieren que el navegador
 *     permita el popup y complican el `nonce` que Supabase exige.
 *
 * Con `ux_mode: 'redirect'` Google navega a su pantalla y vuelve a esta misma
 * ruta con `?code=…`. Aquí se canjea ese código por un ID token y se entrega a
 * Supabase junto con el `nonce` generado antes de salir.
 *
 * Requisitos en Google Cloud (Credenciales → OAuth 2.0 Client ID):
 *   - Authorized JavaScript origins: https://dspstorefront.vercel.app
 *   - Authorized redirect URIs: la MISMA ruta del botón, p. ej.
 *     https://dspstorefront.vercel.app/entrar y
 *     https://dspstorefront.vercel.app/registro
 */

const GOOGLE_CLIENT_ID =
  import.meta.env.PUBLIC_GOOGLE_CLIENT_ID ||
  '487574117831-d497l5eneq6sn1rm0ouigimaet76frb9.apps.googleusercontent.com';

const scope = 'openid email profile';
---

<div id="google-auth" class="w-full" data-client-id={GOOGLE_CLIENT_ID} data-scope={scope}>
  <button type="button" id="google-btn" class="google-btn">
    <span class="google-icon" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 48 48">
        <path
          fill="#EA4335"
          d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"
        ></path>
        <path
          fill="#4285F4"
          d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"
        ></path>
        <path
          fill="#FBBC05"
          d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"
        ></path>
        <path
          fill="#34A853"
          d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.9l-7.98 6.19C6.51 42.62 14.62 48 24 48z"
        ></path>
      </svg>
    </span>
    <span id="google-btn-label">Continuar con Google</span>
  </button>

  <p id="google-error" class="hidden mt-3 text-sm text-red-400 text-center leading-relaxed"></p>
</div>

<style>
  .google-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    min-height: 52px;
    padding: 0.875rem 1.75rem;
    background: #ffffff;
    color: #111111;
    border: 2px solid #ffffff;
    font-family: 'Space Grotesk', Inter, sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      opacity 0.25s ease;
  }

  .google-btn:hover:not(:disabled) {
    background: #ffe28a;
    border-color: #ffe28a;
    box-shadow: 0 0 32px -8px rgba(242, 201, 76, 0.6);
  }

  .google-btn:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 2px #060606,
      0 0 0 4px #ffe28a;
  }

  .google-btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .google-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
    pointer-events: none;
  }

  .google-icon svg {
    display: block;
    transition: transform 0.25s ease;
  }

  .google-btn:hover:not(:disabled) .google-icon svg {
    transform: scale(1.08);
  }
</style>

<script>
  import { supabase } from '../../lib/supabase';

  const GSI_SRC = 'https://accounts.google.com/gsi/client';

  // Supabase exige que el `nonce` del ID token coincida con el que envía.
  // Ese nonce viaja entre dos páginas (Google y esta), así que tiene que
  // sobrevivir al cruce de origen: se guarda en sessionStorage.
  const NONCE_KEY = 'dsp_google_nonce';

  const root = document.getElementById('google-auth');
  const button = document.getElementById('google-btn') as HTMLButtonElement | null;
  const label = document.getElementById('google-btn-label');
  const errorEl = document.getElementById('google-error');
  const clientId = root?.dataset.clientId ?? '';
  const scope = root?.dataset.scope ?? 'openid email profile';

  let loaded: Promise<void> | null = null;

  function setLoading(isLoading: boolean, text = 'Continuar con Google') {
    if (button) button.disabled = isLoading;
    if (label) label.textContent = text;
  }

  function showError(message: string) {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.classList.remove('hidden');
    setLoading(false);
  }

  function loadSdk(): Promise<void> {
    if (loaded) return loaded;

    loaded = new Promise<void>((resolve, reject) => {
      const ready = () => Boolean((window as any).google?.accounts?.oauth2);

      if (ready()) {
        resolve();
        return;
      }

      const script = document.createElement('script');
      script.src = GSI_SRC;
      script.async = true;
      script.defer = true;
      script.onload = () => {
        ready() ? resolve() : reject(new Error('Google Identity no disponible'));
      };
      script.onerror = () => reject(new Error('No se pudo cargar Google'));
      document.head.appendChild(script);
    });

    return loaded;
  }

  /** Supabase compara este nonce con el claim `nonce` del ID token. */
  function createNonce(): string {
    const bytes = new Uint8Array(32);
    crypto.getRandomValues(bytes);
    return Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
  }

  /** Guarda el nonce para el callback (sobrevive al viaje a Google). */
  function stashNonce(nonce: string) {
    try {
      sessionStorage.setItem(NONCE_KEY, nonce);
    } catch {
      // modo privado estricto: el nonce también va en la URL de retorno
    }
  }

  /** Dirección a la que Google devuelve al usuario (mismo host y ruta). */
  function callbackUrl() {
    return `${window.location.origin}${window.location.pathname}`;
  }

  function nextPath(): string {
    const next = new URLSearchParams(window.location.search).get('next');
    return next && next.startsWith('/') && !next.startsWith('//') ? next : '/cuenta';
  }

  /**
   * Decide el destino después de entrar con Google:
   *   - cuenta ya vinculada a Google          → /cuenta
   *   - cuenta recién creada (alta con Google) → /cuenta/onboarding
   */
  async function routeAfterSignIn(createdAt: string | undefined) {
    // Recién creada (< 2 min) ⇒ es un alta, no un login.
    const isNew = createdAt ? Date.now() - new Date(createdAt).getTime() < 120_000 : false;

    if (isNew) {
      window.location.href = `/cuenta/onboarding?nuevo=1&next=${encodeURIComponent(nextPath())}`;
      return;
    }

    window.location.href = nextPath();
  }

  /**
   * Google devuelve a esta página con `?code=…`. El código se canjea aquí
   * mismo (token endpoint con CORS) para obtener el ID token con el nonce
   * que guardamos antes de salir.
   */
  /** SHA-256 en base64url: así espera Google el nonce cuando se usa `hash`.
      Si se envía en claro, el token trae el valor en claro. */
  async function sha256Base64Url(value: string): Promise<string> {
    const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(value));
    const bytes = new Uint8Array(digest);
    let binary = '';
    bytes.forEach((b) => (binary += String.fromCharCode(b)));
    return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  }

  async function exchangeCode(code: string): Promise<string | null> {
    const body = new URLSearchParams({
      code,
      client_id: clientId,
      redirect_uri: window.location.origin + window.location.pathname,
      grant_type: 'authorization_code',
    });

    const res = await fetch('https://oauth2.googleapis.com/token', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: body.toString(),
    });

    const json: any = await res.json().catch(() => ({}));

    if (!res.ok || !json.id_token) {
      console.error('[google] token exchange', res.status, json?.error, json?.error_description);
      return null;
    }

    return json.id_token as string;
  }

  /**
   * Si volvemos de Google (`?code=`), se completa el inicio de sesión.
   * El código se canjea aquí mismo contra el token endpoint de Google.
   */
  function cleanUrl() {
    const url = new URL(window.location.href);
    url.searchParams.delete('code');
    url.searchParams.delete('scope');
    url.searchParams.delete('authuser');
    url.searchParams.delete('prompt');
    url.searchParams.delete('hd');
    history.replaceState({}, '', `${url.pathname}${url.search}`);
  }

  async function completeRedirectFlow(): Promise<boolean> {
    const params = new URLSearchParams(window.location.search);
    const code = params.get('code');

    if (!code) return false;

    // El formulario no debe heredar los parámetros de Google.
    cleanUrl();

    let nonce = '';
    try {
      nonce = sessionStorage.getItem(NONCE_KEY) ?? '';
    } catch {
      /* modo privado: sin nonce no se puede validar */
    }

    setLoading(true, 'Verificando…');

    try {
      const idToken = await exchangeCode(code);
      if (!idToken) {
        showError('No pudimos validar el acceso con Google. Intenta de nuevo.');
        return true;
      }

      // El ID token trae el `nonce` en claro o su hash (SHA-256 base64url).
      const candidates = nonce ? [nonce, await sha256Base64Url(nonce)] : [undefined];

      let lastError: any = null;

      for (const candidate of candidates) {
        const { data, error } = await supabase.auth.signInWithIdToken({
          provider: 'google',
          token: idToken,
          ...(candidate ? { nonce: candidate } : {}),
        });

        if (!error) {
          try {
            sessionStorage.removeItem(NONCE_KEY);
          } catch {
            /* sin storage */
          }

          await routeAfterSignIn(data?.user?.created_at);
          return true;
        }

        lastError = error;
      }

      console.error('[google] signInWithIdToken:', lastError?.message, lastError?.status);
      showError('No pudimos validar la sesión con Google. Recarga la página e intenta de nuevo.');
      return true;
    } catch (err: any) {
      console.error('[google] redirect flow', err?.message);
      showError('No pudimos completar el inicio de sesión con Google.');
      return true;
    }
  }

  /**
   * Flujo de CÓDIGO (redirect). Sin One Tap no se puede pedir el ID token
   * directo desde el navegador; el nonce que Supabase valida va aquí.
   */
  async function startGoogleLogin() {
    if (errorEl) errorEl.classList.add('hidden');
    setLoading(true, 'Abriendo Google…');

    try {
      await loadSdk();
    } catch {
      showError('No se pudo cargar Google. Revisa tu conexión.');
      return;
    }

    const oauth2 = (window as any).google?.accounts?.oauth2;

    if (!oauth2 || typeof oauth2.initCodeClient !== 'function') {
      setLoading(false);
      console.error(
        '[google] oauth2 no disponible. window.google =',
        (window as any).google,
        'se esperaba accounts.oauth2.initCodeClient'
      );
      showError(
        'Google no está disponible en este navegador. Desactiva bloqueadores de scripts y recarga la página.'
      );
      return;
    }

    const nonce = createNonce();
    stashNonce(nonce);

    try {
      const codeClient = oauth2.initCodeClient({
        client_id: clientId,
        scope,
        nonce,
        ux_mode: 'redirect',
        redirect_uri: callbackUrl(),
        select_account: true,
      });

      codeClient.requestCode();
    } catch (err: any) {
      setLoading(false);
      console.error('[google] initCodeClient', err);
      showError('No se pudo abrir Google. Recarga la página e intenta de nuevo.');
    }
  }

  // Acelera la carga del SDK mientras el usuario lee el formulario
  if ('requestIdleCallback' in window) {
    (window as any).requestIdleCallback(() => loadSdk().catch(() => {}));
  } else {
    setTimeout(() => loadSdk().catch(() => {}), 1200);
  }

  // Si venimos de Google, se termina el flujo antes de nada más.
  void completeRedirectFlow();

  button?.addEventListener('click', () => void startGoogleLogin());
</script>

<!--
  Requisitos fuera del código:
  · Supabase → Authentication → Providers → Google: Client ID y Secret del
    mismo cliente OAuth (el ID es el de PUBLIC_GOOGLE_CLIENT_ID).
  · Supabase → Authentication → URL Configuration:
      Site URL       = https://dspstorefront.vercel.app
      Redirect URLs  += https://dspstorefront.vercel.app/**
  · Google Cloud → Credenciales → OAuth 2.0 Client ID (Web application):
      Authorized JavaScript origins = https://dspstorefront.vercel.app
      Authorized redirect URIs     = https://dspstorefront.vercel.app/entrar
                                     https://dspstorefront.vercel.app/registro
-->
