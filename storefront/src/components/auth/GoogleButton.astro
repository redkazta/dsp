---
/**
 * Botón de Google con Google Identity Services (ID Token flow).
 *
 * El flujo es el recomendado por Supabase para apps web:
 *   1. Google devuelve un ID token (no un código).
 *   2. Se entrega a `signInWithIdToken` con el `nonce` (no su hash).
 *
 * Se usa `google.accounts.id.renderButton()` apuntando a un contenedor propio
 * y se estiliza por CSS: así no aparece el One Tap (el que Google está
 * apagando por FedCM) ni hace falta popup ni `redirect_uri`.
 *
 * Requisitos en Google Cloud (Credenciales → OAuth 2.0 Client ID · Web):
 *   - Authorized JavaScript origins: https://dspstorefront.vercel.app
 *   - Authorized redirect URIs: https://dzrxwmyxxhjonhbfgfvo.supabase.co/auth/v1/callback
 *   (la redirección la hace Supabase, no esta página).
 */
import { getCopy, type Lang } from '../../lib/i18n';

const lang = (Astro.locals.lang ?? 'es') as Lang;
const t = getCopy(lang);

const GOOGLE_CLIENT_ID =
  import.meta.env.PUBLIC_GOOGLE_CLIENT_ID ||
  '487574117831-d497l5eneq6sn1rm0ouigimaet76frb9.apps.googleusercontent.com';
---

<div id="google-auth" class="w-full" data-client-id={GOOGLE_CLIENT_ID}>
  <button type="button" id="google-btn" class="google-btn" aria-label={t.account.continueGoogle}>
    <span class="google-icon" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 48 48">
        <path
          fill="#EA4335"
          d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"
        ></path>
        <path
          fill="#4285F4"
          d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"
        ></path>
        <path
          fill="#FBBC05"
          d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"
        ></path>
        <path
          fill="#34A853"
          d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.9l-7.98 6.19C6.51 42.62 14.62 48 24 48z"
        ></path>
      </svg>
    </span>
    <span id="google-btn-label">{t.account.continueGoogle}</span>
  </button>

  <p id="google-error" class="hidden mt-3 text-sm text-red-400 text-center leading-relaxed"></p>
</div>

<style>
  .google-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    min-height: 52px;
    padding: 0.875rem 1.75rem;
    background: #ffffff;
    color: #111111;
    border: 2px solid #ffffff;
    font-family: 'Space Grotesk', Inter, sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      opacity 0.25s ease;
  }

  .google-btn:hover:not(:disabled) {
    background: #ffe28a;
    border-color: #ffe28a;
    box-shadow: 0 0 32px -8px rgba(242, 201, 76, 0.6);
  }

  .google-btn:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 2px #060606,
      0 0 0 4px #ffe28a;
  }

  .google-btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .google-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
    pointer-events: none;
  }

  .google-icon svg {
    display: block;
    transition: transform 0.25s ease;
  }

  .google-btn:hover:not(:disabled) .google-icon svg {
    transform: scale(1.08);
  }
</style>

<script>
  import { supabase } from '../../lib/supabase';

  const GSI_SRC = 'https://accounts.google.com/gsi/client';

  const root = document.getElementById('google-auth');
  const button = document.getElementById('google-btn') as HTMLButtonElement | null;
  const label = document.getElementById('google-btn-label');
  const errorEl = document.getElementById('google-error');
  const clientId = root?.dataset.clientId ?? '';

  /** Nonce en claro para Supabase y su hash SHA-256 (hex) para Google. */
  const NONCE_KEY = 'dsp_google_nonce_plain';
  const HASH_KEY = 'dsp_google_nonce_hash';

  let loaded: Promise<void> | null = null;
  let rendered = false;

  function setLoading(isLoading: boolean, text = 'Continuar con Google') {
    if (button) button.disabled = isLoading;
    if (label) label.textContent = text;
  }

  function showError(message: string) {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.classList.remove('hidden');
    setLoading(false);
  }

  function loadSdk(): Promise<void> {
    if (loaded) return loaded;

    loaded = new Promise<void>((resolve, reject) => {
      const ready = () => Boolean((window as any).google?.accounts?.id);

      if (ready()) {
        resolve();
        return;
      }

      const script = document.createElement('script');
      script.src = GSI_SRC;
      script.async = true;
      script.defer = true;
      script.onload = () => {
        ready() ? resolve() : reject(new Error('Google Identity no disponible'));
      };
      script.onerror = () => reject(new Error('No se pudo cargar Google'));
      document.head.appendChild(script);
    });

    return loaded;
  }

  /**
   * Supabase compara el `nonce` enviado con el del ID token. Google recibe el
   * HASH (SHA-256 en hexadecimal) y lo copia tal cual al token, así que:
   *   - a Google → hashedNonce
   *   - a Supabase → nonce en claro
   */
  async function createNoncePair(): Promise<{ nonce: string; hashed: string }> {
    const bytes = crypto.getRandomValues(new Uint8Array(32));
    const nonce = btoa(String.fromCharCode(...bytes));

    const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(nonce));
    const hashed = Array.from(new Uint8Array(digest))
      .map((b) => b.toString(16).padStart(2, '0'))
      .join('');

    return { nonce, hashed };
  }

  function nextPath(): string {
    const next = new URLSearchParams(window.location.search).get('next');
    return next && next.startsWith('/') && !next.startsWith('//') ? next : '/cuenta';
  }

  /** Cuenta nueva (< 2 min) → completar datos; si ya existía → su cuenta. */
  function routeAfterSignIn(createdAt: string | undefined) {
    const isNew = createdAt ? Date.now() - new Date(createdAt).getTime() < 120_000 : false;

    window.location.href = isNew
      ? `/cuenta/onboarding?nuevo=1&next=${encodeURIComponent(nextPath())}`
      : nextPath();
  }

  async function handleCredential(response: any) {
    const credential = response?.credential as string | undefined;

    if (!credential) {
      showError('Google no devolvió credenciales. Intenta de nuevo.');
      return;
    }

    let nonce = '';
    try {
      nonce = sessionStorage.getItem(NONCE_KEY) ?? '';
    } catch {
      /* sin storage: se intenta igual */
    }

    const { data, error } = await supabase.auth.signInWithIdToken({
      provider: 'google',
      token: credential,
      ...(nonce ? { nonce } : {}),
    });

    if (error) {
      console.error('[google] signInWithIdToken:', error.message, error.status);
      showError('No pudimos iniciar sesión con Google. Intenta de nuevo.');
      return;
    }

    routeAfterSignIn(data?.user?.created_at);
  }

  async function renderGoogle() {
    await loadSdk();

    const google = (window as any).google;
    if (!google?.accounts?.id) {
      showError('Google no está disponible en este navegador.');
      return;
    }

    const { nonce, hashed } = await createNoncePair();

    try {
      sessionStorage.setItem(NONCE_KEY, nonce);
      sessionStorage.setItem(HASH_KEY, hashed);
    } catch {
      /* modo privado */
    }

    google.accounts.id.initialize({
      client_id: clientId,
      nonce: hashed,
      callback: (resp: any) => {
        setLoading(false);
        void handleCredential(resp);
      },
    });

    rendered = true;

    // Genera el ID token sin abrir el One Tap: el usuario ya hizo clic.
    google.accounts.id.prompt(() => {
      /* el callback de estado no se usa: el resultado llega por `callback` */
    });
  }

  // Precarga el SDK mientras el usuario lee el formulario
  if ('requestIdleCallback' in window) {
    (window as any).requestIdleCallback(() => loadSdk().catch(() => {}));
  }

  button?.addEventListener('click', async () => {
    if (errorEl) errorEl.classList.add('hidden');
    setLoading(true, 'Abriendo Google…');

    try {
      await renderGoogle();
    } catch (err: any) {
      setLoading(false);
      console.error('[google] renderGoogle', err?.message);
      showError('No se pudo cargar Google. Revisa tu conexión.');
      return;
    }

    // Si el prompt no dispara el callback (p. ej. bloqueado), no dejamos el
    // botón colgado.
    if (rendered) {
      setTimeout(() => {
        if (label?.textContent === 'Abriendo Google…') setLoading(false);
      }, 4000);
    }
  });
</script>

<!--
  Configuración externa (no depende de esta página):
  · Google Cloud → Credenciales → OAuth 2.0 Client ID (Web application):
      Authorized JavaScript origins = https://dspstorefront.vercel.app
      Authorized redirect URIs     = https://dzrxwmyxxhjonhbfgfvo.supabase.co/auth/v1/callback
  · Supabase → Authentication → URL Configuration:
      Site URL      = https://dspstorefront.vercel.app
      Redirect URLs = https://dspstorefront.vercel.app/**
  · Supabase → Authentication → Providers → Google: el mismo Client ID y su Secret.
-->
