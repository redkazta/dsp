---
/**
 * Botón de Google con Google Identity Services (ID Token flow).
 * Renderiza el botón programáticamente y se adapta al ancho disponible.
 */
import { supabase } from '../../lib/supabase';

const GOOGLE_CLIENT_ID =
  import.meta.env.PUBLIC_GOOGLE_CLIENT_ID ||
  '487574117831-d497l5eneq6sn1rm0ouigimaet76frb9.apps.googleusercontent.com';
---

<div
  id="google-auth"
  class="w-full flex flex-col items-center"
  data-client-id={GOOGLE_CLIENT_ID}
>
  <div id="google-btn-slot" class="w-full flex justify-center">
    <!-- Fallback mientras carga el SDK -->
    <button
      type="button"
      disabled
      class="btn-outline w-full opacity-60 cursor-wait"
    >
      Cargando Google…
    </button>
  </div>

  <p id="google-error" class="hidden mt-3 text-xs text-red-400 text-center leading-relaxed"></p>
</div>

<script>
  import { supabase } from '../../lib/supabase';

  const root = document.getElementById('google-auth');
  const slot = document.getElementById('google-btn-slot');
  const errorEl = document.getElementById('google-error');
  const clientId = root?.dataset.clientId ?? '';

  function showError(message: string) {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.classList.remove('hidden');
  }

  async function handleCredential(response: { credential: string }) {
    const { error } = await supabase.auth.signInWithIdToken({
      provider: 'google',
      token: response.credential,
    });

    if (error) {
      console.error('[google] signInWithIdToken:', error.message);
      showError('No pudimos iniciar sesión con Google. Intenta de nuevo.');
      return;
    }

    window.location.href = '/cuenta';
  }

  function renderGoogleButton() {
    const g = (window as any).google;
    if (!g?.accounts?.id || !slot || !clientId) return;

    const width = Math.min(384, Math.max(200, slot.clientWidth || 320));

    slot.innerHTML = '<div id="g-btn"></div>';
    const target = document.getElementById('g-btn');
    if (!target) return;

    g.accounts.id.initialize({
      client_id: clientId,
      callback: handleCredential,
      auto_select: false,
      cancel_on_tap_outside: true,
      use_fedcm_for_prompt: true,
    });

    g.accounts.id.renderButton(target, {
      type: 'standard',
      theme: 'outline',
      size: 'large',
      shape: 'rectangular',
      text: 'continue_with',
      logo_alignment: 'center',
      width: String(width),
    });
  }

  function loadGoogleScript() {
    if ((window as any).google?.accounts?.id) {
      renderGoogleButton();
      return;
    }

    if (document.getElementById('gsi-script')) {
      // Script ya insertado, espera a que cargue
      setTimeout(renderGoogleButton, 300);
      return;
    }

    const script = document.createElement('script');
    script.id = 'gsi-script';
    script.src = 'https://accounts.google.com/gsi/client';
    script.async = true;
    script.defer = true;
    script.onload = renderGoogleButton;
    script.onerror = () => showError('No se pudo cargar Google. Revisa tu conexión.');
    document.head.appendChild(script);
  }

  let resizeTimer: number | undefined;
  window.addEventListener('resize', () => {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(renderGoogleButton, 250);
  });

  loadGoogleScript();
</script>
