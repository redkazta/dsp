---
/**
 * Botón de Google con Google Identity Services (ID Token).
 * Muestra el popup nativo centrado y con tamaño grande.
 */
import { supabase } from '../../lib/supabase';

const GOOGLE_CLIENT_ID =
  import.meta.env.PUBLIC_GOOGLE_CLIENT_ID ||
  '487574117831-d497l5eneq6sn1rm0ouigimaet76frb9.apps.googleusercontent.com';
---

<div class="w-full flex flex-col items-center">
  <!-- Contenedor donde Google inyecta su botón oficial -->
  <div id="g_id_onload"
       data-client_id={GOOGLE_CLIENT_ID}
       data-context="signin"
       data-ux_mode="popup"
       data-callback="handleGoogleCredential"
       data-auto_prompt="false"
       data-use_fedcm_for_prompt="true">
  </div>

  <div class="w-full flex justify-center overflow-hidden rounded-sm">
    <div
      id="google-btn-container"
      class="g_id_signin"
      data-type="standard"
      data-theme="outline"
      data-size="large"
      data-shape="rectangular"
      data-text="continue_with"
      data-logo_alignment="center"
      data-width="384"
    ></div>
  </div>

  <p id="google-error" class="hidden mt-3 text-xs text-red-400 text-center"></p>
</div>

<script>
  import { supabase } from '../../lib/supabase';

  declare global {
    interface Window {
      handleGoogleCredential?: (response: { credential: string }) => void;
    }
  }

  window.handleGoogleCredential = async (response) => {
    const errorEl = document.getElementById('google-error');

    const { error } = await supabase.auth.signInWithIdToken({
      provider: 'google',
      token: response.credential,
    });

    if (error) {
      console.error('[google] signInWithIdToken:', error.message);
      if (errorEl) {
        errorEl.textContent = 'No pudimos iniciar sesión con Google. Intenta de nuevo.';
        errorEl.classList.remove('hidden');
      }
      return;
    }

    window.location.href = '/cuenta';
  };

  if (!document.getElementById('gsi-script')) {
    const s = document.createElement('script');
    s.id = 'gsi-script';
    s.src = 'https://accounts.google.com/gsi/client';
    s.async = true;
    s.defer = true;
    document.head.appendChild(s);
  }

  // En móvil el botón de 384px no cabe: lo limitamos al ancho disponible
  const fitGoogleButton = () => {
    const container = document.getElementById('google-btn-container');
    if (!container) return;

    const parent = container.parentElement;
    if (!parent) return;

    // Desconta padding del contenedor para evitar desbordes
    const styles = getComputedStyle(parent);
    const available =
      parent.clientWidth -
      parseFloat(styles.paddingLeft || '0') -
      parseFloat(styles.paddingRight || '0');

    const width = Math.min(384, Math.max(200, available));
    container.style.width = `${width}px`;
    container.style.marginLeft = 'auto';
    container.style.marginRight = 'auto';
  };

  fitGoogleButton();
  window.addEventListener('resize', fitGoogleButton);
</script>
