---
/**
 * Aviso de cookies — barra fija abajo.
 *
 * Delgada a propósito: una sola línea en desktop, mensaje corto y el botón de
 * aceptar a la derecha. Se guarda en `dsp_cookie_consent` y no vuelve a salir.
 *
 * Hoy la tienda no usa rastreadores publicitarios: sesión (Supabase), carrito
 * (localStorage) e idioma (cookie) son técnicos, y Vercel Analytics no usa
 * cookies. Cuando se añada medición con consentimiento, debe leer esta clave.
 */
import { localize } from '../lib/routes';

const lang = (Astro.locals.lang ?? 'es') as 'es' | 'en';

const copy =
  lang === 'es'
    ? {
        text: 'Solo usamos cookies necesarias: sesión, carrito e idioma.',
        all: 'Aceptar',
        necessary: 'Solo necesarias',
        more: 'Privacidad',
      }
    : {
        text: 'We only use necessary cookies: session, cart and language.',
        all: 'Accept',
        necessary: 'Necessary only',
        more: 'Privacy',
      };
---

<div
  id="cookie-consent"
  class="hidden fixed bottom-0 inset-x-0 z-[95] border-t-2 border-oro-brillo/60 bg-negro-profundo/98 backdrop-blur-xl"
  role="region"
  aria-live="polite"
  aria-label="Cookies"
>
  <div class="page-container py-2.5 flex items-center gap-3 sm:gap-5">
    <p class="flex-1 min-w-0 text-[11px] sm:text-xs text-white/75 leading-snug">
      {copy.text}
      <a
        href={localize(lang, 'privacy')}
        class="text-white/60 hover:text-oro-brillo underline underline-offset-2 whitespace-nowrap"
      >
        {copy.more}
      </a>
    </p>

    <button
      type="button"
      data-cookie="necessary"
      class="hidden sm:inline text-[11px] uppercase tracking-[0.12em] text-white/55 hover:text-white/85 transition-colors whitespace-nowrap"
    >
      {copy.necessary}
    </button>

    <button
      type="button"
      data-cookie="all"
      class="btn-gold !min-h-[36px] !px-4 !py-1.5 !text-[10px] !tracking-[0.16em] shrink-0"
    >
      {copy.all}
    </button>
  </div>
</div>

<script>
  const KEY = 'dsp_cookie_consent';
  const bar = document.getElementById('cookie-consent');

  if (bar && !localStorage.getItem(KEY)) {
    bar.classList.remove('hidden');
    document.body.classList.add('has-cookie-bar');
  }

  if (bar) {
    bar.querySelectorAll<HTMLButtonElement>('[data-cookie]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const choice = btn.dataset.cookie ?? 'necessary';
        localStorage.setItem(KEY, choice);
        bar.classList.add('hidden');
        document.body.classList.remove('has-cookie-bar');

        // Punto único para colgar medición con consentimiento en el futuro.
        window.dispatchEvent(new CustomEvent('cookie:consent', { detail: { choice } }));
      })
    );
  }
</script>

<style is:global>
  /* La barra no debe tapar el final del footer. */
  body.has-cookie-bar {
    padding-bottom: 64px;
  }
</style>
