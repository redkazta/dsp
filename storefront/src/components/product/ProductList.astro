---
/**
 * ProductList.astro - Grid de productos
 */
import ProductCard from './ProductCard.astro';

export interface Props {
  products: any[];
}

const { products } = Astro.props;
---

{
  products.length === 0 ? (
    <div class="text-center py-24">
      <p class="font-titulos text-2xl text-plata-metalico/40 mb-2">Sin resultados</p>
      <p class="text-sm text-plata-metalico/40">No hay productos disponibles por el momento.</p>
    </div>
  ) : (
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-8">
      {products.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>
  )
}
