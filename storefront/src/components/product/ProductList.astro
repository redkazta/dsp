---
/**
 * ProductList.astro - Grid de productos
 * 2 columnas en móvil, 3 en tablet, 4 en desktop. Y una columna más en
 * pantallas grandes para que toda la colección entre sin scroll.
 * En `/tienda` se usa `compact` para que se vean jeans y playeras de una.
 */
import ProductCard from './ProductCard.astro';
import { getCopy, type Lang } from '../../lib/i18n';

export interface Props {
  products: any[];
  /** Tarjetas más pequeñas y sin aire extra (catálogo de /tienda). */
  compact?: boolean;
}

const { products: rawProducts, compact = false } = Astro.props;

const lang = (Astro.locals.lang ?? 'es') as Lang;
const t = getCopy(lang);

// Red de seguridad: un producto por id aunque la consulta lo repita
// (p. ej. por un join con imágenes o variantes).
const products = [...new Map<string, any>(rawProducts.map((p) => [String(p.id), p])).values()];
---

{
  products.length === 0 ? (
    <div class="text-center py-20 sm:py-24">
      <p class="font-titulos text-2xl sm:text-3xl text-blancoRoto mb-3">{t.shop.emptyTitle}</p>
      <div class="gold-line mx-auto mb-5" />
      <p class="text-muted">{t.shop.noProducts}</p>
    </div>
  ) : (
    <div
      data-shop-grid
      class:list={[
        'grid',
        compact
          ? 'grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-x-3 gap-y-6 sm:gap-x-4 sm:gap-y-7 lg:gap-x-5 lg:gap-y-8 shop-grid--compact'
          : 'grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-x-4 gap-y-10 sm:gap-x-5 sm:gap-y-12 lg:gap-x-8 lg:gap-y-16',
      ]}
    >
      {products.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>
  )
}

<style>
  /* Versión compacta de /tienda: mismas piezas, menos aire.
     Ojo: aquí NO se puede usar `aspect-ratio` con contenido absoluto.
     Todo lo que va dentro del marco (imagen, badge, flechas, CTA) es
     `position: absolute`, así que el marco no tiene contenido en flujo y
     su altura sería 0. Se le da altura explícita y se centra con flex. */
  .shop-grid--compact :global(.product-frame) {
    aspect-ratio: auto !important;
    height: clamp(140px, 21vh, 250px);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* La imagen del producto suelto llena el marco sin depender de `inset` */
  .shop-grid--compact :global(.product-frame > img),
  .shop-grid--compact :global(.product-frame > picture > img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    padding: 3%;
  }

  .shop-grid--compact :global(.product-card-wrap) {
    display: flex;
    flex-direction: column;
  }

  .shop-grid--compact :global(.product-card-wrap a) {
    display: block;
    min-width: 0;
  }

  .shop-grid--compact :global(.product-frame > img),
  .shop-grid--compact :global(.product-frame > picture > img),
  .shop-grid--compact :global(.card-slide img) {
    padding: 3%;
  }

  /* Título y precio: una línea cada uno, sin desbordes */
  .shop-grid--compact :global(.product-card-wrap h3) {
    font-size: 0.78rem;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    word-break: break-word;
  }

  .shop-grid--compact :global(.product-card-wrap p) {
    font-size: 0.75rem;
    line-height: 1.2;
  }

  /* Badge de reflectivo y corazón, a escala de la tarjeta */
  .shop-grid--compact :global(.reflect-badge) {
    top: 4px;
    left: 4px;
    min-width: 0;
    min-height: 0;
    padding: 3px 6px;
    gap: 0;
    border-width: 1px;
    backdrop-filter: none;
  }

  /* Las piezas sin reflejo solo llevan la etiqueta: ocupa menos y no
     compite con las que sí tienen cuenta atrás. */
  .shop-grid--compact :global(.reflect-badge.is-plain) {
    min-width: 0;
    min-height: 0;
    padding: 3px 6px;
  }

  .shop-grid--compact :global(.reflect-badge-label) {
    font-size: 7px;
    letter-spacing: 0.06em;
    line-height: 1.1;
  }

  .shop-grid--compact :global(.reflect-badge-count) {
    font-size: 15px;
    margin-top: 1px;
  }

  .shop-grid--compact :global(.reflect-badge-dot) {
    width: 4px;
    height: 4px;
    flex-basis: 4px;
  }

  /* Con cuenta atrás sí necesita un poco más de cuerpo para leerse */
  .shop-grid--compact :global(.reflect-badge:not(.is-plain)) {
    min-width: 42px;
    min-height: 30px;
    padding: 3px 5px 2px;
  }

  .shop-grid--compact :global(.wish-btn) {
    top: 4px;
    right: 4px;
    width: 28px;
    height: 28px;
  }

  .shop-grid--compact :global(.wish-btn svg) {
    width: 13px;
    height: 13px;
  }

  /* El CTA "Ver producto" ocupaba un tercio de una tarjeta ya pequeña */
  .shop-grid--compact :global(.product-cta > div) {
    padding-top: 0.35rem;
    padding-bottom: 0.35rem;
  }

  .shop-grid--compact :global(.product-cta span) {
    font-size: 8px;
    letter-spacing: 0.18em;
  }
</style>
