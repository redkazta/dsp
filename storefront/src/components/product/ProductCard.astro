---
/**
 * ProductCard.astro - Tarjeta de producto
 *
 * Si el producto tiene más de una foto, la imagen es un carrusel:
 * flechas al hacer hover (desktop) o swipe (móvil) + puntos de posición.
 * El clic en una flecha no navega al producto.
 */
import { getCopy, type Lang } from '../../lib/i18n';
import { planReflectImages, isFlashUrl } from '../../lib/reflective';
import { productName } from '../../lib/product-texts';
import { localize } from '../../lib/routes';
import ReflectBadge from './ReflectBadge.astro';

export interface Props {
  product: {
    id: string;
    slug?: string | null;
    name: string;
    base_price: number;
    is_reflective?: boolean | null;
    product_variants?: Array<{ id: string; name: string; price: number; stock: number }> | null;
    product_images?: Array<{ url: string; alt_text?: string; position?: number }> | null;
  };
}

const { product } = Astro.props;

const lang = (Astro.locals.lang ?? 'es') as Lang;
const t = getCopy(lang);
// Siempre por slug: es la URL que se indexa y la que se comparte.
const href = localize(lang, 'products', product.slug || product.id);
const price = product.product_variants?.[0]?.price ?? product.base_price;

// Nombre en el idioma activo (cae al español si falta la traducción).
const title = productName(product as any, lang);

// Mismo orden que la ficha: frente, espalda, frente con flash, espalda con flash
// (aunque la base traiga otro `position`).
function viewRank(url: string): number {
  const file = url.toLowerCase();
  const back = file.includes('back') ? 1 : 0;
  const flash = isFlashUrl(file) ? 2 : 0;
  return flash + back;
}

// Piezas reflectivas: solo portada + toma con el reflejo, para que el
// encendido se note (ver `lib/reflective.ts`).
const reflectPlan = planReflectImages(product.product_images, Boolean(product.is_reflective));

const images = reflectPlan.animatable
  ? reflectPlan.images.map((url) => ({ url }))
  : [...(product.product_images ?? [])].sort(
      (a: any, b: any) => viewRank(a.url) - viewRank(b.url) || (a.position ?? 0) - (b.position ?? 0)
    );

const reflect = reflectPlan.animatable;
const reflectFlash = reflectPlan.flashIndex;

const totalStock =
  product.product_variants?.reduce((sum, v) => sum + (v.stock ?? 0), 0) ?? 0;
const isSoldOut = product.product_variants != null && product.product_variants.length > 0 && totalStock === 0;

const sizes = [
  ...new Set((product.product_variants ?? []).map((v: any) => v.size).filter(Boolean)),
] as string[];

const trackId = `card-carousel-${product.id}`;
void trackId;

/** Variantes con stock: lo que se puede añadir desde la tarjeta. */
type CardVariant = {
  id: string;
  name: string;
  size?: string | null;
  color?: string | null;
  price: number;
  stock: number;
};

const available = ((product.product_variants ?? []) as CardVariant[]).filter(
  (v) => (v.stock ?? 0) > 0
);

const canQuickAdd = !isSoldOut && available.length > 0;
const singleVariant = available.length === 1 ? available[0] : null;
const cancelLabel = lang === 'es' ? 'Cancelar' : 'Cancel';
---

<div
  class="product-card-wrap"
  data-card
  data-card-id={product.id}
  data-card-slug={product.slug ?? ''}
  data-card-name={title}
  data-card-image={images[0]?.url ?? ''}
>
  <a href={href} class="block">
    <!-- Imagen: marco 1:1, mismo encuadre para toda la colección -->
    <div
      class="product-frame border-2 product-media transition-colors duration-300"
      data-reflect={reflect ? '1' : undefined}
      data-reflect-flash={reflect ? reflectFlash : undefined}
      data-reflect-ms={reflect ? 1000 : undefined}
      data-reflect-rotates={reflect ? '1' : undefined}
    >
      <ReflectBadge reflective={reflect} class={isSoldOut ? 'is-lowered' : ''} />

      <!-- El corazón vive DENTRO del marco: si cuelga de la tarjeta, se
           posiciona sobre el nombre y el precio, no sobre la foto. -->
      <button
        type="button"
        class="wish-btn absolute top-3 right-3 z-20 w-11 h-11 inline-flex items-center justify-center bg-negro-profundo border-2 border-white/40 text-white hover:border-oro-brillo hover:text-oro-brillo transition-colors"
        data-wish-id={product.id}
        data-wish-slug={product.slug ?? ''}
        data-wish-name={title}
        data-wish-price={price}
        data-wish-image={images[0]?.url ?? ''}
        aria-pressed="false"
        aria-label={`${t.product.wishlistAdd}: ${title}`}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1L12 21l7.7-7.6 1.1-1a5.5 5.5 0 0 0 0-7.8Z" />
        </svg>
      </button>
      {images.length > 0 ? (
        <>
          {images.length > 1 ? (
            <div class="card-carousel" data-carousel-scope>
              <div class="card-track" data-carousel-track tabindex="0" aria-label={`${title}: fotos`}>
                {images.map((img: any, i: number) => (
                  <div class="card-slide" data-carousel-slide>
                    <img
                      src={img.url}
                      alt={i === 0 ? title : `${title} · ${i + 1}`}
                      loading={i === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  </div>
                ))}
              </div>

              <button
                type="button"
                class="card-arrow card-arrow--prev"
                data-carousel-dir="-1"
                aria-label={t.product.previousPhoto}
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="m15 18-6-6 6-6" />
                </svg>
              </button>
              <button
                type="button"
                class="card-arrow card-arrow--next"
                data-carousel-dir="1"
                aria-label={t.product.nextPhoto}
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="m9 18 6-6-6-6" />
                </svg>
              </button>

              <div class="card-dots">
                {images.map((_: any, i: number) => (
                  <span
                    class:list={['card-dot', { 'is-active': i === 0 }]}
                    data-carousel-dot={i}
                  ></span>
                ))}
              </div>
            </div>
          ) : (
            <img
              src={images[0].url}
              alt={title}
              class="transition-transform duration-700 ease-out"
              loading="lazy"
              decoding="async"
            />
          )}
        </>
      ) : (
        <div class="absolute inset-0 flex items-center justify-center">
          <span class="font-acentos text-[10px] uppercase tracking-[0.3em] text-negro-profundo/20">
            {t.product.noImage}
          </span>
        </div>
      )}

      <!-- Badge agotado -->
      {isSoldOut && (
        <span class="absolute top-3 left-3 bg-negro-profundo px-3 py-1 border-2 border-white/50">
          <span class="font-acentos text-[10px] uppercase tracking-[0.2em] text-blancoRoto">
            {t.product.soldOut}
          </span>
        </span>
      )}

      <!-- Barra inferior (CTA en desktop, siempre visible en touch) -->
      <div class="product-cta absolute bottom-0 left-0 right-0 transition-transform duration-500">
        <div class="bg-oro-brillo text-negro-profundo text-center py-3">
          <span class="font-acentos text-[10px] uppercase tracking-[0.3em] font-medium">
            {t.product.viewProduct}
          </span>
        </div>
      </div>

      <!-- Selector rápido de talla: se abre desde el botón de la tarjeta -->
      {canQuickAdd && (
        <div class="quick-panel" data-quick-panel hidden>
          <p class="quick-title">{t.product.selectSize}</p>
          <div class="quick-sizes">
            {available.map((v) => (
              <button
                type="button"
                class="quick-size"
                data-add-variant={v.id}
                data-v-name={v.name ?? ''}
                data-v-size={v.size ?? ''}
                data-v-color={v.color ?? ''}
                data-v-price={v.price}
              >
                {v.size || v.name}
              </button>
            ))}
          </div>
          <button type="button" class="quick-cancel" data-quick-close>
            {cancelLabel}
          </button>
        </div>
      )}

      <!-- Línea dorada -->
      <div class="absolute top-0 left-0 w-full h-0.5 bg-oro-brillo scale-x-0 transition-transform duration-500 origin-left z-10 product-line"></div>

      <!-- Marco sutil -->
      <div class="absolute inset-0 ring-2 ring-inset ring-transparent transition-all duration-500 pointer-events-none"></div>
    </div>

    <!-- Info -->
    <div class="pt-4 flex items-start justify-between gap-3">
      <div class="min-w-0 flex-1">
        <h3 class="font-acentos text-base sm:text-lg text-blancoRoto transition-colors duration-300 leading-snug">
          {title}
        </h3>
        {sizes.length > 0 && <p class="mt-1.5 text-xs text-muted">{sizes.join(' · ')}</p>}
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <p class="font-acentos text-base sm:text-lg text-oro-brillo whitespace-nowrap leading-none">
          ${Number(price).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
        </p>

        {canQuickAdd && (
          <button
            type="button"
            class="quick-add"
            data-quick-add
            data-single-variant={singleVariant?.id ?? ''}
            data-single-name={singleVariant?.name ?? ''}
            data-single-size={singleVariant?.size ?? ''}
            data-single-color={singleVariant?.color ?? ''}
            data-single-price={singleVariant?.price ?? price}
            aria-label={`${t.product.addToCart}: ${title}`}
            title={t.product.addToCart}
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
              <path d="M3 6h18M16 10a4 4 0 0 1-8 0" />
            </svg>
          </button>
        )}
      </div>
    </div>
  </a>
</div>

<style>
  /* La tarjeta se repite en varias páginas: los efectos viven aquí,
     no en el layout, para no mezclar scope. */
  .product-card-wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .product-card-wrap > a {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* ---------- Añadir al carrito desde la tarjeta ---------- */
  .quick-add {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    border: 2px solid #ffe28a;
    background: rgba(255, 226, 138, 0.08);
    color: #ffe28a;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .quick-add:hover {
    background: #ffe28a;
    color: #0a0a0a;
  }

  .quick-panel {
    position: absolute;
    inset: 0;
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem;
    background: rgba(6, 6, 6, 0.94);
    backdrop-filter: blur(2px);
    text-align: center;
  }

  .quick-panel[hidden] {
    display: none;
  }

  .quick-title {
    font-family: 'Space Grotesk', Inter, sans-serif;
    font-size: 8px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #ffe28a;
  }

  .quick-sizes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px;
    max-height: 60%;
    overflow-y: auto;
  }

  .quick-size {
    min-width: 32px;
    min-height: 30px;
    padding: 0 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.45);
    background: transparent;
    color: #ffffff;
    font-family: 'Space Grotesk', Inter, sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .quick-size:hover {
    border-color: #ffe28a;
    color: #ffe28a;
  }

  .quick-cancel {
    font-family: 'Space Grotesk', Inter, sans-serif;
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    background: none;
    border: 0;
    padding: 0.25rem;
  }

  .quick-cancel:hover {
    color: #ffffff;
  }

  .product-card-wrap a .product-media {
    border-color: rgba(255, 255, 255, 0.3);
  }

  .product-card-wrap:hover .product-media {
    border-color: #ffe28a;
  }

  .product-card-wrap:hover h3 {
    color: #ffe28a;
  }

  .product-card-wrap:hover .product-media img {
    transform: scale(1.03);
  }

  .product-card-wrap:hover .product-line {
    transform: scaleX(1);
  }

  .product-cta {
    transform: translateY(0);
  }

  @media (min-width: 1024px) {
    .product-cta {
      transform: translateY(100%);
    }

    .product-card-wrap:hover .product-cta {
      transform: translateY(0);
    }
  }

  /* ---------- Carrusel dentro de la tarjeta ---------- */
  /* `.card-slide` se estira al alto de `.card-track`, que a su vez mide
     `height: 100%` del marco. Sin `min-height: 0` el flex item no puede
     encogerse y la imagen colapsa a 0 en marcos de altura fija (/tienda). */
  .card-carousel {
    position: absolute;
    inset: 0;
  }

  .card-track {
    display: flex;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    outline: none;
  }

  .card-track::-webkit-scrollbar {
    display: none;
  }

  .card-slide {
    flex: 0 0 100%;
    position: relative;
    height: 100%;
    min-height: 0;
    scroll-snap-align: start;
  }

  /* La imagen se posiciona como la de un producto de una sola foto:
     así ambas rutas (img suelta / carrusel) se pintan igual. */
  .card-slide img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    padding: 6%;
  }

  .card-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(6, 6, 6, 0.86);
    border: 2px solid rgba(255, 255, 255, 0.5);
    color: #ffffff;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .card-arrow--prev {
    left: 8px;
  }

  .card-arrow--next {
    right: 8px;
  }

  .card-carousel:hover .card-arrow,
  .card-track:focus-visible ~ .card-arrow {
    opacity: 1;
    pointer-events: auto;
  }

  .card-arrow:hover {
    border-color: #ffe28a;
    color: #ffe28a;
  }

  .card-arrow[data-edge] {
    opacity: 0.3;
  }

  /* En touch no hay hover: las flechas se quedan visibles */
  @media (hover: none) {
    .card-arrow {
      opacity: 1;
      pointer-events: auto;
      width: 30px;
      height: 30px;
    }
  }

  .card-dots {
    position: absolute;
    bottom: 10px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: 5px;
    z-index: 6;
    pointer-events: none;
  }

  .card-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: rgba(6, 6, 6, 0.35);
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .card-dot.is-active {
    background: #060606;
    transform: scale(1.15);
  }

  @media (prefers-reduced-motion: reduce) {
    .card-track {
      scroll-behavior: auto;
    }
  }

  /* El badge vive en global.css (también lo usan ficha y favoritos).
     Aquí solo se ajusta cuando la pieza está agotada. */
  .reflect-badge.is-lowered {
    top: 46px;
  }

  /* El badge y su cuenta atrás viven en global.css (ReflectBadge.astro). */
</style>

<script>
  import '../../lib/carousel';
  import '../../lib/reflect-anim';
  import { currentWishlist, hasSession, toggleWishlist } from '../../lib/wishlist';
  import { addToCart } from '../../lib/cart';
  type WishWindow = Window & { __dspWishBound?: boolean; __dspQuickBound?: boolean };

  function initWishCards() {
    const paint = (btn: HTMLButtonElement, active: boolean) => {
      btn.setAttribute('aria-pressed', String(active));
      btn.classList.toggle('border-oro-brillo', active);
      btn.classList.toggle('text-oro-brillo', active);
      btn.classList.toggle('border-white/40', !active);
      btn.querySelector('svg')?.setAttribute('fill', active ? 'currentColor' : 'none');
    };

    // Un solo request para todas las tarjetas: mismo origen de datos que
    // /favoritos y el panel, para que el corazón nunca se quede "pegado".
    async function syncCards() {
      try {
        const items = await currentWishlist(await hasSession());
        const saved = new Set(items.map((i) => String(i.productId)));
        document.querySelectorAll<HTMLButtonElement>('.wish-btn').forEach((btn) =>
          paint(btn, saved.has(String(btn.dataset.wishId)))
        );
      } catch {
        /* sin datos: se deja lo que haya pintado */
      }
    }

    void syncCards();
    // Al volver de /favoritos (o de otra pestaña) el estado se refresca.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') void syncCards();
    });
    window.addEventListener('focus', () => void syncCards());

    document.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement)?.closest<HTMLButtonElement>('.wish-btn');
      if (!btn) return;

      e.preventDefault();
      e.stopPropagation();

      const active = await toggleWishlist({
        productId: btn.dataset.wishId!,
        slug: btn.dataset.wishSlug || null,
        name: btn.dataset.wishName!,
        price: Number(btn.dataset.wishPrice),
        image: btn.dataset.wishImage || null,
      });

      // Todas las tarjetas del mismo producto, no solo la pulsada.
      const id = String(btn.dataset.wishId);
      document.querySelectorAll<HTMLButtonElement>('.wish-btn').forEach((other) => {
        if (String(other.dataset.wishId) === id) paint(other, active);
      });
    });
  }

  if (!(window as WishWindow).__dspWishBound) {
    (window as WishWindow).__dspWishBound = true;
    initWishCards();
  }

  // ---------- Añadir al carrito desde la tarjeta ----------
  // La tarjeta entera es un enlace: todo lo que sea botón corta la navegación.
  function initQuickAdd() {
    const addPiece = (
      card: HTMLElement,
      variantId: string,
      variantName: string,
      size: string,
      color: string,
      price: number
    ) => {
      addToCart({
        variantId,
        productId: card.dataset.cardId!,
        slug: card.dataset.cardSlug || null,
        name: card.dataset.cardName!,
        variantName: [size, color].filter(Boolean).join(' · ') || variantName || 'Unitalla',
        price: Number(price) || 0,
        qty: 1,
        image: card.dataset.cardImage || undefined,
        size: size || null,
        color: color || null,
      });
    };

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      const closeBtn = target.closest<HTMLElement>('[data-quick-close]');
      if (closeBtn) {
        e.preventDefault();
        e.stopPropagation();

        const panel = closeBtn
          .closest<HTMLElement>('[data-card]')
          ?.querySelector<HTMLElement>('[data-quick-panel]');

        if (panel) panel.hidden = true;
        return;
      }

      const sizeBtn = target.closest<HTMLElement>('[data-add-variant]');
      if (sizeBtn) {
        e.preventDefault();
        e.stopPropagation();

        const card = sizeBtn.closest<HTMLElement>('[data-card]');
        if (!card) return;

        addPiece(
          card,
          sizeBtn.dataset.addVariant!,
          sizeBtn.dataset.vName ?? '',
          sizeBtn.dataset.vSize ?? '',
          sizeBtn.dataset.vColor ?? '',
          Number(sizeBtn.dataset.vPrice)
        );

        const panel = card.querySelector<HTMLElement>('[data-quick-panel]');
        if (panel) panel.hidden = true;
        return;
      }

      const addBtn = target.closest<HTMLElement>('[data-quick-add]');
      if (!addBtn) return;

      e.preventDefault();
      e.stopPropagation();

      const card = addBtn.closest<HTMLElement>('[data-card]');
      if (!card) return;

      // Una sola variante disponible: se añade sin preguntar talla.
      const single = addBtn.dataset.singleVariant;
      if (single) {
        addPiece(
          card,
          single,
          addBtn.dataset.singleName ?? '',
          addBtn.dataset.singleSize ?? '',
          addBtn.dataset.singleColor ?? '',
          Number(addBtn.dataset.singlePrice)
        );
        return;
      }

      const panel = card.querySelector<HTMLElement>('[data-quick-panel]');
      if (panel) panel.hidden = !panel.hidden;
    });
  }

  if (!(window as WishWindow).__dspQuickBound) {
    (window as WishWindow).__dspQuickBound = true;
    initQuickAdd();
  }

  // ---------- Carrusel ----------
  // El comportamiento (flechas, puntos, avance automático) vive en
  // `lib/carousel.ts`, que se inicializa por delegación una sola vez.
</script>
