---
/**
 * ProductCard.astro - Tarjeta de producto
 * Fondos claros para fotos sobre blanco; hover con acento dorado
 */
export interface Props {
  product: {
    id: string;
    slug?: string | null;
    name: string;
    base_price: number;
    product_variants?: Array<{ id: string; name: string; price: number; stock: number }> | null;
    product_images?: Array<{ url: string; alt_text?: string }> | null;
  };
}

const { product } = Astro.props;
const href = `/producto/${product.slug || product.id}`;
const price = product.product_variants?.[0]?.price ?? product.base_price;
const image = product.product_images?.[0]?.url ?? null;
const totalStock =
  product.product_variants?.reduce((sum, v) => sum + (v.stock ?? 0), 0) ?? 0;
const isSoldOut = product.product_variants != null && product.product_variants.length > 0 && totalStock === 0;

const sizes = [
  ...new Set((product.product_variants ?? []).map((v: any) => v.size).filter(Boolean)),
] as string[];
---

<a href={href} class="group block">
  <!-- Imagen -->
  <div class="relative aspect-[4/5] overflow-hidden bg-white">
    {
      image ? (
        <img
          src={image}
          alt={product.name}
          class="w-full h-full object-contain transition-transform duration-700 ease-out group-hover:scale-[1.05]"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center">
          <span class="font-acentos text-[10px] uppercase tracking-[0.3em] text-negro-profundo/20">
            Sin imagen
          </span>
        </div>
      )
    }

    <!-- Badge agotado -->
    {
      isSoldOut && (
        <span class="absolute top-3 left-3 bg-negro-profundo/90 backdrop-blur px-3 py-1 border border-plata-metalico/20">
          <span class="font-acentos text-[9px] uppercase tracking-[0.2em] text-plata-metalico">
            Agotado
          </span>
        </span>
      )
    }

    <!-- CTA hover -->
    <div class="absolute bottom-0 left-0 right-0 translate-y-full group-hover:translate-y-0 transition-transform duration-500">
      <div class="bg-oro-elegante text-negro-profundo text-center py-3">
        <span class="font-acentos text-[10px] uppercase tracking-[0.3em] font-medium">
          Ver producto
        </span>
      </div>
    </div>

    <!-- Línea dorada -->
    <div class="absolute top-0 left-0 w-full h-px bg-oro-elegante scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left z-10"></div>

    <!-- Marco sutil -->
    <div class="absolute inset-0 ring-1 ring-inset ring-negro-profundo/5 group-hover:ring-oro-elegante/30 transition-all duration-500 pointer-events-none"></div>
  </div>

  <!-- Info -->
  <div class="pt-4 flex items-start justify-between gap-4">
    <div>
      <h3 class="font-acentos text-sm text-plata-claro group-hover:text-oro-elegante transition-colors duration-300">
        {product.name}
      </h3>
      {
        sizes.length > 0 && (
          <p class="mt-1 text-[11px] text-plata-metalico/40">
            {sizes.join(' · ')}
          </p>
        )
      }
    </div>
    <p class="font-acentos text-sm text-oro-elegante whitespace-nowrap">
      ${Number(price).toLocaleString('es-MX', { minimumFractionDigits: 2 })}
    </p>
  </div>
</a>
