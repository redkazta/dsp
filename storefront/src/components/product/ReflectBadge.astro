---
/**
 * ReflectBadge — cronómetro del ciclo del reflejo.
 *
 *   ┌─────────────────┐   ┌─────────────────┐
 *   │ REFLECTIVO EN:  │   │   NORMAL EN:    │
 *   │        2        │   │        1        │
 *   └─────────────────┘   └─────────────────┘
 *
 * El número baja 2 → 1 y al llegar a cero cambia la foto de la prenda.
 * El controlador (`lib/reflect-anim.ts`) es quien pinta el texto y el
 * número; este componente solo aporta la estructura.
 *
 * Si la prenda no es reflectiva muestra "Sin reflejo", apagado.
 */
import { getCopy, type Lang } from '../../lib/i18n';

export interface Props {
  /** true = la prenda tiene reflejo y se anima. Normalmente `product.is_reflective`. */
  reflective: boolean;
  /** Desde qué número arranca la cuenta. */
  seconds?: number;
  /** Clases extra del contenedor (p. ej. `is-lowered` si hay badge de agotado). */
  class?: string;
}

const { reflective, seconds = 2, class: className = '' } = Astro.props;

const lang = (Astro.locals.lang ?? 'es') as Lang;
const t = getCopy(lang);
---

<span
  class:list={[
    'reflect-badge',
    { 'is-plain': !reflective, 'is-lit': reflective },
    className,
  ]}
  data-reflect-badge
  data-label={t.product.reflective}
  data-label-normal={t.product.normalPhase}
>
  <span class="reflect-badge-label" data-reflect-label>
    {reflective ? t.product.reflective : t.product.notReflective}
  </span>
  {
    reflective && (
      <span class="reflect-badge-count" data-reflect-count>
        {seconds}
      </span>
    )
  }
  <span class="reflect-badge-dot" aria-hidden="true"></span>
</span>
