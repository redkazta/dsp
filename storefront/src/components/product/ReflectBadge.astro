---
/**
 * ReflectBadge — aviso "Reflectivo en…" con el cuenta atrás debajo.
 *
 *   ┌──────────────────┐
 *   │   Reflectivo en… │
 *   │        2         │
 *   └──────────────────┘
 *
 * Se usa en el hero, en las tarjetas del catálogo, en la ficha, en favoritos
 * y en el carrito. El controlador (`lib/reflect-anim.ts`) escribe el número
 * y marca `.is-lit` cuando ya está puesta la foto del reflejo.
 *
 * Si la prenda no es reflectiva muestra "Sin reflejo", apagado.
 */
import { getCopy, type Lang } from '../../lib/i18n';

export interface Props {
  /** true = la prenda tiene reflejo y se anima. Normalmente `product.is_reflective`. */
  reflective: boolean;
  /** Clases extra del contenedor (p. ej. `is-lowered` si hay badge de agotado). */
  class?: string;
}

const { reflective, class: className = '' } = Astro.props;

const lang = (Astro.locals.lang ?? 'es') as Lang;
const t = getCopy(lang);

// "Reflectivo en…" → la palabra sola se usa al encenderse.
const label = reflective ? t.product.reflective : t.product.notReflective;
---

<span
  class:list={['reflect-badge', { 'is-plain': !reflective }, className]}
  data-reflect-badge
  data-label={t.product.reflective}
  data-label-off={t.product.notReflective}
>
  <span class="reflect-badge-label" data-reflect-label>{label}</span>
  <span class="reflect-badge-dot" aria-hidden="true"></span>
</span>
