---
/**
 * ProductCarousel.astro
 *
 * Carrusel horizontal con scroll-snap: se desliza con el dedo en móvil,
 * con el trackpad/shift+rueda en desktop, o con las flechas.
 * No usa librerías: cero peso extra y funciona sin JS (solo scroll).
 */
import ProductCard from './ProductCard.astro';
import { getCopy, type Lang } from '../../lib/i18n';
import { localize } from '../../lib/routes';

export interface Props {
  title: string;
  subtitle?: string;
  products: any[];
  href?: string;
  hrefLabel?: string;
  /** Piezas visibles en desktop (3 = fotos más grandes a todo lo ancho). */
  perView?: 3 | 4;
}

const lang = (Astro.locals.lang ?? 'es') as Lang;
const t = getCopy(lang);

const {
  title,
  subtitle,
  products,
  href = localize(lang, 'shop'),
  hrefLabel = 'Ver todo',
  perView = 4,
} = Astro.props;

const trackId = `track-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;

// Un producto por id (la consulta puede repetirlo por joins)
const uniqueProducts = [...new Map<string, any>(products.map((p) => [String(p.id), p])).values()];
---

<section class="py-14 sm:py-20">
  <div class="page-container">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-8 sm:mb-10">
      <div>
        <p class="section-label mb-3">{subtitle ?? 'Colección'}</p>
        <h2 class="font-titulos text-3xl sm:text-4xl lg:text-5xl text-blancoRoto leading-none">
          {title}
        </h2>
      </div>

      <div class="flex items-center gap-3">
        <a href={href} class="btn-outline !min-h-[44px] !px-5 !py-2 !text-xs">{hrefLabel}</a>
        <div class="hidden sm:flex gap-2">
          <button
            type="button"
            data-carousel-prev={trackId}
            class="carousel-arrow"
            aria-label={`${title}: anteriores`}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m15 18-6-6 6-6" />
            </svg>
          </button>
          <button
            type="button"
            data-carousel-next={trackId}
            class="carousel-arrow"
            aria-label={`${title}: siguientes`}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m9 18 6-6-6-6" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    {
      uniqueProducts.length === 0 ? (
        <p class="text-base text-white/80 py-10">{t.shop.emptyCollection}</p>
      ) : (
        <div
          id={trackId}
          class={`carousel-track${perView === 3 ? ' carousel-track--three' : ''}`}
          role="list"
          aria-label={`${title}: piezas`}
        >
          {uniqueProducts.map((product) => (
            <div class="carousel-item" role="listitem">
              <ProductCard product={product} />
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .carousel-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 72%;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 0.5rem;
  }

  .carousel-track::-webkit-scrollbar {
    display: none;
  }

  .carousel-item {
    scroll-snap-align: start;
    min-width: 0;
  }

  @media (min-width: 640px) {
    .carousel-track {
      grid-auto-columns: 44%;
      gap: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    .carousel-track {
      grid-auto-columns: 23.5%;
      gap: 1.5rem;
    }

    .carousel-track--three {
      grid-auto-columns: 31%;
    }
  }

  .carousel-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    background: transparent;
    color: #ffffff;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .carousel-arrow:hover:not(:disabled) {
    border-color: #ffe28a;
    color: #ffe28a;
  }

  .carousel-arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel-prev], [data-carousel-next]').forEach((btn) => {
    const id = btn.dataset.carouselPrev ?? btn.dataset.carouselNext ?? '';
    const track = document.getElementById(id);
    if (!track) return;

    const direction = btn.hasAttribute('data-carousel-next') ? 1 : -1;

    const step = () => {
      const first = track.firstElementChild as HTMLElement | null;
      if (!first) return track.clientWidth;
      const styles = getComputedStyle(track);
      const gap = parseFloat(styles.columnGap || styles.gap || '0') || 0;
      return first.getBoundingClientRect().width + gap;
    };

    btn.addEventListener('click', () => {
      track.scrollBy({ left: step() * direction, behavior: 'smooth' });
    });

    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      const prev = document.querySelector<HTMLElement>(`[data-carousel-prev="${id}"]`);
      const next = document.querySelector<HTMLElement>(`[data-carousel-next="${id}"]`);
      if (prev) prev.disabled = track.scrollLeft <= 2;
      if (next) next.disabled = track.scrollLeft >= max;
    };

    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>
