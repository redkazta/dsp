---
interface Props {
  images: string[];
}

const { images = [] } = Astro.props;

const fallback = '/img/camisas/camisa-dsp-2-01-frente.jpg';

// Slide a slide, no imagen a imagen: si un producto tiene 3 fotos y otro 1,
// no se ve la misma playera tres veces seguidas.
const slides = images.length > 0 ? images : [fallback];
const duplicated = [...slides, ...slides];
---

<div class="hero-carousel">
  <div class="hero-carousel-track" data-hero-track>
    {
      duplicated.map((src) => (
        <div class="hero-slide">
          <img src={src} alt="" loading="lazy" decoding="async" />
        </div>
      ))
    }
  </div>
</div>

<style>
  .hero-carousel {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: #000;
  }

  .hero-carousel-track {
    display: flex;
    height: 100%;
    transition: transform 0.8s ease-in-out;
    will-change: transform;
  }

  /* Cada slide mide 1/3 del contenedor. El track NO puede tener un ancho fijo
     en % (con las slides en flex acababa desplazando de más y mostrando
     huecos negros entre fotos). */
  .hero-slide {
    flex: 0 0 33.3333%;
    height: 100%;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
  }

  .hero-slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0.95;
  }

  @media (max-width: 640px) {
    .hero-slide {
      flex: 0 0 100%;
    }
    .hero-slide img {
      object-fit: cover;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-carousel-track {
      transition: none;
    }
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>('[data-hero-track]');

  if (track) {
    let index = 0;
    let timer: number | undefined;

    /** Cuántas slides caben a la vez (3 en desktop, 1 en móvil). */
    const perView = () => (window.matchMedia('(max-width: 640px)').matches ? 1 : 3);

    /** Posición en % del propio track, que mide N slides de ancho. */
    function move(animate = true) {
      if (!animate) track!.style.transition = 'none';
      track!.style.transform = `translateX(-${index * (100 / perView())}%)`;
      if (!animate) {
        // Fuerza un reflow para que el salto no se anime.
        void track!.offsetWidth;
        track!.style.transition = '';
      }
    }

    function next() {
      const total = track!.children.length / 2;
      index++;

      // Se pasó de la copia original: salto invisible al primer slide.
      if (index > total - perView()) {
        move(true);
        window.setTimeout(() => {
          index = 0;
          move(false);
        }, 850);
        return;
      }

      move(true);
    }

    function start() {
      if (timer) return;
      timer = window.setInterval(next, 5000);
    }

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      start();

      // Al cambiar de tamaño, el desplazamiento en % cambia de base: recolocamos.
      window.addEventListener('resize', () => move(false));

      // No animar en pestañas ocultas (ahorra batería y evita saltos al volver).
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          window.clearInterval(timer);
          timer = undefined;
        } else {
          move(false);
          start();
        }
      });
    } else {
      move(false);
    }
  }
</script>
