---
interface Props {
  images: string[];
}

const { images = [] } = Astro.props;

const fallback = '/img/camisas/camisa-dsp-2-01-frente.jpg';

// Solo fotos distintas: si una pieza repite la misma URL, no se muestra dos veces.
const slides = [...new Set(images.filter(Boolean))];
const list = slides.length > 0 ? slides : [fallback];

// Se recorre la lista DOS veces para poder volver al inicio sin que se note.
const doubled = [...list, ...list];
---

<div class="hero-carousel">
  <div class="hero-carousel-track" data-hero-track style={`--count: ${list.length}`}>
    {
      doubled.map((src, i) => (
        <div class="hero-slide">
          <img src={src} alt="" loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
        </div>
      ))
    }
  </div>
</div>

<style>
  .hero-carousel {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: #000;
  }

  /*
    Por qué antes se veía "bugueado":
    el track no tenía ancho propio, así que se estiraba con sus hijos, pero el
    JS lo movía en % de ese ancho ya estirado. Cada salto equivalía a varias
    pantallas: la misma playera se repetía y había huecos en blanco.

    Ahora el desplazamiento es de una tanda completa, no de una slide:
      - cada slide ocupa 1/3 del contenedor (1 en móvil),
      - el track contiene la lista DOS veces,
      - avanzar una tanda = mover 100% del ancho del track (mitad de su ancho),
      - al llegar a la copia se salta sin animación al inicio.
    La velocidad cambia un poco según cuántas fotos haya, pero nunca se
    repite ni se queda en blanco.
  */
  .hero-carousel-track {
    display: flex;
    height: 100%;
    transition: transform 0.9s ease-in-out;
    will-change: transform;
  }

  .hero-slide {
    flex: 0 0 33.3333%;
    height: 100%;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
  }

  .hero-slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0.95;
  }

  @media (max-width: 640px) {
    .hero-slide {
      flex-basis: 100%;
    }
    .hero-slide img {
      object-fit: cover;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-carousel-track {
      transition: none;
    }
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>('[data-hero-track]');

  if (track) {
    const total = track.children.length / 2;
    let timer: number | undefined;

    /**
     * Avanza una tanda completa (mover 100% del track = su mitad, que es una
     * copia exacta de la lista). Así el carrusel nunca se queda corto ni
     * muestra huecos, tenga 1 foto o 7.
     */
    function next() {
      track!.style.transition = '';
      track!.style.transform = 'translateX(-50%)';

      window.setTimeout(() => {
        // Se está viendo la copia idéntica: se salta al original sin animar.
        track!.style.transition = 'none';
        track!.style.transform = 'translateX(0)';
        void track!.offsetWidth;
        track!.style.transition = '';
      }, 950);
    }

    function start() {
      if (timer) return;
      timer = window.setInterval(next, 5000);
    }

    function stop() {
      window.clearInterval(timer);
      timer = undefined;
    }

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && total > 1) {
      start();

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else start();
      });
    }
  }
</script>
