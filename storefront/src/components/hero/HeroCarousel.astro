---
/**
 * HeroCarousel.astro
 *
 * Carrusel de fondo para el hero: muestra 3 fotos de las playeras
 * separadas, con opacidad al 40 %, efecto de mostrador (3 imágenes
 * visibles, la central completa y las laterales a la mitad) y cambio
 * automático cada 5 segundos.
 */
interface Props {
  images: string[];
}

const { images = [] } = Astro.props;

const fallback = '/img/camisas/camisa-dsp-2-01-frente.jpg';
const slides = images.length > 0 ? images : [fallback];
const duplicated = [...slides, ...slides]; // loop infinito
---

<div class="hero-carousel">
  <div class="hero-carousel-track" data-hero-track>
    {duplicated.map((src, i) => (
      <div class="hero-slide">
        <img src={src} alt="" loading="lazy" />
      </div>
    ))}
  </div>
</div>

<style>
  .hero-carousel {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .hero-carousel-track {
    display: flex;
    width: 300%; /* 3 imágenes */
    transition: transform 0.8s ease-in-out;
    will-change: transform;
  }

  .hero-slide {
    width: 33.33%;
    height: 100%;
  }

  .hero-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.4;
    filter: grayscale(20%);
  }

  /* Móvil: 2 imágenes visibles, la central completa y la de la derecha a la mitad */
  @media (max-width: 640px) {
    .hero-carousel-track {
      width: 200%;
    }
    .hero-slide {
      width: 50%;
    }
  }
</style>

<script>
  const track = document.querySelector('[data-hero-track]');
  if (!track) {
    console.warn('HeroCarousel: no se encontró el track');
  } else {
    const total = track.children.length / 2; // mitad porque duplicamos
    let current = 0;

    function next() {
      current++;
      track.style.transform = `translateX(-${current * (100 / total)}%)`;

      if (current >= total) {
        setTimeout(() => {
          track.style.transition = 'none';
          current = 0;
          track.style.transform = 'translateX(0)';
          setTimeout(() => {
            track.style.transition = 'transform 0.8s ease-in-out';
          }, 50);
        }, 800);
      }
    }

    setInterval(next, 5000);
  }
</script>