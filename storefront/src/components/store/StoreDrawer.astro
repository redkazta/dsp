---
/**
 * StoreDrawer - panel flotante con carrito y wishlist.
 * Se abre desde el header o desde cualquier página que emita
 * `store:open` con detail { tab: 'cart' | 'wishlist' }.
 */
import { getCopy, type Lang } from '../../lib/i18n';

export interface Props {
  class?: string;
  /** Favoritos que ya pintó el servidor (sin parpadeo) */
  wishlist?: Array<{
    productId: string;
    slug: string | null;
    name: string;
    price: number;
    image: string | null;
  }>;
}

const { class: className = '', wishlist: initialWishlist = [] } = Astro.props;

const lang = (Astro.locals.lang ?? 'es') as Lang;
const t = getCopy(lang);

// Mini textos del panel (también los usan los scripts de abajo).
const ui = {
  cart: t.nav.carrito,
  wishlist: t.nav.favoritos,
  viewPieces: lang === 'en' ? 'View piece' : 'Ver pieza',
  seeAll: lang === 'en' ? 'See all' : 'Ver todos',
  seeFullCart: lang === 'en' ? 'See full cart' : 'Ver carrito completo',
  checkout: t.header.checkout,
  subtotal: 'Subtotal',
  close: t.header.close,
  emptyCart: lang === 'en' ? 'Your cart is empty.' : 'Tu carrito está vacío.',
  emptyWish: lang === 'en' ? 'No favorites yet.' : 'Todavía no guardas favoritos.',
  removeOne: lang === 'en' ? 'Remove one' : 'Quitar uno',
  addOne: lang === 'en' ? 'Add one' : 'Agregar uno',
  freeShipping: lang === 'en' ? 'Free shipping included.' : 'Envío gratis incluido.',
  missingForFree:
    lang === 'en' ? 'away from free shipping.' : 'para envío gratis.',
  savedToWish: lang === 'en' ? 'Saved to wishlist' : 'Guardado en favoritos',
  removedFromWish: lang === 'en' ? 'Removed from wishlist' : 'Quitado de favoritos',
  wishLoginPrompt:
    lang === 'en'
      ? 'Sign in to keep your favourites on every device.'
      : 'Inicia sesión para no perder tus favoritos al cambiar de dispositivo.',
  wishLoginCta: lang === 'en' ? 'Sign in' : 'Iniciar sesión',
  openPiece: lang === 'en' ? 'Open piece' : 'Abrir pieza',
  removeWish: lang === 'en' ? 'Remove' : 'Quitar',
  addAllToCart: lang === 'en' ? 'Add all to cart' : 'Añadir todo al carrito',
  addOneToCart: lang === 'en' ? 'Add to cart' : 'Añadir al carrito',
  inCart: lang === 'en' ? 'In cart' : 'En el carrito',
  qty: lang === 'en' ? 'Qty' : 'Cant.',
  addedN: lang === 'en' ? 'Added' : 'Añadidas',
  newCartFromWish: lang === 'en' ? 'New cart with these' : 'Carrito nuevo con estos',
  working: lang === 'en' ? 'Adding…' : 'Añadiendo…',
  nothingAdded: lang === 'en' ? 'Nothing available' : 'Nada disponible',
  removedFromCart: lang === 'en' ? 'Removed from cart' : 'Quitado del carrito',
  removedFromWish: lang === 'en' ? 'Removed from wishlist' : 'Quitado de favoritos',
  addedToCart: lang === 'en' ? 'Added to cart' : 'Añadido al carrito',
  cartAddedTitle: t.product.cartAddedTitle,
  cartRemovedTitle: t.product.cartRemovedTitle,
  wishAddedTitle: t.product.wishAddedTitle,
  wishRemovedTitle: t.product.wishRemovedTitle,
  addedNTitle: t.product.addedTitle,
  minQtyWish: lang === 'en' ? 'Minimum is 1 in the cart' : 'Mínimo 1 en el carrito',
  actionFailed:
    lang === 'en' ? 'Could not complete, try again' : 'No se pudo completar, intenta otra vez',
  toCart: lang === 'en' ? 'to cart' : 'al carrito',
  newCartReady: lang === 'en' ? 'New cart ready' : 'Carrito nuevo listo',
  itemOne: lang === 'en' ? 'item' : 'pieza',
  itemMany: lang === 'en' ? 'items' : 'piezas',
};
---

<!-- Disparadores -->
<div class={`store-actions ${className}`}>
  <!-- Favoritos: mini panel al hover, click navega a /favoritos -->
  <div class="store-trigger" data-panel="wishlist">
    <a
      href="/favoritos"
      id="drawer-open-wishlist"
      class="header-icon header-icon--wish"
      aria-label={t.nav.favoritos}
    >
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1L12 21l7.7-7.6 1.1-1a5.5 5.5 0 0 0 0-7.8Z" />
      </svg>
      <span id="wish-count" class="header-badge hidden">0</span>
    </a>

    <div id="mini-wishlist" class="mini-panel" role="region" aria-label={t.nav.favoritos} hidden>
      <div class="mini-head">
        <span>{t.nav.favoritos}</span>
        <span id="mini-wish-count" class="tab-count">0</span>
      </div>
      <div id="mini-wish-body" class="mini-body"></div>
      <div class="mini-foot">
        <p id="mini-wish-hint" class="mini-hint" hidden>
          {ui.wishLoginPrompt}
          <a href="/entrar" class="mini-hint-link">{ui.wishLoginCta}</a>
        </p>
        <div class="mini-actions">
          <button type="button" id="mini-wish-add-all" class="mini-action mini-action--gold">
            {ui.addAllToCart}
          </button>
          <button type="button" id="mini-wish-new-cart" class="mini-action">
            {ui.newCartFromWish}
          </button>
        </div>
        <a href="/favoritos" class="mini-cta">{ui.seeAll}</a>
      </div>
    </div>
  </div>

  <!-- Carrito: mini panel al hover, click navega a /carrito -->
  <div class="store-trigger" data-panel="cart">
    <a
      href="/carrito"
      id="drawer-open-cart"
      class="header-icon"
      aria-label={t.nav.carrito}
    >
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
        <path d="M3 6h18M16 10a4 4 0 0 1-8 0" />
      </svg>
      <span id="cart-count" class="header-badge hidden">0</span>
    </a>

    <div id="mini-cart" class="mini-panel" role="region" aria-label={t.nav.carrito} hidden>
      <div class="mini-head">
        <span>{t.nav.carrito}</span>
        <span id="mini-cart-count" class="tab-count">0</span>
      </div>
      <div id="mini-cart-body" class="mini-body"></div>
      <div class="mini-foot">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs uppercase tracking-[0.16em] text-white/80">{ui.subtotal}</span>
          <span id="mini-cart-total" class="font-acentos text-lg text-oro-brillo">$0.00</span>
        </div>
        <a href="/checkout" class="btn-gold w-full !min-h-[44px] !px-4 !py-2 !text-xs">{t.header.checkout}</a>
        <a href="/carrito" class="mini-link">{ui.seeFullCart}</a>
      </div>
    </div>
  </div>
</div>

<!-- Overlay + panel -->
<div id="drawer" class="drawer" data-wishlist={JSON.stringify(initialWishlist)} data-ui={JSON.stringify(ui)} hidden>
  <button type="button" id="drawer-backdrop" class="drawer-backdrop" aria-label={t.header.close}></button>

  <aside
    id="drawer-panel"
    class="drawer-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="tab-cart"
    tabindex="-1"
  >
    <header class="drawer-head">
      <div class="drawer-tabs" role="tablist">
        <button type="button" id="tab-cart" role="tab" class="drawer-tab" aria-selected="true">
          {t.nav.carrito} <span id="tab-cart-count" class="tab-count">0</span>
        </button>
        <button type="button" id="tab-wishlist" role="tab" class="drawer-tab" aria-selected="false">
          {t.nav.favoritos} <span id="tab-wish-count" class="tab-count">0</span>
        </button>
      </div>
      <button type="button" id="drawer-close" class="drawer-close" aria-label={t.header.close}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </header>

    <div class="drawer-body">
      <section id="pane-cart" class="drawer-pane">
        <div id="drawer-cart-list" class="drawer-list"></div>
      </section>

      <section id="pane-wishlist" class="drawer-pane hidden">
        <div id="drawer-wish-list" class="drawer-list"></div>
      </section>
    </div>

    <footer id="drawer-footer" class="drawer-foot">
      <div id="drawer-cart-totals">
        <div class="flex items-center justify-between mb-3">
          <span class="font-acentos text-sm uppercase tracking-[0.18em] text-blancoRoto">{t.cart.total}</span>
          <span id="drawer-total" class="font-acentos text-2xl text-oro-brillo">$0.00</span>
        </div>
        <p id="drawer-shipping-hint" class="text-xs text-white/80 mb-4"></p>
      </div>
      <a id="drawer-checkout" href="/checkout" class="btn-gold w-full">{t.header.checkout}</a>
      <a href="/carrito" class="btn-outline w-full mt-2">{ui.seeFullCart}</a>
    </footer>
  </aside>
</div>

<style is:global>
  /* Los dos botones flotan juntos arriba a la derecha.
     Siempre visibles: en móvil, tablet y desktop. */
  .store-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    position: relative;
    z-index: 60;
  }

  /* ---------- Mini paneles (hover) ---------- */
  .store-trigger {
    position: relative;
  }

  /* Puente invisible: cubre el hueco entre el icono y el panel
     para que el mouse no lo cierre al bajar. */
  .store-trigger::after {
    content: '';
    position: absolute;
    top: 100%;
    right: 0;
    width: 100%;
    height: 14px;
    pointer-events: none;
  }

  .store-trigger.is-open::after {
    pointer-events: auto;
  }

  .mini-panel {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 348px;
    max-width: calc(100vw - 32px);
    background: #050505;
    border: 2px solid rgba(247, 223, 165, 0.28);
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.95);
    z-index: 70;
  }

  /* Al hacer clic en el icono se navega a /carrito o /favoritos.
     Este bloqueo evita que el panel parpadee durante la navegación
     (el hover se re-dispara al pasar por el area del panel). */
  .store-actions.is-leaving .mini-panel,
  .store-trigger.is-leaving .mini-panel {
    display: none !important;
  }

  .store-actions.is-leaving .store-trigger::after {
    pointer-events: none !important;
  }

  .mini-panel[hidden] {
    display: none;
  }

  /* Entrada suave al aparecer con hover (no interfiere con `hidden`). */
  .store-trigger.is-open .mini-panel:not([hidden]) {
    animation: mini-in 0.18s ease-out both;
  }

  @keyframes mini-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .store-trigger.is-open .mini-panel:not([hidden]) {
      animation: none;
    }
  }

  .mini-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    border-bottom: 2px solid rgba(255, 255, 255, 0.18);
    font-family: 'Space Grotesk', Inter, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ffe28a;
  }

  .mini-body {
    max-height: 348px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* Cada pieza: foto a la izquierda a toda la altura, detalles a la derecha. */
  .mini-item {
    display: flex;
    align-items: stretch;
    gap: 12px;
    padding: 12px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    position: relative;
    text-decoration: none;
    transition: background-color 0.18s ease;
  }

  .mini-item:hover {
    background: rgba(255, 226, 138, 0.05);
  }

  .mini-item:last-child {
    border-bottom: 0;
  }

  .mini-thumb {
    width: 78px;
    flex: 0 0 78px;
    align-self: stretch;
    min-height: 86px;
    background: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    overflow: hidden;
    display: block;
  }

  .mini-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .mini-info {
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 4px;
    text-decoration: none;
    color: inherit;
  }

  .mini-name {
    font-family: 'Space Grotesk', Inter, sans-serif;
    font-size: 13px;
    line-height: 1.3;
    color: #ffffff;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-decoration: none;
  }

  .mini-item:hover .mini-name {
    color: #ffe28a;
  }

  .mini-meta {
    font-size: 11.5px;
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.7);
  }

  .mini-price {
    font-family: 'Space Grotesk', Inter, sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #ffe28a;
    white-space: nowrap;
  }

  .mini-empty {
    padding: 22px 16px;
    text-align: center;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.8);
  }

  .mini-foot {
    padding: 12px 14px;
    border-top: 2px solid rgba(255, 255, 255, 0.18);
  }

  /* Aviso para el visitante: sus favoritos solo viven en este navegador. */
  .mini-hint {
    margin-bottom: 10px;
    font-size: 11.5px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.78);
  }

  .mini-hint-link {
    display: inline-block;
    margin-top: 4px;
    color: #ffe28a;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Botón "ver todos" del mini panel */
  .mini-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 40px;
    border: 2px solid rgba(247, 223, 165, 0.55);
    color: #f7dfa5;
    font-family: 'Space Grotesk', Inter, sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .mini-cta:hover {
    background: rgba(255, 226, 138, 0.1);
    border-color: #ffe28a;
    color: #ffe28a;
  }

  /* Acciones del pie del mini panel */
  .mini-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 10px;
  }

  .mini-action {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    min-height: 38px;
    border: 2px solid rgba(247, 223, 165, 0.55);
    background: transparent;
    color: #f7dfa5;
    font-family: 'Space Grotesk', Inter, sans-serif;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .mini-action:hover:not(:disabled) {
    background: rgba(255, 226, 138, 0.12);
    border-color: #ffe28a;
    color: #ffe28a;
  }

  .mini-action:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .mini-action--gold {
    background: #ffe28a;
    border-color: #ffe28a;
    color: #000000;
  }

  .mini-action--gold:hover:not(:disabled) {
    background: #ffed9f;
    border-color: #ffed9f;
    color: #000000;
  }

  /* Fila de acciones dentro de un artículo del mini panel */
  .mini-row-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 2px;
    flex-wrap: wrap;
  }

  /* Control de cantidad compacto */
  .mini-qty {
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(255, 255, 255, 0.32);
  }

  .mini-qty button {
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: #ffffff;
    font-size: 13px;
    line-height: 1;
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .mini-qty button:hover {
    color: #ffe28a;
    background: rgba(255, 226, 138, 0.12);
  }

  .mini-qty span {
    min-width: 20px;
    text-align: center;
    font-family: 'Space Grotesk', Inter, sans-serif;
    font-size: 11px;
    color: #ffffff;
  }

  /* Botón pequeño "añadir" / "quitar" de un artículo */
  .mini-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-height: 26px;
    min-width: 92px;
    padding: 0 8px;
    border: 1px solid rgba(247, 223, 165, 0.5);
    background: transparent;
    color: #f7dfa5;
    font-family: 'Space Grotesk', Inter, sans-serif;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }

  .mini-chip:hover:not(:disabled) {
    background: rgba(255, 226, 138, 0.12);
    border-color: #ffe28a;
    color: #ffe28a;
  }

  .mini-chip:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .mini-chip.is-done {
    border-color: rgba(255, 226, 138, 0.35);
    color: rgba(255, 226, 138, 0.75);
    cursor: default;
  }

  /* Botón de quitar (carrito y favoritos). */
  .mini-remove {
    width: 24px;
    height: 24px;
    flex: 0 0 24px;
    margin-left: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: rgba(255, 255, 255, 0.55);
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .mini-remove:hover {
    color: #f87171;
  }

  .mini-link {
    display: block;
    width: 100%;
    margin-top: 8px;
    padding: 8px;
    background: none;
    border: 0;
    cursor: pointer;
    font-family: 'Space Grotesk', Inter, sans-serif;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }

  .mini-link:hover {
    color: #ffe28a;
  }

  /* Puede haber un aviso flotante encima del panel */
  .store-actions {
    isolation: isolate;
  }

  /* Pieza recién quitada: se desvanece antes de desaparecer del panel */
  .mini-item.is-leaving {
    animation: mini-leave 0.22s ease-in forwards;
    pointer-events: none;
  }

  @keyframes mini-leave {
    to {
      opacity: 0;
      transform: translateX(12px);
      max-height: 0;
      padding-top: 0;
      padding-bottom: 0;
    }
  }

  /* Confirmación de +/− de cantidad */
  .mini-qty.is-bumped span {
    color: #ffe28a;
    transform: scale(1.18);
  }

  .mini-qty span {
    transition: color 0.16s ease, transform 0.16s ease;
  }

  .drawer {
    position: fixed;
    inset: 0;
    z-index: 80;
  }

  .drawer[hidden] {
    display: none;
  }

  .drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.72);
    border: 0;
    cursor: pointer;
  }

  .drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(430px, 100%);
    display: flex;
    flex-direction: column;
    background: #050505;
    border-left: 2px solid rgba(247, 223, 165, 0.22);
    box-shadow: -24px 0 60px -30px rgba(0, 0, 0, 0.95);
    transform: translateX(100%);
    transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
    outline: none;
  }

  .drawer.is-open .drawer-panel {
    transform: translateX(0);
  }

  .drawer-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 2px solid rgba(247, 223, 165, 0.22);
    background: #0b0b0b;
  }

  .drawer-tabs {
    display: flex;
    gap: 8px;
    flex: 1;
  }

  .drawer-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 14px;
    background: transparent;
    border: 2px solid rgba(255, 255, 255, 0.35);
    color: #ffffff;
    font-family: 'Space Grotesk', Inter, sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .drawer-tab:hover {
    border-color: #ffe28a;
    color: #ffe28a;
  }

  .drawer-tab[aria-selected='true'] {
    border-color: #ffe28a;
    color: #ffe28a;
    background: rgba(255, 226, 138, 0.1);
  }

  .tab-count {
    font-size: 11px;
  }

  .drawer-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 0;
    color: #ffffff;
    cursor: pointer;
  }

  .drawer-close:hover {
    color: #ffe28a;
  }

  .drawer-body {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .drawer-list > * + * {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .drawer-foot {
    padding: 16px;
    border-top: 2px solid rgba(247, 223, 165, 0.22);
    background: #0b0b0b;
  }

  .drawer-empty {
    padding: 56px 24px;
    text-align: center;
  }

  .drawer-item {
    display: flex;
    gap: 12px;
    padding: 16px;
  }

  .drawer-thumb {
    width: 72px;
    height: 88px;
    flex: 0 0 72px;
    background: #ffffff;
    border: 2px solid rgba(255, 255, 255, 0.3);
    overflow: hidden;
  }

  .drawer-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .drawer-qty {
    display: inline-flex;
    align-items: center;
    border: 2px solid rgba(255, 255, 255, 0.35);
  }

  .drawer-qty button {
    width: 40px;
    height: 40px;
    background: transparent;
    border: 0;
    color: #ffffff;
    font-size: 18px;
    cursor: pointer;
  }

  .drawer-qty button:hover {
    color: #ffe28a;
  }

  .drawer-qty span {
    width: 32px;
    text-align: center;
    color: #ffffff;
    font-size: 15px;
  }

  @media (max-width: 480px) {
    .drawer-panel {
      width: 100%;
      border-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer-panel {
      transition: none;
    }
  }

  /* Botón flotante del header (carrito, favoritos) */
  .header-icon {
    position: relative;
    width: 46px;
    height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    background: #0b0b0b;
    color: #ffffff;
    box-shadow: 0 8px 20px -12px rgba(0, 0, 0, 0.9);
    transition:
      border-color 0.25s ease,
      color 0.25s ease,
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .header-icon:hover,
  .header-icon:focus-visible {
    border-color: #ffe28a;
    color: #ffe28a;
    outline: none;
    transform: translateY(-2px);
    box-shadow: 0 0 26px -6px rgba(255, 226, 138, 0.65);
  }

  /* Contador en la esquina superior derecha */
  .header-badge {
    position: absolute;
    top: -5px;
    right: -5px;
    min-width: 21px;
    height: 21px;
    padding: 0 5px;
    border-radius: 999px;
    background: #ffe28a;
    color: #000000;
    font-size: 10px;
    font-weight: 700;
    line-height: 21px;
    text-align: center;
    border: 2px solid #000000;
  }

  /* Favoritos: fondo cálido para distinguirlos del carrito */
  .header-icon--wish {
    background: #1a1710;
  }

  .header-icon--wish:hover {
    background: rgba(255, 226, 138, 0.14);
  }

  @media (max-width: 640px) {
    .header-icon {
      width: 42px;
      height: 42px;
    }
  }
</style>

<script>
  import {
    addToCart,
    getCart,
    updateQty,
    removeFromCart,
    cartCount,
    cartSubtotal,
    formatMXN,
    saveCart,
    startCartSync,
    takeLastAdded,
    type CartItem,
  } from '../../lib/cart';
  import type { VariantOption } from '../../lib/product-variants';
  import {
    SESSION_ENDED_EVENT,
    initWishlistView,
    removeFromWishlist,
    type WishlistItem,
  } from '../../lib/wishlist';
  import { FREE_SHIPPING_THRESHOLD } from '../../lib/pricing';
  import { escapeHtml, safeUrl } from '../../lib/html';
  import { showFlashToast } from '../../lib/flash-toast';

  type Tab = 'cart' | 'wishlist';

  const drawer = document.getElementById('drawer') as HTMLElement;

  /** Textos del panel resueltos en servidor (docs/i18n). */
  const ui = JSON.parse(drawer.dataset.ui || '{}') as Record<string, string>;
  const uiText = (key: string) => ui[key] ?? '';
  const panel = document.getElementById('drawer-panel') as HTMLElement;
  const openCartBtn = document.getElementById('drawer-open-cart');
  const openWishBtn = document.getElementById('drawer-open-wishlist');
  const closeBtn = document.getElementById('drawer-close');
  const backdrop = document.getElementById('drawer-backdrop');
  const tabCart = document.getElementById('tab-cart') as HTMLButtonElement;
  const tabWish = document.getElementById('tab-wishlist') as HTMLButtonElement;
  const paneCart = document.getElementById('pane-cart')!;
  const paneWish = document.getElementById('pane-wishlist')!;
  const cartTotals = document.getElementById('drawer-cart-totals') as HTMLElement;
  const totalEl = document.getElementById('drawer-total')!;
  const hintEl = document.getElementById('drawer-shipping-hint')!;
  const checkoutLink = document.getElementById('drawer-checkout') as HTMLAnchorElement;
  const serverWishlist: WishlistItem[] = JSON.parse(
    document.getElementById('drawer')?.dataset.wishlist ?? '[]'
  );
  const badge = document.getElementById('cart-count')!;
  const wishBadge = document.getElementById('wish-count')!;
  const tabCartCount = document.getElementById('tab-cart-count')!;
  const tabWishCount = document.getElementById('tab-wish-count')!;
  const cartList = document.getElementById('drawer-cart-list')!;
  const wishList = document.getElementById('drawer-wish-list')!;

  let currentTab: Tab = 'cart';
  let lastFocus: HTMLElement | null = null;
  let currentWish: WishlistItem[] = serverWishlist;

  const money = (n: number) => `$${formatMXN(n)}`;

  function setBadge(el: HTMLElement, count: number) {
    el.textContent = String(count);
    el.classList.toggle('hidden', count === 0);
  }

  function updateBadges() {
    const count = cartCount();
    setBadge(badge, count);
    tabCartCount.textContent = String(count);
    setBadge(wishBadge, currentWish.length);
    tabWishCount.textContent = String(currentWish.length);
  }

  // ---------- Carrito ----------
  function renderCart() {
    const items = getCart();

    if (items.length === 0) {
      cartList.innerHTML = `
        <div class="drawer-empty">
          <p class="font-titulos text-2xl text-blancoRoto mb-3">${escapeHtml(uiText('emptyCart'))}</p>
          <p class="text-sm text-white/80 mb-6">${escapeHtml(uiText('viewPieces'))}</p>
          <a href="/tienda" class="btn-gold inline-flex">${escapeHtml(uiText('seeAll'))}</a>
        </div>`;
    } else {
      cartList.innerHTML = items
        .map(
          (i) => `
        <article class="drawer-item">
          <div class="drawer-thumb">
            ${safeUrl(i.image) ? `<img src="${safeUrl(i.image)}" alt="" loading="lazy">`.replace(' alt=""', ` alt="${escapeHtml(i.name)}"`) : ''}
          </div>
          <div class="flex-1 min-w-0 flex flex-col justify-between gap-2">
            <div>
              <p class="font-acentos text-base text-blancoRoto leading-snug">${escapeHtml(i.name)}</p>
              <p class="text-sm text-white/80">${escapeHtml(i.variantName)}</p>
            </div>
            <div class="flex items-end justify-between gap-2">
              <div class="drawer-qty">
                <button type="button" data-dec="${escapeHtml(i.variantId)}" aria-label="${escapeHtml(uiText('removeOne'))}">−</button>
                <span>${i.qty}</span>
                <button type="button" data-inc="${escapeHtml(i.variantId)}" aria-label="${escapeHtml(uiText('addOne'))}">+</button>
              </div>
              <div class="text-right">
                <p class="font-acentos text-base text-oro-brillo">${money(i.price * i.qty)}</p>
                <button type="button" data-remove="${escapeHtml(i.variantId)}"
                  class="text-xs uppercase tracking-wider text-white/80 hover:text-red-400 py-1">
                  ${escapeHtml(uiText('removeWish'))}
                </button>
              </div>
            </div>
          </div>
        </article>`
        )
        .join('');

      cartList.querySelectorAll<HTMLElement>('[data-inc]').forEach((b) =>
        b.addEventListener('click', () => {
          const item = getCart().find((i) => i.variantId === b.dataset.inc);
          if (item) updateQty(item.variantId, item.qty + 1);
          renderCart();
        })
      );

      cartList.querySelectorAll<HTMLElement>('[data-dec]').forEach((b) =>
        b.addEventListener('click', () => {
          const item = getCart().find((i) => i.variantId === b.dataset.dec);
          if (!item) return;
          if (item.qty <= 1) removeFromCart(item.variantId);
          else updateQty(item.variantId, item.qty - 1);
          renderCart();
        })
      );

      cartList.querySelectorAll<HTMLElement>('[data-remove]').forEach((b) =>
        b.addEventListener('click', () => {
          removeFromCart(b.dataset.remove!);
          renderCart();
        })
      );
    }

    const subtotal = cartSubtotal();
    totalEl.textContent = money(subtotal);

    if (subtotal === 0) {
      hintEl.textContent = '';
    } else if (subtotal >= FREE_SHIPPING_THRESHOLD) {
      hintEl.textContent = uiText('freeShipping');
    } else {
      hintEl.textContent = `${uiText('missingForFree')} ${money(FREE_SHIPPING_THRESHOLD - subtotal)}`;
    }

    updateBadges();
  }

  // ---------- Wishlist ----------
  function renderWishlist() {
    if (currentWish.length === 0) {
      wishList.innerHTML = `
        <div class="drawer-empty">
          <p class="font-titulos text-2xl text-blancoRoto mb-3">${escapeHtml(uiText('emptyWish'))}</p>
          <p class="text-sm text-white/80 mb-6">${escapeHtml(uiText('viewPieces'))}</p>
          <a href="/tienda" class="btn-outline inline-flex">${escapeHtml(uiText('seeAll'))}</a>
        </div>`;
      updateBadges();
      return;
    }

    wishList.innerHTML = currentWish
      .map(
        (i) => `
      <article class="drawer-item">
        <div class="drawer-thumb">
          ${safeUrl(i.image) ? `<img src="${safeUrl(i.image)}" alt="" loading="lazy">` : ''}
        </div>
        <div class="flex-1 min-w-0 flex flex-col justify-between gap-2">
          <div>
            <p class="font-acentos text-base text-blancoRoto leading-snug">${escapeHtml(i.name)}</p>
            <p class="text-sm text-oro-brillo mt-1">${money(i.price)}</p>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <a href="/producto/${encodeURIComponent(i.slug ?? i.productId)}" class="btn-outline !min-h-[40px] !px-4 !py-2 !text-xs">
              ${escapeHtml(uiText('openPiece'))}
            </a>
            <button type="button" data-wish-remove="${escapeHtml(i.productId)}"
              class="text-xs uppercase tracking-wider text-white/80 hover:text-red-400 py-2 px-1">
              ${escapeHtml(uiText('removeWish'))}
            </button>
          </div>
        </div>
      </article>`
      )
      .join('');

    wishList.querySelectorAll<HTMLElement>('[data-wish-remove]').forEach((b) =>
      b.addEventListener('click', async () => {
        const name =
          b.closest('.drawer-item')?.querySelector('.mini-name')?.textContent?.trim() ??
          '';
        await removeFromWishlist(b.dataset.wishRemove!, name);
        renderWishlist();
      })
    );

    updateBadges();
  }

  // ---------- Apertura ----------
  function switchTab(tab: Tab) {
    currentTab = tab;
    tabCart.setAttribute('aria-selected', String(tab === 'cart'));
    tabWish.setAttribute('aria-selected', String(tab === 'wishlist'));
    paneCart.classList.toggle('hidden', tab !== 'cart');
    paneWish.classList.toggle('hidden', tab !== 'wishlist');

    // El CTA de compra se mantiene visible en ambas pestañas:
    // el total solo aplica al carrito.
    cartTotals.classList.toggle('hidden', tab !== 'cart');
    checkoutLink.classList.toggle('hidden', tab !== 'cart');
  }

  function open(tab: Tab = 'cart') {
    lastFocus = document.activeElement as HTMLElement;
    // Cierra el menú móvil: el panel se abre encima del header
    document.getElementById('mobile-menu')?.classList.add('hidden');
    drawer.hidden = false;
    switchTab(tab);

    if (tab === 'cart') renderCart();
    else renderWishlist();

    requestAnimationFrame(() => drawer.classList.add('is-open'));
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function close() {
    drawer.classList.remove('is-open');
    document.body.style.overflow = '';
    setTimeout(() => {
      drawer.hidden = true;
      // En móvil el panel cubre el botón; devolver el foco ahí reabriría
      // visualmente el menú. Solo se enfoca si el disparador sigue visible.
      if (lastFocus && lastFocus.isConnected && lastFocus.getClientRects().length > 0) {
        lastFocus.focus();
      }
    }, 320);
  }

  /*
   * El panel grande (`#drawer`) queda en el DOM por compatibilidad, pero los
   * iconos del header ya no lo abren: navegan a /carrito y /favoritos.
   */
  closeBtn?.addEventListener('click', close);
  backdrop?.addEventListener('click', close);
  tabCart.addEventListener('click', () => {
    switchTab('cart');
    renderCart();
  });
  tabWish.addEventListener('click', () => {
    switchTab('wishlist');
    renderWishlist();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !drawer.hidden) close();
  });

  // Otras páginas piden abrir el panel
  window.addEventListener('store:open', (e: Event) => {
    const tab = (e as CustomEvent<{ tab?: Tab }>).detail?.tab ?? 'cart';
    open(tab);
  });

  window.addEventListener('cart:updated', () => {
    if (!drawer.hidden && currentTab === 'cart') renderCart();
    else updateBadges();
  });

  window.addEventListener('wishlist:updated', (e: Event) => {
    currentWish = (e as CustomEvent<WishlistItem[]>).detail ?? [];
    if (!drawer.hidden && currentTab === 'wishlist') renderWishlist();
    else updateBadges();
  });

  // Avisos flotantes: carrito y favoritos, en cualquier página.
  // Todos pasan por `showFlashToast` (centro de la pantalla).
  window.addEventListener('wishlist:added', (e: Event) => {
    const name = (e as CustomEvent<{ name?: string }>).detail?.name;
    showFlashToast(uiText('wishAddedTitle'), { tone: 'wish', detail: name || '' });
  });

  // "Producto añadido al carrito": se emite en `lib/cart.ts`. Se compara la
  // firma del carrito para no repetir el aviso cuando `refreshCartPrices()`
  // reajusta precios o reordena sin que el usuario haya añadido nada.
  let lastCartSignature = '';
  window.addEventListener('cart:updated', () => {
    const items = getCart();
    if (items.length === 0) {
      lastCartSignature = '';
      return;
    }

    // Orden fijo por variante: solo cuenta qué hay y cuánto, no el orden.
    const signature = items
      .map((i) => `${i.variantId}:${i.qty}`)
      .sort()
      .join('|');

    // Un cambio de precio (misma cantidad) no es un "añadido".
    if (signature === lastCartSignature) return;
    const firstRender = lastCartSignature === '';
    lastCartSignature = signature;

    // Primera lectura (otra pestaña, recarga): no hubo acción del usuario.
    if (firstRender) return;

    // Cambio hecho en OTRA pestaña: el carrito se repinta, pero no se lanza
    // un aviso que el usuario no provocó en esta pantalla.
    const added = takeLastAdded();
    if (!added) return;

    showFlashToast(uiText('cartAddedTitle'), {
      tone: 'cart',
      detail: [added.name, added.variantName].filter(Boolean).join(' · '),
    });
  });

  window.addEventListener('wishlist:removed', (e: Event) => {
    const name = (e as CustomEvent<{ name?: string }>).detail?.name;
    showFlashToast(uiText('wishRemovedTitle'), { tone: 'wish', detail: name || '' });
  });

  // Favoritos iniciales (SSR + fusión de lo guardado sin sesión)
  initWishlistView(serverWishlist, {
    isAuth: document.documentElement.dataset.auth === '1',
  })
    .then((items) => {
      currentWish = items;
      updateBadges();
    })
    .catch(() => updateBadges());

  // Al cerrar sesión se descarta la lista de la cuenta: si el visitante no
  // tenía favoritos propios en este navegador, el panel queda vacío.
  window.addEventListener(SESSION_ENDED_EVENT, (e) => {
    currentWish = ((e as CustomEvent<WishlistItem[]>).detail ?? []).slice();
    if (!drawer.hidden && currentTab === 'wishlist') renderWishlist();
    updateBadges();
  });

  updateBadges();

  // Otras pestañas del mismo navegador: sus cambios repintan el carrito y
  // el contador del header sin recargar.
  startCartSync();

  /** Reemplaza el carrito completo ("carrito nuevo con estos"). */
  function replaceCart(items: CartItem[]) {
    // `saveCart` escribe, avisa a las demás pestañas y emite `cart:updated`.
    saveCart(items);
  }

  // ============================================
  // Mini paneles: aparecen al pasar el mouse.
  // El clic en el icono abre el panel completo.
  // ============================================
  const miniCart = document.getElementById('mini-cart') as HTMLElement;
  const miniWish = document.getElementById('mini-wishlist') as HTMLElement;
  const miniCartBody = document.getElementById('mini-cart-body')!;
  const miniWishBody = document.getElementById('mini-wish-body')!;
  const miniCartCount = document.getElementById('mini-cart-count')!;
  const miniWishCount = document.getElementById('mini-wish-count')!;
  const miniCartTotal = document.getElementById('mini-cart-total')!;
  const triggers = [...document.querySelectorAll<HTMLElement>('.store-trigger')];
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  let closeTimer: number | undefined;

  // ---------- Aviso de acciones dentro de los mini paneles ----------
  //
  // Antes era un toast diminuto pegado al header. Ahora todo el feedback
  // usa el mismo aviso flotante centrado (`lib/flash-toast.ts`), para que
  // el usuario reconozca una sola forma de confirmar acciones.
  //
  // `tone` decide el icono: carrito, favorito o informativo.
  function miniNotify(message: string, tone: 'cart' | 'wish' | 'info' = 'info') {
    if (!message) return;
    showFlashToast(message, { tone });
  }

  /** Extrae el nombre visible de una fila del mini panel. */
  const rowName = (el: Element | null) =>
    el?.querySelector('.mini-name')?.textContent?.trim() ?? '';

  /** Resalta el contador de cantidad para confirmar el cambio. */
  function bumpQty(el: HTMLElement | null) {
    if (!el) return;
    el.classList.add('is-bumped');
    window.setTimeout(() => el.classList.remove('is-bumped'), 220);
  }

  /** Desvanece una fila antes de que se repinte la lista. */
  function fadeOutRow(row: HTMLElement | null) {
    return new Promise<void>((resolve) => {
      if (!row) return resolve();
      row.classList.add('is-leaving');
      window.setTimeout(resolve, 200);
    });
  }

  function renderMiniCart() {
    const items = getCart();
    const count = items.reduce((n, i) => n + i.qty, 0);
    miniCartCount.textContent = String(count);
    miniCartTotal.textContent = `$${formatMXN(cartSubtotal())}`;

    if (items.length === 0) {
      miniCartBody.innerHTML = `<div class="mini-empty">${escapeHtml(uiText('emptyCart'))}</div>`;
      return;
    }

    miniCartBody.innerHTML = items
      .slice(0, 3)
      .map((i) => {
        const img = safeUrl(i.image);
        const href = `/producto/${encodeURIComponent(i.productId)}`;

        return `
        <div class="mini-item">
          <a class="mini-thumb" href="${href}">${img ? `<img src="${img}" alt="">` : ''}</a>
          <div class="mini-info">
            <a class="mini-name" href="${href}">${escapeHtml(i.name)}</a>
            <span class="mini-meta">${escapeHtml(i.variantName)}</span>
            <span class="mini-price">$${formatMXN(i.price * i.qty)}</span>
            <div class="mini-row-actions">
              <div class="mini-qty">
                <button type="button" data-mini-qty="cart:${escapeHtml(i.variantId)}" data-dir="-1" aria-label="${escapeHtml(uiText('removeOne'))}">−</button>
                <span>${i.qty}</span>
                <button type="button" data-mini-qty="cart:${escapeHtml(i.variantId)}" data-dir="1" aria-label="${escapeHtml(uiText('addOne'))}">+</button>
              </div>
              <button
                type="button"
                class="mini-remove"
                data-mini-remove="cart:${escapeHtml(i.variantId)}"
                aria-label="${escapeHtml(uiText('removeWish'))}"
              >
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14" />
                </svg>
              </button>
            </div>
          </div>
        </div>`;
      })
      .join('');

    bindMiniQuantityControls(miniCartBody);
  }

  /**
   * Botones +/− y quitar dentro de un mini panel.
   * El `action` de cada botón se guarda como String y se resuelve aquí:
   * `cart:<variantId>` o `wish:<productId>`.
   */
  function bindMiniQuantityControls(root: HTMLElement) {
    const resolve = (action: string) => {
      const [scope, id] = action.split(':');
      return { scope, id };
    };

    root.querySelectorAll<HTMLElement>('[data-mini-qty]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const { scope, id } = resolve(btn.dataset.miniQty!);
        const dir = Number(btn.dataset.dir ?? 1);
        const item = getCart().find((i) =>
          scope === 'cart' ? i.variantId === id : i.productId === id
        );

        if (!item) return;

        if (item.qty + dir <= 0) {
          if (scope === 'cart') {
            await fadeOutRow(btn.closest('.mini-item') as HTMLElement | null);
            removeFromCart(item.variantId);
            showFlashToast(uiText('cartRemovedTitle'), {
              tone: 'cart',
              detail: item.name,
            });
          } else {
            miniNotify(uiText('minQtyWish'));
          }
          return;
        }

        updateQty(item.variantId, item.qty + dir);
        bumpQty(btn.closest('.mini-qty') as HTMLElement | null);
        showFlashToast(uiText('qty') + ' ' + (item.qty + dir), {
          tone: 'cart',
          detail: item.name,
        });
      });
    });

    root.querySelectorAll<HTMLElement>('[data-mini-remove]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const { scope, id } = resolve(btn.dataset.miniRemove!);
        const row = btn.closest('.mini-item') as HTMLElement | null;
        const name = rowName(row);

        if (scope === 'cart') {
          const variantId = getCart().find((i) => i.variantId === id)?.variantId ?? id;
          await fadeOutRow(row);
          removeFromCart(variantId);
          showFlashToast(uiText('cartRemovedTitle'), { tone: 'cart', detail: name });
          return;
        }

        btn.setAttribute('disabled', 'true');
        row?.style.setProperty('opacity', '0.55');

        try {
          await removeFromWishlist(id, name);
          // El evento `wishlist:removed` ya muestra el aviso centrado.
        } catch {
          row?.style.removeProperty('opacity');
          btn.removeAttribute('disabled');
          miniNotify(uiText('actionFailed'));
        }
      });
    });
  }

  /**
   * Variante que se asigna a cada favorito al llevarlo al carrito.
   * Se pide una sola vez por producto y se guarda en memoria.
   */
  const variantCache: Record<string, VariantOption> = {};

  async function variantFor(productId: string): Promise<VariantOption | null> {
    if (variantCache[productId]) return variantCache[productId];

    try {
      const res = await fetch(`/api/variant?product=${encodeURIComponent(productId)}`);
      if (!res.ok) return null;
      const data = (await res.json()) as { variant?: VariantOption };
      if (!data.variant) return null;
      variantCache[productId] = data.variant;
      return data.variant;
    } catch {
      return null;
    }
  }

  /**
   * Lleva favoritos al carrito.
   * @param replace true = carrito nuevo con solo estos favoritos.
   * @returns cuántas piezas se añadieron.
   */
  async function wishItemsToCart(replace: boolean): Promise<number> {
    const added: CartItem[] = [];

    for (const item of currentWish) {
      const variant = await variantFor(item.productId);
      if (!variant || variant.stock <= 0) continue;

      added.push({
        variantId: variant.id,
        productId: item.productId,
        name: item.name,
        variantName: [variant.size, variant.color].filter(Boolean).join(' · ') || variant.name,
        price: variant.price || item.price,
        qty: 1,
        image: item.image ?? undefined,
        size: variant.size,
        color: variant.color,
      });
    }

    if (added.length === 0) return 0;

    if (replace) {
      replaceCart(added);
      return added.length;
    }

    // Sin duplicar: si la variante ya está, solo sube la cantidad.
    added.forEach((piece) => addToCart(piece));
    return added.length;
  }

  /**
   * Añade una sola pieza de favoritos al carrito actual.
   * Devuelve false si no tiene variante con stock.
   */
  async function addWishItemToCart(productId: string): Promise<boolean> {
    const item = currentWish.find((w) => w.productId === productId);
    if (!item) return false;

    const variant = await variantFor(productId);
    if (!variant || variant.stock <= 0) return false;

    addToCart({
      variantId: variant.id,
      productId,
      name: item.name,
      variantName: [variant.size, variant.color].filter(Boolean).join(' · ') || variant.name,
      price: variant.price || item.price,
      qty: 1,
      image: item.image ?? undefined,
      size: variant.size,
      color: variant.color,
    });
    return true;
  }

  function renderMiniWish() {
    miniWishCount.textContent = String(currentWish.length);

    const hint = document.getElementById('mini-wish-hint') as HTMLElement | null;
    const isGuest = document.documentElement.dataset.auth !== '1';

    // El aviso solo tiene sentido si hay algo guardado y no hay cuenta.
    if (hint) hint.hidden = !(isGuest && currentWish.length > 0);

    const addAll = document.getElementById('mini-wish-add-all') as HTMLButtonElement | null;
    const newCart = document.getElementById('mini-wish-new-cart') as HTMLButtonElement | null;
    const empty = currentWish.length === 0;
    if (addAll) addAll.disabled = empty;
    if (newCart) newCart.disabled = empty;

    if (empty) {
      miniWishBody.innerHTML = `<div class="mini-empty">${escapeHtml(uiText('emptyWish'))}</div>`;
      return;
    }

    miniWishBody.innerHTML = currentWish
      .slice(0, 3)
      .map((i) => {
        const img = safeUrl(i.image);
        const href = `/producto/${encodeURIComponent(i.slug ?? i.productId)}`;
        const inCart = getCart().find((c) => c.productId === i.productId);

        return `
        <div class="mini-item">
          <a class="mini-thumb" href="${href}">${img ? `<img src="${img}" alt="">` : ''}</a>
          <div class="mini-info">
            <a class="mini-name" href="${href}">${escapeHtml(i.name)}</a>
            <span class="mini-price">$${formatMXN(i.price)}</span>
            <div class="mini-row-actions">
              ${
                inCart
                  ? `<div class="mini-qty">
                       <button type="button" data-mini-qty="wish:${escapeHtml(i.productId)}" data-dir="-1" aria-label="${escapeHtml(uiText('removeOne'))}">−</button>
                       <span>${inCart.qty}</span>
                       <button type="button" data-mini-qty="wish:${escapeHtml(i.productId)}" data-dir="1" aria-label="${escapeHtml(uiText('addOne'))}">+</button>
                     </div>`
                  : `<button type="button" class="mini-chip" data-mini-add-wish="${escapeHtml(i.productId)}">${escapeHtml(uiText('addOneToCart'))}</button>`
              }
              <button
                type="button"
                class="mini-remove"
                data-mini-remove="wish:${escapeHtml(i.productId)}"
                aria-label="${escapeHtml(uiText('removeWish'))}"
              >
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14" />
                </svg>
              </button>
            </div>
          </div>
        </div>`;
      })
      .join('');

    // Añadir una pieza suelta al carrito actual.
    miniWishBody.querySelectorAll<HTMLElement>('[data-mini-add-wish]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const name = rowName(btn.closest('.mini-item'));
        btn.setAttribute('disabled', 'true');
        const ok = await addWishItemToCart(btn.dataset.miniAddWish!);

        if (!ok) {
          btn.removeAttribute('disabled');
          btn.textContent = uiText('nothingAdded');
          showFlashToast(uiText('nothingAdded'), { tone: 'info', detail: name });
          return;
        }

        // El aviso lo emite el listener global de `cart:updated`.
        // Si funcionó, `cart:updated` repinta y el botón pasa a −/+ qty.
      });
    });

    bindMiniQuantityControls(miniWishBody);
  }

  function hideMini(immediate = false) {
    window.clearTimeout(closeTimer);

    const apply = () => {
      triggers.forEach((t) => {
        t.classList.remove('is-open');
        t.querySelector('.header-icon')?.setAttribute('aria-expanded', 'false');
        const panel = t.querySelector<HTMLElement>('.mini-panel');
        if (panel) panel.hidden = true;
      });
    };

    if (immediate) apply();
    else closeTimer = window.setTimeout(apply, 220);
  }

  /**
   * Al hacer clic en un icono se navega a /carrito o /favoritos.
   * Se marca el contenedor como "saliendo" para que el mini panel no
   * vuelva a abrirse con el hover mientras el navegador cambia de página.
   */
  function leaveFor(href: string) {
    const actions = document.querySelector('.store-actions');
    actions?.classList.add('is-leaving');
    triggers.forEach((t) => t.classList.add('is-leaving'));
    hideMini(true);

    // Small delay para que el clic se registre antes de la navegación.
    window.setTimeout(() => {
      window.location.href = href;
    }, 60);
  }

  function showMini(tab: Tab) {
    // Nunca se abre si el usuario ya hizo clic para irse a /carrito o /favoritos.
    if (document.querySelector('.store-actions.is-leaving')) return;
    window.clearTimeout(closeTimer);

    if (tab === 'cart') renderMiniCart();
    else renderMiniWish();

    triggers.forEach((t) => {
      const target = t.dataset.panel === tab;
      t.classList.toggle('is-open', target);
      t.querySelector('.header-icon')?.setAttribute('aria-expanded', String(target));
      const panel = t.querySelector<HTMLElement>('.mini-panel');
      if (panel) panel.hidden = !target;
    });
  }

  if (canHover) {
    triggers.forEach((t) => {
      const tab = (t.dataset.panel as Tab) ?? 'cart';

      // Área de hover generosa: el icono mide 46px y el hueco hasta el panel
      // otros 14px. Sin esto hay que apuntar con precisión para que no se
      // cierre al bajar el mouse.
      t.addEventListener('mouseenter', () => showMini(tab));
      t.addEventListener('mouseleave', () => hideMini());

      // Teclado: el foco mantiene el panel abierto, pero solo si el foco entra
      // en el propio icono. Así al volver el foco al botón (p. ej. al cerrar
      // el panel grande) no se despliega nada por sorpresa.
      t.addEventListener('focusin', (e) => {
        if (t.classList.contains('is-leaving')) return;
        if (!(e.target instanceof Element) || !e.target.closest('.header-icon')) return;
        showMini(tab);
      });
      t.addEventListener('focusout', (e) => {
        if (!t.contains((e as FocusEvent).relatedTarget as Node | null)) hideMini();
      });
    });
  }

  // Clic en los iconos: navegan a /carrito o /favoritos (ya no abren drawer)
  // El mini panel sigue funcionando con hover
  openCartBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    leaveFor('/carrito');
  });
  openWishBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    leaveFor('/favoritos');
  });

  // "Ver carrito completo" desde el mini panel
  document.querySelectorAll<HTMLElement>('[data-drawer]').forEach((b) =>
    b.addEventListener('click', () => {
      hideMini(true);
      open((b.dataset.drawer as Tab) ?? 'cart');
    })
  );

  // Los mini se refrescan con cada cambio aunque no estén visibles
  window.addEventListener('cart:updated', () => renderMiniCart());
  window.addEventListener('wishlist:updated', () => renderMiniWish());

  // "Añadir todo al carrito" y "carrito nuevo con estos"
  document.getElementById('mini-wish-add-all')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = uiText('working');

    const n = await wishItemsToCart(false);
    btn.textContent = n > 0 ? `${uiText('addedN')} ${n}` : uiText('nothingAdded');
    if (n > 0) {
      showFlashToast(uiText('cartAddedTitle'), {
        tone: 'cart',
        detail: `${n} ${n === 1 ? uiText('itemOne') : uiText('itemMany')}`,
      });
    } else {
      showFlashToast(uiText('nothingAdded'), { tone: 'info' });
    }
    window.setTimeout(() => {
      btn.textContent = uiText('addAllToCart');
      btn.disabled = currentWish.length === 0;
    }, 1600);
  });

  document.getElementById('mini-wish-new-cart')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = uiText('working');

    const n = await wishItemsToCart(true);
    btn.textContent = n > 0 ? `${uiText('addedN')} ${n}` : uiText('nothingAdded');
    if (n > 0) {
      showFlashToast(uiText('newCartReady'), {
        tone: 'cart',
        detail: `${n} ${n === 1 ? uiText('itemOne') : uiText('itemMany')}`,
      });
    } else {
      showFlashToast(uiText('nothingAdded'), { tone: 'info' });
    }
    window.setTimeout(() => {
      btn.textContent = uiText('newCartFromWish');
      btn.disabled = currentWish.length === 0;
    }, 1600);
  });

  // Al abrir el panel grande, los mini se ocultan
  window.addEventListener('store:open', () => hideMini(true));

  // Si el navegador restaura la página desde el bfcache (botón "atrás"),
  // se limpia el bloqueo de navegación para que el hover vuelva a funcionar.
  window.addEventListener('pageshow', () => {
    document.querySelector('.store-actions')?.classList.remove('is-leaving');
    triggers.forEach((t) => t.classList.remove('is-leaving'));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') hideMini(true);
  });

  // Estado inicial del mini carrito (en móvil no hay hover, pero así los
  // contadores y el total ya están listos si se gira el dispositivo)
  renderMiniCart();

  (window as any).dspStore = { open, close };
</script>
