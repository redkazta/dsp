---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCopy, type Lang } from '../../lib/i18n';
import { localize } from '../../lib/routes';
import { isStripeConfigured, stripePublishableKey } from '../../lib/stripe';
import { isFedexConfigured } from '../../lib/fedex';
import { SHIPPING_REGIONS } from '../../lib/us';
import { getStoreSettings, shippingRulesFrom } from '../../lib/settings';

interface Props {
  /** true = compra sin cuenta (se sirve en /invitado/checkout). */
  guest?: boolean;
}

const { guest = false } = Astro.props;

const lang = (Astro.locals.lang ?? 'es') as Lang;
const t = getCopy(lang);

// Reglas de envío configuradas en el panel.
const settings = await getStoreSettings();
const shippingRules = shippingRulesFrom(settings);

const paymentAvailable = isStripeConfigured();
// Con FedEx configurado el checkout cotiza envío real; si no, tarifa plana.
// Debe declararse antes de `ui`: ese objeto ya lo consume.
const fedexReady = isFedexConfigured();

// Textos y mensajes del script del navegador.
const ui = {
  required: t.checkout.required,
  invalidEmail: t.checkout.invalidEmail,
  invalidPhone: t.checkout.invalidPhone,
  invalidPostal: t.checkout.invalidPostal,
  zipLooking: t.checkout.zipLooking,
  zipAutocompleteFilled: t.checkout.zipAutocompleteFilled,
  zipStateUnavailable: t.checkout.zipStateUnavailable,
  zipNotFound: t.checkout.zipNotFound,
  fixErrors: t.checkout.fixErrors,
  emptyCartError: t.checkout.emptyCartError,
  waitCart: t.checkout.waitCart,
  opening: t.checkout.opening,
  pay: t.checkout.pay,
  openFailed: t.checkout.openFailed,
  redirecting: t.checkout.redirecting,
  connection: t.checkout.connection,
  unavailable: t.checkout.cardUnavailable,
  noSession: t.errors.noSession,
  pieceOne: t.checkout.pieceOne,
  pieceMany: t.checkout.pieceMany,
  removedPieces: t.checkout.removedPieces,
  unavailableNow: t.checkout.unavailableNow,
  free: t.cart.free,
  freeFrom: String(shippingRules.freeFrom),
  shipCost: String(shippingRules.cost),
  fedex: fedexReady ? '1' : '0',
  shippingTitle: t.checkout.shippingTitle,
  shippingHint: t.checkout.shippingHint,
  shippingCalculating: t.checkout.shippingCalculating,
  shippingEstimated: t.checkout.shippingEstimated,
  shippingEstimateNote: t.checkout.shippingEstimateNote,
  shippingUnavailable: t.checkout.shippingUnavailable,
  shippingChangedTitle: t.checkout.shippingChangedTitle,
  shippingChangedMessage: t.checkout.shippingChangedMessage,
  shippingChangeAccept: t.checkout.shippingChangeAccept,
  shippingDays: t.checkout.shippingDays,
  shippingDay: t.checkout.shippingDay,
  shippingArrives: t.checkout.shippingArrives,
  continueBtn: t.checkout.continueBtn,
  backBtn: t.checkout.backBtn,
  stepProgress: t.checkout.stepProgress,
  stepOf: t.checkout.stepOf,
  preparingPayment: t.checkout.preparingPayment,
  paymentInitFailed: t.checkout.paymentInitFailed,
  paymentFailed: t.checkout.paymentFailed,
  stripeKey: paymentAvailable ? stripePublishableKey() : '',
};

const { firstName, email, phone } = Astro.locals;

const canceled = Astro.url.searchParams.get('canceled') === '1';
---

<BaseLayout title={t.checkout.metaTitle} description={t.checkout.metaDescription}>
  <script type="application/json" id="checkout-ui" set:html={JSON.stringify(ui)} />
  <section class="border-b-2 border-white/25 bg-noise">
    <div class="page-container py-10 sm:py-12">
      <nav class="mb-6">
        <ol class="flex items-center gap-2 font-acentos text-xs uppercase tracking-[0.2em] text-white/80">
          <li><a href={localize(lang, 'cart')} class="hover:text-oro-brillo transition-colors">{t.cart.title}</a></li>
          <li>/</li>
          <li class="text-oro-brillo">{t.checkout.title}</li>
        </ol>
      </nav>
      <h1 class="font-titulos text-3xl sm:text-4xl lg:text-5xl text-blancoRoto">{t.checkout.title}</h1>
      <p class="mt-3 text-base text-white/80">{t.checkout.subtitle}</p>
      {guest && (
        <p class="mt-2 text-sm text-white/70">
          {t.checkout.guestNote}{' '}
          <a
            href={localize(lang, 'login')}
            class="text-oro-brillo underline underline-offset-2"
          >
            {t.checkout.guestLogin}
          </a>
        </p>
      )}
    </div>
  </section>

  <div
    id="checkout-alert"
    role="alert"
    class="hidden max-w-3xl mx-auto px-5 py-3 mb-4 bg-oro-brillo/10 border-2 border-oro-brillo text-oro-brillo text-sm font-acentos tracking-wide rounded-sm"
  ></div>

  <div id="checkout-empty" class="hidden max-w-3xl mx-auto px-5 py-24 sm:py-32 text-center">
    <p class="font-titulos text-3xl text-blancoRoto mb-6">{t.checkout.emptyTitle}</p>
    <div class="gold-line mx-auto mb-8"></div>
    <a href={localize(lang, 'shop')} class="btn-gold inline-flex">{t.checkout.goShop}</a>
  </div>

  <div id="checkout-content" class="page-container py-8 sm:py-12 lg:py-16">
    <!-- Indicador de pasos: siempre visible para saber dónde va la compra. -->
    <nav id="checkout-steps" class="mb-8" aria-label={t.checkout.title}>
      <ol class="grid grid-cols-3 gap-2 sm:gap-4">
        <li>
          <button
            type="button"
            class="step-tab"
            data-step-tab="1"
            aria-current="step"
            aria-controls="step-1"
          >
            <span class="step-num">1</span>
            <span class="step-name">{t.checkout.step1}</span>
          </button>
        </li>
        <li>
          <button type="button" class="step-tab" data-step-tab="2" aria-controls="step-2">
            <span class="step-num">2</span>
            <span class="step-name">{t.checkout.step2}</span>
          </button>
        </li>
        <li>
          <button type="button" class="step-tab" data-step-tab="3" aria-controls="step-3">
            <span class="step-num">3</span>
            <span class="step-name">{t.checkout.step3}</span>
          </button>
        </li>
      </ol>
      <p id="step-progress" class="sr-only" role="status" aria-live="polite"></p>
    </nav>

    <div class="grid lg:grid-cols-3 gap-8 lg:gap-12">
      <!-- Formulario principal -->
      <div class="lg:col-span-2 order-2 lg:order-1">
        <form id="checkout-form" class="space-y-8" novalidate>
          <!-- Paso 1: contacto -->
          <section id="step-1" data-step="1" class="bg-negro-carbono border-2 border-white/25 p-6 sm:p-8">
            <h2 class="font-titulos text-2xl text-blancoRoto mb-6 flex items-center gap-3">
              <span class="w-8 h-8 border-2 border-oro-brillo text-oro-brillo flex items-center justify-center font-acentos text-sm">1</span>
              {t.checkout.step1}
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-2">
                <label class="field-label" for="firstName">{t.checkout.firstName} *</label>
                <input
                  id="firstName"
                  name="firstName"
                  required
                  class="input-dark"
                  autocomplete="given-name"
                  value={firstName ?? ''}
                />
              </div>
              <div class="space-y-2">
                <label class="field-label" for="lastName">{t.checkout.lastName} *</label>
                <input
                  id="lastName"
                  name="lastName"
                  required
                  class="input-dark"
                  autocomplete="family-name"
                />
              </div>
              <div class="space-y-2 sm:col-span-2">
                <label class="field-label" for="email">{t.checkout.email} *</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  class="input-dark"
                  autocomplete="email"
                  inputmode="email"
                  value={email ?? ''}
                />
              </div>
            </div>
            <div class="mt-6 flex justify-end">
              <button type="button" class="btn-gold" data-next="2">{t.checkout.continueBtn}</button>
            </div>
          </section>

          <!-- Paso 2: envío -->
          <section id="step-2" data-step="2" class="hidden bg-negro-carbono border-2 border-white/25 p-6 sm:p-8">
            <h2 class="font-titulos text-2xl text-blancoRoto mb-6 flex items-center gap-3">
              <span class="w-8 h-8 border-2 border-oro-brillo text-oro-brillo flex items-center justify-center font-acentos text-sm">2</span>
              {t.checkout.step2}
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-2 sm:col-span-2">
                <label class="field-label" for="postalCode">{t.checkout.postalCode} *</label>
                <div class="relative">
                  <input
                    id="postalCode"
                    name="postalCode"
                    required
                    class="input-dark pr-20"
                    autocomplete="postal-code"
                    inputmode="numeric"
                    maxlength="10"
                    placeholder="12345"
                    aria-describedby="zip-note"
                  />
                  <span
                    id="zip-status"
                    class="shimmer hidden absolute right-3 top-1/2 -translate-y-1/2 h-1.5 w-12 rounded-full"
                    aria-hidden="true"
                  ></span>
                </div>
                <p id="zip-note" class="hidden text-[11px] text-white/80 leading-snug" role="status"></p>
              </div>
              <div class="space-y-2">
                <label class="field-label" for="city">{t.checkout.city} *</label>
                <input
                  id="city"
                  name="city"
                  required
                  class="input-dark"
                  autocomplete="address-level2"
                />
              </div>
              <div class="space-y-2">
                <label class="field-label" for="state">{t.checkout.state} *</label>
                <select id="state" name="state" required class="input-dark" autocomplete="address-level1">
                  <option value="">{t.checkout.statePlaceholder}</option>
                  {SHIPPING_REGIONS.map((s) => (
                    <option value={s.code}>{s.name}</option>
                  ))}
                </select>
              </div>
              <div class="space-y-2 sm:col-span-2">
                <label class="field-label" for="street">{t.checkout.street} *</label>
                <input
                  id="street"
                  name="street"
                  required
                  class="input-dark"
                  autocomplete="street-address"
                />
              </div>
              <div class="space-y-2 sm:col-span-2">
                <label class="field-label" for="colonia">{t.checkout.colonia}</label>
                <input
                  id="colonia"
                  name="colonia"
                  class="input-dark"
                  placeholder={t.checkout.coloniaHint}
                />
              </div>
              <div class="space-y-2 sm:col-span-2">
                <label class="field-label" for="phone">{t.checkout.phone} *</label>
                <input
                  id="phone"
                  name="phone"
                  type="tel"
                  required
                  class="input-dark"
                  autocomplete="tel"
                  inputmode="tel"
                  placeholder={t.checkout.phonePlaceholder}
                  value={phone ?? ''}
                />
              </div>
              <div class="space-y-2 sm:col-span-2">
                <label class="field-label" for="country">{t.checkout.country}</label>
                <input
                  id="country"
                  name="country"
                  class="input-dark opacity-70 cursor-not-allowed"
                  value={t.checkout.countryUS}
                  readonly
                  tabindex="-1"
                  aria-describedby="country-note"
                />
                <p id="country-note" class="text-[11px] text-white/50 leading-snug">
                  {t.checkout.countryNote}
                </p>
                <p class="text-[11px] text-white/50 leading-snug">{t.checkout.apoTip}</p>
              </div>
              <div class="space-y-2 sm:col-span-2">
                <label class="field-label" for="references">{t.checkout.references} *</label>
                <input
                  id="references"
                  name="references"
                  required
                  class="input-dark"
                  placeholder={t.checkout.referencesPlaceholder}
                />
              </div>
              <div class="space-y-2 sm:col-span-2">
                <label class="field-label" for="notes">{t.checkout.notes} *</label>
                <textarea
                  id="notes"
                  name="notes"
                  rows="3"
                  required
                  class="input-dark !min-h-[96px] py-3"
                  placeholder={t.checkout.notesPlaceholder}
                ></textarea>
              </div>
            </div>

            <!-- Método de envío: tarifas FedEx para el ZIP/estado capturados -->
            <div id="shipping-quote" class="mt-6 border-t-2 border-white/15 pt-5 hidden">
              <div class="flex items-center justify-between gap-3 mb-3">
                <p class="field-label !mb-0">{t.checkout.shippingTitle}</p>
                <span
                  id="shipping-estimated-badge"
                  class="text-[10px] uppercase tracking-[0.16em] text-oro-brillo hidden"
                >
                  {t.checkout.shippingEstimated}
                </span>
              </div>
              <p id="shipping-quote-hint" class="text-[11px] text-white/70 leading-snug mb-3">
                {t.checkout.shippingHint}
              </p>
              <div
                id="shipping-options"
                class="space-y-2"
                role="radiogroup"
                aria-label={t.checkout.shippingTitle}
              ></div>
              <p id="shipping-quote-note" class="hidden mt-3 text-[11px] text-white/60 leading-snug">
                {t.checkout.shippingEstimateNote}
              </p>
            </div>

            <div class="mt-6 flex flex-col-reverse sm:flex-row sm:justify-between gap-3">
              <button type="button" class="btn-outline w-full sm:w-auto" data-back="1">{t.checkout.backBtn}</button>
              <button type="button" class="btn-gold w-full sm:w-auto" data-next="3">{t.checkout.continueBtn}</button>
            </div>
          </section>

          <!-- Paso 3: pago embebido -->
          <section id="step-3" data-step="3" class="hidden bg-negro-carbono border-2 border-white/25 p-6 sm:p-8">
            <h2 class="font-titulos text-2xl text-blancoRoto mb-6 flex items-center gap-3">
              <span class="w-8 h-8 border-2 border-oro-brillo text-oro-brillo flex items-center justify-center font-acentos text-sm">3</span>
              {t.checkout.step3}
            </h2>

            <div id="payment-unavailable" class={paymentAvailable ? 'hidden' : 'border-2 border-oro-brillo/60 p-5 sm:p-6'}>
              <p class="text-base text-blancoRoto font-semibold">{t.checkout.cardTitle}</p>
              <p class="text-sm text-white/80 leading-relaxed mt-1">{t.checkout.cardUnavailable}</p>
            </div>

            <div id="payment-box" class={paymentAvailable ? '' : 'hidden'}>
              <p class="field-label">{t.checkout.cardTitle}</p>
              <p class="text-sm text-white/80 leading-relaxed mb-4">{t.checkout.cardText}</p>

              <!-- El esqueleto reserva el espacio del formulario de Stripe. -->
              <div class="relative">
                <div
                  id="payment-skeleton"
                  class="hidden absolute inset-0 z-10 bg-negro-carbono"
                  aria-hidden="true"
                >
                  <div class="shimmer h-12 w-full"></div>
                  <div class="shimmer h-12 w-full mt-3"></div>
                  <div class="shimmer h-12 w-full mt-3"></div>
                </div>

                <div id="payment-element" class="min-h-[120px]"></div>
              </div>

              <p
                id="payment-error"
                role="alert"
                class="hidden mt-4 text-sm text-oro-brillo leading-relaxed"
              ></p>
            </div>

            <p
              id="pay-error"
              role="alert"
              class="hidden mt-4 text-sm text-oro-brillo text-center leading-relaxed"
            ></p>

            <div class="mt-6 flex flex-col-reverse sm:flex-row sm:justify-between gap-3">
              <button type="button" class="btn-outline w-full sm:w-auto" data-back="2">{t.checkout.backBtn}</button>
              <button
                type="submit"
                id="pay-btn"
                class="btn-gold w-full sm:w-auto"
                disabled={!paymentAvailable}
                data-available={paymentAvailable ? 'true' : 'false'}
              >
                {t.checkout.pay}
              </button>
            </div>
          </section>
        </form>
      </div>

      <!-- Resumen del pedido -->
      <aside class="lg:col-span-1 order-1 lg:order-2">
        <div class="lg:sticky lg:top-28 bg-negro-carbono border-2 border-white/25 p-6 sm:p-8">
          <h2 class="font-titulos text-2xl text-blancoRoto mb-6">{t.checkout.orderTitle}</h2>
          <div id="checkout-items" class="divide-y-2 divide-white/15 mb-6">
            <!-- Los items se renderizan aquí -->
          </div>

          <p
            id="checkout-summary-error"
            role="status"
            class="hidden mb-4 text-sm text-oro-brillo leading-relaxed border-2 border-oro-brillo/50 px-3 py-2"
          ></p>

          <div class="space-y-3 pb-4 border-b-2 border-white/25 text-base">
            <div class="flex justify-between">
              <span class="text-white/80">{t.cart.subtotal}</span>
              <span id="co-subtotal" class="text-blancoRoto">$0.00</span>
            </div>
            <div class="flex justify-between">
              <span class="text-white/80">{t.cart.shipping}</span>
              <span id="co-shipping" class="text-blancoRoto">—</span>
            </div>
            <p id="co-shipping-note" class="hidden text-[11px] text-white/60 leading-snug text-right"></p>
          </div>

          <div class="flex justify-between items-center py-5">
            <span class="font-acentos text-base uppercase tracking-[0.18em] text-blancoRoto">{t.checkout.total}</span>
            <span id="co-total" class="font-acentos text-3xl text-oro-brillo font-medium">$0.00</span>
          </div>

          <p class="mt-2 text-xs text-white/80 text-center leading-relaxed">
            {t.checkout.terms}
            <a href={localize(lang, 'terms')} class="text-oro-brillo underline underline-offset-2">{t.checkout.termsLink}</a>,
            {t.checkout.and} <a href={localize(lang, 'privacy')} class="text-oro-brillo underline underline-offset-2">{t.checkout.privacyLink}</a>
            {t.checkout.and} <a href={localize(lang, 'returns')} class="text-oro-brillo underline underline-offset-2">{t.checkout.returnsLink}</a>.
          </p>
        </div>
      </aside>
    </div>
  </div>

  <!-- Transición al pago: se muestra al enviar y no se quita si todo sale bien. -->
  <div
    id="checkout-redirect"
    class="hidden fixed inset-0 z-[130] bg-negro-profundo/92 backdrop-blur-md flex flex-col items-center justify-center gap-5 px-6 text-center"
    role="status"
    aria-live="assertive"
  >
    <span class="redirect-spinner" aria-hidden="true"></span>
    <p class="font-acentos text-[10px] uppercase tracking-[0.28em] text-oro-brillo">Pago seguro</p>
    <p class="text-sm text-white/75 max-w-xs leading-relaxed">{t.checkout.redirecting}</p>
  </div>

  <style>
    .redirect-spinner {
      width: 44px;
      height: 44px;
      border-radius: 9999px;
      border: 2px solid rgba(255, 255, 255, 0.15);
      border-top-color: #ffe28a;
      animation: redirect-spin 0.9s linear infinite;
    }

    @keyframes redirect-spin {
      to {
        transform: rotate(360deg);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .redirect-spinner {
        animation-duration: 2.4s;
      }
    }

    .field-label {
      display: block;
      margin-bottom: 0.5rem;
      font-family: 'Space Grotesk', Inter, sans-serif;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #ffe28a;
    }

    .input-dark {
      width: 100%;
      background: #050505;
      border: 2px solid rgba(247, 223, 165, 0.28);
      border-radius: 0.375rem;
      padding: 0.75rem 1rem;
      color: #ffffff;
      font-size: 1rem;
      transition: all 0.2s ease;
    }

    .input-dark:focus {
      outline: none;
      border-color: #ffe28a;
      box-shadow: 0 0 0 3px rgba(255, 226, 138, 0.1);
    }

    .input-dark::placeholder {
      color: rgba(255, 255, 255, 0.5);
    }

    .input-dark.invalid {
      border-color: #ef4444;
      box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.15);
    }

    .btn-gold {
      background: #ffe28a;
      color: #000000;
      font-family: 'Space Grotesk', Inter, sans-serif;
      font-weight: 600;
      font-size: 0.875rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      padding: 1rem 1.5rem;
      border-radius: 0.375rem;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 52px;
    }

    .btn-gold:hover:not(:disabled) {
      background: #ffed9f;
      transform: translateY(-2px);
      box-shadow: 0 10px 25px -5px rgba(255, 226, 138, 0.4);
    }

    .btn-gold:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .gold-line {
      height: 2px;
      width: 24px;
      background: linear-gradient(to right, transparent, #ffe28a, transparent);
      margin: 0 auto;
    }

    .step-tab {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      width: 100%;
      padding: 0.7rem 0.75rem;
      border: 2px solid rgba(255, 255, 255, 0.3);
      border-radius: 0.375rem;
      text-align: left;
      transition: border-color 0.2s ease, background-color 0.2s ease, opacity 0.2s ease;
    }

    .step-tab[aria-current='step'] {
      border-color: #ffe28a;
      background: rgba(255, 226, 138, 0.08);
    }

    .step-tab.step-done {
      border-color: rgba(255, 226, 138, 0.55);
    }

    .step-tab.step-ahead {
      opacity: 0.65;
    }

    .step-num {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.6rem;
      height: 1.6rem;
      flex: 0 0 auto;
      border: 2px solid rgba(255, 255, 255, 0.45);
      border-radius: 9999px;
      font-family: 'Space Grotesk', Inter, sans-serif;
      font-size: 0.7rem;
      color: #ffffff;
    }

    .step-tab[aria-current='step'] .step-num,
    .step-tab.step-done .step-num {
      border-color: #ffe28a;
      color: #ffe28a;
    }

    .step-name {
      font-family: 'Space Grotesk', Inter, sans-serif;
      font-size: 0.65rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.85);
      line-height: 1.2;
    }

    @media (min-width: 640px) {
      .step-name {
        font-size: 0.75rem;
      }
    }
  </style>

  <script>
    import { getCart, refreshCartPrices, formatMXN, startCartSync } from '../../lib/cart';
    import { nudge, busy } from '../../lib/ux';
    import { shippingCostFor } from '../../lib/pricing';
    import { escapeHtml, friendlyError } from '../../lib/html';
    import { askConfirm } from '../../lib/dialog';
    import { wireZipAutocomplete } from '../../lib/zip-autocomplete';

    const ui = JSON.parse(document.getElementById('checkout-ui')?.textContent || '{}') as Record<string, string>;
    const uiText = (key: string) => ui[key] ?? '';

    const form = document.getElementById('checkout-form') as HTMLFormElement;
    const payBtn = document.getElementById('pay-btn') as HTMLButtonElement;
    const errorEl = document.getElementById('pay-error')!;
    const summaryError: HTMLElement | null = document.getElementById('checkout-summary-error') as HTMLElement;
    const alertDiv = document.getElementById('checkout-alert') as HTMLElement;
    const paymentAvailable = payBtn?.getAttribute('data-available') !== 'false';

    // ---------------- Pasos del checkout ----------------

    const stepSections = Array.from(
      form.querySelectorAll<HTMLElement>('[data-step]')
    );
    const stepTabs = Array.from(
      document.querySelectorAll<HTMLElement>('[data-step-tab]')
    );
    const stepProgressEl = document.getElementById('step-progress');
    const reducedMotion = () =>
      window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;

    let currentStep = 1;

    function stepSection(step: number): HTMLElement | null {
      return stepSections.find((s) => Number(s.dataset.step) === step) ?? null;
    }

    function showStep(step: number, options: { scroll?: boolean } = {}) {
      currentStep = step;

      for (const section of stepSections) {
        section.classList.toggle('hidden', Number(section.dataset.step) !== step);
      }

      for (const tab of stepTabs) {
        const value = Number(tab.dataset.stepTab);
        tab.setAttribute('aria-current', value === step ? 'step' : 'false');
        tab.classList.toggle('step-done', value < step);
        tab.classList.toggle('step-ahead', value > step);
      }

      if (stepProgressEl) {
        stepProgressEl.textContent = `${uiText('stepProgress')} ${step} ${uiText('stepOf')} ${stepSections.length}`;
      }

      if (step === 2) {
        quoteBlock?.classList.remove('hidden');
        void loadQuotes();
      }

      if (step === 3) void preparePayment();

      if (options.scroll !== false) {
        const anchor = document.getElementById('checkout-steps');
        anchor?.scrollIntoView({
          behavior: reducedMotion() ? 'auto' : 'smooth',
          block: 'start',
        });
      }
    }

    // ---------------- Pago embebido (Stripe Payment Element) ----------------

    const stripeKey = uiText('stripeKey');
    const paymentSkeleton = document.getElementById('payment-skeleton');
    const paymentElementHost = document.getElementById('payment-element');
    const paymentErrorEl = document.getElementById('payment-error');

    let stripeInstance: any = null;
    let stripeElements: any = null;
    let paymentElement: any = null;
    let clientSecret: string | null = null;
    let returnPath = '/confirmacion';
    let orderNumber: string | null = null;
    let paymentPrepared = false;
    let paymentSignature = '';
    let preparePromise: Promise<boolean> | null = null;
    let stripeLoader: Promise<any> | null = null;
    let paymentReady = false;

    function showPaymentError(message: string | null) {
      if (!paymentErrorEl) return;
      paymentErrorEl.textContent = message ?? '';
      paymentErrorEl.classList.toggle('hidden', !message);
    }

    function showPaymentSkeleton(show: boolean) {
      // Solo se superpone el esqueleto: el contenedor de Stripe sigue montado.
      paymentSkeleton?.classList.toggle('hidden', !show);
    }

    function loadStripeJs(key: string): Promise<any> {
      const existing = (window as any).Stripe;
      if (existing) return Promise.resolve(existing(key));
      if (stripeLoader) return stripeLoader;

      stripeLoader = new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = 'https://js.stripe.com/v3/';
        script.async = true;
        script.onload = () => {
          const loader = (window as any).Stripe;
          loader ? resolve(loader(key)) : reject(new Error('stripe_unavailable'));
        };
        script.onerror = () => reject(new Error('stripe_unavailable'));
        document.head.appendChild(script);
      });

      return stripeLoader;
    }

    /** Firma del checkout: si cambia, el PaymentIntent anterior ya no sirve. */
    function checkoutSignature(): string {
      return JSON.stringify({
        cart: getCart().map((i) => [i.variantId, i.qty]),
        quote: selectedQuote?.productCode ?? null,
        amount: selectedQuote?.amount ?? null,
        zip: value('postalCode'),
        state: value('state'),
      });
    }

    function resetPayment() {
      paymentPrepared = false;
      paymentSignature = '';
      clientSecret = null;
      paymentReady = false;
      try {
        paymentElement?.unmount?.();
      } catch {
        // El nodo ya pudo desaparecer: no hay nada que desmontar.
      }
      paymentElement = null;
      stripeElements = null;
      if (paymentElementHost) paymentElementHost.innerHTML = '';
      showPaymentError(null);
      if (paymentAvailable) payBtn.disabled = true;
    }

    async function mountPayment(secret: string) {
      stripeInstance = await loadStripeJs(stripeKey);

      stripeElements = stripeInstance.elements({
        clientSecret: secret,
        appearance: {
          theme: 'night',
          variables: {
            colorPrimary: '#ffe28a',
            colorBackground: '#050505',
            colorText: '#ffffff',
            colorDanger: '#ffe28a',
            borderRadius: '6px',
          },
        },
      });

      paymentElement = stripeElements.create('payment', { layout: 'tabs' });
      paymentElement.mount('#payment-element');

      paymentElement.on?.('ready', () => {
        paymentReady = true;
        showPaymentSkeleton(false);
        payBtn.disabled = false;
      });
    }

    async function doPreparePayment(): Promise<boolean> {
      if (!paymentAvailable) return false;

      // Un PaymentIntent nuevo invalida el anterior: se desmonta antes de pedir.
      resetPayment();
      showPaymentError(null);
      showPaymentSkeleton(true);
      payBtn.disabled = true;

      try {
        const res = await fetch('/api/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items: getCart().map((i) => ({ variantId: i.variantId, qty: i.qty })),
            customer: {
              firstName: value('firstName'),
              lastName: value('lastName'),
              email: value('email'),
              phone: value('phone'),
              street: value('street'),
              colonia: value('colonia'),
              city: value('city'),
              state: value('state'),
              postalCode: value('postalCode'),
              references: value('references'),
              notes: value('notes'),
            },
            coupon: sessionStorage.getItem('dsp_coupon') || undefined,
            shipping: selectedQuote
              ? { productCode: selectedQuote.productCode, amount: selectedQuote.amount }
              : undefined,
            acceptShippingChange,
          }),
        });

        const data = await res.json().catch(() => ({}));

        if (!res.ok) {
          if (data?.code === 'SHIPPING_CHANGED' && data?.shipping) {
            showPaymentSkeleton(false);
            payBtn.disabled = false;

            const next = data.shipping as QuoteOption & { name?: string };
            const previous = quoteOptions.find((o) => o.productCode === next.productCode);
            const confirmed = await askConfirm({
              title: uiText('shippingChangedTitle'),
              message:
                `${uiText('shippingChangedMessage')} $${formatMXN(next.amount)} (${next.name ?? next.productName}).`,
              confirmLabel: uiText('shippingChangeAccept'),
            });

            if (!confirmed) return false;

            selectedQuote = {
              productCode: next.productCode,
              productName: next.name ?? next.productName,
              amount: next.amount,
              currency: 'USD',
              deliveryDate: previous?.deliveryDate ?? null,
              estimatedDays: previous?.estimatedDays ?? null,
              estimated: previous?.estimated ?? true,
            };
            quoteOptions = quoteOptions.map((o) =>
              o.productCode === next.productCode ? { ...o, amount: next.amount } : o
            );
            renderShippingOptions();
            renderSummary();
            acceptShippingChange = true;
            return doPreparePayment();
          }

          if (data?.code === 'NO_SESSION') {
            sessionStorage.setItem('dsp_checkout_error', uiText('noSession'));
            window.location.href =
              '/entrar?next=' + encodeURIComponent(window.location.pathname);
            return false;
          }

          showPaymentSkeleton(false);
          payBtn.disabled = false;
          showError(
            friendlyError(data?.code, data?.error ?? uiText('openFailed')) +
              (data?.detail ? ` (Stripe: ${data.detail})` : '')
          );
          return false;
        }

        clientSecret = typeof data?.clientSecret === 'string' ? data.clientSecret : null;
        returnPath = typeof data?.returnPath === 'string' ? data.returnPath : '/confirmacion';
        orderNumber = typeof data?.orderNumber === 'string' ? data.orderNumber : null;

        if (!clientSecret) throw new Error('missing_client_secret');
        if (!stripeKey) throw new Error('missing_publishable_key');

        await mountPayment(clientSecret);
        paymentPrepared = true;
        paymentSignature = checkoutSignature();
        return true;
      } catch {
        showPaymentSkeleton(false);
        payBtn.disabled = false;
        showPaymentError(uiText('paymentInitFailed'));
        return false;
      }
    }

    /** Idempotente: un solo pedido/PaymentIntent por combinación de carrito. */
    async function preparePayment(): Promise<boolean> {
      if (!paymentAvailable) return false;
      if (paymentPrepared && paymentSignature === checkoutSignature()) return true;
      if (preparePromise) return preparePromise;

      preparePromise = doPreparePayment().finally(() => {
        preparePromise = null;
      });

      return preparePromise;
    }

    // ---------------- Envío (FedEx) ----------------

    interface QuoteOption {
      productCode: string;
      productName: string;
      amount: number;
      currency: string;
      deliveryDate: string | null;
      estimatedDays: number | null;
      /** Días de la tabla local porque FedEx no dio compromiso. */
      estimated: boolean;
    }

    const fedexReady = ui.fedex === '1';
    const quoteBlock = document.getElementById('shipping-quote');
    const quoteOptionsEl = document.getElementById('shipping-options');
    const quoteHintEl = document.getElementById('shipping-quote-hint');
    const quoteNoteEl = document.getElementById('shipping-quote-note');
    const shippingNoteEl = document.getElementById('co-shipping-note');

    let quoteOptions: QuoteOption[] = [];
    let selectedQuote: QuoteOption | null = null;
    let quoteLoading = false;
    let quoteSeq = 0;
    let quoteTimer: number | null = null;
    // Hubo un intento real de cotización (sirve para no pintar "no pudimos"
    // cuando el destino todavía está incompleto).
    let quoteAttempted = false;
    // El cliente ya aceptó un cambio de precio en el servidor.
    let acceptShippingChange = false;

    let cartReady = false;

    function flatShipping(subtotal: number): number {
      return shippingCostFor(subtotal, {
        freeFrom: Number(ui.freeFrom) || 0,
        cost: Number(ui.shipCost) || 0,
      });
    }

    function cartSubtotal(): number {
      return getCart().reduce((sum, i) => sum + i.price * i.qty, 0);
    }

    function destinationReady(): boolean {
      return /^\d{5}(-\d{4})?$/.test(value('postalCode')) && !!value('state');
    }

    function quoteEta(option: QuoteOption): string {
      if (option.estimatedDays) {
        const unit = option.estimatedDays === 1 ? uiText('shippingDay') : uiText('shippingDays');
        return `${option.estimatedDays} ${unit}`;
      }
      if (option.deliveryDate) {
        return `${uiText('shippingArrives')} ${formatDeliveryDate(option.deliveryDate)}`;
      }
      return '';
    }

    /** `2026-11-08` (o ISO completo) → `8 nov` / `Nov 8`. */
    function formatDeliveryDate(value: string): string {
      const day = String(value).slice(0, 10);
      const date = new Date(`${day}T12:00:00`);
      if (Number.isNaN(date.getTime())) return String(value);

      const locale = (document.documentElement.lang || 'es').startsWith('en') ? 'en-US' : 'es-MX';
      return new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short' }).format(date);
    }

    function optionHtml(option: QuoteOption): string {
      const selected = selectedQuote?.productCode === option.productCode;
      const eta = quoteEta(option);
      // Solo se marca "estimado" cuando el plazo no es un compromiso de FedEx.
      const etaNote = option.estimated ? uiText('shippingEstimated') : '';
      const classes =
        'w-full text-left border-2 ' +
        (selected ? 'border-oro-brillo bg-oro-brillo/10' : 'border-white/40 hover:border-white/80') +
        ' px-4 py-3 transition-colors';
      const priceClass =
        'font-acentos text-base ' +
        (selected ? 'text-oro-brillo' : 'text-blancoRoto') +
        ' whitespace-nowrap';

      return (
        '<button type="button" role="radio" aria-checked="' +
        selected +
        '" data-quote="' +
        escapeHtml(option.productCode) +
        '" class="' +
        classes +
        '">' +
        '<span class="flex items-center justify-between gap-3">' +
        '<span class="text-sm text-blancoRoto">' +
        escapeHtml(option.productName) +
        '</span>' +
        '<span class="' +
        priceClass +
        '">$' +
        formatMXN(option.amount) +
        '</span></span>' +
        (eta
          ? '<span class="mt-1 block text-[11px] text-white/60">' +
            escapeHtml(eta) +
            (etaNote ? ' · ' + escapeHtml(etaNote) : '') +
            '</span>'
          : '') +
        '</button>'
      );
    }

    function renderShippingOptions() {
      if (!quoteOptionsEl) return;

      quoteOptionsEl.innerHTML =
        quoteOptions.length === 0
          ? quoteAttempted
            ? '<p class="text-xs text-oro-brillo leading-snug">' +
              escapeHtml(uiText('shippingUnavailable')) +
              '</p>'
            : ''
          : quoteOptions.map(optionHtml).join('');

      // El aviso "estimado" de la cabecera solo aplica si algún plazo es de respaldo.
      document
        .getElementById('shipping-estimated-badge')
        ?.classList.toggle('hidden', !quoteOptions.some((o) => o.estimated));

      quoteOptionsEl.querySelectorAll<HTMLElement>('[data-quote]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const code = btn.dataset.quote ?? '';
          selectedQuote = quoteOptions.find((o) => o.productCode === code) ?? null;
          acceptShippingChange = false;
          renderShippingOptions();
          renderSummary();
        });
      });
    }

    function showQuoteSkeleton() {
      if (!quoteOptionsEl) return;
      quoteOptionsEl.innerHTML =
        '<div class="shimmer h-14 w-full" aria-hidden="true"></div>' +
        '<div class="shimmer h-14 w-full mt-2" aria-hidden="true"></div>';
    }

    async function loadQuotes() {
      if (!fedexReady || !quoteBlock) return;

      const subtotal = cartSubtotal();

      // Envío gratis (o carrito vacío): no hace falta cotizar.
      if (subtotal <= 0 || flatShipping(subtotal) === 0) {
        quoteBlock.classList.add('hidden');
        quoteOptions = [];
        selectedQuote = null;
        quoteLoading = false;
        quoteAttempted = false;
        renderSummary();
        return;
      }

      if (!destinationReady()) {
        quoteBlock.classList.remove('hidden');
        quoteHintEl?.classList.remove('hidden');
        quoteNoteEl?.classList.add('hidden');
        if (quoteOptionsEl) quoteOptionsEl.innerHTML = '';
        quoteOptions = [];
        selectedQuote = null;
        quoteLoading = false;
        quoteAttempted = false;
        renderSummary();
        return;
      }

      const seq = ++quoteSeq;
      quoteLoading = true;
      quoteAttempted = true;
      quoteBlock.classList.remove('hidden');
      quoteHintEl?.classList.add('hidden');
      quoteNoteEl?.classList.add('hidden');
      showQuoteSkeleton();
      renderSummary();

      try {
        const res = await fetch('/api/shipping/quote', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            zip: value('postalCode'),
            city: value('city'),
            state: value('state'),
            items: getCart().map((i) => ({ qty: i.qty })),
          }),
        });

        const data = await res.json().catch(() => ({}));

        // Respuesta vieja: llegó después de otro cambio de ZIP/estado.
        if (seq !== quoteSeq) return;

        quoteOptions = Array.isArray(data?.options) ? (data.options as QuoteOption[]) : [];
        selectedQuote = quoteOptions[0] ?? null;
        acceptShippingChange = false;
      } catch {
        if (seq !== quoteSeq) return;
        quoteOptions = [];
        selectedQuote = null;
      }

      quoteLoading = false;
      renderShippingOptions();
      quoteNoteEl?.classList.toggle('hidden', quoteOptions.length === 0);
      renderSummary();
    }

    function scheduleQuotes() {
      if (quoteTimer) window.clearTimeout(quoteTimer);
      quoteTimer = window.setTimeout(() => {
        quoteTimer = null;
        void loadQuotes();
      }, 500);
    }

    function getProfile() {
      return fetch('/api/profile')
        .then((res) => res.json())
        .catch(() => null);
    }

    function value(field: string): string {
      return (form.elements.namedItem(field) as HTMLInputElement | HTMLTextAreaElement)?.value?.trim() || '';
    }

    function validateField(field: HTMLInputElement | HTMLTextAreaElement): boolean {
      const name = field.name;
      const val = field.value.trim();
      let isValid = true;
      let errorMessage = '';

      if (field.hasAttribute('required') && !val) {
        isValid = false;
        errorMessage = uiText('required');
      }

      if (name === 'email' && val) {
        const emailRegex = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
        if (!emailRegex.test(val)) {
          isValid = false;
          errorMessage = uiText('invalidEmail');
        }
      }

      if (name === 'phone' && val) {
        const digits = val.replace(/\D/g, '');
        if (digits.length < 10 || digits.length > 15) {
          isValid = false;
          errorMessage = uiText('invalidPhone');
        }
      }

      if (name === 'postalCode' && val && !/^\d{5}(-\d{4})?$/.test(val)) {
        isValid = false;
        errorMessage = uiText('invalidPostal');
      }

      const parent = field.closest('.space-y-2') || field.parentElement;

      if (!isValid) {
        // Sacudida + anillo en el propio campo: la mirada va justo ahí.
        nudge(field, { focus: false });
        if (parent) {
          let errorDiv: HTMLElement | null = parent.querySelector('.error-message');
          if (!errorDiv) {
            errorDiv = document.createElement('div');
            errorDiv.className = 'error-message dsp-alert mt-1.5 text-xs';
            errorDiv.setAttribute('data-tone', 'error');
            parent.appendChild(errorDiv);
          }
          errorDiv.textContent = errorMessage;
        }
        return false;
      }

      field.classList.remove('invalid');
      const errorDiv = parent?.querySelector('.error-message');
      if (errorDiv) errorDiv.remove();
      return true;
    }

    function validateFields(scope: ParentNode): boolean {
      const inputs = scope.querySelectorAll('input[required], textarea[required]');
      let isValid = true;
      let firstInvalid: HTMLElement | null = null;

      inputs.forEach((input) => {
        const ok = validateField(input as HTMLInputElement | HTMLTextAreaElement);
        if (!ok) {
          isValid = false;
          if (!firstInvalid) firstInvalid = input as HTMLElement;
        }
      });

      // Lleva el foco al primer campo que falla, no deja al usuario buscando.
      if (firstInvalid) {
        (firstInvalid as HTMLElement).focus({ preventScroll: true });
        (firstInvalid as HTMLElement).scrollIntoView({
          behavior: 'smooth',
          block: 'center',
        });
      }

      return isValid;
    }

    function validateAllFields(): boolean {
      return validateFields(form);
    }

    function validateStep(step: number): boolean {
      const section = stepSection(step);
      return section ? validateFields(section) : true;
    }

    /** Un paso solo avanza si sus campos están completos y no hay cotización viva. */
    function canAdvance(step: number): boolean {
      if (step === 2 && quoteLoading) {
        showError(uiText('shippingCalculating'));
        return false;
      }
      return validateStep(step);
    }

    function renderSummary() {
      const items = getCart();
      const empty = document.getElementById('checkout-empty')!;
      const main = document.getElementById('checkout-content')!;

      if (items.length === 0) {
        empty.classList.remove('hidden');
        main.classList.add('hidden');
        return;
      }

      empty.classList.add('hidden');
      main.classList.remove('hidden');

      document.getElementById('checkout-items')!.innerHTML = items
        .map(
          (i) => `
        <div class="flex justify-between items-center gap-3 py-3">
          <div class="min-w-0">
            <p class="text-base text-blancoRoto">${escapeHtml(i.name)}</p>
            <p class="text-sm text-white/80">${escapeHtml(i.variantName)} × ${i.qty}</p>
          </div>
          <span class="text-base font-acentos text-oro-brillo whitespace-nowrap">$${formatMXN(i.price * i.qty)}</span>
        </div>`
        )
        .join('');

      const subtotal = items.reduce((sum, i) => sum + i.price * i.qty, 0);
      const flat = flatShipping(subtotal);
      const shipping = selectedQuote ? selectedQuote.amount : flat;
      const pending = quoteLoading && fedexReady && flat > 0;

      const shippingEl = document.getElementById('co-shipping')!;
      const totalEl = document.getElementById('co-total')!;

      document.getElementById('co-subtotal')!.textContent = `$${formatMXN(subtotal)}`;

      if (pending) {
        shippingEl.textContent = '—';
        totalEl.textContent = '—';
      } else {
        shippingEl.textContent = shipping === 0 ? uiText('free') : `$${formatMXN(shipping)}`;
        totalEl.textContent = `$${formatMXN(subtotal + shipping)}`;
      }

      if (shippingNoteEl) {
        if (selectedQuote && !pending) {
          shippingNoteEl.textContent = selectedQuote.estimated
            ? `${selectedQuote.productName} · ${uiText('shippingEstimated')}`
            : selectedQuote.productName;
          shippingNoteEl.classList.remove('hidden');
        } else {
          shippingNoteEl.classList.add('hidden');
        }
      }
    }

    function showError(message: string) {
      alertDiv.textContent = message;
      alertDiv.classList.remove('hidden');
      alertDiv.classList.add('dsp-alert');
      alertDiv.setAttribute('data-tone', 'error');
      alertDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
    }

    /** Restaura el botón de pago si el intento se queda a medias. */
    let restorePay: (() => void) | null = null;

    const redirectOverlay = document.getElementById('checkout-redirect');

    function showRedirect() {
      redirectOverlay?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function hideRedirect() {
      redirectOverlay?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    function restoreButton() {
      if (restorePay) {
        restorePay();
        restorePay = null;
      }
      payBtn.disabled = false;
      payBtn.textContent = uiText('pay');
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.classList.add('hidden');
      alertDiv.classList.add('hidden');
      showPaymentError(null);

      if (!paymentAvailable) {
        showError(uiText('unavailable'));
        return;
      }

      if (!cartReady) {
        showError(uiText('waitCart'));
        return;
      }

      const items = getCart();
      if (items.length === 0) {
        showError(uiText('emptyCartError'));
        return;
      }

      if (currentStep !== 3) {
        // Enter en un campo avanza un paso, validando primero.
        if (canAdvance(currentStep)) showStep(Math.min(currentStep + 1, 3));
        return;
      }

      if (!validateAllFields()) {
        showError(uiText('fixErrors'));
        return;
      }

      if (quoteLoading) {
        showError(uiText('shippingCalculating'));
        return;
      }

      // El PaymentIntent se crea al entrar al paso 3; si algo cambió, se rehace.
      if (!paymentPrepared || paymentSignature !== checkoutSignature()) {
        const ready = await preparePayment();
        if (!ready) return;
      }

      if (!stripeInstance || !stripeElements || !clientSecret) {
        showPaymentError(uiText('paymentInitFailed'));
        return;
      }

      if (!paymentReady) {
        // Stripe todavía monta el formulario: el botón sigue bloqueado.
        showPaymentError(uiText('preparingPayment'));
        return;
      }

      showPaymentError(null);

      // `busy` bloquea el botón mientras Stripe confirma la tarjeta.
      restorePay = busy(payBtn, uiText('opening'));
      showRedirect();

      const returnUrl = new URL(returnPath, window.location.origin);
      if (orderNumber) returnUrl.searchParams.set('order', orderNumber);

      try {
        const result = await stripeInstance.confirmPayment({
          elements: stripeElements,
          confirmParams: { return_url: returnUrl.toString() },
          redirect: 'if_required',
        });

        if (result?.error) {
          hideRedirect();
          restoreButton();
          showPaymentError(result.error.message ?? uiText('paymentFailed'));
          return;
        }

        const intent = result?.paymentIntent;
        if (intent) {
          // El total ya se cobró en el servidor: solo se muestra la confirmación.
          const next = new URL(returnUrl.toString());
          next.searchParams.set('payment_intent', intent.id);
          next.searchParams.set('redirect_status', intent.status ?? 'succeeded');
          window.location.href = next.toString();
          return;
        }

        // Sin redirect: Stripe está resolviendo el pago; el overlay se queda.
      } catch {
        showError(uiText('connection'));
        hideRedirect();
        restoreButton();
      }
    });

    // ---------------- Navegación entre pasos ----------------

    const goToStep = (target: number) => {
      if (target === currentStep) return;

      if (target < currentStep) {
        showStep(target);
        return;
      }

      for (let step = currentStep; step < target; step += 1) {
        if (!canAdvance(step)) return;
      }

      showStep(target);
    };

    document.querySelectorAll<HTMLElement>('[data-next]').forEach((button) => {
      button.addEventListener('click', () => goToStep(Number(button.dataset.next)));
    });

    document.querySelectorAll<HTMLElement>('[data-back]').forEach((button) => {
      button.addEventListener('click', () => goToStep(Number(button.dataset.back)));
    });

    stepTabs.forEach((tab) => {
      tab.addEventListener('click', () => goToStep(Number(tab.dataset.stepTab)));
    });

    // Desmarcar el error de cada campo al corregirlo
    form?.querySelectorAll('input, textarea').forEach((input) => {
      input.addEventListener('blur', () => {
        const el = input as HTMLInputElement;
        if (el.value.trim()) validateField(el);
      });
    });

    // Volver a cotizar cuando cambia el destino (ZIP, estado o ciudad).
    (['postalCode', 'state', 'city'] as const).forEach((name) => {
      const el = form?.elements.namedItem(name) as HTMLElement | null;
      el?.addEventListener('input', scheduleQuotes);
      el?.addEventListener('change', scheduleQuotes);
    });

    // Autocompletado ZIP → ciudad/estado desde el catálogo local.
    // Si el ZIP no existe o el endpoint falla, no se bloquea ni se avisa: el
    // cliente escribe ciudad y estado a mano.
    const zipStatusEl = document.getElementById('zip-status');
    const zipNoteEl = document.getElementById('zip-note');

    function showZipNote(message: string | null) {
      if (!zipNoteEl) return;
      zipNoteEl.textContent = message ?? '';
      zipNoteEl.classList.toggle('hidden', !message);
    }

    wireZipAutocomplete(form, {
      onLoading(loading) {
        // Una espera visible usa siempre `.shimmer` (forma reservada).
        zipStatusEl?.classList.toggle('hidden', !loading);
        showZipNote(loading ? uiText('zipLooking') : null);
      },
      onFilled() {
        showZipNote(uiText('zipAutocompleteFilled'));
      },
      onStateUnavailable() {
        showZipNote(uiText('zipStateUnavailable'));
      },
      onNotFound() {
        showZipNote(uiText('zipNotFound'));
      },
    });

    // Prellenar con los datos de la cuenta
    getProfile()
      .then((profile) => {
        if (!profile) return;
        const set = (name: string, val: string | null | undefined) => {
          const el: HTMLInputElement | null = form.elements.namedItem(name) as HTMLInputElement;
          if (el && !el.value && val) el.value = val;
        };
        set('firstName', profile.first_name);
        set('lastName', profile.last_name);
        set('email', profile.email);
        set('phone', profile.phone);
      })
      .catch(() => {});

    // Precios y disponibilidad antes de mostrar el resumen:
    // si el carrito trae piezas viejas, se actualiza o se retiran.
    refreshCartPrices()
      .then(({ removed }) => {
        cartReady = true;
        if (removed.length > 0 && summaryError) {
          const names = removed
            .map((item: any) => (item?.name ? String(item.name) : ''))
            .filter(Boolean)
            .join(', ');

          summaryError.textContent =
            `${uiText('removedPieces')} ${removed.length} ${
              removed.length === 1 ? uiText('pieceOne') : uiText('pieceMany')
            } ${uiText('unavailableNow')}` + (names ? ` (${names})` : '');
          summaryError.classList.remove('hidden');
        }
        renderSummary();
      })
      .catch(() => {
        cartReady = true;
        renderSummary();
      })
      .finally(() => {
        void loadQuotes();
      });

    renderSummary();
    showStep(1, { scroll: false });

    // Otra pestaña cambió el carrito: el resumen se repinta antes de pagar
    // (nunca se cobra un carrito que ya no es el que se ve).
    startCartSync();
    window.addEventListener('cart:updated', () => {
      renderSummary();
      // El monto cambió: el PaymentIntent montado ya no sirve.
      resetPayment();
      void loadQuotes();
      if (currentStep === 3) void preparePayment();
    });

    if (!paymentAvailable) {
      showError(uiText('unavailable'));
    }
  </script>
</BaseLayout>
