---
/**
 * Nosotros / About — manifiesto de llegada.
 *
 * Página mínima a propósito: tres líneas y los 7 logos de la marca rebotando
 * por la pantalla. La velocidad no es constante a propósito: cada logo cambia
 * de marcha por su cuenta (frenazos de 0.2× durante ~1 s y arranques enteros
 * de 3×–50× que duran al menos 3 s) y gira como una marometa descontrolada.
 * Sin JS, o con `prefers-reduced-motion`, los logos quedan quietos y el texto
 * sigue mandando.
 */
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';

/** Tamaños distintos para que el rebote no parezca una cuadrícula. */
const LOGO_SIZES = [72, 104, 60, 88, 116, 66, 94];
---

<BaseLayout
  title="¡DSP! — Dinero Sobre Problemas"
  description="¡DSP! Dinero Sobre Problemas. We've arrived."
>
  <section
    id="arrived"
    class="relative overflow-hidden flex items-center justify-center min-h-[calc(100svh-5rem)] bg-negro-profundo"
  >
    <div id="dvd-layer" class="absolute inset-0 pointer-events-none" aria-hidden="true">
      {
        LOGO_SIZES.map((size) => (
          <img
            src="/img/logo/DSP.jpg"
            alt=""
            width={size}
            height={size}
            data-dvd
            data-size={size}
            class="dvd-logo"
            decoding="async"
          />
        ))
      }
    </div>

    <div class="relative z-10 px-6 py-16 text-center select-none arrived-copy">
      <p class="font-titulos text-6xl sm:text-8xl lg:text-[8rem] leading-[0.9] text-blancoRoto tracking-tight">
        ¡DSP!
      </p>
      <p class="font-acentos mt-6 sm:mt-8 text-[11px] sm:text-sm uppercase tracking-[0.42em] sm:tracking-[0.6em] text-oro-brillo">
        Dinero Sobre Problemas
      </p>
      <p class="font-titulos mt-10 sm:mt-14 text-2xl sm:text-4xl text-blancoRoto/90 tracking-[0.08em]">
        WE'VE ARRIVED
      </p>
    </div>
  </section>

  <style>
    .dvd-logo {
      position: absolute;
      top: 0;
      left: 0;
      width: var(--dvd-size, 96px);
      height: var(--dvd-size, 96px);
      object-fit: contain;
      background: #000;
      border: 1px solid rgba(255, 255, 255, 0.12);
      opacity: 0.5;
      will-change: transform, filter;
      transform: translate3d(0, 0, 0);
    }

    /* Un halo oscuro detrás del texto para que el rebote no lo ensucie. */
    .arrived-copy {
      background: radial-gradient(
        ellipse at center,
        rgba(10, 10, 10, 0.92) 0%,
        rgba(10, 10, 10, 0.75) 45%,
        rgba(10, 10, 10, 0) 72%
      );
    }

    @media (prefers-reduced-motion: reduce) {
      .dvd-logo {
        opacity: 0.28;
      }
    }
  </style>

  <script>
    const layer = document.getElementById('dvd-layer');

    if (layer) {
      const nodes = Array.from(layer.querySelectorAll<HTMLImageElement>('[data-dvd]'));
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /** Píxeles por frame (a 60 fps) con factor 1. */
      const BASE = 2.4;

      interface Bouncer {
        el: HTMLImageElement;
        size: number;
        x: number;
        y: number;
        /** Dirección unitaria; el sentido lo llevan estos signos. */
        dx: number;
        dy: number;
        /** Multiplicador de velocidad de la fase actual. */
        factor: number;
        /** Fin de la fase actual (ms). */
        until: number;
        /** Rotación acumulada y velocidad angular (grados por segundo). */
        angle: number;
        spin: number;
        hue: number;
      }

      const rand = (min: number, max: number) => min + Math.random() * (max - min);

      const items: Bouncer[] = nodes.map((el, i) => {
        const size = Number(el.dataset.size) || 96;
        el.style.setProperty('--dvd-size', `${size}px`);

        return {
          el,
          size,
          x: 0,
          y: 0,
          dx: Math.cos((Math.PI * 2 * i) / nodes.length + 0.35),
          dy: Math.sin((Math.PI * 2 * i) / nodes.length + 0.35),
          factor: 1,
          until: 0,
          angle: rand(0, 360),
          spin: rand(-540, 540),
          hue: Math.floor(rand(0, 360)),
        };
      });

      /**
       * Nueva fase de movimiento.
       *  · 35 %: bajón a 0.2×, apenas 1 segundo.
       *  · 45 %: acelerón entero de 3× a 50×, nunca menos de 3 segundos.
       *  · 20 %: vuelta a 1× para que el ojo recupere la referencia.
       */
      const nextPhase = (it: Bouncer, now: number) => {
        const roll = Math.random();

        if (roll < 0.35) {
          it.factor = 0.2;
          it.until = now + rand(800, 1200);
        } else if (roll < 0.8) {
          it.factor = 3 + Math.floor(rand(0, 48));
          it.until = now + rand(3000, 7000);
        } else {
          it.factor = 1;
          it.until = now + rand(1200, 2600);
        }

        // Rumbo nuevo: nada de trayectorias memorizables.
        const heading = rand(0, Math.PI * 2);
        it.dx = Math.cos(heading);
        it.dy = Math.sin(heading);

        // Marometa: el giro también cambia de intensidad y de sentido.
        const spinMag = [180, 360, 720, 1080, 1440][Math.floor(rand(0, 5))];
        it.spin = spinMag * rand(0.35, 1.6) * (Math.random() < 0.5 ? -1 : 1);

        // El color cambia por fase, no por choque: a 50× los destellos por
        // rebote serían un estroboscopio.
        it.hue = Math.floor(rand(0, 360));
      };

      const paint = (it: Bouncer) => {
        it.el.style.transform =
          `translate3d(${it.x}px, ${it.y}px, 0) rotate(${it.angle}deg)`;
        it.el.style.filter =
          `hue-rotate(${it.hue}deg) drop-shadow(0 0 18px rgba(255, 226, 138, 0.22))`;
      };

      /**
       * Rebote sin túnel: pliega la posición en un vaivén triangular, así
       * funciona igual a 0.2× que a 50× (un frame puede cruzar la pantalla
       * entera varias veces sin escaparse del recuadro).
       */
      const fold = (pos: number, span: number) => {
        if (span <= 0) return { pos: 0, bounced: false };

        const period = span * 2;
        let m = pos % period;
        if (m < 0) m += period;

        const bounced = m > span;
        return { pos: bounced ? period - m : m, bounced };
      };

      const layout = (initial: boolean) => {
        const width = layer.clientWidth;
        const height = layer.clientHeight;

        for (const it of items) {
          const maxX = Math.max(0, width - it.size);
          const maxY = Math.max(0, height - it.size);

          if (initial) {
            it.x = rand(0, maxX);
            it.y = rand(0, maxY);
          } else {
            it.x = Math.min(it.x, maxX);
            it.y = Math.min(it.y, maxY);
          }

          paint(it);
        }
      };

      layout(true);

      if (!reduced) {
        let frame = 0;
        let last = 0;

        const tick = (time: number) => {
          // Delta normalizado a 60 fps, acotado para no saltar tras un tab en
          // segundo plano.
          const dt = last ? Math.min(3, (time - last) / 16.667) : 1;
          last = time;

          const width = layer.clientWidth;
          const height = layer.clientHeight;

          for (const it of items) {
            if (time >= it.until) nextPhase(it, time);

            const vx = it.dx * BASE * it.factor * dt;
            const vy = it.dy * BASE * it.factor * dt;

            const nx = fold(it.x + vx, width - it.size);
            const ny = fold(it.y + vy, height - it.size);

            it.x = nx.pos;
            it.y = ny.pos;

            if (nx.bounced) it.dx = -it.dx;
            if (ny.bounced) it.dy = -it.dy;

            it.angle = (it.angle + it.spin * ((dt * 16.667) / 1000)) % 360;

            paint(it);
          }

          frame = requestAnimationFrame(tick);
        };

        frame = requestAnimationFrame(tick);

        window.addEventListener('resize', () => layout(false), { passive: true });

        // Sin frames con la pestaña oculta (móvil: ahorro de batería).
        document.addEventListener('visibilitychange', () => {
          cancelAnimationFrame(frame);
          last = 0;
          if (!document.hidden) frame = requestAnimationFrame(tick);
        });
      }
    }
  </script>
</BaseLayout>
