---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getCopy, type Lang } from '../lib/i18n';

const lang = (Astro.locals.lang ?? 'es') as Lang;
const t = getCopy(lang);
const a = t.about;
---

<BaseLayout title={a.metaTitle} description={a.metaDescription}>
  <section class="relative py-24 lg:py-32 bg-noise overflow-hidden">
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[500px] h-[500px] rounded-full bg-oro-brillo/5 blur-[120px]"></div>
    <div class="relative max-w-3xl mx-auto px-6 text-center">
      <p class="section-label mb-6">{a.label}</p>
      <h1 class="font-titulos text-5xl lg:text-7xl text-blancoRoto mb-8 leading-[0.95]">
        {a.headline1}<br />
        <span class="text-gold-gradient">{a.headline2}</span>
      </h1>
      <div class="gold-line mx-auto mb-10"></div>
      <p class="text-lg text-white/80 leading-relaxed">
        {a.intro}
      </p>
    </div>
  </section>

  <section class="page-container pb-24 lg:pb-32">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <div class="product-frame">
        <img src="/img/camisas/camisa-dsp-2-01-frente.jpg" alt="¡D$P! V3" loading="lazy" />
      </div>
      <div class="space-y-10">
        <div>
          <p class="section-label mb-4">{a.rootsLabel}</p>
          <p class="text-white/80 leading-relaxed">
            {a.roots}
          </p>
        </div>

        {
          a.pillars.map((item, i) => (
            <div class="flex gap-6">
              <span class="font-titulos text-3xl text-oro-brillo/30 leading-none shrink-0">
                0{i + 1}
              </span>
              <div>
                <h3 class="font-acentos text-sm uppercase tracking-[0.2em] text-white mb-2">
                  {item.title}
                </h3>
                <p class="text-sm text-white/80 leading-relaxed">{item.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-y border-white/30 bg-negro-carbono">
    <div class="max-w-3xl mx-auto px-6 py-24 text-center">
      <p class="section-label mb-6">{a.philosophyLabel}</p>
      <blockquote class="font-titulos text-3xl md:text-5xl leading-tight text-blancoRoto mb-8">
        “{a.quote1}<br />
        {a.quote2} <span class="text-gold-gradient">{a.quoteAccent}</span>.”
      </blockquote>
      <div class="gold-line mx-auto mb-8"></div>
      <p class="text-white/80 leading-relaxed">
        {a.philosophy}
      </p>
    </div>
  </section>

  <section class="page-container py-20 text-center">
    <h2 class="font-titulos text-3xl lg:text-4xl text-blancoRoto mb-6">
      {a.closingTitle}
    </h2>
    <p class="text-white/80 mb-10 max-w-md mx-auto">
      {a.closingText}
    </p>
    <a href="/tienda" class="btn-gold inline-block">{a.closingCta}</a>
  </section>
</BaseLayout>
