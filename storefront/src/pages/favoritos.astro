---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCarousel from '../components/product/ProductCarousel.astro';
import { createSupabaseServerClient } from '../lib/supabase-server';
import { TENANT_ID } from '../lib/constants';
import type { WishlistItem } from '../lib/wishlist-local';
import { getCopy, type Lang } from '../lib/i18n';
import { productName } from '../lib/product-texts';

const lang = (Astro.locals.lang ?? 'es') as Lang;
const t = getCopy(lang);

const ui = {
  chooseSize: t.account.chooseSize,
  addToCart: t.product.addToCart,
  accept: t.product.accept,
  pickSize: t.product.pickSize,
  pickColor: t.product.pickColor,
  chooseQty: t.product.chooseQty,
  selectSizeError: t.product.selectSizeError,
  selectColorError: t.product.selectColorError,
  outOfStock: t.product.outOfStockSize,
  soldOut: t.product.soldOut,
  addedToCart: t.product.cartAddedTitle,
  alreadyInCart: t.product.alreadyInCart,
  otherSizeInCart: t.product.otherSizeInCart,
  cancel: t.common.cancel,
  pieceOne: t.checkout.pieceOne,
  pieceMany: t.checkout.pieceMany,
  reflective: t.product.reflective,
  notReflective: t.product.notReflective,
  remove: t.cart.remove,
};

const user = Astro.locals.user;
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);

let rows: Array<{
  product_id: string;
  product_slug: string | null;
  product_name: string | null;
  price: number | null;
  image_url: string | null;
}> = [];

if (user) {
  const { data } = await supabase
    .from('wishlist_items')
    .select('product_id, product_slug, product_name, price, image_url')
    .eq('user_id', user.id)
    .order('created_at', { ascending: false });

  rows = data ?? [];
}

const items: WishlistItem[] = rows.map((r) => ({
  productId: r.product_id,
  slug: r.product_slug,
  name: r.product_name ?? '',
  price: Number(r.price ?? 0),
  image: r.image_url,
}));

/** Datos extra para animar el reflejo en la tarjeta (no se guardan en wishlist_items). */
const reflectById = new Map<string, { isReflective: boolean; images: string[] }>();

/**
 * Una talla por producto, con la variante de más stock de esa talla.
 * Es lo que alimenta el flujo "elige talla → cantidad → carrito" sin abrir
 * la ficha ni pedir nada al servidor desde el navegador.
 */
type WishVariant = {
  id: string;
  size: string | null;
  color: string | null;
  name: string;
  price: number;
  stock: number;
};

const variantsById = new Map<string, WishVariant[]>();

// Refresca precio/nombre con el catálogo y detecta piezas fuera de venta.
const stale: string[] = [];

if (items.length > 0) {
  const { data: products } = await supabase
    .from('products')
    .select('id, name, name_en, slug, base_price, is_reflective, is_active, is_deleted, tenant_id, product_variants(id, name, size, color, price, stock, is_deleted), product_images(url, position)')
    .in('id', items.map((i) => i.productId));

  const byId = new Map((products ?? []).map((p: any) => [p.id, p]));

  for (const item of items) {
    const p: any = byId.get(item.productId);

    if (!p || p.is_deleted || !p.is_active || p.tenant_id !== TENANT_ID) {
      stale.push(item.productId);
      continue;
    }

    const images = [...(p.product_images ?? [])].sort(
      (a: any, b: any) => (a.position ?? 0) - (b.position ?? 0)
    );

    item.name = productName(p, lang);
    item.slug = p.slug ?? item.slug;
    item.price = Number(p.product_variants?.[0]?.price ?? p.base_price ?? item.price);
    item.image = images[0]?.url ?? item.image;

    reflectById.set(item.productId, {
      isReflective: Boolean(p.is_reflective),
      images: images.map((img: any) => img.url).filter(Boolean),
    });

    // Todas las variantes (talla · color): el flujo de la tarjeta pregunta
    // talla y, si la pieza tiene más de un color, también el color.
    variantsById.set(
      item.productId,
      ((p.product_variants ?? []) as any[])
        .filter((v) => !v.is_deleted)
        .map((v) => ({
          id: v.id,
          size: v.size ?? null,
          color: v.color ?? null,
          name: v.name ?? '',
          price: Number(v.price) || 0,
          stock: Number(v.stock) || 0,
        }))
    );
  }
}

// Las piezas fuera de venta solo se OCULTAN, no se borran: una página GET
// no debe tocar datos. Si el catálogo falla un instante, el favorito vuelve
// solo cuando la pieza regresa; antes se eliminaba en silencio.
const available = items.filter((i) => !stale.includes(i.productId));

/** Sugerencias: piezas activas que aún no están en favoritos. */
let suggestions: any[] = [];

{
  const excluded = new Set(available.map((i) => i.productId));

  try {
    const { data } = await supabase
      .from('products')
      .select(
        'id, name, name_en, slug, base_price, is_reflective, categories(id, name, slug), product_variants(price), product_images(url, alt_text, position)'
      )
      .eq('tenant_id', TENANT_ID)
      .eq('is_active', true)
      .eq('is_deleted', false)
      .order('created_at', { ascending: false })
      .limit(12);

    suggestions = (data ?? []).filter((p: any) => !excluded.has(p.id)).slice(0, 9);
  } catch {
    suggestions = [];
  }
}
import { localize } from '../lib/routes';
---

<BaseLayout title={t.account.wishlistMetaTitle} description={t.cart.emptyText}>
  <script type="application/json" id="wish-ui" set:html={JSON.stringify(ui)} />
  <section class="border-b-2 border-white/30 bg-noise">
    <div class="page-container py-6 sm:py-8">
      <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
        <h1 class="font-titulos text-2xl sm:text-3xl text-blancoRoto">{t.account.wishlistTitle}</h1>
        <p id="wish-summary" class="text-sm text-white/70">
          {available.length}
          {available.length === 1 ? t.checkout.pieceOne : t.checkout.pieceMany}
        </p>
      </div>
      <p class="section-label mt-1">{t.account.listLabel}</p>
    </div>
  </section>

  <div class="page-container py-10 sm:py-14">
    <div id="wish-empty" class={available.length === 0 && user ? '' : 'hidden'}>
      <div class="text-center py-16">
        <p class="font-titulos text-2xl sm:text-3xl text-blancoRoto mb-3">{t.account.wishlistEmptyTitle}</p>
        <p class="text-base text-white/80 mb-8">
          {t.account.wishlistEmptyText}
        </p>
        <a href={localize(lang, 'shop')} class="btn-gold inline-flex">{t.about.closingCta}</a>
      </div>
    </div>

    <div id="wish-loading" class={user ? 'hidden' : 'text-center py-16'}>
      <p class="text-white/80">{t.account.wishlistLoading}</p>
    </div>

    <div
      id="wish-grid"
      class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-x-3 gap-y-8 sm:gap-x-4 lg:gap-x-6"
      data-items={JSON.stringify(available)}
      data-reflect={JSON.stringify([...reflectById])}
      data-variants={JSON.stringify([...variantsById])}
    >
    </div>
  </div>

  {
    suggestions.length > 0 && (
      <ProductCarousel
        title={t.product.related}
        subtitle={t.shop.collection}
        products={suggestions}
        href={localize(lang, 'shop')}
        hrefLabel={t.shop.seeAll}
        perView={3}
      />
    )
  }

  <script>
    import '../lib/reflect-anim';
    import {
      currentWishlist,
      removeFromWishlist,
      SESSION_ENDED_EVENT,
      type WishlistItem,
    } from '../lib/wishlist';
    import { pruneLocalWishlist } from '../lib/wishlist-local';
    import { escapeHtml, safeUrl } from '../lib/html';
    import { planReflectImages } from '../lib/reflective';
    import { addToCart, getCart } from '../lib/cart';
    import { showFlashToast } from '../lib/flash-toast';
    import { nudge } from '../lib/ux';
    import { localize } from '../lib/routes';

    /** Textos resueltos en servidor. */
    const ui = JSON.parse(document.getElementById('wish-ui')?.textContent || '{}') as Record<string, string>;
    const uiText = (key: string) => ui[key] ?? '';

    const grid = document.getElementById('wish-grid') as HTMLElement;
    const empty = document.getElementById('wish-empty')!;
    const loading = document.getElementById('wish-loading')!;
    const summary = document.getElementById('wish-summary')!;
    const isAuth = document.documentElement.dataset.auth === '1';
    const pageLang = document.documentElement.dataset.lang === 'en' ? 'en' : 'es';
    const serverItems: WishlistItem[] = JSON.parse(grid.dataset.items ?? '[]');

    /** Piezas reflectivas: isReflective + galería, para animar el marco. */
    const reflectById = new Map<string, { isReflective: boolean; images: string[] }>(
      (() => {
        try {
          return JSON.parse(grid.dataset.reflect || '[]');
        } catch {
          return [];
        }
      })()
    );

    /** Texto del badge (resuelto en servidor). */
    const reflectiveLabel = uiText('reflective');

    type WishVariant = {
      id: string;
      size: string | null;
      color: string | null;
      name: string;
      price: number;
      stock: number;
    };

    /** Tallas disponibles por producto (una por talla, la de más stock). */
    const variantsById = new Map<string, WishVariant[]>(
      (() => {
        try {
          return JSON.parse(grid.dataset.variants || '[]');
        } catch {
          return [];
        }
      })()
    );

    /** Producto por id, para armar la pieza del carrito desde la tarjeta. */
    const itemsById = new Map<string, WishlistItem>();

    const money = (n: number) => `$${Number(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

    function card(item: WishlistItem) {
      const href = localize(pageLang, 'products', item.slug ?? item.productId);
      const img = safeUrl(item.image);

      const meta = reflectById.get(item.productId);
      const plan = planReflectImages(
        (meta?.images ?? []).map((url) => ({ url })),
        Boolean(meta?.isReflective)
      );
      const animated = Boolean(meta) && plan.animatable;

      const variants = variantsById.get(item.productId) ?? [];
      const inStock = variants.some((v) => v.stock > 0);

      return `
        <article data-wish-row="${escapeHtml(item.productId)}">
          <a href="${href}" class="block">
            <div
              class="product-frame border-2 border-white/25"
              ${animated ? `data-reflect data-reflect-flash="${plan.flashIndex}" data-reflect-ms="1000"` : ''}
            >
              <span class="reflect-badge${animated ? '' : ' is-plain'}" ${animated ? `data-reflect-badge data-label="${escapeHtml(reflectiveLabel)}"` : ''}><span class="reflect-badge-label">${escapeHtml(animated ? reflectiveLabel : uiText('notReflective'))}</span><span class="reflect-badge-dot"></span></span>
              ${img ? `<img src="${img}" alt="" loading="lazy">` : ''}
            </div>
            <div class="pt-4 flex items-start justify-between gap-3">
              <h3 class="font-acentos text-base text-blancoRoto leading-snug">${escapeHtml(item.name)}</h3>
              <p class="font-acentos text-base text-oro-brillo whitespace-nowrap">${money(item.price)}</p>
            </div>
          </a>

          <div class="mt-3" data-wish-actions>
            <div class="flex gap-2" data-wish-idle>
              <button type="button" data-wish-add
                class="btn-gold !min-h-[44px] !px-4 !py-2 !text-xs flex-1"
                ${inStock ? '' : 'disabled aria-disabled="true"'}>
                ${escapeHtml(inStock ? uiText('addToCart') : uiText('soldOut'))}
              </button>
              <button type="button" data-wish-remove="${escapeHtml(item.productId)}"
                class="min-h-[44px] px-3 border-2 border-white/40 text-xs uppercase tracking-wider text-white/80 hover:border-red-400 hover:text-red-400">
                ${uiText('remove')}
              </button>
            </div>

            <div class="hidden" data-wish-flow>
              <p class="text-[11px] uppercase tracking-[0.15em] text-white/60" data-flow-label></p>
              <div class="flex flex-wrap gap-2 mt-2" data-flow-sizes></div>
              <div class="hidden flex-wrap gap-2 mt-2" data-flow-colors></div>
              <div class="hidden items-center gap-2 mt-3" data-flow-qty>
                <button type="button" data-qty="-1" aria-label="−"
                  class="w-9 h-9 border-2 border-white/40 text-lg leading-none text-white/80 hover:border-oro-brillo hover:text-oro-brillo">−</button>
                <span data-qty-value class="min-w-[2ch] text-center font-acentos text-lg text-blancoRoto">1</span>
                <button type="button" data-qty="1" aria-label="+"
                  class="w-9 h-9 border-2 border-white/40 text-lg leading-none text-white/80 hover:border-oro-brillo hover:text-oro-brillo">+</button>
              </div>
              <p class="hidden text-xs text-red-400 mt-2" data-flow-msg role="alert"></p>
              <div class="flex gap-2 mt-3">
                <button type="button" data-flow-accept
                  class="btn-gold !min-h-[44px] !px-4 !py-2 !text-xs flex-1"></button>
                <button type="button" data-flow-cancel
                  class="min-h-[44px] px-3 border-2 border-white/40 text-xs uppercase tracking-wider text-white/80 hover:border-white/80">
                  ${uiText('cancel')}
                </button>
              </div>
            </div>
          </div>
        </article>`;
    }

    /**
     * Flujo de una tarjeta: "Add to cart" → talla → cantidad → carrito.
     * Cada paso valida el anterior: no hay cantidad sin talla con stock.
     */
    function bindCard(row: HTMLElement, item: WishlistItem) {
      const idle = row.querySelector<HTMLElement>('[data-wish-idle]');
      const flow = row.querySelector<HTMLElement>('[data-wish-flow]');
      const label = row.querySelector<HTMLElement>('[data-flow-label]');
      const sizesBox = row.querySelector<HTMLElement>('[data-flow-sizes]');
      const colorsBox = row.querySelector<HTMLElement>('[data-flow-colors]');
      const qtyBox = row.querySelector<HTMLElement>('[data-flow-qty]');
      const qtyValue = row.querySelector<HTMLElement>('[data-qty-value]');
      const msg = row.querySelector<HTMLElement>('[data-flow-msg]');
      const accept = row.querySelector<HTMLButtonElement>('[data-flow-accept]');
      const cancel = row.querySelector<HTMLButtonElement>('[data-flow-cancel]');
      const addBtn = row.querySelector<HTMLButtonElement>('[data-wish-add]');

      if (!idle || !flow || !label || !sizesBox || !colorsBox || !qtyBox || !qtyValue || !msg) return;
      if (!accept || !cancel || !addBtn) return;

      const allVariants = variantsById.get(item.productId) ?? [];
      const sizeKey = (v: WishVariant) => v.size || v.name || '—';
      const colorKey = (v: WishVariant) => v.color || v.name || '—';
      const sizes = [...new Set(allVariants.map(sizeKey))];

      const variantsOfSize = (size: string) => allVariants.filter((v) => sizeKey(v) === size);
      const stockOfSize = (size: string) =>
        variantsOfSize(size).reduce((n, v) => n + Math.max(0, v.stock), 0);

      let step: 'idle' | 'size' | 'color' | 'qty' = 'idle';
      let selectedSize: string | null = null;
      let selected: WishVariant | null = null;
      let qty = 1;

      const maxQty = () => Math.max(1, Math.min(5, selected?.stock || 1));

      const chipClass = (active: boolean, out: boolean) =>
        `min-h-[36px] px-3 border-2 text-xs uppercase tracking-wider ${
          out
            ? 'border-white/15 text-white/30 line-through cursor-not-allowed'
            : active
              ? 'border-oro-brillo text-oro-brillo'
              : 'border-white/40 text-white/80 hover:border-white/80'
        }`;

      const setMsg = (text: string) => {
        msg.textContent = text;
        msg.classList.toggle('hidden', !text);
      };

      const paintQty = () => {
        qtyValue.textContent = String(qty);
      };

      const hideQty = () => {
        qtyBox.classList.add('hidden');
        qtyBox.classList.remove('flex');
      };

      const hideColors = () => {
        colorsBox.classList.add('hidden');
        colorsBox.classList.remove('flex');
        colorsBox.innerHTML = '';
      };

      const goQty = () => {
        step = 'qty';
        qty = 1;
        paintQty();
        label.textContent = uiText('chooseQty');
        qtyBox.classList.remove('hidden');
        qtyBox.classList.add('flex');
        accept.textContent = uiText('addToCart');
        setMsg('');
      };

      const reset = () => {
        step = 'idle';
        selectedSize = null;
        selected = null;
        qty = 1;
        idle.classList.remove('hidden');
        flow.classList.add('hidden');
        hideQty();
        hideColors();
        setMsg('');
      };

      const renderSizes = () => {
        sizesBox.innerHTML = sizes
          .map((size) => {
            const out = stockOfSize(size) <= 0;
            const active = selectedSize === size;
            return `<button type="button" data-size="${escapeHtml(size)}" ${out ? 'disabled' : ''}
              class="${chipClass(active, out)}">${escapeHtml(size)}</button>`;
          })
          .join('');

        sizesBox.querySelectorAll<HTMLButtonElement>('[data-size]').forEach((b) =>
          b.addEventListener('click', () => {
            const size = b.dataset.size ?? '';
            if (stockOfSize(size) <= 0) return;

            selectedSize = size;
            selected = null;
            qty = 1;
            paintQty();
            setMsg('');
            hideQty();

            // Cambiar de talla reinicia el paso: el color depende de ella.
            if (step === 'qty' || step === 'color') {
              step = 'size';
              label.textContent = uiText('pickSize');
              accept.textContent = uiText('accept');
            }

            renderSizes();
            hideColors();
          })
        );
      };

      const renderColors = () => {
        const opts = selectedSize ? variantsOfSize(selectedSize) : [];

        if (opts.length <= 1) {
          hideColors();
          return;
        }

        colorsBox.classList.remove('hidden');
        colorsBox.classList.add('flex');
        colorsBox.innerHTML = opts
          .map((v) => {
            const out = v.stock <= 0;
            const active = selected?.id === v.id;
            return `<button type="button" data-color="${escapeHtml(v.id)}" ${out ? 'disabled' : ''}
              class="${chipClass(active, out)}">${escapeHtml(colorKey(v))}</button>`;
          })
          .join('');

        colorsBox.querySelectorAll<HTMLButtonElement>('[data-color]').forEach((b) =>
          b.addEventListener('click', () => {
            const v = opts.find((o) => o.id === b.dataset.color);
            if (!v || v.stock <= 0) return;
            selected = v;
            qty = 1;
            paintQty();
            setMsg('');
            renderColors();
          })
        );
      };

      const add = () => {
        if (!selected) return;

        const cart = getCart();
        const sameProduct = cart.filter((c) => c.productId === item.productId);
        const sameVariant = sameProduct.some((c) => c.variantId === selected!.id);

        addToCart({
          variantId: selected.id,
          productId: item.productId,
          slug: item.slug ?? null,
          name: item.name,
          variantName:
            [selected.size, selected.color].filter(Boolean).join(' · ') || selected.name,
          price: selected.price || item.price,
          qty,
          image: item.image ?? undefined,
          size: selected.size,
          color: selected.color,
        });

        // Aviso honesto: no se pisa nada del carrito, solo se informa.
        if (sameVariant) {
          showFlashToast(uiText('alreadyInCart'), { detail: item.name, tone: 'cart' });
        } else if (sameProduct.length > 0) {
          showFlashToast(uiText('otherSizeInCart'), { detail: item.name, tone: 'cart' });
        } else {
          showFlashToast(uiText('addedToCart'), { detail: item.name, tone: 'cart' });
        }

        reset();
      };

      addBtn.addEventListener('click', () => {
        if (!allVariants.some((v) => v.stock > 0)) return;

        step = 'size';
        selectedSize = null;
        selected = null;
        qty = 1;
        paintQty();
        idle.classList.add('hidden');
        flow.classList.remove('hidden');
        label.textContent = uiText('pickSize');
        hideQty();
        hideColors();
        accept.textContent = uiText('accept');
        setMsg('');
        renderSizes();
      });

      cancel.addEventListener('click', reset);

      accept.addEventListener('click', () => {
        // Paso 1: talla.
        if (step === 'size') {
          if (!selectedSize || stockOfSize(selectedSize) <= 0) {
            setMsg(uiText('selectSizeError'));
            nudge(sizesBox);
            return;
          }

          const opts = variantsOfSize(selectedSize).filter((v) => v.stock > 0);

          // Paso 2 (solo si aplica): color.
          if (opts.length > 1) {
            step = 'color';
            selected = null;
            label.textContent = uiText('pickColor');
            renderColors();
            setMsg('');
            return;
          }

          selected = opts[0] ?? null;
          if (!selected) {
            setMsg(uiText('outOfStock'));
            return;
          }

          goQty();
          return;
        }

        if (step === 'color') {
          if (!selected || selected.stock <= 0) {
            setMsg(uiText('selectColorError'));
            nudge(colorsBox);
            return;
          }
          goQty();
          return;
        }

        // Paso final: el segundo "Aceptar" ya agrega al carrito.
        if (step === 'qty') add();
      });

      qtyBox.querySelectorAll<HTMLButtonElement>('[data-qty]').forEach((b) =>
        b.addEventListener('click', () => {
          const dir = Number(b.dataset.qty ?? 0);
          qty = Math.min(maxQty(), Math.max(1, qty + dir));
          paintQty();
        })
      );
    }

    function render(items: WishlistItem[]) {
      loading.classList.add('hidden');
      summary.textContent = `${items.length} ${items.length === 1 ? uiText('pieceOne') : uiText('pieceMany')}`;

      if (items.length === 0) {
        empty.classList.remove('hidden');
        grid.innerHTML = '';
        return;
      }

      empty.classList.add('hidden');

      itemsById.clear();
      items.forEach((i) => itemsById.set(i.productId, i));

      grid.innerHTML = items.map(card).join('');

      // El controlador del reflejo se registra al cargar la página: avisarle
      // de las tarjetas repintadas para que también se animen.
      document.dispatchEvent(new CustomEvent('reflect:refresh'));

      grid.querySelectorAll<HTMLElement>('[data-wish-row]').forEach((row) => {
        const item = itemsById.get(row.dataset.wishRow ?? '');

        row.querySelector<HTMLButtonElement>('[data-wish-remove]')?.addEventListener('click', async (e) => {
          const b = e.currentTarget as HTMLButtonElement;
          b.disabled = true;
          const name = row.querySelector('h3')?.textContent?.trim() ?? '';
          // El aviso centrado lo emite `StoreDrawer` desde `wishlist:removed`.
          await removeFromWishlist(row.dataset.wishRow!, name);
        });

        if (item) bindCard(row, item);
      });
    }

    window.addEventListener('wishlist:updated', (e) => {
      render((e as CustomEvent<WishlistItem[]>).detail ?? []);
    });

    // Al volver a esta pestaña o al recuperar el foco, se relee la fuente
    // real (servidor o navegador): así un cambio hecho en otra página
    // (/tienda, ficha, otro tab) se refleja sin recargar.
    async function syncWishlist() {
      try {
        const items = await currentWishlist(isAuth);
        render(items);
      } catch {
        /* si falla, se queda lo que ya estaba pintado */
      }
    }

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') syncWishlist();
    });
    window.addEventListener('focus', syncWishlist);
    window.addEventListener(SESSION_ENDED_EVENT, syncWishlist);

    if (isAuth) {
      render(serverItems);
    } else {
      // Visitante: la MISMA fuente que el resto del sitio (localStorage vía
      // `wishlist.ts`), no una lectura suelta del navegador.
      const items = await currentWishlist(false);
      if (items.length === 0) {
        render([]);
      } else {
        // Descarta piezas que ya no existen en el catálogo.
        fetch('/api/wishlist?ids=1')
          .then((r) => r.json())
          .then((json) => render(Array.isArray(json?.ids) ? pruneLocalWishlist(json.ids) : items))
          .catch(() => render(items));
      }
    }
  </script>
</BaseLayout>
