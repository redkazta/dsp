---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getCopy, type Lang } from '../lib/i18n';

const lang = (Astro.locals.lang ?? 'es') as Lang;
const t = getCopy(lang);
const page = t.legal.returns;
import { localize } from '../lib/routes';
---

<BaseLayout
  title={t.content.returnsMetaTitle}
  description={t.content.returnsMetaDescription}
>
  <article class="max-w-3xl mx-auto px-6 py-16 lg:py-24">
    <p class="section-label mb-4">{t.legal.help}</p>
    <h1 class="font-titulos text-4xl lg:text-5xl text-blancoRoto mb-4">{page.title}</h1>
    <div class="gold-line mb-12"></div>

    <div class="space-y-10 text-base text-white/80 leading-relaxed">
      {
        page.sections.map((section) => (
          <section>
            <h2 class="font-acentos text-[11px] uppercase tracking-[0.25em] text-oro-brillo mb-4">
              {section.title}
            </h2>

            {section.p?.map((text) => <p class="mb-3 last:mb-0">{text}</p>)}

            {section.items && (
              <ul class="space-y-2 list-disc pl-5">
                {section.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
    </div>

    <div class="mt-14 flex flex-wrap gap-3">
      <a href={localize(lang, 'contact')} class="btn-gold">{t.legal.linkContact}</a>
      <a href={localize(lang, 'shop')} class="btn-outline">{t.legal.viewCatalog}</a>
    </div>
  </article>
</BaseLayout>
