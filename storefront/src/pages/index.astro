---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCarousel from '../components/product/ProductCarousel.astro';
import { getProducts, TENANT_SLUG } from '../lib/supabase';

const CAT_CAMISAS = 'c0000001-0000-4000-8000-000000000001';
const CAT_JEANS = 'c0000001-0000-4000-8000-000000000002';

let camisas: any[] = [];
let jeans: any[] = [];

try {
  const [camisasRes, jeansRes] = await Promise.all([
    getProducts(TENANT_SLUG, { page: 1, limit: 12, categoryId: CAT_CAMISAS, sort: 'name-asc' }),
    getProducts(TENANT_SLUG, { page: 1, limit: 12, categoryId: CAT_JEANS, sort: 'name-asc' }),
  ]);

  camisas = camisasRes.data ?? [];
  jeans = jeansRes.data ?? [];
} catch {
  camisas = [];
  jeans = [];
}
---

<BaseLayout>
  <!-- ============ HERO ============ -->
  <section class="relative min-h-[92vh] flex items-center overflow-hidden bg-noise">
    <div class="absolute inset-0">
      <img
        src="/img/DSP_3.jpg"
        alt=""
        class="w-full h-full object-cover opacity-20 grayscale"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-negro-profundo/70 via-negro-profundo/90 to-negro-profundo"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-negro-profundo via-negro-profundo/50 to-transparent"></div>
    </div>

    <!-- Cinta de producto en el hero -->
    <div class="absolute right-0 top-1/2 -translate-y-1/2 hidden xl:flex flex-col gap-3 pr-10 z-10">
      {
        [
          { src: '/img/DSP_2.jpg', label: 'Aurora', slug: 'camisa-dsp-v3-aurora' },
          { src: '/img/DSP_3.jpg', label: 'Silver', slug: 'camisa-dsp-v3-silver' },
          { src: '/img/DSP_5.jpg', label: 'Violet', slug: 'camisa-dsp-v3-violet' },
          { src: '/img/DSP_6.jpg', label: 'Crimson', slug: 'camisa-dsp-v3-crimson' },
        ].map((p) => (
          <a
            href={`/producto/${p.slug}`}
            class="group relative block w-24 h-24 product-frame border-2 border-white/30 hover:border-oro-brillo transition-colors duration-300"
          >
            <img src={p.src} alt={p.label} loading="lazy" />
            <span class="absolute inset-x-0 bottom-0 bg-negro-profundo text-center py-1 font-acentos text-[10px] uppercase tracking-[0.2em] text-blancoRoto opacity-0 transition-opacity reels-label">
              {p.label}
            </span>
          </a>
        ))
      }
    </div>

    <div class="absolute top-1/3 left-1/3 w-[420px] sm:w-[600px] h-[420px] sm:h-[600px] rounded-full bg-oro-brillo/10 blur-[130px] pointer-events-none"></div>

    <div class="relative z-10 page-container w-full">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-3 mb-8 animate-fade-in" style="animation-delay: 0.1s">
          <span class="w-2 h-2 rounded-full bg-oro-brillo animate-pulse"></span>
          <span class="section-label">Drop Reflective · Disponible ahora</span>
        </div>

        <h1
          class="font-titulos text-5xl sm:text-7xl md:text-8xl lg:text-[7rem] leading-[0.9] text-blancoRoto mb-6 sm:mb-8 animate-fade-up"
          style="animation-delay: 0.2s"
        >
          Del suelo<br />
          al cielo,<br />
          <em class="text-gold-gradient not-italic font-normal">sin miedo</em>
        </h1>

        <p
          class="text-base md:text-lg text-white/80 max-w-lg leading-relaxed mb-10 sm:mb-12 animate-fade-up"
          style="animation-delay: 0.4s"
        >
          Streetwear artesanal prensado a mano, una pieza a la vez.
          Diseño callejero con raíces mexicanas. No seguimos modas, las creamos.
        </p>

        <div class="flex flex-col sm:flex-row flex-wrap gap-3 sm:gap-4 animate-fade-up" style="animation-delay: 0.6s">
          <a href="/tienda" class="btn-gold">Comprar el drop</a>
          <a href="/nosotros" class="btn-outline">Nuestra historia</a>
        </div>

        <div class="flex flex-wrap items-center gap-4 sm:gap-6 mt-10 sm:mt-14 animate-fade-up" style="animation-delay: 0.8s">
          {
            [
              { value: '4.9★', label: 'Valoración' },
              { value: '+500', label: 'Clientes felices' },
              { value: '24-48h', label: 'Envío express' },
            ].map((stat) => (
              <div class="border-2 border-white/25 px-4 sm:px-5 py-3 min-w-[110px] bg-negro-carbono/60">
                <p class="font-acentos text-xl sm:text-2xl text-oro-brillo leading-none">{stat.value}</p>
                <p class="mt-1.5 text-xs text-white/80 uppercase tracking-[0.14em]">{stat.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CARRUSELES POR CATEGORÍA ============ -->
  <div class="bg-negro-carbono border-y-2 border-white/25 py-6">
    <ProductCarousel
      title="Camisas"
      subtitle="Reflective V3 · 7 acabados"
      products={camisas}
      href="/tienda?category=camisas"
      hrefLabel="Ver camisas"
    />

    <div class="page-container">
      <div class="gold-line mx-0"></div>
    </div>

    <ProductCarousel
      title="Jeans"
      subtitle="Jeep! Jeans · reflectivo"
      products={jeans}
      href="/tienda?category=jeans"
      hrefLabel="Ver jeans"
    />
  </div>

  <!-- ============ MARCA ============ -->
  <section class="relative py-20 sm:py-28 lg:py-40 overflow-hidden">
    <div class="absolute inset-0 bg-noise"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[320px] sm:w-[500px] h-[320px] sm:h-[500px] rounded-full bg-oro-brillo/5 blur-[100px]"></div>

    <div class="relative max-w-3xl mx-auto px-5 sm:px-6 text-center">
      <p class="section-label mb-6">Streetwear artesanal</p>
      <blockquote class="font-titulos text-3xl sm:text-4xl md:text-5xl leading-tight text-blancoRoto mb-8">
        "Que el silencio también<br />
        hace <span class="text-gold-gradient">ruido</span>."
      </blockquote>
      <div class="gold-line mx-auto mb-8"></div>
      <p class="text-base sm:text-lg text-white/80 leading-relaxed max-w-xl mx-auto">
        Diseñamos prendas con atención al detalle, prensadas a mano una por una.
        Cada pieza refleja el balance entre estilo callejero y calidad artesanal —
        hecha para quienes valoran la autenticidad por encima de las tendencias.
      </p>

      <div class="grid gap-4 sm:gap-6 sm:grid-cols-3 mt-12 sm:mt-14">
        {
          [
            { t: 'Prensado a mano', d: 'Una pieza a la vez. Nada de producción en masa.' },
            { t: 'Raíces mexicanas', d: 'Diseño inspirado en la cultura urbana de México.' },
            { t: 'Ediciones limitadas', d: 'Cuando se agota, no vuelve igual.' },
          ].map((item) => (
            <div class="border-2 border-white/25 p-6 text-left">
              <h3 class="font-acentos text-xs uppercase tracking-[0.2em] text-oro-brillo mb-2 font-bold">
                {item.t}
              </h3>
              <p class="text-sm text-white/80 leading-relaxed">{item.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ NEWSLETTER CTA ============ -->
  <section class="bg-negro-carbono border-t-2 border-white/25">
    <div class="page-container py-16 sm:py-24">
      <div class="relative border-2 border-oro-brillo/40 p-6 sm:p-10 lg:p-14 overflow-hidden glow-gold">
        <div class="absolute top-0 right-0 w-64 h-64 bg-oro-brillo/10 blur-[80px] rounded-full"></div>
        <div class="relative grid gap-8 lg:grid-cols-2 lg:items-center">
          <div>
            <h2 class="font-titulos text-2xl sm:text-3xl md:text-4xl text-blancoRoto mb-4">
              Únete a<br />
              <span class="text-oro-brillo">nuestra familia</span>
            </h2>
            <p class="text-base text-white/80 leading-relaxed">
              Entérate de cada drop antes que nadie. Sin spam,
              solo lanzamientos que valen la pena.
            </p>
          </div>
          <form class="flex flex-col sm:flex-row gap-3 lg:justify-end">
            <input type="email" placeholder="tu@email.com" class="input-dark sm:max-w-xs" required />
            <button type="submit" class="btn-gold shrink-0">Unirme</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .reels-label {
    transition: opacity 0.25s ease;
  }

  a:hover > .reels-label {
    opacity: 1;
  }
</style>
