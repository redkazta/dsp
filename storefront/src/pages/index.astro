---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCarousel from '../components/product/ProductCarousel.astro';
import { getProducts, TENANT_SLUG } from '../lib/supabase';

const CAT_CAMISAS = 'c0000001-0000-4000-8000-000000000001';
const CAT_JEANS = 'c0000001-0000-4000-8000-000000000002';

let camisas: any[] = [];
let jeans: any[] = [];

try {
  const [camisasRes, jeansRes] = await Promise.all([
    getProducts(TENANT_SLUG, { page: 1, limit: 8, categoryId: CAT_CAMISAS, sort: 'newest' }),
    getProducts(TENANT_SLUG, { page: 1, limit: 8, categoryId: CAT_JEANS, sort: 'newest' }),
  ]);
  camisas = camisasRes.data ?? [];
  jeans = jeansRes.data ?? [];
} catch {
  camisas = [];
  jeans = [];
}
---

<BaseLayout>
  <!-- HERO DIRECTO: producto primero -->
  <section class="relative min-h-[85vh] flex items-center overflow-hidden bg-negro-profundo">
    <div class="absolute inset-0">
      <img src="/img/camisas/camisa-dsp-2-01-frente.jpg" alt="" class="w-full h-full object-cover opacity-30 grayscale" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-r from-negro-profundo via-negro-profundo/60 to-transparent"></div>
    </div>

    <div class="relative z-10 page-container w-full py-16">
      <div class="max-w-2xl">
        <a href="/tienda" class="btn-gold inline-flex mb-6">Ver drop</a>
        <h1 class="font-titulos text-6xl sm:text-8xl lg:text-9xl leading-[0.85] text-blancoRoto mb-4 tracking-tighter">
          D$P!
        </h1>
        <p class="text-xl sm:text-2xl text-oro-brillo font-acentos tracking-[0.3em] uppercase mb-8">Reflective V3</p>
        <div class="flex gap-4">
          <a href="/tienda?category=camisas" class="btn-outline">Camisas</a>
          <a href="/tienda?category=jeans" class="btn-outline">Jeans</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CARRUSELES DIRECTOS -->
  <div class="bg-negro-carbono border-y-2 border-white/25 py-6">
    <ProductCarousel title="Camisas" subtitle="Reflective V3" products={camisas} href="/tienda?category=camisas" hrefLabel="Ver todo" />
    <div class="page-container"><div class="gold-line mx-0"></div></div>
    <ProductCarousel title="Jeans" subtitle="Jeep! Reflectivo" products={jeans} href="/tienda?category=jeans" hrefLabel="Ver todo" />
  </div>

  <!-- CTA SIMPLE -->
  <section class="bg-negro-profundo py-16 sm:py-24 text-center">
    <h2 class="font-titulos text-4xl sm:text-6xl text-blancoRoto mb-4">Sin miedo</h2>
    <a href="/tienda" class="btn-gold inline-flex">Comprar ahora</a>
  </section>
</BaseLayout>
