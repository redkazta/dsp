---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCarousel from '../components/hero/HeroCarousel.astro';
import { getHomeSlides } from '../lib/home-products';
import { getCopy, type Lang } from '../lib/i18n';

const lang = (Astro.locals.lang ?? 'es') as Lang;
const t = getCopy(lang);

// Playera, jean, playera, jean…: el intercalado se hace en servidor.
const slides = await getHomeSlides({ perCategory: 8, max: 12, lang });
---

<BaseLayout homeScreen>
  <!--
    HOME A PANTALLA COMPLETA (sin scroll).
    El carrusel ocupa el alto sobrante del viewport y cada pieza enlaza a su
    detalle. El botón queda al pie.
  -->
  <div class="home-screen">
    <section class="hero-section relative overflow-hidden bg-negro-profundo">
      <HeroCarousel slides={slides} t={t} currency="USD" />

      <div class="hero-actions">
        <a href="/tienda" class="btn-drop">{t.hero.cta}</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Alto exacto de una pantalla: 100dvh descuenta la barra del navegador en
     móvil. Restamos la barra de anuncios (2.25rem) y el header (5rem / 6rem +
     borde de 2px). */
  .home-screen {
    height: calc(100dvh - 2.25rem - 5rem - 2px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .home-screen {
      height: calc(100dvh - 2.25rem - 6rem - 2px);
    }
  }

  .hero-section {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
  }

  /* Botón pegada al borde inferior del hero. El carrusel reserva ese espacio
     abajo (padding del slide) para que el botón no tape el nombre ni el precio. */
  .hero-actions {
    position: absolute;
    left: 50%;
    bottom: 0;
    z-index: 20;
    transform: translateX(-50%);
    padding: 0 1rem 0.6rem;
  }

  .btn-drop {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0.75rem 2.5rem;
    background: #ffe28a;
    color: #000000;
    font-family: 'Space Grotesk', Inter, sans-serif;
    font-weight: 600;
    font-size: 0.8125rem;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    border-radius: 0.375rem;
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-drop:hover {
    background: #ffed9f;
    transform: translateY(-2px);
    box-shadow: 0 10px 25px -5px rgba(255, 226, 138, 0.45);
  }

  @media (max-width: 640px) {
    .btn-drop {
      min-height: 42px;
      padding: 0.65rem 2rem;
    }
    .hero-actions {
      padding-bottom: 0.5rem;
    }
  }
</style>
