---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCarousel from '../components/hero/HeroCarousel.astro';
import { getProducts, TENANT_SLUG } from '../lib/supabase';

const CAT_CAMISAS = 'c0000001-0000-4000-8000-000000000001';

let camisas: any[] = [];

try {
  const res = await getProducts(TENANT_SLUG, { page: 1, limit: 8, categoryId: CAT_CAMISAS, sort: 'newest' });
  camisas = res.data ?? [];
} catch {
  camisas = [];
}

const camisasImages = camisas.flatMap(
  (p: any) => (p.product_images ?? []).map((img: any) => img.url)
);
---

<BaseLayout>
  <section class="relative min-h-[95vh] flex items-center overflow-hidden bg-negro-profundo">
    <HeroCarousel images={camisasImages} />

    <div class="relative z-10 page-container w-full flex flex-col items-center justify-center h-full py-16">
      <a href="/tienda" class="btn-gold inline-flex mb-6">Ver drop</a>
      <img src="/img/logo/DSP.jpg" alt="¡D$P!" class="logo-animated w-32 h-32 lg:w-48 lg:h-48 object-contain mb-6" />
    </div>
  </section>
</BaseLayout>