---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCarousel from '../components/hero/HeroCarousel.astro';
import { getProducts, TENANT_SLUG } from '../lib/supabase';

const CAT_CAMISAS = 'c0000001-0000-4000-8000-000000000001';

let camisas: any[] = [];

try {
  const res = await getProducts(TENANT_SLUG, { page: 1, limit: 8, categoryId: CAT_CAMISAS, sort: 'newest' });
  camisas = res.data ?? [];
} catch {
  camisas = [];
}

// Un slide por pieza (su foto principal): el carrusel se ve variado en vez de
// repetir la misma playera en varias tomas.
const camisasImages = camisas
  .map((p: any) => {
    const images = [...(p.product_images ?? [])].sort(
      (a: any, b: any) => (a.position ?? 0) - (b.position ?? 0)
    );
    return images[0]?.url;
  })
  .filter(Boolean) as string[];
---

<BaseLayout>
  <!--
    HERO: el carrusel de fondo con el boton pegado al borde inferior.
    Alto: 88vh en movil / 94vh en desktop, para que "Ver drop" se vea sin
    desplazarse (es la primera impresion al entrar).
  -->
  <section class="hero-section relative h-[88vh] lg:h-[94vh] overflow-hidden bg-negro-profundo">
    <HeroCarousel images={camisasImages} />

    <div class="absolute inset-x-0 bottom-0 z-10 flex justify-center pb-5 sm:pb-7">
      <a href="/tienda" class="btn-drop">Ver drop</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Botón apaisado y a nivel del borde inferior: menos alto que el btn-gold
     genérico para que no "flote" sobre la última foto. */
  .btn-drop {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.7rem 2.5rem;
    background: #ffe28a;
    color: #000000;
    font-family: 'Space Grotesk', Inter, sans-serif;
    font-weight: 600;
    font-size: 0.8125rem;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    border-radius: 0.375rem;
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-drop:hover {
    background: #ffed9f;
    transform: translateY(-2px);
    box-shadow: 0 10px 25px -5px rgba(255, 226, 138, 0.45);
  }

  @media (max-width: 640px) {
    .btn-drop {
      min-height: 42px;
      padding: 0.65rem 2rem;
    }
  }

  /* Pantallas bajas (laptops 13", iPhone apaisado): el hero no debe empujar
     el boton fuera de vista. */
  @media (max-height: 700px) {
    .hero-section {
      height: 80vh;
    }
  }
</style>
