---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCarousel from '../components/hero/HeroCarousel.astro';
import { getProducts, TENANT_SLUG } from '../lib/supabase';
import { getCopy, type Lang } from '../lib/i18n';

const lang = (Astro.locals.lang ?? 'es') as Lang;
const t = getCopy(lang);

const CAT_CAMISAS = 'c0000001-0000-4000-8000-000000000001';

let camisas: any[] = [];

try {
  const res = await getProducts(TENANT_SLUG, { page: 1, limit: 8, categoryId: CAT_CAMISAS, sort: 'newest' });
  camisas = res.data ?? [];
} catch {
  camisas = [];
}

// Una foto por pieza, y sin repetir URL: el carrusel se ve variado y no
// parece que "se atora" en la misma playera.
const camisasImages = [
  ...new Set<string>(
    camisas
      .map((p: any) => {
        const images = [...(p.product_images ?? [])].sort(
          (a: any, b: any) => (a.position ?? 0) - (b.position ?? 0)
        );
        return images[0]?.url as string | undefined;
      })
      .filter((url): url is string => Boolean(url))
  ),
];
---

<BaseLayout homeScreen>
  <!--
    HOME A PANTALLA COMPLETA (sin scroll).
    La página mide exactamente el viewport: el hero toma el alto sobrante
    (100dvh − barra de anuncios − header) y el botón queda al pie.
  -->
  <div class="home-screen">
    <section class="hero-section relative overflow-hidden bg-negro-profundo">
      <HeroCarousel images={camisasImages} />

      <div class="hero-actions">
        <a href="/tienda" class="btn-drop">{t.hero.cta}</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Alto exacto de una pantalla: 100dvh descuenta la barra del navegador en
     móvil. Restamos la barra de anuncios (2.25rem) y el header (5rem / 6rem +
     borde de 2px). */
  .home-screen {
    height: calc(100dvh - 2.25rem - 5rem - 2px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .home-screen {
      height: calc(100dvh - 2.25rem - 6rem - 2px);
    }
  }

  .hero-section {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
  }

  /* Botón pegado al borde inferior del hero */
  .hero-actions {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 10;
    display: flex;
    justify-content: center;
    padding: 0 1rem 1.5rem;
  }

  .btn-drop {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0.75rem 2.5rem;
    background: #ffe28a;
    color: #000000;
    font-family: 'Space Grotesk', Inter, sans-serif;
    font-weight: 600;
    font-size: 0.8125rem;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    border-radius: 0.375rem;
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-drop:hover {
    background: #ffed9f;
    transform: translateY(-2px);
    box-shadow: 0 10px 25px -5px rgba(255, 226, 138, 0.45);
  }

  @media (max-width: 640px) {
    .btn-drop {
      min-height: 44px;
      padding: 0.7rem 2rem;
    }
    .hero-actions {
      padding-bottom: 1.25rem;
    }
  }
</style>
