---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCarousel from '../components/hero/HeroCarousel.astro';
import { getProducts, TENANT_SLUG } from '../lib/supabase';

const CAT_CAMISAS = 'c0000001-0000-4000-8000-000000000001';

let camisas: any[] = [];

try {
  const res = await getProducts(TENANT_SLUG, { page: 1, limit: 8, categoryId: CAT_CAMISAS, sort: 'newest' });
  camisas = res.data ?? [];
} catch {
  camisas = [];
}

const camisasImages = camisas.flatMap(
  (p: any) => (p.product_images ?? []).map((img: any) => img.url)
);
---

<BaseLayout>
  <!-- HERO: solo el carrusel de fondo (define el alto), el logo centrado y "Ver drop" abajo -->
  <section class="relative h-[85vh] lg:h-[90vh] overflow-hidden bg-negro-profundo">
    <HeroCarousel images={camisasImages} />

    <div class="absolute inset-0 z-10 flex flex-col items-center justify-center px-5 pb-16">
      <img src="/img/logo/DSP.jpg" alt="¡D$P!" class="logo-animated w-32 h-32 lg:w-48 lg:h-48 object-contain" />
    </div>

    <div class="absolute inset-x-0 bottom-0 z-10 pb-8 sm:pb-10 flex justify-center">
      <a href="/tienda" class="btn-gold inline-flex">Ver drop</a>
    </div>
  </section>
</BaseLayout>
