---
export const prerender = false;

import { Resend } from 'resend';

export async function POST({ request }: { request: Request }) {
  const apiKey = import.meta.env.RESSEND_API_KEY;

  if (!apiKey) {
    return new Response(
      JSON.stringify({ error: 'RESSEND_API_KEY no configurada' }),
      { status: 500, headers: { 'Content-Type': 'application/json' } }
    );
  }

  const resend = new Resend(apiKey);
  const fromEmail = import.meta.env.RESSEND_FROM_EMAIL || 'no-reply@dinerosobreproblemas.com';

  try {
    const body = await request.json();
    const { to, subject, html, text, fromName } = body;

    if (!to || !subject) {
      return new Response(
        JSON.stringify({ error: 'Faltan campos obligatorios: to, subject' }),
        { status: 400, headers: { 'Content-Type': 'application/json' } }
      );
    }

    const result = await resend.emails.send({
      from: fromName ? `${fromName} <${fromEmail}>` : fromEmail,
      to: Array.isArray(to) ? to : [to],
      subject: String(subject),
      html: html ? String(html) : undefined,
      text: text ? String(text) : undefined,
    });

    return new Response(
      JSON.stringify({ success: true, id: result.data?.id }),
      { status: 200, headers: { 'Content-Type': 'application/json' } }
    );
  } catch (error: any) {
    console.error('[api/send-email]', error);
    return new Response(
      JSON.stringify({ error: error.message || 'Error al enviar email' }),
      { status: 500, headers: { 'Content-Type': 'application/json' } }
    );
  }
}
