---
// SSR: el detalle se resuelve en cada request (stock/precio en vivo)
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/product/ProductCard.astro';
import {
  getProductBySlugOrId,
  getRelatedProducts,
  TENANT_SLUG,
} from '../../lib/supabase';
import { getCopy, categoryName, type Lang } from '../../lib/i18n';
import { planReflectImages, isFlashUrl } from '../../lib/reflective';
import ReflectBadge from '../../components/product/ReflectBadge.astro';
import { productName, productDescription } from '../../lib/product-texts';

const lang = (Astro.locals.lang ?? 'es') as Lang;
const t = getCopy(lang);

const param = Astro.params.slug ?? '';

const { data: product, error: productError } = await getProductBySlugOrId(TENANT_SLUG, param).catch(
  () => ({ data: null, error: true })
);

// Canonical: si entraron por UUID, apunta al slug
const canonicalSlug = (product as any)?.slug ?? param;

const related = product
  ? await getRelatedProducts(TENANT_SLUG, (product as any).category_id ?? null, (product as any).id, 4)
  : [];

// Nombre y descripción en el idioma activo (cae al español si falta).
const title = productName(product as any, lang);
const blurb = productDescription(product as any, lang);

const rawImages = product?.product_images ?? [];

// La prenda dice si es reflectiva; las fotos solo dicen cuál es la del reflejo.
const isReflective = Boolean((product as any)?.is_reflective);
const reflectPlan = planReflectImages(rawImages, isReflective);

// Orden de galería según el nombre del archivo:
//   1. frente sin flash (portada)  2. espalda sin flash
//   3. frente con flash            4. espalda con flash
function viewRank(url: string): number {
  const file = url.toLowerCase();
  const back = file.includes('back') ? 1 : 0;
  const flash = isFlashUrl(file) ? 2 : 0;
  return flash + back;
}

const images = reflectPlan.animatable
  ? reflectPlan.images.map((url) => ({ url, alt_text: undefined }))
  : [...rawImages].sort(
      (a: any, b: any) =>
        viewRank(a.url) - viewRank(b.url) || (a.position ?? 0) - (b.position ?? 0)
    );

const reflectFlash = reflectPlan.flashIndex;

function viewLabel(url: string) {
  if (isFlashUrl(url)) return t.product.frontFlash;
  return t.product.front;
}

const variants = product?.product_variants ?? [];
const price = variants[0]?.price ?? product?.base_price ?? 0;
const totalStock = variants.reduce((sum: number, v: any) => sum + (v.stock ?? 0), 0);
const isSoldOut = variants.length > 0 && totalStock === 0;

const sizes = [...new Set(variants.map((v: any) => v.size).filter(Boolean))];
const colors = [...new Set(variants.map((v: any) => v.color).filter(Boolean))];

const breadcrumbLd = product
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t.shop.breadcrumbHome, item: Astro.site },
        { '@type': 'ListItem', position: 2, name: t.shop.breadcrumb, item: new URL('/tienda', Astro.site ?? Astro.url.origin).toString() },
        { '@type': 'ListItem', position: 3, name: title },
      ],
    }
  : null;

const productLd = product
  ? {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: title,
      description: blurb,
      sku: product.sku,
      image: images.map((i: any) => i.url),
      offers: {
        '@type': 'Offer',
        price: price,
        priceCurrency: 'USD',
        availability: isSoldOut
          ? 'https://schema.org/OutOfStock'
          : 'https://schema.org/InStock',
      },
    }
  : null;

// Textos para el script del navegador (Astro los serializa con este objeto).
const ui = {
  selectSizeError: t.product.selectSizeError,
  selectColorError: t.product.selectColorError,
  combinationUnavailable: t.product.combinationUnavailable,
  wishlistShort: t.product.wishlistShort,
  wishlistSaved: t.product.wishlistSaved,
  addedToCart: t.product.added,
  cartAddedTitle: t.product.cartAddedTitle,
  wishAddedTitle: t.product.wishAddedTitle,
};
---

<BaseLayout
  title={product ? `${title} | Dinero Sobre Problemas` : t.product.notFoundTitle}
  description={blurb || t.product.notFoundText}
  image={images[0]?.url}
>
  {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
  {productLd && <script type="application/ld+json" set:html={JSON.stringify(productLd)} />}
  <script type="application/json" id="pdp-ui" set:html={JSON.stringify(ui)} />

  {
    !product ? (
      <div class="max-w-3xl mx-auto py-32 text-center px-6">
        <p class="section-label mb-4">404</p>
        <h1 class="font-titulos text-4xl text-blancoRoto mb-6">{t.product.notFoundTitle}</h1>
        <a href="/tienda" class="btn-gold inline-block">{t.product.backToShop}</a>
      </div>
    ) : (
      <>
        {/* Breadcrumb */}
        <div class="page-container py-5 border-b-2 border-white/25">
          <ol class="flex items-center gap-2 font-acentos text-xs uppercase tracking-[0.2em] text-white/80">
            <li><a href="/" class="hover:text-oro-brillo transition-colors">{t.shop.breadcrumbHome}</a></li>
            <li>/</li>
            <li><a href="/tienda" class="hover:text-oro-brillo transition-colors">{t.shop.breadcrumb}</a></li>
            <li>/</li>
            <li class="text-oro-brillo truncate max-w-[200px]">{title}</li>
          </ol>
        </div>

        <div class="page-container py-10 sm:py-16 lg:py-20">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 sm:gap-12 lg:gap-20">
            {/* Galería: el scope envuelve pista, flechas Y miniaturas, si no
                las miniaturas quedan fuera y el JS nunca las registra. */}
            <div>
              {images.length > 1 ? (
                <div class="pdp-carousel" data-carousel-scope>
                  {/* El badge va una sola vez, encima del carrusel: dentro de
                      cada slide se repetiría en cada foto. */}
                  <div
                    class="pdp-reflect"
                    data-reflect={reflectPlan.animatable ? '1' : undefined}
                    data-reflect-flash={reflectPlan.animatable ? reflectFlash : undefined}
                    data-reflect-ms={reflectPlan.animatable ? 1000 : undefined}
                  >
                    <ReflectBadge reflective={reflectPlan.animatable} />
                  </div>

                  <div class="pdp-track" id="pdp-track" data-carousel-track tabindex="0" aria-label={`${title}: ${t.product.photos}`}>
                    {images.map((img: any, i: number) => (
                      <div class="pdp-slide" data-carousel-slide>
                        <div class="product-frame border-2 border-white/25">
                          <img
                            src={img.url}
                            alt={img.alt_text ?? title}
                            loading={i === 0 ? 'eager' : 'lazy'}
                          />
                        </div>
                      </div>
                    ))}
                  </div>

                  <button type="button" class="pdp-arrow pdp-arrow--prev" data-carousel-dir="-1" aria-label={t.product.previousPhoto}>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="m15 18-6-6 6-6" />
                    </svg>
                  </button>
                  <button type="button" class="pdp-arrow pdp-arrow--next" data-carousel-dir="1" aria-label={t.product.nextPhoto}>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="m9 18 6-6-6-6" />
                    </svg>
                  </button>

                  <div class="pdp-dots">
                    {images.map((img: any, i: number) => (
                      <span
                        class:list={['pdp-dot', { 'is-active': i === 0 }]}
                        data-carousel-dot={i}
                        title={viewLabel(img.url)}
                      ></span>
                    ))}
                  </div>

                  <div class="grid grid-cols-4 gap-2 sm:gap-3 mt-3" id="gallery-thumbs">
                    {images.map((img: any, i: number) => (
                      <button
                        type="button"
                        class:list={[
                          'pdp-thumb product-frame border-2 transition-colors',
                          { 'is-active': i === 0 },
                        ]}
                        data-carousel-thumb={i}
                        aria-pressed={i === 0 ? 'true' : 'false'}
                        aria-label={`${t.product.seeView} ${viewLabel(img.url)}`}
                      >
                        <img src={img.url} alt="" loading="lazy" />
                        <span class="gallery-tag">{viewLabel(img.url)}</span>
                      </button>
                    ))}
                  </div>
                </div>
              ) : (
                <div class="product-frame border-2 border-white/25">
                  <ReflectBadge reflective={false} />
                  {images.length > 0 ? (
                    <img src={images[0].url} alt={images[0].alt_text ?? title} loading="eager" />
                  ) : (
                    <div class="absolute inset-0 flex items-center justify-center">
                      <span class="font-acentos text-xs uppercase tracking-[0.3em] text-blancoRoto">
                        {t.product.noImage}
                      </span>
                    </div>
                  )}
                </div>
              )}
            </div>

            {/* Info */}
            <div class="lg:py-4">
              {product.categories?.name && (
                <a href={`/tienda?category=${product.categories.id}`} class="section-label mb-4 inline-block hover:text-white transition-colors">
                  {categoryName(lang, product.categories)}
                </a>
              )}

              <h1 class="font-titulos text-3xl sm:text-4xl lg:text-5xl text-blancoRoto mb-6 leading-tight">
                {title}
              </h1>

              <div class="flex items-center gap-4 mb-8">
                <p class="font-acentos text-3xl text-oro-brillo font-medium">
                  ${Number(price).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                </p>
                <span class="text-white/80 text-base">USD</span>
                <button
                  type="button"
                  id="wish-toggle"
                  class="ml-auto inline-flex items-center justify-center gap-2 min-h-[48px] px-4 border-2 border-white/40 text-blancoRoto hover:border-oro-brillo hover:text-oro-brillo transition-colors font-acentos text-xs uppercase tracking-[0.18em]"
                  data-wish-id={product.id}
                  data-wish-slug={product.slug ?? ''}
                  data-wish-name={title}
                  data-wish-price={price}
                  data-wish-image={images[0]?.url ?? ''}
                  aria-pressed="false"
                  aria-label={t.product.wishlistAdd}
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1L12 21l7.7-7.6 1.1-1a5.5 5.5 0 0 0 0-7.8Z" />
                  </svg>
                  <span id="wish-label">{t.product.wishlistShort}</span>
                </button>
              </div>

              <div class="gold-line mb-8" style="margin-left: 0"></div>

              <p class="text-white/80 leading-relaxed mb-8 whitespace-pre-line">
                {blurb || t.product.defaultDescription}
              </p>

              <!-- Tallas -->
              {sizes.length > 0 && (
                <div class="mb-6">
                  <h3 class="font-acentos text-xs uppercase tracking-[0.25em] text-blancoRoto mb-4">
                    {t.product.size}
                  </h3>
                  <div class="flex flex-wrap gap-3" id="size-options">
                    {sizes.map((size: any) => (
                      <button
                        type="button"
                        data-size={size}
                        class="size-btn min-w-[3.25rem] min-h-[52px] px-4 py-3 border-2 border-white/40 text-base text-blancoRoto hover:border-oro-brillo transition-all duration-300 font-acentos"
                      >
                        {size}
                      </button>
                    ))}
                  </div>
                </div>
              )}

              <!-- Colores -->
              {colors.length > 0 && (
                <div class="mb-8">
                  <h3 class="font-acentos text-xs uppercase tracking-[0.25em] text-blancoRoto mb-4">
                    {t.product.colorLabel}
                  </h3>
                  <div class="flex flex-wrap gap-3" id="color-options">
                    {colors.map((color: any) => (
                      <button
                        type="button"
                        data-color={color}
                        class="color-btn min-h-[52px] px-5 py-3 border-2 border-white/40 text-base text-blancoRoto hover:border-oro-brillo transition-all duration-300 font-acentos"
                      >
                        {color}
                      </button>
                    ))}
                  </div>
                </div>
              )}

              <!-- CTA -->
              <div class="flex flex-col sm:flex-row gap-3 mb-4">
                <button
                  id="add-to-cart"
                  data-product-id={product.id}
                  data-product-name={title}
                  data-image={images[0]?.url ?? ''}
                  data-variants={JSON.stringify(variants)}
                  class:list={[
                    'flex-1 py-5 min-h-[56px] font-acentos text-sm uppercase tracking-[0.25em] transition-all duration-400',
                    isSoldOut
                      ? 'bg-negro-elevado text-blancoRoto cursor-not-allowed border-2 border-white/30'
                      : 'bg-oro-brillo text-negro-profundo hover:bg-oro-brillo hover:tracking-[0.3em]',
                  ]}
                  disabled={isSoldOut}
                >
                  {isSoldOut ? t.product.soldOut : t.product.addToCart}
                </button>
                <a
                  href="/carrito"
                  id="open-cart-drawer"
                  class="min-h-[56px] px-6 py-5 border-2 border-white/50 text-blancoRoto hover:border-oro-brillo hover:text-oro-brillo transition-all duration-300 flex items-center justify-center gap-2 font-acentos text-xs uppercase tracking-[0.2em]"
                  aria-label={t.product.cartCta}
                >
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
                    <path d="M3 6h18M16 10a4 4 0 0 1-8 0" />
                  </svg>
                  <span class="whitespace-nowrap">{t.product.cartCta}</span>
                </a>
              </div>

              <p id="add-feedback" class="hidden text-sm mb-6 font-acentos tracking-wide" hidden></p>

              {/* Detalles */}
              <div class="border-t-2 border-white/25 pt-6 space-y-2">
                <details class="group">
                  <summary class="flex justify-between items-center cursor-pointer py-3 min-h-[48px] font-acentos text-sm uppercase tracking-[0.2em] text-blancoRoto hover:text-oro-brillo transition-colors">
                    {t.product.detailsTitle}
                    <span class="text-oro-brillo transition-transform group-open:rotate-45">+</span>
                  </summary>
                  <ul class="pt-3 pb-2 space-y-2 text-base text-white/80">
                    <li>SKU: {product.sku ?? '—'}</li>
                    <li>{t.product.stockAvailable}: {totalStock}</li>
                    {product.categories?.name && <li>{t.product.category}: {categoryName(lang, product.categories)}</li>}
                  </ul>
                </details>

                <details class="group border-t border-white/15">
                  <summary class="flex justify-between items-center cursor-pointer py-4 min-h-[48px] font-acentos text-sm uppercase tracking-[0.2em] text-blancoRoto hover:text-oro-brillo transition-colors">
                    {t.product.shippingTitle}
                    <span class="text-oro-brillo transition-transform group-open:rotate-45">+</span>
                  </summary>
                  <p class="pb-4 text-base text-white/80 leading-relaxed">
                    {t.product.shippingText}
                  </p>
                </details>
              </div>
            </div>
          </div>
        </div>
      </>
    )
  }

  <style>
    /* ---------- Carrusel de la ficha ---------- */
    .pdp-carousel {
      position: relative;
    }

    /* Contenedor del badge: no ocupa espacio, solo ancla el aviso sobre el
       marco. Así el badge va una sola vez y no se repite en cada slide. */
    .pdp-reflect {
      position: absolute;
      top: 0;
      left: 0;
      z-index: 8;
      pointer-events: none;
    }

    .pdp-track {
      position: relative;
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      scrollbar-width: none;
      -ms-overflow-style: none;
      outline: none;
    }

    .pdp-track::-webkit-scrollbar {
      display: none;
    }

    .pdp-slide {
      flex: 0 0 100%;
      scroll-snap-align: start;
    }

    .pdp-arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 5;
      width: 46px;
      height: 46px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: rgba(6, 6, 6, 0.86);
      border: 2px solid rgba(255, 255, 255, 0.5);
      color: #ffffff;
      transition:
        border-color 0.2s ease,
        color 0.2s ease;
    }

    .pdp-arrow:hover {
      border-color: #ffe28a;
      color: #ffe28a;
    }

    .pdp-arrow[data-edge] {
      opacity: 0.35;
    }

    .pdp-arrow--prev {
      left: 10px;
    }

    .pdp-arrow--next {
      right: 10px;
    }

    .pdp-dots {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 12px;
    }

    .pdp-dot {
      width: 9px;
      height: 9px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.35);
      cursor: pointer;
      transition:
        background-color 0.2s ease,
        transform 0.2s ease;
    }

    .pdp-dot.is-active {
      background: #ffe28a;
      transform: scale(1.2);
    }

    /* Etiqueta de vista en la miniatura: Frente / Espalda / · flash */
    [data-carousel-thumb] {
      position: relative;
    }

    /* Miniatura activa: la marca el JS con `is-active` (no con clases de
       Tailwind generadas en runtime, que no existen en el CSS compilado). */
    .pdp-thumb {
      border-color: rgba(255, 255, 255, 0.25);
    }

    .pdp-thumb:hover {
      border-color: #ffe28a;
    }

    .pdp-thumb.is-active {
      border-color: #ffe28a;
    }

    .gallery-tag {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 2px 4px;
      background: rgba(6, 6, 6, 0.82);
      color: #ffffff;
      font-family: 'Space Grotesk', Inter, sans-serif;
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-align: center;
      pointer-events: none;
    }

    @media (max-width: 640px) {
      .gallery-tag {
        font-size: 8px;
        letter-spacing: 0.05em;
        padding: 1px 2px;
      }

      .pdp-arrow {
        width: 40px;
        height: 40px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .pdp-track {
        scroll-behavior: auto;
      }
    }

  </style>

  <script>
    import '../../lib/carousel';
    import '../../lib/reflect-anim';
    import { addToCart } from '../../lib/cart';
    import { sanitizeVariants } from '../../lib/product-variants';
    import { toggleWishlist, currentWishlist, hasSession, SESSION_ENDED_EVENT } from '../../lib/wishlist';
    import { alert, busy, confirm, nudge, nudgeGroup } from '../../lib/ux';

    // El botón secundario de la ficha lleva directo al pago con el carrito
    // abierto, en vez de a una página intermedia sin acción clara.
    document.getElementById('open-cart-drawer')?.addEventListener('click', (e) => {
      e.preventDefault();
      window.location.href = '/checkout';
    });

    /** Textos resueltos en servidor. */
    const ui = JSON.parse(document.getElementById('pdp-ui')?.textContent || '{}') as Record<string, string>;
    const uiText = (key: string) => ui[key] ?? '';

    // La galería (flechas, puntos, miniaturas y avance automático) la maneja
    // `lib/carousel.ts`. Aquí solo se guarda la foto visible para el carrito.
    let currentImage =
      (document.querySelector<HTMLImageElement>('#pdp-track img')?.getAttribute('src') ?? '') ||
      ((document.getElementById('add-to-cart') as HTMLButtonElement | null)?.dataset.image ?? '');

    document.querySelector<HTMLElement>('#pdp-track')?.addEventListener(
      'scroll',
      () => {
        const trackEl = document.getElementById('pdp-track');
        const first = trackEl?.querySelector<HTMLElement>('[data-carousel-slide]');
        if (!trackEl || !first) return;

        const index = Math.round(trackEl.scrollLeft / Math.max(first.offsetWidth, 1));
        const imgs = trackEl.querySelectorAll<HTMLImageElement>('img');
        const img = imgs[Math.min(index, imgs.length - 1)];
        if (img) currentImage = img.getAttribute('src') ?? currentImage;
      },
      { passive: true }
    );

    const btn = document.getElementById('add-to-cart') as HTMLButtonElement | null;
    if (btn) {
      // data-variants lo genera el servidor: aquí solo se tipa.
      const variants = sanitizeVariants(JSON.parse(btn.dataset.variants || '[]'));
      const feedback = document.getElementById('add-feedback') as HTMLElement;

      let selectedSize: string | null = null;
      let selectedColor: string | null = null;

      const sizes = [...new Set(variants.map((v) => v.size).filter(Boolean))] as string[];
      const colors = [...new Set(variants.map((v) => v.color).filter(Boolean))] as string[];

      // Preseleccionar si solo hay una opción
      if (sizes.length === 1) selectedSize = sizes[0];
      if (colors.length === 1) selectedColor = colors[0];

      function findVariant() {
        return variants.find(
          (v) =>
            (!selectedSize || v.size === selectedSize) &&
            (!selectedColor || v.color === selectedColor)
        );
      }

      function paint(selector: string, attr: string, value: string | null) {
        document.querySelectorAll(selector).forEach((el) => {
          const match = (el as HTMLElement).dataset[attr] === value;
          el.classList.toggle('border-oro-brillo', match);
          el.classList.toggle('text-oro-brillo', match);
          el.classList.toggle('border-white/30', !match);
        });
      }

      document.querySelectorAll('.size-btn').forEach((el) =>
        el.addEventListener('click', () => {
          selectedSize = (el as HTMLElement).dataset.size!;
          paint('.size-btn', 'size', selectedSize);
          // Elegir opción descarta el aviso pendiente: ya está resuelto.
          feedback.classList.add('hidden');
          feedback.hidden = true;
        })
      );
      document.querySelectorAll('.color-btn').forEach((el) =>
        el.addEventListener('click', () => {
          selectedColor = (el as HTMLElement).dataset.color!;
          paint('.color-btn', 'color', selectedColor);
          feedback.classList.add('hidden');
          feedback.hidden = true;
        })
      );

      paint('.size-btn', 'size', selectedSize);
      paint('.color-btn', 'color', selectedColor);

      btn.addEventListener('click', () => {
        // Falta la talla: el botón se sacude y el foco salta al grupo.
        if (sizes.length > 0 && !selectedSize) {
          nudgeGroup('.size-btn');
          alert(feedback, uiText('selectSizeError'));
          return;
        }
        if (colors.length > 0 && !selectedColor) {
          nudgeGroup('.color-btn');
          alert(feedback, uiText('selectColorError'));
          return;
        }

        const variant = findVariant();
        if (!variant) {
          nudge(document.getElementById('size-options'));
          alert(feedback, uiText('combinationUnavailable'));
          return;
        }

        addToCart({
          variantId: variant.id,
          productId: btn.dataset.productId!,
          name: btn.dataset.productName!,
          variantName: [variant.size, variant.color].filter(Boolean).join(' · '),
          price: Number(variant.price),
          qty: 1,
          image: currentImage || btn.dataset.image || undefined,
          size: variant.size ?? null,
          color: variant.color ?? null,
        });

        // Confirmación en el propio botón + destello; el aviso flotante
        // centrado lo emite `StoreDrawer` desde `cart:updated`.
        confirm(btn);
      });
    }

    // ---------- Favoritos ----------
    const wishBtn = document.getElementById('wish-toggle') as HTMLButtonElement | null;

    function paintWish(active: boolean) {
      if (!wishBtn) return;
      wishBtn.setAttribute('aria-pressed', String(active));
      wishBtn.classList.toggle('border-oro-brillo', active);
      wishBtn.classList.toggle('text-oro-brillo', active);
      wishBtn.classList.toggle('border-white/40', !active);

      const icon = wishBtn.querySelector('svg');
      if (icon) icon.setAttribute('fill', active ? 'currentColor' : 'none');

      const label = document.getElementById('wish-label');
      if (label) label.textContent = active ? uiText('wishlistSaved') : uiText('wishlistShort');
    }

    if (wishBtn) {
      // Misma fuente de datos que el catálogo y /favoritos: si se quita el
      // favorito en otra vista, el botón no puede quedar marcado.
      const syncWish = async () => {
        try {
          const items = await currentWishlist(await hasSession());
          paintWish(items.some((i) => String(i.productId) === String(wishBtn.dataset.wishId)));
        } catch {
          /* sin datos: se deja lo pintado */
        }
      };

      void syncWish();
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') void syncWish();
      });
      window.addEventListener('focus', () => void syncWish());

      wishBtn.addEventListener('click', async () => {
        const active = await toggleWishlist({
          productId: wishBtn.dataset.wishId!,
          slug: wishBtn.dataset.wishSlug || null,
          name: wishBtn.dataset.wishName!,
          price: Number(wishBtn.dataset.wishPrice),
          image: wishBtn.dataset.wishImage || null,
        });

        paintWish(active);
        // El aviso flotante lo emite `StoreDrawer` al escuchar `wishlist:added`.
      });

      // Al cerrar sesión el botón vuelve a reflejar el almacenamiento del
      // visitante, que puede estar vacío.
      window.addEventListener(SESSION_ENDED_EVENT, () => void syncWish());
    }
  </script>

  {
    product && related.length > 0 && (
      <section class="border-t border-white/30 bg-negro-carbono">
        <div class="page-container py-20">
          <div class="text-center mb-14">
            <p class="section-label mb-4">{t.product.related}</p>
            <h2 class="font-titulos text-3xl md:text-4xl text-blancoRoto">{t.product.completeLook}</h2>
          </div>
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-5 lg:gap-8">
            {related.map((p: any) => (
              <ProductCard product={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
