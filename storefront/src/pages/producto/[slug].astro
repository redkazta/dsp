---
// SSR: el detalle se resuelve en cada request (stock/precio en vivo)
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProductById } from '../../lib/supabase';

const id = Astro.params.slug ?? '';
const tenantId = 'dinerosobreproblemas';

const { data: product, error: productError } = await getProductById(tenantId, id).catch(() => ({ data: null, error: true }));

const images = product?.product_images ?? [];
const variants = product?.product_variants ?? [];
const price = variants[0]?.price ?? product?.base_price ?? 0;
const totalStock = variants.reduce((sum: number, v: any) => sum + (v.stock ?? 0), 0);
const isSoldOut = variants.length > 0 && totalStock === 0;

const sizes = [...new Set(variants.map((v: any) => v.size).filter(Boolean))];
const colors = [...new Set(variants.map((v: any) => v.color).filter(Boolean))];

const breadcrumbLd = product
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: Astro.site },
        { '@type': 'ListItem', position: 2, name: 'Tienda', item: new URL('/tienda', Astro.site ?? Astro.url.origin).toString() },
        { '@type': 'ListItem', position: 3, name: product.name },
      ],
    }
  : null;

const productLd = product
  ? {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: product.name,
      description: product.description,
      sku: product.sku,
      image: images.map((i: any) => i.url),
      offers: {
        '@type': 'Offer',
        price: price,
        priceCurrency: 'MXN',
        availability: isSoldOut
          ? 'https://schema.org/OutOfStock'
          : 'https://schema.org/InStock',
      },
    }
  : null;
---

<BaseLayout
  title={product ? `${product.name} | Dinero Sobre Problemas` : 'Producto no encontrado'}
  description={product?.description ?? 'Detalle del producto'}
  image={images[0]?.url}
>
  {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
  {productLd && <script type="application/ld+json" set:html={JSON.stringify(productLd)} />}

  {
    !product ? (
      <div class="max-w-3xl mx-auto py-32 text-center px-6">
        <p class="section-label mb-4">Error 404</p>
        <h1 class="font-titulos text-4xl text-blancoRoto mb-6">Producto no encontrado</h1>
        <a href="/tienda" class="btn-gold inline-block">Volver al catálogo</a>
      </div>
    ) : (
      <>
        {/* Breadcrumb */}
        <div class="max-w-[1400px] mx-auto px-6 lg:px-10 py-6 border-b border-plata-metalico/10">
          <ol class="flex items-center gap-2 font-acentos text-[10px] uppercase tracking-[0.2em] text-plata-metalico/40">
            <li><a href="/" class="hover:text-oro-elegante transition-colors">Inicio</a></li>
            <li>/</li>
            <li><a href="/tienda" class="hover:text-oro-elegante transition-colors">Tienda</a></li>
            <li>/</li>
            <li class="text-oro-elegante truncate max-w-[200px]">{product.name}</li>
          </ol>
        </div>

        <div class="max-w-[1400px] mx-auto px-6 lg:px-10 py-12 lg:py-20">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">
            {/* Galería */}
            <div>
              <div class="aspect-[4/5] bg-negro-elevado border border-plata-metalico/10 overflow-hidden">
                {images.length > 0 ? (
                  <img
                    src={images[0].url}
                    alt={product.name}
                    class="w-full h-full object-cover"
                    loading="eager"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center">
                    <span class="font-acentos text-xs uppercase tracking-[0.3em] text-plata-metalico/25">
                      Sin imagen
                    </span>
                  </div>
                )}
              </div>

              {images.length > 1 && (
                <div class="grid grid-cols-4 gap-3 mt-3">
                  {images.slice(0, 4).map((img: any) => (
                    <div class="aspect-square bg-negro-elevado border border-plata-metalico/10 overflow-hidden hover:border-oro-elegante/40 transition-colors">
                      <img src={img.url} alt={img.alt_text ?? product.name} class="w-full h-full object-cover" loading="lazy" />
                    </div>
                  ))}
                </div>
              )}
            </div>

            {/* Info */}
            <div class="lg:py-4">
              {product.categories?.name && (
                <a href={`/tienda?category=${product.categories.id}`} class="section-label mb-4 inline-block hover:text-oro-suave transition-colors">
                  {product.categories.name}
                </a>
              )}

              <h1 class="font-titulos text-4xl lg:text-5xl text-blancoRoto mb-6 leading-tight">
                {product.name}
              </h1>

              <div class="flex items-center gap-4 mb-8">
                <p class="font-acentos text-3xl text-oro-elegante font-medium">
                  ${Number(price).toLocaleString('es-MX', { minimumFractionDigits: 2 })}
                </p>
                <span class="text-plata-metalico/50 text-sm">MXN</span>
              </div>

              <div class="gold-line mb-8" style="margin-left: 0"></div>

              <p class="text-plata-metalico/70 leading-relaxed mb-8">
                {product.description ?? 'Sin descripción disponible.'}
              </p>

              {/* Tallas */}
              {sizes.length > 0 && (
                <div class="mb-6">
                  <h3 class="font-acentos text-[11px] uppercase tracking-[0.25em] text-plata-claro mb-4">
                    Talla
                  </h3>
                  <div class="flex flex-wrap gap-3">
                    {sizes.map((size: any) => (
                      <button class="min-w-[3rem] px-4 py-3 border border-plata-metalico/20 text-sm text-plata-claro hover:border-oro-elegante hover:text-oro-elegante transition-all duration-300 font-acentos">
                        {size}
                      </button>
                    ))}
                  </div>
                </div>
              )}

              {/* Colores */}
              {colors.length > 0 && (
                <div class="mb-8">
                  <h3 class="font-acentos text-[11px] uppercase tracking-[0.25em] text-plata-claro mb-4">
                    Color · <span class="text-plata-metalico/50">{colors[0]}</span>
                  </h3>
                  <div class="flex flex-wrap gap-3">
                    {colors.map((color: any) => (
                      <button class="px-5 py-3 border border-plata-metalico/20 text-sm text-plata-claro hover:border-oro-elegante hover:text-oro-elegante transition-all duration-300 font-acentos">
                        {color}
                      </button>
                    ))}
                  </div>
                </div>
              )}

              {/* CTA */}
              <div class="flex flex-col sm:flex-row gap-3 mb-8">
                <button
                  class:list={[
                    'flex-1 py-5 font-acentos text-xs uppercase tracking-[0.25em] transition-all duration-400',
                    isSoldOut
                      ? 'bg-negro-elevado text-plata-metalico/40 cursor-not-allowed border border-plata-metalico/10'
                      : 'bg-oro-elegante text-negro-profundo hover:bg-oro-suave hover:tracking-[0.3em]',
                  ]}
                  disabled={isSoldOut}
                >
                  {isSoldOut ? 'Agotado' : 'Agregar al carrito'}
                </button>
                <button class="px-6 py-5 border border-plata-metalico/20 text-plata-metalico hover:border-oro-elegante hover:text-oro-elegante transition-all duration-300">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                  </svg>
                </button>
              </div>

              {/* Detalles */}
              <div class="border-t border-plata-metalico/10 pt-8 space-y-4">
                <details class="group">
                  <summary class="flex justify-between items-center cursor-pointer py-2 font-acentos text-[11px] uppercase tracking-[0.2em] text-plata-claro hover:text-oro-elegante transition-colors">
                    Detalles del producto
                    <span class="text-oro-elegante transition-transform group-open:rotate-45">+</span>
                  </summary>
                  <ul class="pt-4 space-y-2 text-sm text-plata-metalico/60">
                    <li>SKU: {product.sku ?? '—'}</li>
                    <li>Stock disponible: {totalStock} piezas</li>
                    {product.categories?.name && <li>Categoría: {product.categories.name}</li>}
                  </ul>
                </details>

                <details class="group border-t border-plata-metalico/10">
                  <summary class="flex justify-between items-center cursor-pointer py-4 font-acentos text-[11px] uppercase tracking-[0.2em] text-plata-claro hover:text-oro-elegante transition-colors">
                    Envío y devoluciones
                    <span class="text-oro-elegante transition-transform group-open:rotate-45">+</span>
                  </summary>
                  <p class="pb-4 text-sm text-plata-metalico/60 leading-relaxed">
                    Envío gratis en pedidos superiores a $1,500 MXN. Devoluciones
                    aceptadas dentro de 30 días con etiqueta original.
                  </p>
                </details>
              </div>
            </div>
          </div>
        </div>
      </>
    )
  }
</BaseLayout>
