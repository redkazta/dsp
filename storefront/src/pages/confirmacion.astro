---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pedido confirmado | Dinero Sobre Problemas" description="Tu pedido fue recibido.">
  <div id="conf-loading" class="min-h-[70vh] flex items-center justify-center">
    <p class="text-muted">Cargando tu pedido…</p>
  </div>

  <div id="conf-empty" class="hidden min-h-[70vh] flex items-center justify-center px-5 bg-noise">
    <div class="max-w-xl text-center">
      <div class="w-16 h-16 mx-auto mb-8 border-2 border-oro-brillo flex items-center justify-center">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#FFE28A" stroke-width="2">
          <path d="m5 13 4 4L19 7" />
        </svg>
      </div>
      <p class="section-label mb-4">Pedido recibido</p>
      <h1 class="font-titulos text-4xl lg:text-5xl text-blancoRoto mb-6">Gracias por tu compra</h1>
      <div class="gold-line mx-auto mb-8"></div>
      <p class="text-base text-white/80 leading-relaxed mb-10">
        No encontramos el detalle del pedido en este navegador.
        Revisa tu correo o entra a tu cuenta para verlo.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/cuenta" class="btn-gold">Ver mis pedidos</a>
        <a href="/tienda" class="btn-outline">Seguir comprando</a>
      </div>
    </div>
  </div>

  <div id="conf-content" class="hidden">
    <section class="border-b-2 border-white/25 bg-noise">
      <div class="page-container py-12 sm:py-16 text-center">
        <div class="w-16 h-16 mx-auto mb-7 border-2 border-oro-brillo flex items-center justify-center">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#FFE28A" stroke-width="2">
            <path d="m5 13 4 4L19 7" />
          </svg>
        </div>
        <p class="section-label mb-4">Pago aprobado</p>
        <h1 class="font-titulos text-3xl sm:text-4xl lg:text-5xl text-blancoRoto mb-4">
          Gracias, <span id="conf-name">cliente</span>
        </h1>
        <div class="gold-line mx-auto mb-6"></div>
        <p class="text-base text-white/80">
          Pedido <span id="conf-number" class="font-acentos text-oro-brillo">—</span> ·
          <span id="conf-date">—</span>
        </p>
      </div>
    </section>

    <div class="page-container py-10 sm:py-14">
      <div class="grid lg:grid-cols-3 gap-8 lg:gap-10">
        <section class="lg:col-span-2">
          <h2 class="section-label mb-5">Seguimiento</h2>
          <div id="conf-timeline" class="card p-6 sm:p-8"></div>

          <h2 class="section-label mt-10 mb-5">Piezas</h2>
          <div id="conf-items" class="card divide-y-2 divide-white/15"></div>
        </section>

        <aside class="space-y-6">
          <div class="card p-6">
            <h2 class="section-label mb-4">Resumen</h2>
            <div class="space-y-3 text-base">
              <div class="flex justify-between">
                <span class="text-white/80">Subtotal</span>
                <span id="conf-subtotal" class="text-blancoRoto">—</span>
              </div>
              <div class="flex justify-between">
                <span class="text-white/80">Envío</span>
                <span id="conf-shipping" class="text-blancoRoto">—</span>
              </div>
              <div class="flex justify-between pt-3 border-t-2 border-white/25">
                <span class="font-acentos uppercase tracking-[0.16em] text-blancoRoto">Total</span>
                <span id="conf-total" class="font-acentos text-xl text-oro-brillo">—</span>
              </div>
            </div>
          </div>

          <div class="card p-6">
            <h2 class="section-label mb-4">Envío</h2>
            <div id="conf-address" class="text-base text-white/80 leading-relaxed"></div>
          </div>

          <div class="flex flex-col gap-3">
            <a href="/cuenta" class="btn-gold w-full">Ver mis pedidos</a>
            <a href="/tienda" class="btn-outline w-full">Seguir comprando</a>
          </div>
        </aside>
      </div>
    </div>
  </div>

  <script>
    import {
      getOrderById,
      getOrderHistory,
      STATUS_FLOW,
      STATUS_LABEL,
      STATUS_HINT,
      formatOrderMoney,
      formatOrderDate,
      type OrderStatus,
    } from '../lib/orders';

    const loading = document.getElementById('conf-loading')!;
    const empty = document.getElementById('conf-empty')!;
    const content = document.getElementById('conf-content')!;

    function timeline(order: any, history: any[]) {
      const reached = new Set<string>(history.map((h) => h.status));
      reached.add(order.status);

      const isClosed = ['cancelled', 'returned'].includes(order.status);

      if (isClosed) {
        return `
          <div class="flex items-center gap-3 mb-3">
            <span class="w-3 h-3 rounded-full ${order.status === 'cancelled' ? 'bg-red-400' : 'bg-oro-brillo'}"></span>
            <p class="font-acentos text-base text-blancoRoto">${STATUS_LABEL[order.status as OrderStatus]}</p>
          </div>
          <p class="text-sm text-white/80">${STATUS_HINT[order.status as OrderStatus]}</p>`;
      }

      const steps = STATUS_FLOW.filter((s) => s !== 'pending' || reached.has('pending'));
      const currentIndex = Math.max(0, steps.indexOf(order.status as OrderStatus));

      return steps
        .map((step, index) => {
          const done = index <= currentIndex;
          const active = index === currentIndex;
          const stamp = history.find((h) => h.status === step)?.created_at;

          return `
          <div class="flex gap-4">
            <div class="flex flex-col items-center">
              <span class="w-3.5 h-3.5 rounded-full border-2 ${
                done ? 'bg-oro-brillo border-oro-brillo' : 'bg-transparent border-white/50'
              }"></span>
              ${index < steps.length - 1 ? `<span class="w-0.5 flex-1 my-1 ${done && index < currentIndex ? 'bg-oro-brillo' : 'bg-white/25'}"></span>` : ''}
            </div>
            <div class="pb-5 ${index === steps.length - 1 ? 'pb-0' : ''}">
              <p class="font-acentos text-sm uppercase tracking-[0.14em] ${
                active ? 'text-oro-brillo' : done ? 'text-blancoRoto' : 'text-white/80'
              }">${STATUS_LABEL[step]}</p>
              ${active ? `<p class="text-sm text-white/80 mt-1">${STATUS_HINT[step]}</p>` : ''}
              ${stamp ? `<p class="text-xs text-white/80 mt-1">${new Date(stamp).toLocaleString('es-MX', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}</p>` : ''}
            </div>
          </div>`;
        })
        .join('');
    }

    async function init() {
      const id = new URLSearchParams(window.location.search).get('order');

      if (!id) {
        loading.classList.add('hidden');
        empty.classList.remove('hidden');
        return;
      }

      const order = await getOrderById(id);
      loading.classList.add('hidden');

      if (!order) {
        empty.classList.remove('hidden');
        return;
      }

      content.classList.remove('hidden');

      document.getElementById('conf-name')!.textContent =
        (order.contact_name ?? 'cliente').split(' ')[0];
      document.getElementById('conf-number')!.textContent = order.order_number ?? order.id.slice(0, 8);
      document.getElementById('conf-date')!.textContent = formatOrderDate(order.created_at);

      const history = await getOrderHistory(order.id);
      document.getElementById('conf-timeline')!.innerHTML = timeline(order, history);

      const items = order.order_items ?? [];
      document.getElementById('conf-items')!.innerHTML = items
        .map(
          (i: any) => `
        <div class="flex gap-4 p-4 sm:p-5">
          <div class="w-16 h-20 sm:w-20 sm:h-24 shrink-0 bg-white border-2 border-white/30 overflow-hidden">
            ${i.image_url ? `<img src="${i.image_url}" alt="${i.product_name ?? ''}" class="w-full h-full object-contain">` : ''}
          </div>
          <div class="flex-1 min-w-0">
            <p class="font-acentos text-base text-blancoRoto">${i.product_name ?? 'Pieza'}</p>
            <p class="text-sm text-white/80">
              ${[i.size, i.color].filter(Boolean).join(' · ') || i.variant_name || ''}
              · Cantidad ${i.quantity}
            </p>
          </div>
          <p class="font-acentos text-base text-oro-brillo whitespace-nowrap">
            ${formatOrderMoney(Number(i.unit_price) * Number(i.quantity))}
          </p>
        </div>`
        )
        .join('');

      const subtotal = Number(order.subtotal ?? order.total_amount);
      const shipping = Number(order.shipping_cost ?? 0);

      document.getElementById('conf-subtotal')!.textContent = formatOrderMoney(subtotal);
      document.getElementById('conf-shipping')!.textContent =
        shipping === 0 ? 'Gratis' : formatOrderMoney(shipping);
      document.getElementById('conf-total')!.textContent = formatOrderMoney(Number(order.total_amount));

      document.getElementById('conf-address')!.innerHTML = `
        <p class="text-blancoRoto mb-1">${order.contact_name ?? ''}</p>
        <p>${order.shipping_street ?? ''}</p>
        <p>${order.shipping_colonia ? order.shipping_colonia + ', ' : ''}${order.shipping_city ?? ''}</p>
        <p>${order.shipping_state ?? ''} ${order.shipping_postal_code ?? ''}</p>
        <p class="mt-2">${order.contact_phone ?? ''}</p>
        <p>${order.contact_email ?? ''}</p>`;
    }

    init();
  </script>
</BaseLayout>
