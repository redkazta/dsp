---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { createSupabaseServerClient, createSupabaseAdminClient } from '../lib/supabase-server';
import { confirmSessionOnReturn } from '../lib/checkout';
import { getCustomerOrder } from '../lib/customer-orders';
import {
  STATUS_FLOW,
  orderLabels,
  formatOrderMoney,
  formatOrderDate,
  trackingUrl,
  type OrderStatus,
} from '../lib/orders';
import { getCopy, type Lang } from '../lib/i18n';

const lang = (Astro.locals.lang ?? 'es') as Lang;
const t = getCopy(lang);
const { status: STATUS_LABEL, hint: STATUS_HINT } = orderLabels(lang);

const user = Astro.locals.user;
const orderParam = (Astro.url.searchParams.get('order') ?? '').trim();

let order: Awaited<ReturnType<typeof getCustomerOrder>> = null;
if (user && orderParam) {
  const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
  order = await getCustomerOrder(supabase, user.id, orderParam);
}

// Al volver del Checkout de Stripe, si el pago todavía no se refleja se le
// pregunta a Stripe directamente (el webhook puede tardar unos segundos).
// Solo el servidor puede leer el pedido, y `stripe=return` solo lo pone
// nuestra propia success_url.
const returning = Astro.url.searchParams.get('stripe') === 'return';
const sessionId = (Astro.url.searchParams.get('session_id') ?? '').trim();
const db = createSupabaseAdminClient();

if (db && order && order.payment_status !== 'approved') {
  try {
    if (returning && sessionId) {
      await confirmSessionOnReturn({ db, sessionId });
    }

    const { data: fresh } = await db
      .from('orders')
      .select('payment_status, status')
      .eq('id', order.id)
      .maybeSingle();

    if (fresh) {
      order.payment_status = fresh.payment_status ?? order.payment_status;
      order.status = fresh.status ?? order.status;
    }
  } catch (err: any) {
    console.error('[confirmacion]', err?.message);
  }
}

const isPaid = order?.payment_status === 'approved';

const reached = new Set((order?.order_status_history ?? []).map((h) => h.status));
if (order) reached.add(order.status);

const isClosed = order ? ['cancelled', 'returned'].includes(order.status) : false;
const steps = order
  ? STATUS_FLOW.filter((s) => s !== 'pending' || reached.has('pending')).map((step) => ({
      step,
      done: reached.has(step),
      active: step === order!.status,
      stamp: order!.order_status_history.find((h) => h.status === step)?.created_at ?? null,
    }))
  : [];

const subtotal = Number(order?.subtotal ?? order?.total_amount ?? 0);
const shipping = Number(order?.shipping_cost ?? 0);
const trackUrl = order?.tracking_number ? trackingUrl(order.carrier, order.tracking_number) : null;
---

<BaseLayout title="Pedido confirmado | Dinero Sobre Problemas" description="Tu pedido fue recibido.">
  {
    !order ? (
      <div id="conf-empty" class="min-h-[70vh] flex items-center justify-center px-5 bg-noise">
        <div class="max-w-xl text-center">
          <div class="w-16 h-16 mx-auto mb-8 border-2 border-oro-brillo flex items-center justify-center">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#FFE28A" stroke-width="2">
              <path d="m5 13 4 4L19 7" />
            </svg>
          </div>
          <p class="section-label mb-4">{t.order.received}</p>
          <h1 class="font-titulos text-4xl lg:text-5xl text-blancoRoto mb-6">{t.order.thanks}</h1>
          <div class="gold-line mx-auto mb-8"></div>
          <p class="text-base text-white/80 leading-relaxed mb-10">
            {user && orderParam
              ? t.account.orderNotFound
              : t.account.orderSignIn}
          </p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href="/cuenta#pedidos" class="btn-gold">{t.account.myOrders}</a>
            <a href="/tienda" class="btn-outline">{t.cart.continueShopping}</a>
          </div>
        </div>
      </div>
    ) : (
      <div id="conf-content">
        <section class="border-b-2 border-white/25 bg-noise">
          <div class="page-container py-12 sm:py-16 text-center">
            <div class="w-16 h-16 mx-auto mb-7 border-2 border-oro-brillo flex items-center justify-center">
              <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#FFE28A" stroke-width="2">
                {isPaid ? <path d="m5 13 4 4L19 7" /> : <circle cx="12" cy="12" r="9" />}
              </svg>
            </div>
            <p class="section-label mb-4">{isPaid ? t.account.paidApproved : t.account.paidPending}</p>
            <h1 class="font-titulos text-3xl sm:text-4xl lg:text-5xl text-blancoRoto mb-4">
              {isPaid ? `${t.account.thankYou}, ${(order.contact_name ?? t.account.customerFallback).split(' ')[0]}` : t.account.confirmingPayment}
            </h1>
            <div class="gold-line mx-auto mb-6"></div>
            <p class="text-base text-white/80">
              Pedido <span class="font-acentos text-oro-brillo">{order.order_number ?? order.id.slice(0, 8)}</span> ·{' '}
              {formatOrderDate(order.created_at)}
            </p>
            {!isPaid && (
              <p class="mt-4 max-w-xl mx-auto text-sm text-white/80 leading-relaxed">
                Si ya pagaste, esto puede tardar unos segundos:{' '}
                <a href={Astro.url.pathname + Astro.url.search} class="text-oro-brillo underline underline-offset-2">
                  actualizar
                </a>.
                Si tu pago fue rechazado, el pedido quedará cancelado y no se fabricará.
              </p>
            )}
          </div>
        </section>

        <div class="page-container py-10 sm:py-14">
          <div class="grid lg:grid-cols-3 gap-8 lg:gap-10">
            <section class="lg:col-span-2">
              <h2 class="section-label mb-5">{t.order.tracking}</h2>
              <div class="card p-6 sm:p-8">
                {isClosed ? (
                  <>
                    <div class="flex items-center gap-3 mb-3">
                      <span
                        class={`w-3 h-3 rounded-full ${
                          order.status === 'cancelled' ? 'bg-red-400' : 'bg-oro-brillo'
                        }`}
                      ></span>
                      <p class="font-acentos text-base text-blancoRoto">{STATUS_LABEL[order.status as OrderStatus]}</p>
                    </div>
                    <p class="text-sm text-white/80">{STATUS_HINT[order.status as OrderStatus]}</p>
                  </>
                ) : (
                  steps.map((s, index) => (
                    <div class="flex gap-4">
                      <div class="flex flex-col items-center">
                        <span
                          class={`w-3.5 h-3.5 rounded-full border-2 ${
                            s.done ? 'bg-oro-brillo border-oro-brillo' : 'bg-transparent border-white/50'
                          }`}
                        ></span>
                        {index < steps.length - 1 && (
                          <span
                            class={`w-0.5 flex-1 my-1 ${s.done ? 'bg-oro-brillo' : 'bg-white/25'}`}
                          ></span>
                        )}
                      </div>
                      <div class={index === steps.length - 1 ? '' : 'pb-5'}>
                        <p
                          class={`font-acentos text-sm uppercase tracking-[0.14em] ${
                            s.active ? 'text-oro-brillo' : s.done ? 'text-blancoRoto' : 'text-white/80'
                          }`}
                        >
                          {STATUS_LABEL[s.step]}
                        </p>
                        {s.active && <p class="text-sm text-white/80 mt-1">{STATUS_HINT[s.step]}</p>}
                        {s.stamp && (
                          <p class="text-xs text-white/80 mt-1">
                            {new Date(s.stamp).toLocaleString(lang === 'en' ? 'en-US' : 'es-MX', {
                              day: 'numeric',
                              month: 'short',
                              hour: '2-digit',
                              minute: '2-digit',
                            })}
                          </p>
                        )}
                      </div>
                    </div>
                  ))
                )}

                {trackUrl && (
                  <div class="mt-6 pt-5 border-t-2 border-white/20">
                    <p class="text-sm text-blancoRoto mb-2">
                      {t.account.tracking} {order.carrier ?? ''} {order.tracking_number}
                    </p>
                    <a
                      href={trackUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-outline !min-h-[44px] !px-4 !py-2 !text-xs inline-flex"
                    >
                      {t.account.trackPackage}
                    </a>
                  </div>
                )}
              </div>

              <h2 class="section-label mt-10 mb-5">{t.order.pieces}</h2>
              <div class="card divide-y-2 divide-white/15">
                {order.order_items.map((i) => (
                  <div class="flex gap-4 p-4 sm:p-5">
                    <div class="w-16 h-20 sm:w-20 sm:h-24 shrink-0 bg-white border-2 border-white/30 overflow-hidden">
                      {i.image_url && (
                        <img src={i.image_url} alt={i.product_name ?? ''} class="w-full h-full object-contain" />
                      )}
                    </div>
                    <div class="flex-1 min-w-0">
                      <p class="font-acentos text-base text-blancoRoto">{i.product_name ?? t.common.piece}</p>
                      <p class="text-sm text-white/80">
                        {[i.size, i.color].filter(Boolean).join(' · ') || i.variant_name || ''} · Cantidad {i.quantity}
                      </p>
                    </div>
                    <p class="font-acentos text-base text-oro-brillo whitespace-nowrap">
                      {formatOrderMoney(Number(i.unit_price) * Number(i.quantity))}
                    </p>
                  </div>
                ))}
              </div>
            </section>

            <aside class="space-y-6">
              <div class="card p-6">
                <h2 class="section-label mb-4">{t.cart.summary}</h2>
                <div class="space-y-3 text-base">
                  <div class="flex justify-between">
                    <span class="text-white/80">{t.cart.subtotal}</span>
                    <span class="text-blancoRoto">{formatOrderMoney(subtotal)}</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-white/80">{t.cart.shipping}</span>
                    <span class="text-blancoRoto">
                      {shipping === 0 ? t.account.free : formatOrderMoney(shipping)}
                    </span>
                  </div>
                  <div class="flex justify-between pt-3 border-t-2 border-white/25">
                    <span class="font-acentos uppercase tracking-[0.16em] text-blancoRoto">{t.cart.total}</span>
                    <span class="font-acentos text-xl text-oro-brillo">
                      {formatOrderMoney(Number(order.total_amount))}
                    </span>
                  </div>
                </div>
              </div>

              <div class="card p-6">
                <h2 class="section-label mb-4">{t.order.shippingSection}</h2>
                <div class="text-base text-white/80 leading-relaxed">
                  <p class="text-blancoRoto mb-1">{order.contact_name ?? ''}</p>
                  <p>{order.shipping_street ?? ''}</p>
                  <p>
                    {order.shipping_colonia ? order.shipping_colonia + ', ' : ''}
                    {order.shipping_city ?? ''}
                  </p>
                  <p>
                    {order.shipping_state ?? ''} {order.shipping_postal_code ?? ''}
                  </p>
                  <p class="mt-2">{order.contact_phone ?? ''}</p>
                  <p>{order.contact_email ?? ''}</p>
                </div>
              </div>

              <div class="flex flex-col gap-3">
                <a href="/cuenta#pedidos" class="btn-gold w-full">{t.account.myOrders}</a>
                <a href="/tienda" class="btn-outline w-full">{t.cart.continueShopping}</a>
              </div>
            </aside>
          </div>
        </div>
      </div>
    )
  }
</BaseLayout>
