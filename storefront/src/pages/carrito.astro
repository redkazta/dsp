---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { createSupabaseServerClient } from '../lib/supabase-server';
import { FREE_SHIPPING_THRESHOLD } from '../lib/constants';
import { getCopy, categoryName, type Lang } from '../lib/i18n';
import { productName } from '../lib/product-texts';

const lang = (Astro.locals.lang ?? 'es') as Lang;
const t = getCopy(lang);

// Textos que necesita el script del navegador.
const ui = {
  one: t.common.itemOne,
  many: t.common.itemMany,
  free: t.cart.free,
  remove: t.cart.remove,
  removeOne: t.cart.removeOne,
  addOne: t.cart.addOne,
  freeShippingDone: t.cart.freeShippingDone,
  freeShippingMissing: t.cart.freeShippingMissing,
  forFree: t.cart.forFree,
  unavailableRemoved: t.cart.unavailableRemoved,
};

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);

const featured = await supabase
  .from('products')
  .select('id, name, name_en, slug, base_price, is_reflective, categories(name, slug), product_variants(price), product_images(url, position)')
  .eq('is_active', true)
  .eq('is_deleted', false)
  .order('created_at', { ascending: false })
  .limit(2);

const suggestions = (featured.data ?? []).map((p: any) => {
  const images = [...(p.product_images ?? [])].sort(
    (a: any, b: any) => (a.position ?? 0) - (b.position ?? 0)
  );
  return {
    id: p.id,
    name: productName(p as any, lang),
    slug: p.slug ?? p.id,
    category: categoryName(lang, p.categories),
    price: Number(p.product_variants?.[0]?.price ?? p.base_price ?? 0),
    image: images[0]?.url ?? null,
    isReflective: Boolean(p.is_reflective),
  };
});
---

<BaseLayout title={t.cart.metaTitle} description={t.cart.metaDescription}>
  <script type="application/json" id="cart-ui" set:html={JSON.stringify(ui)} />
  <section class="border-b-2 border-white/25 bg-noise">
    <div class="page-container py-4 sm:py-5">
      <div class="flex items-baseline justify-between gap-4">
        <h1 class="font-titulos text-2xl sm:text-3xl text-blancoRoto leading-none">{t.cart.title}</h1>
        <p id="cart-summary-text" class="text-white/70 text-sm sm:text-base">{t.common.loading}</p>
      </div>
    </div>
  </section>

  <div class="page-container py-5 sm:py-6">
    <div id="cart-empty" class="hidden">
      <div class="text-center py-10 sm:py-16">
        <p class="font-titulos text-2xl sm:text-3xl text-blancoRoto mb-4">{t.cart.emptyTitle}</p>
        <p class="text-white/80 mb-10">{t.cart.emptyText}</p>
        <a href="/tienda" class="btn-gold inline-block">{t.checkout.goShop}</a>
      </div>

      {
        suggestions.length > 0 && (
          <div class="max-w-3xl mx-auto mt-6">
            <h2 class="section-label mb-5 text-center">{t.cart.suggestions}</h2>
            <div class="grid grid-cols-2 gap-4 sm:gap-6">
              {suggestions.map((p) => (
                <a
                  href={`/producto/${p.slug}`}
                  class="group block border-2 border-white/25 hover:border-oro-brillo transition-colors"
                >
                  <div class="product-frame">
                    <span
                      class:list={['reflect-badge', { 'is-plain': !p.isReflective }]}
                      data-reflect-badge
                      data-label={p.isReflective ? t.product.reflective : t.product.notReflective}
                    >
                      <span class="reflect-badge-label">
                        {p.isReflective ? t.product.reflective : t.product.notReflective}
                      </span>
                      <span class="reflect-badge-dot"></span>
                    </span>
                    {p.image && (
                      <img
                        src={p.image}
                        alt={p.name}
                        class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500"
                        loading="lazy"
                      />
                    )}
                  </div>
                  <div class="p-4 flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <p class="font-acentos text-sm text-blancoRoto truncate">{p.name}</p>
                      <p class="text-xs text-white/70 mt-0.5">{p.category ?? t.common.piece}</p>
                    </div>
                    <p class="font-acentos text-sm text-oro-brillo whitespace-nowrap">
                      ${p.price.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>

    <div id="cart-content" class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_340px] xl:grid-cols-[minmax(0,1fr)_380px] gap-6 lg:gap-8">
      <!-- Items -->
      <div class="min-w-0">
        <ul id="cart-notices" class="hidden mb-3 space-y-2"></ul>
        <div id="cart-items" class="divide-y divide-white/15 border-y border-white/15"></div>
      </div>

      <!-- Resumen: primero en móvil, al lado en desktop -->
      <aside class="order-first lg:order-last">
        <div class="lg:sticky lg:top-24 border-2 border-white/25 p-5 sm:p-6 bg-negro-carbono">
          <h2 class="font-titulos text-lg text-blancoRoto mb-4">{t.cart.summary}</h2>

          <div class="space-y-2.5 pb-4 border-b border-white/20">
            <div class="flex justify-between text-sm">
              <span class="text-white/75">{t.cart.subtotal}</span>
              <span id="sum-subtotal" class="text-blancoRoto">$0.00</span>
            </div>
            <div class="flex justify-between gap-3 text-sm">
              <span class="text-white/75">{t.cart.shipping}</span>
              <span id="sum-shipping" class="text-blancoRoto text-right">{t.cart.shippingAtPay}</span>
            </div>
            <div id="free-shipping-progress" class="hidden">
              <div class="h-1 bg-white/20 mb-1.5">
                <div id="free-shipping-bar" class="h-full bg-oro-brillo transition-all duration-500" style="width:0%"></div>
              </div>
              <p id="free-shipping-text" class="text-[11px] text-white/75 leading-snug"></p>
            </div>
          </div>

          <div class="flex justify-between items-baseline py-3.5">
            <span class="font-acentos text-xs uppercase tracking-[0.18em] text-blancoRoto">{t.cart.total}</span>
            <span id="sum-total" class="font-acentos text-2xl text-oro-brillo">$0.00</span>
          </div>

          <a href="/checkout" class="btn-gold w-full !min-h-[46px] mb-2">{t.cart.checkout}</a>
          <a href="/tienda" class="btn-outline w-full !min-h-[42px] mb-2 text-center !text-xs">{t.cart.continueShopping}</a>
          <a
            href="/favoritos"
            class="block text-center text-xs uppercase tracking-[0.14em] text-white/70 hover:text-oro-brillo py-1.5"
          >
            {t.cart.viewWishlist}
          </a>

          <div class="mt-4 pt-4 border-t border-white/20 space-y-1.5">
            <p class="flex items-center gap-2 text-xs text-white/75">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FFE28A" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
              {t.cart.freeFrom} {`$${FREE_SHIPPING_THRESHOLD.toLocaleString('en-US')} USD`}
            </p>
            <p class="text-[11px] text-white/55 leading-snug">{t.cart.madeToOrderTime}</p>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <script>
    import {
      getCart,
      updateQty,
      removeFromCart,
      cartSubtotal,
      refreshCartPrices,
      formatMXN,
      startCartSync,
    } from '../lib/cart';
    import { FREE_SHIPPING_THRESHOLD, STANDARD_SHIPPING, shippingCostFor } from '../lib/pricing';
    import { escapeHtml, safeUrl } from '../lib/html';

    const ui = JSON.parse(document.getElementById('cart-ui')?.textContent || '{}') as Record<string, string>;
    const uiText = (key: string) => ui[key] ?? '';

    const empty = document.getElementById('cart-empty')!;
    const content = document.getElementById('cart-content')!;
    const list = document.getElementById('cart-items')!;
    const notices = document.getElementById('cart-notices')!;
    const summaryText = document.getElementById('cart-summary-text')!;

    function render() {
      const items = getCart();

      if (items.length === 0) {
        empty.classList.remove('hidden');
        content.classList.add('hidden');
        summaryText.textContent = `0 ${uiText('many')}`;
        return;
      }

      empty.classList.add('hidden');
      content.classList.remove('hidden');
      const count = items.reduce((n, i) => n + i.qty, 0);
      summaryText.textContent = `${count} ${count === 1 ? uiText('one') : uiText('many')}`;

      list.innerHTML = items
        .map((i) => {
          const img = safeUrl(i.image);
          return `
        <div class="cart-row flex items-center gap-4 py-3.5 sm:py-4" data-row="${escapeHtml(i.variantId)}">
          <div class="w-16 h-16 sm:w-[72px] sm:h-[72px] bg-white border border-white/25 overflow-hidden shrink-0">
            ${img ? `<img src="${img}" alt="${escapeHtml(i.name)}" class="w-full h-full object-contain">` : ''}
          </div>

          <div class="flex-1 min-w-0">
            <h3 class="font-acentos text-sm sm:text-[15px] text-blancoRoto truncate">${escapeHtml(i.name)}</h3>
            <p class="text-xs text-white/65 truncate mt-0.5">${escapeHtml(i.variantName)}</p>
          </div>

          <div class="flex items-center border border-white/30 shrink-0">
            <button data-dec="${escapeHtml(i.variantId)}" aria-label="${uiText('removeOne')}"
              class="w-8 h-8 text-blancoRoto hover:text-oro-brillo hover:bg-white/5 transition-colors text-sm leading-none">−</button>
            <span class="w-8 text-center text-sm text-blancoRoto tabular-nums">${i.qty}</span>
            <button data-inc="${escapeHtml(i.variantId)}" aria-label="${uiText('addOne')}"
              class="w-8 h-8 text-blancoRoto hover:text-oro-brillo hover:bg-white/5 transition-colors text-sm leading-none">+</button>
          </div>

          <p class="font-acentos text-sm sm:text-base text-oro-brillo whitespace-nowrap w-[76px] text-right shrink-0 tabular-nums">$${formatMXN(i.price * i.qty)}</p>

          <button data-remove="${escapeHtml(i.variantId)}"
            aria-label="${uiText('remove')}: ${escapeHtml(i.name)}"
            title="${uiText('remove')}"
            class="remove-btn w-9 h-9 shrink-0 inline-flex items-center justify-center border border-white/25 text-white/60 hover:border-red-400 hover:text-red-400 hover:bg-red-400/10 transition-colors">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v5M14 11v5" />
            </svg>
          </button>
        </div>`;
        })
        .join('');

      const subtotal = cartSubtotal();
      const shipping = shippingCostFor(subtotal);

      document.getElementById('sum-subtotal')!.textContent = `$${formatMXN(subtotal)}`;
      document.getElementById('sum-total')!.textContent = `$${formatMXN(subtotal + shipping)}`;
      document.getElementById('sum-shipping')!.textContent =
        subtotal === 0 ? '—' : shipping === 0 ? uiText('free') : `$${formatMXN(STANDARD_SHIPPING)}`;

      const progress = document.getElementById('free-shipping-progress')!;
      const bar = document.getElementById('free-shipping-bar')!;
      const text = document.getElementById('free-shipping-text')!;

      progress.classList.remove('hidden');
      if (subtotal >= FREE_SHIPPING_THRESHOLD) {
        bar.style.width = '100%';
        text.textContent = uiText('freeShippingDone');
      } else {
        bar.style.width = `${Math.min(100, (subtotal / FREE_SHIPPING_THRESHOLD) * 100)}%`;
        text.textContent = `${uiText('freeShippingMissing')} $${formatMXN(FREE_SHIPPING_THRESHOLD - subtotal)} ${uiText('forFree')}`;
      }

      list.querySelectorAll<HTMLElement>('[data-inc]').forEach((b) =>
        b.addEventListener('click', () => {
          const id = b.dataset.inc!;
          const item = getCart().find((i) => i.variantId === id);
          updateQty(id, (item?.qty ?? 0) + 1);
          render();
        })
      );
      list.querySelectorAll<HTMLElement>('[data-dec]').forEach((b) =>
        b.addEventListener('click', () => {
          const id = b.dataset.dec!;
          const item = getCart().find((i) => i.variantId === id);
          if ((item?.qty ?? 0) <= 1) removeFromCart(id);
          else updateQty(id, item!.qty - 1);
          render();
        })
      );
      list.querySelectorAll<HTMLElement>('[data-remove]').forEach((b) =>
        b.addEventListener('click', () => {
          // Se desvanece antes de desaparecer: el usuario ve QUÉ se borró.
          const row = b.closest('.cart-row') as HTMLElement | null;
          if (row) {
            row.classList.add('is-removing');
            window.setTimeout(() => {
              removeFromCart(b.dataset.remove!);
              render();
            }, 220);
            return;
          }
          removeFromCart(b.dataset.remove!);
          render();
        })
      );
    }

    function showNotices(messages: string[]) {
      if (messages.length === 0) {
        notices.classList.add('hidden');
        notices.innerHTML = '';
        return;
      }
      notices.classList.remove('hidden');
      notices.innerHTML = messages
        .map(
          (m) =>
            `<li class="border-2 border-oro-brillo/50 bg-oro-brillo/5 px-4 py-3 text-sm text-blancoRoto">${escapeHtml(m)}</li>`
        )
        .join('');
    }

    // Precios y disponibilidad en el servidor: si algo cambió, se avisa.
    refreshCartPrices()
      .then(({ removed }) => {
        if (removed.length > 0) {
          showNotices([
            uiText('unavailableRemoved') + ` (${removed.length})`,
          ]);
        }
        render();
      })
      .catch(() => render());

    render();

    // Cambios desde otra pestaña: se repinta la página sin recargar.
    startCartSync();
    window.addEventListener('cart:updated', () => render());
  </script>

  <style>
    /* Ítem compacto: todo en una fila, la fila se desvanece al borrar. */
    .cart-row {
      transition:
        opacity 0.2s ease,
        transform 0.2s ease;
    }

    .cart-row.is-removing {
      opacity: 0;
      transform: translateX(14px);
      pointer-events: none;
    }

    /* En pantallas estrechas la fila se reordena en dos líneas. */
    @media (max-width: 639px) {
      .cart-row {
        flex-wrap: wrap;
        row-gap: 0.6rem;
      }

      .cart-row > div:first-child {
        order: 1;
      }

      .cart-row .min-w-0 {
        order: 2;
        flex-basis: calc(100% - 5rem);
      }

      .cart-row > div.flex {
        order: 3;
        margin-left: 5rem;
      }

      .cart-row > p {
        order: 4;
        width: auto !important;
        flex: 1;
      }

      .cart-row .remove-btn {
        order: 5;
      }
    }

    /* El grid debe poder encogerse: sin `min-width: 0` la columna del
       resumen empuja el ancho y la página desborda en móvil. */
    #cart-content > * {
      min-width: 0;
    }

    @media (prefers-reduced-motion: reduce) {
      .cart-row {
        transition: none;
      }
    }
  </style>
</BaseLayout>
