---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={t.account.newPasswordMetaTitle} description={t.account.newPasswordMetaDescription}>
  <script type="application/json" id="pwd-ui" set:html={JSON.stringify(ui)} />
  <section class="min-h-[calc(100dvh-8rem)] flex items-start sm:items-center justify-center px-5 sm:px-6 py-10 sm:py-16 bg-noise">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <p class="section-label mb-3">{t.nav.cuenta}</p>
        <h1 class="font-titulos text-3xl sm:text-4xl text-blancoRoto mb-4">{t.account.newPasswordTitle}</h1>
        <div class="gold-line mx-auto"></div>
      </div>

      <div id="pw-waiting" class="hidden text-center">
        <p class="text-sm text-white/80 leading-relaxed mb-6">{t.common.loading}</p>
      </div>

      <div id="pw-invalid" class="hidden text-center">
        <p class="text-base text-white/80 leading-relaxed mb-6">
          {t.account.newPasswordIntro}
        </p>
        <a href="/recuperar" class="btn-gold inline-flex">{t.account.recoverSubmit}</a>
      </div>

      <form id="pw-form" class="space-y-4 hidden" novalidate>
        <label class="block">
          <span class="field-label">{t.account.password} *</span>
          <input
            type="password"
            name="password"
            placeholder={t.account.passwordNewPlaceholder}
            required
            minlength="8"
            class="input-dark"
            autocomplete="new-password"
          />
        </label>

        <label class="block">
          <span class="field-label">{t.account.passwordConfirm} *</span>
          <input
            type="password"
            name="confirmPassword"
            placeholder={t.account.passwordConfirmPlaceholder}
            required
            minlength="8"
            class="input-dark"
            autocomplete="new-password"
          />
        </label>

        <button type="submit" id="pw-submit" class="btn-gold w-full">{t.account.newPasswordSubmit}</button>

        <p id="pw-error" role="alert" class="hidden text-sm text-red-400 text-center leading-relaxed"></p>
        <p id="pw-ok" role="status" class="hidden text-sm text-oro-brillo text-center leading-relaxed">
          {t.account.newPasswordSaving}
        </p>
      </form>
    </div>
  </section>

  <style>
    .field-label {
      display: block;
      margin-bottom: 0.5rem;
      font-family: 'Space Grotesk', Inter, sans-serif;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #ffe28a;
    }
  </style>

  <script>
    import { supabase } from '../lib/supabase';
    import { updatePassword } from '../lib/auth';

    const ui = JSON.parse(document.getElementById('pwd-ui')?.textContent || '{}') as Record<string, string>;

    const waiting = document.getElementById('pw-waiting')!;
    const invalid = document.getElementById('pw-invalid')!;
    const form = document.getElementById('pw-form') as HTMLFormElement;
    const submit = document.getElementById('pw-submit') as HTMLButtonElement;
    const errorEl = document.getElementById('pw-error')!;
    const okEl = document.getElementById('pw-ok')!;

    /**
     * El enlace de Supabase regresa con una sesión temporal (hash o ?code=).
     * Si no hay sesión, el enlace no es válido para cambiar la contraseña.
     */
    async function init() {
      const params = new URLSearchParams(window.location.search);
      const code = params.get('code');
      const tokenHash = params.get('token_hash');
      const type = params.get('type');

      if (code) {
        await supabase.auth.exchangeCodeForSession(code).catch(() => undefined);
      } else if (tokenHash && type) {
        await supabase.auth.verifyOtp({ token_hash: tokenHash, type: type as any }).catch(() => undefined);
      }

      // Limpia el hash de la URL con datos de sesión
      if (window.location.hash) {
        history.replaceState(null, '', window.location.pathname);
      }

      const {
        data: { session },
      } = await supabase.auth.getSession();

      waiting.classList.add('hidden');

      if (!session) {
        invalid.classList.remove('hidden');
        return;
      }

      form.classList.remove('hidden');
      (form.elements.namedItem('password') as HTMLInputElement).focus();
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.classList.add('hidden');
      okEl.classList.add('hidden');

      const data = new FormData(form);
      const password = String(data.get('password') ?? '');
      const confirm = String(data.get('confirmPassword') ?? '');

      if (password.length < 8) {
        errorEl.textContent = ui.tooShort;
        errorEl.classList.remove('hidden');
        return;
      }

      if (password !== confirm) {
        errorEl.textContent = ui.mismatch;
        errorEl.classList.remove('hidden');
        return;
      }

      submit.disabled = true;
      const { error } = await updatePassword(password);
      submit.disabled = false;

      if (error) {
        errorEl.textContent = ui.failed;
        errorEl.classList.remove('hidden');
        return;
      }

      okEl.classList.remove('hidden');
      setTimeout(() => (window.location.href = '/cuenta'), 1200);
    });

    init();
  </script>
</BaseLayout>
