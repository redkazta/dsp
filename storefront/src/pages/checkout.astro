---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';

const apiUrl = import.meta.env.PUBLIC_API_URL ?? '';
void apiUrl;
---

<BaseLayout title="Checkout | Dinero Sobre Problemas" description="Completa tu compra de forma segura.">
  <section class="border-b-2 border-white/25 bg-noise">
    <div class="page-container py-10 sm:py-12">
      <nav class="mb-6">
        <ol class="flex items-center gap-2 font-acentos text-xs uppercase tracking-[0.2em] text-white/80">
          <li><a href="/carrito" class="hover:text-oro-brillo transition-colors">Carrito</a></li>
          <li>/</li>
          <li class="text-oro-brillo">Checkout</li>
        </ol>
      </nav>
      <h1 class="font-titulos text-3xl sm:text-4xl lg:text-5xl text-blancoRoto">Finalizar compra</h1>
      <p class="mt-3 text-base text-white/80">Producción bajo pedido · Pago seguro simulado</p>
    </div>
  </section>

  <div id="checkout-empty" class="hidden max-w-3xl mx-auto px-5 py-24 sm:py-32 text-center">
    <p class="font-titulos text-3xl text-blancoRoto mb-6">Tu carrito está vacío</p>
    <div class="gold-line mx-auto mb-8"></div>
    <a href="/tienda" class="btn-gold inline-flex">Ir a la tienda</a>
  </div>

  <div id="checkout-content" class="hidden page-container py-8 sm:py-12 lg:py-16">
    <form id="checkout-form" class="grid lg:grid-cols-3 gap-8 lg:gap-12" novalidate>
      <!-- Datos -->
      <div class="lg:col-span-2 space-y-10 order-2 lg:order-1">
        <!-- Contacto -->
        <fieldset>
          <legend class="flex items-center gap-3 mb-6">
            <span class="w-8 h-8 border-2 border-oro-brillo text-oro-brillo flex items-center justify-center font-acentos text-sm shrink-0">1</span>
            <span class="font-acentos text-base uppercase tracking-[0.2em] text-blancoRoto">Contacto</span>
          </legend>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <label class="block">
              <span class="field-label">Nombre *</span>
              <input name="firstName" required class="input-dark" autocomplete="given-name" />
            </label>
            <label class="block">
              <span class="field-label">Apellidos *</span>
              <input name="lastName" required class="input-dark" autocomplete="family-name" />
            </label>
            <label class="block sm:col-span-2">
              <span class="field-label">Correo *</span>
              <input name="email" type="email" required class="input-dark" autocomplete="email" inputmode="email" />
            </label>
            <label class="block sm:col-span-2">
              <span class="field-label">Teléfono *</span>
              <input name="phone" type="tel" required class="input-dark" autocomplete="tel" inputmode="tel" placeholder="10 dígitos" />
            </label>
          </div>
        </fieldset>

        <!-- Envío -->
        <fieldset>
          <legend class="flex items-center gap-3 mb-6">
            <span class="w-8 h-8 border-2 border-oro-brillo text-oro-brillo flex items-center justify-center font-acentos text-sm shrink-0">2</span>
            <span class="font-acentos text-base uppercase tracking-[0.2em] text-blancoRoto">Dirección de envío</span>
          </legend>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <label class="block sm:col-span-2">
              <span class="field-label">Calle y número *</span>
              <input name="street" required class="input-dark" autocomplete="street-address" />
            </label>
            <label class="block">
              <span class="field-label">Colonia *</span>
              <input name="colonia" required class="input-dark" />
            </label>
            <label class="block">
              <span class="field-label">Código postal *</span>
              <input name="postalCode" required class="input-dark" autocomplete="postal-code" inputmode="numeric" />
            </label>
            <label class="block">
              <span class="field-label">Ciudad *</span>
              <input name="city" required class="input-dark" autocomplete="address-level2" />
            </label>
            <label class="block">
              <span class="field-label">Estado *</span>
              <input name="state" required class="input-dark" autocomplete="address-level1" />
            </label>
            <label class="block sm:col-span-2">
              <span class="field-label">Referencias</span>
              <input name="references" class="input-dark" placeholder="Entre calles, número de casa…" />
            </label>
            <label class="block sm:col-span-2">
              <span class="field-label">Notas del pedido</span>
              <textarea
                name="notes"
                rows="3"
                class="input-dark !min-h-[96px] py-3"
                placeholder="Diseño, color, talla especial o cualquier indicación."
              ></textarea>
            </label>
          </div>
        </fieldset>

        <!-- Pago -->
        <fieldset>
          <legend class="flex items-center gap-3 mb-6">
            <span class="w-8 h-8 border-2 border-oro-brillo text-oro-brillo flex items-center justify-center font-acentos text-sm shrink-0">3</span>
            <span class="font-acentos text-base uppercase tracking-[0.2em] text-blancoRoto">Pago</span>
          </legend>

          <div class="border-2 border-oro-brillo/60 bg-negro-carbono p-5 sm:p-6">
            <div class="flex items-start gap-3 mb-6">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFE28A" stroke-width="2" class="mt-0.5 shrink-0">
                <rect x="2" y="5" width="20" height="14" rx="2" /><path d="M2 10h20" />
              </svg>
              <div>
                <p class="text-base text-blancoRoto font-semibold">Tarjeta de crédito o débito</p>
                <p class="text-sm text-white/80 leading-relaxed mt-1">
                  Modo de prueba: no se cobra nada. Usa cualquier tarjeta válida de 16 dígitos.
                </p>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <label class="block sm:col-span-2">
                <span class="field-label">Número de tarjeta *</span>
                <input
                  name="cardNumber"
                  id="card-number"
                  required
                  inputmode="numeric"
                  autocomplete="cc-number"
                  placeholder="4242 4242 4242 4242"
                  maxlength="19"
                  class="input-dark"
                />
              </label>
              <label class="block sm:col-span-2">
                <span class="field-label">Nombre en la tarjeta *</span>
                <input name="cardName" required class="input-dark" autocomplete="cc-name" />
              </label>
              <label class="block">
                <span class="field-label">Vigencia MM/AA *</span>
                <input
                  name="cardExpiry"
                  id="card-expiry"
                  required
                  autocomplete="cc-exp"
                  placeholder="12/29"
                  maxlength="5"
                  class="input-dark"
                />
              </label>
              <label class="block">
                <span class="field-label">CVV *</span>
                <input
                  name="cardCvv"
                  required
                  inputmode="numeric"
                  autocomplete="cc-csc"
                  placeholder="123"
                  maxlength="4"
                  class="input-dark"
                />
              </label>
            </div>

            <p class="mt-4 text-xs text-white/80">
              Prueba de rechazo: <span class="text-oro-brillo">4000 0000 0000 0002</span>
            </p>
          </div>
        </fieldset>
      </div>

      <!-- Resumen -->
      <aside class="lg:col-span-1 order-1 lg:order-2">
        <div class="lg:sticky lg:top-28 border-2 border-white/25 p-6 sm:p-8 bg-negro-carbono">
          <h2 class="font-titulos text-2xl text-blancoRoto mb-6">Tu pedido</h2>
          <div id="checkout-items" class="divide-y-2 divide-white/15 mb-6"></div>

          <div class="space-y-3 pb-4 border-b-2 border-white/25 text-base">
            <div class="flex justify-between">
              <span class="text-white/80">Subtotal</span>
              <span id="co-subtotal" class="text-blancoRoto">$0.00</span>
            </div>
            <div class="flex justify-between">
              <span class="text-white/80">Envío</span>
              <span id="co-shipping" class="text-blancoRoto">—</span>
            </div>
          </div>

          <div class="flex justify-between items-center py-5">
            <span class="font-acentos text-base uppercase tracking-[0.2em] text-blancoRoto">Total</span>
            <span id="co-total" class="font-acentos text-3xl text-oro-brillo font-medium">$0.00</span>
          </div>

          <button type="submit" id="pay-btn" class="btn-gold w-full">
            Pagar y confirmar
          </button>

          <p id="pay-error" role="alert" class="hidden mt-4 text-sm text-red-400 text-center leading-relaxed"></p>

          <p class="mt-6 text-xs text-white/80 text-center leading-relaxed">
            Al confirmar aceptas nuestros términos y política de privacidad.
          </p>
        </div>
      </aside>
    </form>
  </div>

  <style>
    .field-label {
      display: block;
      margin-bottom: 0.5rem;
      font-family: 'Space Grotesk', Inter, sans-serif;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #ffe28a;
    }
  </style>

  <script>
    import { getCart, formatMXN } from '../lib/cart';
    import {
      createOrder,
      shippingCostFor,
      validateSimulatedCard,
      FREE_SHIPPING_THRESHOLD,
      STANDARD_SHIPPING,
    } from '../lib/orders';
    import { getProfile } from '../lib/auth';

    const form = document.getElementById('checkout-form') as HTMLFormElement;
    const payBtn = document.getElementById('pay-btn') as HTMLButtonElement;
    const errorEl = document.getElementById('pay-error')!;

    function renderSummary() {
      const items = getCart();
      const empty = document.getElementById('checkout-empty')!;
      const content = document.getElementById('checkout-content')!;

      if (items.length === 0) {
        empty.classList.remove('hidden');
        content.classList.add('hidden');
        return;
      }

      empty.classList.add('hidden');
      content.classList.remove('hidden');

      document.getElementById('checkout-items')!.innerHTML = items
        .map(
          (i) => `
        <div class="flex justify-between items-center gap-3 py-3">
          <div class="min-w-0">
            <p class="text-base text-blancoRoto">${i.name}</p>
            <p class="text-sm text-white/80">${i.variantName} × ${i.qty}</p>
          </div>
          <span class="text-base font-acentos text-oro-brillo whitespace-nowrap">$${formatMXN(i.price * i.qty)}</span>
        </div>`
        )
        .join('');

      const subtotal = items.reduce((sum, i) => sum + i.price * i.qty, 0);
      const shipping = shippingCostFor(subtotal);

      document.getElementById('co-subtotal')!.textContent = `$${formatMXN(subtotal)}`;
      document.getElementById('co-shipping')!.textContent =
        shipping === 0 ? 'Gratis' : `$${formatMXN(STANDARD_SHIPPING)}`;
      document.getElementById('co-total')!.textContent = `$${formatMXN(subtotal + shipping)}`;

      return subtotal;
    }

    function showError(message: string) {
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
      errorEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    // Prellenar con los datos de la cuenta
    getProfile()
      .then((profile) => {
        if (!profile) return;
        const set = (name: string, value: string | null | undefined) => {
          const el = form.elements.namedItem(name) as HTMLInputElement | null;
          if (el && !el.value && value) el.value = value;
        };
        set('firstName', profile.first_name);
        set('lastName', profile.last_name);
        set('email', profile.email);
        set('phone', profile.phone);
      })
      .catch(() => {});

    // Formato amable de la tarjeta
    const cardNumber = document.getElementById('card-number') as HTMLInputElement;
    cardNumber?.addEventListener('input', () => {
      const digits = cardNumber.value.replace(/\D/g, '').slice(0, 16);
      cardNumber.value = digits.replace(/(.{4})/g, '$1 ').trim();
    });

    const cardExpiry = document.getElementById('card-expiry') as HTMLInputElement;
    cardExpiry?.addEventListener('input', () => {
      const digits = cardExpiry.value.replace(/\D/g, '').slice(0, 4);
      cardExpiry.value = digits.length > 2 ? `${digits.slice(0, 2)}/${digits.slice(2)}` : digits;
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.classList.add('hidden');

      const items = getCart();
      if (items.length === 0) return;

      const data = new FormData(form);
      const value = (name: string) => String(data.get(name) ?? '').trim();

      const required: Array<[string, string]> = [
        ['firstName', 'Escribe tu nombre.'],
        ['lastName', 'Escribe tus apellidos.'],
        ['email', 'Escribe tu correo.'],
        ['phone', 'Escribe tu teléfono.'],
        ['street', 'Escribe tu calle y número.'],
        ['colonia', 'Escribe tu colonia.'],
        ['postalCode', 'Escribe tu código postal.'],
        ['city', 'Escribe tu ciudad.'],
        ['state', 'Escribe tu estado.'],
      ];

      for (const [field, message] of required) {
        if (!value(field)) {
          showError(message);
          (form.elements.namedItem(field) as HTMLInputElement)?.focus();
          return;
        }
      }

      const card = validateSimulatedCard({
        number: value('cardNumber'),
        name: value('cardName'),
        expiry: value('cardExpiry'),
        cvv: value('cardCvv'),
      });

      if (!card.ok) {
        showError(card.error);
        return;
      }

      payBtn.disabled = true;
      payBtn.textContent = 'Procesando pago…';

      try {
        const order = await createOrder(
          items,
          {
            firstName: value('firstName'),
            lastName: value('lastName'),
            email: value('email'),
            phone: value('phone'),
            street: value('street'),
            colonia: value('colonia'),
            city: value('city'),
            state: value('state'),
            postalCode: value('postalCode'),
            references: value('references'),
            notes: value('notes'),
          },
          { method: 'simulated', approved: true }
        );

        window.location.href = `/confirmacion?order=${encodeURIComponent(order.order_number ?? order.id)}`;
      } catch (err: any) {
        showError(err?.message ?? 'No pudimos registrar tu pedido. Intenta de nuevo.');
        payBtn.disabled = false;
        payBtn.textContent = 'Pagar y confirmar';
      }
    });

    renderSummary();
  </script>
</BaseLayout>
