---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getCopy, type Lang } from '../lib/i18n';

const lang = (Astro.locals.lang ?? 'es') as Lang;
const t = getCopy(lang);

// Textos y mensajes del script del navegador.
const ui = {
  required: t.checkout.required,
  invalidEmail: t.checkout.invalidEmail,
  invalidPhone: t.checkout.invalidPhone,
  invalidPostal: t.checkout.invalidPostal,
  fixErrors: t.checkout.fixErrors,
  emptyCartError: t.checkout.emptyCartError,
  waitCart: t.checkout.waitCart,
  opening: t.checkout.opening,
  pay: t.checkout.pay,
  openFailed: t.checkout.openFailed,
  connection: t.checkout.connection,
  unavailable: t.checkout.cardUnavailable,
  noSession: t.errors.noSession,
  pieceOne: t.checkout.pieceOne,
  pieceMany: t.checkout.pieceMany,
  removedPieces: t.checkout.removedPieces,
  unavailableNow: t.checkout.unavailableNow,
  free: t.cart.free,
};

const { firstName, email, phone } = Astro.locals;

const paymentAvailable = Boolean(
  import.meta.env.STRIPE_SECRET_KEY && import.meta.env.PUBLIC_STRIPE_PUBLISHABLE_KEY
);
const canceled = Astro.url.searchParams.get('canceled') === '1';
---

<BaseLayout title={t.checkout.metaTitle} description={t.checkout.metaDescription}>
  <script type="application/json" id="checkout-ui" set:html={JSON.stringify(ui)} />
  <section class="border-b-2 border-white/25 bg-noise">
    <div class="page-container py-10 sm:py-12">
      <nav class="mb-6">
        <ol class="flex items-center gap-2 font-acentos text-xs uppercase tracking-[0.2em] text-white/80">
          <li><a href="/carrito" class="hover:text-oro-brillo transition-colors">{t.cart.title}</a></li>
          <li>/</li>
          <li class="text-oro-brillo">{t.checkout.title}</li>
        </ol>
      </nav>
      <h1 class="font-titulos text-3xl sm:text-4xl lg:text-5xl text-blancoRoto">{t.checkout.title}</h1>
      <p class="mt-3 text-base text-white/80">{t.checkout.subtitle}</p>
    </div>
  </section>

  <div
    id="checkout-alert"
    role="alert"
    class="hidden max-w-3xl mx-auto px-5 py-3 mb-4 bg-oro-brillo/10 border-2 border-oro-brillo text-oro-brillo text-sm font-acentos tracking-wide rounded-sm"
  ></div>

  <div id="checkout-empty" class="hidden max-w-3xl mx-auto px-5 py-24 sm:py-32 text-center">
    <p class="font-titulos text-3xl text-blancoRoto mb-6">{t.checkout.emptyTitle}</p>
    <div class="gold-line mx-auto mb-8"></div>
    <a href="/tienda" class="btn-gold inline-flex">{t.checkout.goShop}</a>
  </div>

  <div id="checkout-content" class="page-container py-8 sm:py-12 lg:py-16">
    <div class="grid lg:grid-cols-3 gap-8 lg:gap-12">
      <!-- Formulario principal -->
      <div class="lg:col-span-2 order-2 lg:order-1">
        <form id="checkout-form" class="space-y-8" novalidate>
          <!-- Sección de contacto -->
          <section class="bg-negro-carbono border-2 border-white/25 p-6 sm:p-8">
            <h2 class="font-titulos text-2xl text-blancoRoto mb-6 flex items-center gap-3">
              <span class="w-8 h-8 border-2 border-oro-brillo text-oro-brillo flex items-center justify-center font-acentos text-sm">1</span>
              {t.checkout.step1}
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-2">
                <label class="field-label" for="firstName">{t.checkout.firstName} *</label>
                <input
                  id="firstName"
                  name="firstName"
                  required
                  class="input-dark"
                  autocomplete="given-name"
                  value={firstName ?? ''}
                />
              </div>
              <div class="space-y-2">
                <label class="field-label" for="lastName">{t.checkout.lastName} *</label>
                <input
                  id="lastName"
                  name="lastName"
                  required
                  class="input-dark"
                  autocomplete="family-name"
                />
              </div>
              <div class="space-y-2 sm:col-span-2">
                <label class="field-label" for="email">{t.checkout.email} *</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  class="input-dark"
                  autocomplete="email"
                  inputmode="email"
                  value={email ?? ''}
                />
              </div>
              <div class="space-y-2 sm:col-span-2">
                <label class="field-label" for="phone">{t.checkout.phone} *</label>
                <input
                  id="phone"
                  name="phone"
                  type="tel"
                  required
                  class="input-dark"
                  autocomplete="tel"
                  inputmode="tel"
                  placeholder={t.checkout.phonePlaceholder}
                  value={phone ?? ''}
                />
              </div>
            </div>
          </section>

          <!-- Sección de envío -->
          <section class="bg-negro-carbono border-2 border-white/25 p-6 sm:p-8">
            <h2 class="font-titulos text-2xl text-blancoRoto mb-6 flex items-center gap-3">
              <span class="w-8 h-8 border-2 border-oro-brillo text-oro-brillo flex items-center justify-center font-acentos text-sm">2</span>
              {t.checkout.step2}
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-2 sm:col-span-2">
                <label class="field-label" for="street">{t.checkout.street} *</label>
                <input
                  id="street"
                  name="street"
                  required
                  class="input-dark"
                  autocomplete="street-address"
                />
              </div>
              <div class="space-y-2">
                <label class="field-label" for="colonia">{t.checkout.colonia} *</label>
                <input id="colonia" name="colonia" required class="input-dark" />
              </div>
              <div class="space-y-2">
                <label class="field-label" for="postalCode">{t.checkout.postalCode} *</label>
                <input
                  id="postalCode"
                  name="postalCode"
                  required
                  class="input-dark"
                  autocomplete="postal-code"
                  inputmode="numeric"
                  maxlength="5"
                />
              </div>
              <div class="space-y-2">
                <label class="field-label" for="city">{t.checkout.city} *</label>
                <input
                  id="city"
                  name="city"
                  required
                  class="input-dark"
                  autocomplete="address-level2"
                />
              </div>
              <div class="space-y-2">
                <label class="field-label" for="state">{t.checkout.state} *</label>
                <input
                  id="state"
                  name="state"
                  required
                  class="input-dark"
                  autocomplete="address-level1"
                />
              </div>
              <div class="space-y-2 sm:col-span-2">
                <label class="field-label" for="references">{t.checkout.references}</label>
                <input
                  id="references"
                  name="references"
                  class="input-dark"
                  placeholder={t.checkout.referencesPlaceholder}
                />
              </div>
              <div class="space-y-2 sm:col-span-2">
                <label class="field-label" for="notes">{t.checkout.notes}</label>
                <textarea
                  id="notes"
                  name="notes"
                  rows="3"
                  class="input-dark !min-h-[96px] py-3"
                  placeholder={t.checkout.notesPlaceholder}
                ></textarea>
              </div>
            </div>
          </section>

          <!-- Sección de pago -->
          <section class="bg-negro-carbono border-2 border-white/25 p-6 sm:p-8">
            <h2 class="font-titulos text-2xl text-blancoRoto mb-6 flex items-center gap-3">
              <span class="w-8 h-8 border-2 border-oro-brillo text-oro-brillo flex items-center justify-center font-acentos text-sm">3</span>
              {t.checkout.step3}
            </h2>

            <div class="border-2 border-oro-brillo/60 bg-negro-carbono p-5 sm:p-6">
              <div class="flex items-start gap-3">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFE28A" stroke-width="2" class="mt-0.5 shrink-0">
                  <rect x="2" y="5" width="20" height="14" rx="2" /><path d="M2 10h20" />
                </svg>
                <div>
                  <p class="text-base text-blancoRoto font-semibold">{t.checkout.cardTitle}</p>
                  <p class="text-sm text-white/80 leading-relaxed mt-1">
                    {paymentAvailable ? t.checkout.cardText : t.checkout.cardUnavailable}
                  </p>
                </div>
              </div>
            </div>
          </section>
        </form>
      </div>

      <!-- Resumen del pedido -->
      <aside class="lg:col-span-1 order-1 lg:order-2">
        <div class="lg:sticky lg:top-28 bg-negro-carbono border-2 border-white/25 p-6 sm:p-8">
          <h2 class="font-titulos text-2xl text-blancoRoto mb-6">{t.checkout.orderTitle}</h2>
          <div id="checkout-items" class="divide-y-2 divide-white/15 mb-6">
            <!-- Los items se renderizan aquí -->
          </div>

          <p
            id="checkout-summary-error"
            role="status"
            class="hidden mb-4 text-sm text-oro-brillo leading-relaxed border-2 border-oro-brillo/50 px-3 py-2"
          ></p>

          <div class="space-y-3 pb-4 border-b-2 border-white/25 text-base">
            <div class="flex justify-between">
              <span class="text-white/80">{t.cart.subtotal}</span>
              <span id="co-subtotal" class="text-blancoRoto">$0.00</span>
            </div>
            <div class="flex justify-between">
              <span class="text-white/80">{t.cart.shipping}</span>
              <span id="co-shipping" class="text-blancoRoto">—</span>
            </div>
          </div>

          <div class="flex justify-between items-center py-5">
            <span class="font-acentos text-base uppercase tracking-[0.18em] text-blancoRoto">{t.checkout.total}</span>
            <span id="co-total" class="font-acentos text-3xl text-oro-brillo font-medium">$0.00</span>
          </div>

          <button
            type="submit"
            form="checkout-form"
            id="pay-btn"
            class="btn-gold w-full"
            disabled={!paymentAvailable}
            data-available={paymentAvailable ? 'true' : 'false'}
          >
            {t.checkout.pay}
          </button>

          <p
            id="pay-error"
            role="alert"
            class="hidden mt-4 text-sm text-red-400 text-center leading-relaxed"
          ></p>

          <p class="mt-6 text-xs text-white/80 text-center leading-relaxed">
            {t.checkout.terms}
            <a href="/terminos" class="text-oro-brillo underline underline-offset-2">{t.checkout.termsLink}</a>,
            {t.checkout.and} <a href="/privacidad" class="text-oro-brillo underline underline-offset-2">{t.checkout.privacyLink}</a>
            {t.checkout.and} <a href="/devoluciones" class="text-oro-brillo underline underline-offset-2">{t.checkout.returnsLink}</a>.
          </p>
        </div>
      </aside>
    </div>
  </div>

  <style>
    .field-label {
      display: block;
      margin-bottom: 0.5rem;
      font-family: 'Space Grotesk', Inter, sans-serif;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #ffe28a;
    }

    .input-dark {
      width: 100%;
      background: #050505;
      border: 2px solid rgba(247, 223, 165, 0.28);
      border-radius: 0.375rem;
      padding: 0.75rem 1rem;
      color: #ffffff;
      font-size: 1rem;
      transition: all 0.2s ease;
    }

    .input-dark:focus {
      outline: none;
      border-color: #ffe28a;
      box-shadow: 0 0 0 3px rgba(255, 226, 138, 0.1);
    }

    .input-dark::placeholder {
      color: rgba(255, 255, 255, 0.5);
    }

    .input-dark.invalid {
      border-color: #ef4444;
      box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.15);
    }

    .btn-gold {
      background: #ffe28a;
      color: #000000;
      font-family: 'Space Grotesk', Inter, sans-serif;
      font-weight: 600;
      font-size: 0.875rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      padding: 1rem 1.5rem;
      border-radius: 0.375rem;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 52px;
    }

    .btn-gold:hover:not(:disabled) {
      background: #ffed9f;
      transform: translateY(-2px);
      box-shadow: 0 10px 25px -5px rgba(255, 226, 138, 0.4);
    }

    .btn-gold:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .gold-line {
      height: 2px;
      width: 24px;
      background: linear-gradient(to right, transparent, #ffe28a, transparent);
      margin: 0 auto;
    }
  </style>

  <script>
    import { getCart, refreshCartPrices, formatMXN } from '../lib/cart';
    import { shippingCostFor, STANDARD_SHIPPING } from '../lib/pricing';
    import { escapeHtml, friendlyError } from '../lib/html';

    const ui = JSON.parse(document.getElementById('checkout-ui')?.textContent || '{}') as Record<string, string>;
    const uiText = (key: string) => ui[key] ?? '';

    const form = document.getElementById('checkout-form') as HTMLFormElement;
    const payBtn = document.getElementById('pay-btn') as HTMLButtonElement;
    const errorEl = document.getElementById('pay-error')!;
    const summaryError = document.getElementById('checkout-summary-error') as HTMLElement | null;
    const alertDiv = document.getElementById('checkout-alert') as HTMLElement;
    const paymentAvailable = payBtn?.getAttribute('data-available') !== 'false';

    let cartReady = false;

    function getProfile() {
      return fetch('/api/profile')
        .then((res) => res.json())
        .catch(() => null);
    }

    function value(field: string): string {
      return (form.elements.namedItem(field) as HTMLInputElement | HTMLTextAreaElement)?.value?.trim() || '';
    }

    function validateField(field: HTMLInputElement | HTMLTextAreaElement): boolean {
      const name = field.name;
      const val = field.value.trim();
      let isValid = true;
      let errorMessage = '';

      if (field.hasAttribute('required') && !val) {
        isValid = false;
        errorMessage = uiText('required');
      }

      if (name === 'email' && val) {
        const emailRegex = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
        if (!emailRegex.test(val)) {
          isValid = false;
          errorMessage = uiText('invalidEmail');
        }
      }

      if (name === 'phone' && val) {
        const digits = val.replace(/\D/g, '');
        if (digits.length < 10 || digits.length > 15) {
          isValid = false;
          errorMessage = uiText('invalidPhone');
        }
      }

      if (name === 'postalCode' && val && !/^\d{4,6}$/.test(val)) {
        isValid = false;
        errorMessage = uiText('invalidPostal');
      }

      const parent = field.closest('.space-y-2') || field.parentElement;

      if (!isValid) {
        field.classList.add('invalid');
        if (parent) {
          let errorDiv = parent.querySelector('.error-message') as HTMLElement | null;
          if (!errorDiv) {
            errorDiv = document.createElement('div');
            errorDiv.className = 'error-message mt-1 text-xs text-red-400';
            parent.appendChild(errorDiv);
          }
          errorDiv.textContent = errorMessage;
        }
        return false;
      }

      field.classList.remove('invalid');
      const errorDiv = parent?.querySelector('.error-message');
      if (errorDiv) errorDiv.remove();
      return true;
    }

    function validateAllFields(): boolean {
      const inputs = form.querySelectorAll('input[required], textarea[required]');
      let isValid = true;

      inputs.forEach((input) => {
        if (!validateField(input as HTMLInputElement | HTMLTextAreaElement)) isValid = false;
      });

      return isValid;
    }

    function renderSummary() {
      const items = getCart();
      const empty = document.getElementById('checkout-empty')!;
      const main = document.getElementById('checkout-content')!;

      if (items.length === 0) {
        empty.classList.remove('hidden');
        main.classList.add('hidden');
        return;
      }

      empty.classList.add('hidden');
      main.classList.remove('hidden');

      document.getElementById('checkout-items')!.innerHTML = items
        .map(
          (i) => `
        <div class="flex justify-between items-center gap-3 py-3">
          <div class="min-w-0">
            <p class="text-base text-blancoRoto">${escapeHtml(i.name)}</p>
            <p class="text-sm text-white/80">${escapeHtml(i.variantName)} × ${i.qty}</p>
          </div>
          <span class="text-base font-acentos text-oro-brillo whitespace-nowrap">$${formatMXN(i.price * i.qty)}</span>
        </div>`
        )
        .join('');

      const subtotal = items.reduce((sum, i) => sum + i.price * i.qty, 0);
      const shipping = shippingCostFor(subtotal);

      document.getElementById('co-subtotal')!.textContent = `$${formatMXN(subtotal)}`;
      document.getElementById('co-shipping')!.textContent =
        shipping === 0 ? uiText('free') : `$${formatMXN(STANDARD_SHIPPING)}`;
      document.getElementById('co-total')!.textContent = `$${formatMXN(subtotal + shipping)}`;
    }

    function showError(message: string) {
      alertDiv.textContent = message;
      alertDiv.classList.remove('hidden');
      alertDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
    }

    function restoreButton() {
      payBtn.disabled = false;
      payBtn.textContent = uiText('pay');
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.classList.add('hidden');
      alertDiv.classList.add('hidden');

      if (!paymentAvailable) {
        showError(uiText('unavailable'));
        return;
      }

      if (!cartReady) {
        showError(uiText('waitCart'));
        return;
      }

      const items = getCart();
      if (items.length === 0) {
        showError(uiText('emptyCartError'));
        return;
      }

      if (!validateAllFields()) {
        showError(uiText('fixErrors'));
        return;
      }

      payBtn.disabled = true;
      payBtn.textContent = uiText('opening');

      try {
        const res = await fetch('/api/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items: items.map((i) => ({ variantId: i.variantId, qty: i.qty })),
            customer: {
              firstName: value('firstName'),
              lastName: value('lastName'),
              email: value('email'),
              phone: value('phone'),
              street: value('street'),
              colonia: value('colonia'),
              city: value('city'),
              state: value('state'),
              postalCode: value('postalCode'),
              references: value('references'),
              notes: value('notes'),
            },
          }),
        });

        const data = await res.json().catch(() => ({}));

        if (!res.ok) {
          if (data?.code === 'NO_SESSION') {
            sessionStorage.setItem('dsp_checkout_error', uiText('noSession'));
            window.location.href = '/entrar?next=/checkout';
            return;
          }

          showError(friendlyError(data?.code, data?.error ?? uiText('openFailed')));
          restoreButton();
          return;
        }

        // El carrito se vacía al volver del pago (solo si Stripe lo aprobó).
        if (data?.url) {
          window.location.href = data.url;
          return;
        }

        showError(uiText('openFailed'));
        restoreButton();
      } catch {
        showError(uiText('connection'));
        restoreButton();
      }
    });

    // Desmarcar el error de cada campo al corregirlo
    form?.querySelectorAll('input, textarea').forEach((input) => {
      input.addEventListener('blur', () => {
        const el = input as HTMLInputElement;
        if (el.value.trim()) validateField(el);
      });
    });

    // Prellenar con los datos de la cuenta
    getProfile()
      .then((profile) => {
        if (!profile) return;
        const set = (name: string, val: string | null | undefined) => {
          const el = form.elements.namedItem(name) as HTMLInputElement | null;
          if (el && !el.value && val) el.value = val;
        };
        set('firstName', profile.first_name);
        set('lastName', profile.last_name);
        set('email', profile.email);
        set('phone', profile.phone);
      })
      .catch(() => {});

    // Precios y disponibilidad antes de mostrar el resumen:
    // si el carrito trae piezas viejas, se actualiza o se retiran.
    refreshCartPrices()
      .then(({ removed }) => {
        cartReady = true;
        if (removed.length > 0 && summaryError) {
          summaryError.textContent = `${uiText('removedPieces')} ${removed.length} ${
            removed.length === 1 ? uiText('pieceOne') : uiText('pieceMany')
          } ${uiText('unavailableNow')}`;
          summaryError.classList.remove('hidden');
        }
        renderSummary();
      })
      .catch(() => {
        cartReady = true;
        renderSummary();
      });

    renderSummary();

    if (!paymentAvailable) {
      showError(uiText('unavailable'));
    }
  </script>
</BaseLayout>
