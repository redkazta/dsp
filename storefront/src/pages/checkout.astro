---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';

const { firstName, email, phone } = Astro.locals;

const paymentAvailable = Boolean(
  import.meta.env.STRIPE_SECRET_KEY && import.meta.env.PUBLIC_STRIPE_PUBLISHABLE_KEY
);
const canceled = Astro.url.searchParams.get('canceled') === '1';
---

<BaseLayout title="Checkout | Dinero Sobre Problemas" description="Completa tu compra de forma segura.">
  <section class="border-b-2 border-white/25 bg-noise">
    <div class="page-container py-10 sm:py-12">
      <nav class="mb-6">
        <ol class="flex items-center gap-2 font-acentos text-xs uppercase tracking-[0.2em] text-white/80">
          <li><a href="/carrito" class="hover:text-oro-brillo transition-colors">Carrito</a></li>
          <li>/</li>
          <li class="text-oro-brillo">Checkout</li>
        </ol>
      </nav>
      <h1 class="font-titulos text-3xl sm:text-4xl lg:text-5xl text-blancoRoto">Finalizar compra</h1>
      <p class="mt-3 text-base text-white/80">Producción bajo pedido · Pago seguro con Stripe</p>
    </div>
  </section>

  <div
    id="checkout-alert"
    role="alert"
    class="hidden max-w-3xl mx-auto px-5 py-3 mb-4 bg-oro-brillo/10 border-2 border-oro-brillo text-oro-brillo text-sm font-acentos tracking-wide rounded-sm"
  ></div>

  <div id="checkout-empty" class="hidden max-w-3xl mx-auto px-5 py-24 sm:py-32 text-center">
    <p class="font-titulos text-3xl text-blancoRoto mb-6">Tu carrito está vacío</p>
    <div class="gold-line mx-auto mb-8"></div>
    <a href="/tienda" class="btn-gold inline-flex">Ir a la tienda</a>
  </div>

  <div id="checkout-content" class="page-container py-8 sm:py-12 lg:py-16">
    <div class="grid lg:grid-cols-3 gap-8 lg:gap-12">
      <!-- Formulario principal -->
      <div class="lg:col-span-2 order-2 lg:order-1">
        <form id="checkout-form" class="space-y-8" novalidate>
          <!-- Sección de contacto -->
          <section class="bg-negro-carbono border-2 border-white/25 p-6 sm:p-8">
            <h2 class="font-titulos text-2xl text-blancoRoto mb-6 flex items-center gap-3">
              <span class="w-8 h-8 border-2 border-oro-brillo text-oro-brillo flex items-center justify-center font-acentos text-sm">1</span>
              Información de contacto
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-2">
                <label class="field-label" for="firstName">Nombre *</label>
                <input
                  id="firstName"
                  name="firstName"
                  required
                  class="input-dark"
                  autocomplete="given-name"
                  value={firstName ?? ''}
                />
              </div>
              <div class="space-y-2">
                <label class="field-label" for="lastName">Apellidos *</label>
                <input
                  id="lastName"
                  name="lastName"
                  required
                  class="input-dark"
                  autocomplete="family-name"
                />
              </div>
              <div class="space-y-2 sm:col-span-2">
                <label class="field-label" for="email">Correo electrónico *</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  class="input-dark"
                  autocomplete="email"
                  inputmode="email"
                  value={email ?? ''}
                />
              </div>
              <div class="space-y-2 sm:col-span-2">
                <label class="field-label" for="phone">Teléfono *</label>
                <input
                  id="phone"
                  name="phone"
                  type="tel"
                  required
                  class="input-dark"
                  autocomplete="tel"
                  inputmode="tel"
                  placeholder="10 dígitos"
                  value={phone ?? ''}
                />
              </div>
            </div>
          </section>

          <!-- Sección de envío -->
          <section class="bg-negro-carbono border-2 border-white/25 p-6 sm:p-8">
            <h2 class="font-titulos text-2xl text-blancoRoto mb-6 flex items-center gap-3">
              <span class="w-8 h-8 border-2 border-oro-brillo text-oro-brillo flex items-center justify-center font-acentos text-sm">2</span>
              Dirección de envío
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-2 sm:col-span-2">
                <label class="field-label" for="street">Calle y número *</label>
                <input
                  id="street"
                  name="street"
                  required
                  class="input-dark"
                  autocomplete="street-address"
                />
              </div>
              <div class="space-y-2">
                <label class="field-label" for="colonia">Colonia *</label>
                <input id="colonia" name="colonia" required class="input-dark" />
              </div>
              <div class="space-y-2">
                <label class="field-label" for="postalCode">Código postal *</label>
                <input
                  id="postalCode"
                  name="postalCode"
                  required
                  class="input-dark"
                  autocomplete="postal-code"
                  inputmode="numeric"
                  maxlength="5"
                />
              </div>
              <div class="space-y-2">
                <label class="field-label" for="city">Ciudad *</label>
                <input
                  id="city"
                  name="city"
                  required
                  class="input-dark"
                  autocomplete="address-level2"
                />
              </div>
              <div class="space-y-2">
                <label class="field-label" for="state">Estado *</label>
                <input
                  id="state"
                  name="state"
                  required
                  class="input-dark"
                  autocomplete="address-level1"
                />
              </div>
              <div class="space-y-2 sm:col-span-2">
                <label class="field-label" for="references">Referencias</label>
                <input
                  id="references"
                  name="references"
                  class="input-dark"
                  placeholder="Entre calles, número de casa…"
                />
              </div>
              <div class="space-y-2 sm:col-span-2">
                <label class="field-label" for="notes">Notas del pedido</label>
                <textarea
                  id="notes"
                  name="notes"
                  rows="3"
                  class="input-dark !min-h-[96px] py-3"
                  placeholder="Diseño, color, talla especial o cualquier indicación."
                ></textarea>
              </div>
            </div>
          </section>

          <!-- Sección de pago -->
          <section class="bg-negro-carbono border-2 border-white/25 p-6 sm:p-8">
            <h2 class="font-titulos text-2xl text-blancoRoto mb-6 flex items-center gap-3">
              <span class="w-8 h-8 border-2 border-oro-brillo text-oro-brillo flex items-center justify-center font-acentos text-sm">3</span>
              Pago
            </h2>

            <div class="border-2 border-oro-brillo/60 bg-negro-carbono p-5 sm:p-6">
              <div class="flex items-start gap-3">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFE28A" stroke-width="2" class="mt-0.5 shrink-0">
                  <rect x="2" y="5" width="20" height="14" rx="2" /><path d="M2 10h20" />
                </svg>
                <div>
                  <p class="text-base text-blancoRoto font-semibold">Tarjeta de crédito o débito</p>
                  <p class="text-sm text-white/80 leading-relaxed mt-1">
                    {paymentAvailable
                      ? 'Al continuar te llevamos a la pantalla segura de Stripe para capturar tu tarjeta. Tus datos nunca pasan por esta tienda.'
                      : 'El pago con tarjeta no está disponible en este momento. Escríbenos para completar tu pedido.'}
                  </p>
                </div>
              </div>
            </div>
          </section>
        </form>
      </div>

      <!-- Resumen del pedido -->
      <aside class="lg:col-span-1 order-1 lg:order-2">
        <div class="lg:sticky lg:top-28 bg-negro-carbono border-2 border-white/25 p-6 sm:p-8">
          <h2 class="font-titulos text-2xl text-blancoRoto mb-6">Tu pedido</h2>
          <div id="checkout-items" class="divide-y-2 divide-white/15 mb-6">
            <!-- Los items se renderizan aquí -->
          </div>

          <p
            id="checkout-summary-error"
            role="status"
            class="hidden mb-4 text-sm text-oro-brillo leading-relaxed border-2 border-oro-brillo/50 px-3 py-2"
          ></p>

          <div class="space-y-3 pb-4 border-b-2 border-white/25 text-base">
            <div class="flex justify-between">
              <span class="text-white/80">Subtotal</span>
              <span id="co-subtotal" class="text-blancoRoto">$0.00</span>
            </div>
            <div class="flex justify-between">
              <span class="text-white/80">Envío</span>
              <span id="co-shipping" class="text-blancoRoto">—</span>
            </div>
          </div>

          <div class="flex justify-between items-center py-5">
            <span class="font-acentos text-base uppercase tracking-[0.18em] text-blancoRoto">Total</span>
            <span id="co-total" class="font-acentos text-3xl text-oro-brillo font-medium">$0.00</span>
          </div>

          <button
            type="submit"
            form="checkout-form"
            id="pay-btn"
            class="btn-gold w-full"
            disabled={!paymentAvailable}
            data-available={paymentAvailable ? 'true' : 'false'}
          >
            Pagar y confirmar
          </button>

          <p
            id="pay-error"
            role="alert"
            class="hidden mt-4 text-sm text-red-400 text-center leading-relaxed"
          ></p>

          <p class="mt-6 text-xs text-white/80 text-center leading-relaxed">
            Al confirmar aceptas nuestros
            <a href="/terminos" class="text-oro-brillo underline underline-offset-2">términos</a>,
            la <a href="/privacidad" class="text-oro-brillo underline underline-offset-2">política de privacidad</a>
            y la <a href="/devoluciones" class="text-oro-brillo underline underline-offset-2">política de devoluciones</a>.
          </p>
        </div>
      </aside>
    </div>
  </div>

  <style>
    .field-label {
      display: block;
      margin-bottom: 0.5rem;
      font-family: 'Space Grotesk', Inter, sans-serif;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #ffe28a;
    }

    .input-dark {
      width: 100%;
      background: #0e0e0e;
      border: 2px solid rgba(255, 255, 255, 0.25);
      border-radius: 0.375rem;
      padding: 0.75rem 1rem;
      color: #ffffff;
      font-size: 1rem;
      transition: all 0.2s ease;
    }

    .input-dark:focus {
      outline: none;
      border-color: #ffe28a;
      box-shadow: 0 0 0 3px rgba(255, 226, 138, 0.1);
    }

    .input-dark::placeholder {
      color: rgba(255, 255, 255, 0.5);
    }

    .input-dark.invalid {
      border-color: #ef4444;
      box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.15);
    }

    .btn-gold {
      background: #ffe28a;
      color: #060606;
      font-family: 'Space Grotesk', Inter, sans-serif;
      font-weight: 600;
      font-size: 0.875rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      padding: 1rem 1.5rem;
      border-radius: 0.375rem;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 52px;
    }

    .btn-gold:hover:not(:disabled) {
      background: #ffed9f;
      transform: translateY(-2px);
      box-shadow: 0 10px 25px -5px rgba(255, 226, 138, 0.4);
    }

    .btn-gold:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .gold-line {
      height: 2px;
      width: 24px;
      background: linear-gradient(to right, transparent, #ffe28a, transparent);
      margin: 0 auto;
    }
  </style>

  <script>
    import { getCart, refreshCartPrices, formatMXN } from '../lib/cart';
    import { shippingCostFor, STANDARD_SHIPPING } from '../lib/pricing';
    import { escapeHtml, friendlyError } from '../lib/html';

    const form = document.getElementById('checkout-form') as HTMLFormElement;
    const payBtn = document.getElementById('pay-btn') as HTMLButtonElement;
    const errorEl = document.getElementById('pay-error')!;
    const summaryError = document.getElementById('checkout-summary-error') as HTMLElement | null;
    const alertDiv = document.getElementById('checkout-alert') as HTMLElement;
    const paymentAvailable = payBtn?.getAttribute('data-available') !== 'false';

    let cartReady = false;

    function getProfile() {
      return fetch('/api/profile')
        .then((res) => res.json())
        .catch(() => null);
    }

    function value(field: string): string {
      return (form.elements.namedItem(field) as HTMLInputElement | HTMLTextAreaElement)?.value?.trim() || '';
    }

    function validateField(field: HTMLInputElement | HTMLTextAreaElement): boolean {
      const name = field.name;
      const val = field.value.trim();
      let isValid = true;
      let errorMessage = '';

      if (field.hasAttribute('required') && !val) {
        isValid = false;
        errorMessage = 'Este campo es obligatorio.';
      }

      if (name === 'email' && val) {
        const emailRegex = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
        if (!emailRegex.test(val)) {
          isValid = false;
          errorMessage = 'Escribe un correo electrónico válido.';
        }
      }

      if (name === 'phone' && val) {
        const digits = val.replace(/\D/g, '');
        if (digits.length < 10 || digits.length > 15) {
          isValid = false;
          errorMessage = 'El teléfono debe tener 10 dígitos (o incluir lada).';
        }
      }

      if (name === 'postalCode' && val && !/^\d{4,6}$/.test(val)) {
        isValid = false;
        errorMessage = 'Código postal de 5 dígitos (o 4-6 si es de otro país).';
      }

      const parent = field.closest('.space-y-2') || field.parentElement;

      if (!isValid) {
        field.classList.add('invalid');
        if (parent) {
          let errorDiv = parent.querySelector('.error-message') as HTMLElement | null;
          if (!errorDiv) {
            errorDiv = document.createElement('div');
            errorDiv.className = 'error-message mt-1 text-xs text-red-400';
            parent.appendChild(errorDiv);
          }
          errorDiv.textContent = errorMessage;
        }
        return false;
      }

      field.classList.remove('invalid');
      const errorDiv = parent?.querySelector('.error-message');
      if (errorDiv) errorDiv.remove();
      return true;
    }

    function validateAllFields(): boolean {
      const inputs = form.querySelectorAll('input[required], textarea[required]');
      let isValid = true;

      inputs.forEach((input) => {
        if (!validateField(input as HTMLInputElement | HTMLTextAreaElement)) isValid = false;
      });

      return isValid;
    }

    function renderSummary() {
      const items = getCart();
      const empty = document.getElementById('checkout-empty')!;
      const main = document.getElementById('checkout-content')!;

      if (items.length === 0) {
        empty.classList.remove('hidden');
        main.classList.add('hidden');
        return;
      }

      empty.classList.add('hidden');
      main.classList.remove('hidden');

      document.getElementById('checkout-items')!.innerHTML = items
        .map(
          (i) => `
        <div class="flex justify-between items-center gap-3 py-3">
          <div class="min-w-0">
            <p class="text-base text-blancoRoto">${escapeHtml(i.name)}</p>
            <p class="text-sm text-white/80">${escapeHtml(i.variantName)} × ${i.qty}</p>
          </div>
          <span class="text-base font-acentos text-oro-brillo whitespace-nowrap">$${formatMXN(i.price * i.qty)}</span>
        </div>`
        )
        .join('');

      const subtotal = items.reduce((sum, i) => sum + i.price * i.qty, 0);
      const shipping = shippingCostFor(subtotal);

      document.getElementById('co-subtotal')!.textContent = `$${formatMXN(subtotal)}`;
      document.getElementById('co-shipping')!.textContent =
        shipping === 0 ? 'Gratis' : `$${formatMXN(STANDARD_SHIPPING)}`;
      document.getElementById('co-total')!.textContent = `$${formatMXN(subtotal + shipping)}`;
    }

    function showError(message: string) {
      alertDiv.textContent = message;
      alertDiv.classList.remove('hidden');
      alertDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
    }

    function restoreButton() {
      payBtn.disabled = false;
      payBtn.textContent = 'Pagar y confirmar';
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.classList.add('hidden');
      alertDiv.classList.add('hidden');

      if (!paymentAvailable) {
        showError('El pago con tarjeta no está disponible en este momento.');
        return;
      }

      if (!cartReady) {
        showError('Espera mientras verificamos tu carrito...');
        return;
      }

      const items = getCart();
      if (items.length === 0) {
        showError('Tu carrito está vacío. Agrega productos antes de continuar.');
        return;
      }

      if (!validateAllFields()) {
        showError('Por favor corrige los errores en el formulario.');
        return;
      }

      payBtn.disabled = true;
      payBtn.textContent = 'Abriendo pago seguro…';

      try {
        const res = await fetch('/api/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items: items.map((i) => ({ variantId: i.variantId, qty: i.qty })),
            customer: {
              firstName: value('firstName'),
              lastName: value('lastName'),
              email: value('email'),
              phone: value('phone'),
              street: value('street'),
              colonia: value('colonia'),
              city: value('city'),
              state: value('state'),
              postalCode: value('postalCode'),
              references: value('references'),
              notes: value('notes'),
            },
          }),
        });

        const data = await res.json().catch(() => ({}));

        if (!res.ok) {
          if (data?.code === 'NO_SESSION') {
            sessionStorage.setItem('dsp_checkout_error', friendlyError('NO_SESSION', ''));
            window.location.href = '/entrar?next=/checkout';
            return;
          }

          showError(friendlyError(data?.code, data?.error ?? 'No pudimos iniciar el pago.'));
          restoreButton();
          return;
        }

        // El carrito se vacía al volver del pago (solo si Stripe lo aprobó).
        if (data?.url) {
          window.location.href = data.url;
          return;
        }

        showError('No pudimos abrir la pantalla de pago. Intenta de nuevo.');
        restoreButton();
      } catch {
        showError('No pudimos conectar con la tienda. Revisa tu conexión e intenta de nuevo.');
        restoreButton();
      }
    });

    // Desmarcar el error de cada campo al corregirlo
    form?.querySelectorAll('input, textarea').forEach((input) => {
      input.addEventListener('blur', () => {
        const el = input as HTMLInputElement;
        if (el.value.trim()) validateField(el);
      });
    });

    // Prellenar con los datos de la cuenta
    getProfile()
      .then((profile) => {
        if (!profile) return;
        const set = (name: string, val: string | null | undefined) => {
          const el = form.elements.namedItem(name) as HTMLInputElement | null;
          if (el && !el.value && val) el.value = val;
        };
        set('firstName', profile.first_name);
        set('lastName', profile.last_name);
        set('email', profile.email);
        set('phone', profile.phone);
      })
      .catch(() => {});

    // Precios y disponibilidad antes de mostrar el resumen:
    // si el carrito trae piezas viejas, se actualiza o se retiran.
    refreshCartPrices()
      .then(({ removed }) => {
        cartReady = true;
        if (removed.length > 0 && summaryError) {
          summaryError.textContent = `Retiramos ${removed.length} ${
            removed.length === 1 ? 'pieza' : 'piezas'
          } que ya no están disponibles.`;
          summaryError.classList.remove('hidden');
        }
        renderSummary();
      })
      .catch(() => {
        cartReady = true;
        renderSummary();
      });

    renderSummary();

    if (!paymentAvailable) {
      showError('El pago con tarjeta no está disponible en este momento. Escríbenos para completar tu pedido.');
    }
  </script>
</BaseLayout>
