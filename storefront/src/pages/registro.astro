---
import BaseLayout from '../layouts/BaseLayout.astro';
import GoogleButton from '../components/auth/GoogleButton.astro';
---

<BaseLayout title="Crear cuenta | Dinero Sobre Problemas" description="Únete a nuestra familia.">
  <section class="min-h-[75vh] flex items-center justify-center px-6 py-16 bg-noise">
    <div class="w-full max-w-md">
      <div class="text-center mb-10">
        <p class="section-label mb-4">Únete</p>
        <h1 class="font-titulos text-4xl text-blancoRoto mb-3">Crear cuenta</h1>
        <div class="gold-line mx-auto"></div>
      </div>

      <form id="register-form" class="space-y-4">
        <input type="text" name="fullName" placeholder="Nombre completo" required class="input-dark" autocomplete="name" />
        <input type="email" name="email" placeholder="Email" required class="input-dark" autocomplete="email" />
        <input type="password" name="password" placeholder="Contraseña (mín. 6 caracteres)" required minlength="6" class="input-dark" autocomplete="new-password" />

        <button type="submit" id="register-btn" class="btn-gold w-full">Crear cuenta</button>
        <p id="register-error" class="hidden text-xs text-red-400 text-center"></p>
        <p id="register-info" class="hidden text-xs text-oro-elegante text-center leading-relaxed"></p>
      </form>

      <div class="flex items-center gap-4 my-8">
        <div class="flex-1 h-px bg-plata-metalico/15"></div>
        <span class="font-acentos text-[10px] uppercase tracking-[0.2em] text-plata-metalico/40">o</span>
        <div class="flex-1 h-px bg-plata-metalico/15"></div>
      </div>

      <GoogleButton />
      <p id="google-error" class="hidden mt-3 text-xs text-red-400 text-center"></p>

      <p class="mt-8 text-center text-sm text-plata-metalico/50">
        ¿Ya tienes cuenta?
        <a href="/entrar" class="text-oro-elegante hover:text-oro-suave transition-colors">Iniciar sesión</a>
      </p>
    </div>
  </section>

  <script>
    import { signUp } from '../lib/auth';

    const form = document.getElementById('register-form') as HTMLFormElement;
    const btn = document.getElementById('register-btn') as HTMLButtonElement;
    const errorEl = document.getElementById('register-error')!;
    const infoEl = document.getElementById('register-info')!;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = 'Creando...';
      errorEl.classList.add('hidden');
      infoEl.classList.add('hidden');

      const data = new FormData(form);
      const { data: result, error } = await signUp(
        String(data.get('email')),
        String(data.get('password')),
        String(data.get('fullName'))
      );

      if (error) {
        errorEl.textContent = error.message;
        errorEl.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'Crear cuenta';
        return;
      }

      // Si Supabase requiere confirmación de email, no hay sesión activa
      if (result.user && !result.session) {
        infoEl.textContent = 'Revisa tu correo para confirmar tu cuenta.';
        infoEl.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'Crear cuenta';
        return;
      }

      window.location.href = '/cuenta';
    });
  </script>
</BaseLayout>
