---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getCopy, type Lang } from '../lib/i18n';

const lang = (Astro.locals.lang ?? 'es') as Lang;
const t = getCopy(lang);

// Textos que necesita el script del navegador.
const ui = {
  needEmail: t.account.recoverNeedEmail,
  sending: t.account.recoverSending,
  submit: t.account.recoverSubmit,
  notFound: t.account.recoverNotFound,
  failed: t.account.recoverFailed,
  sent: t.account.recoverSent,
};
---

<BaseLayout title={t.account.recoverMetaTitle} description={t.account.recoverMetaDescription}>
  <script type="application/json" id="recover-ui" set:html={JSON.stringify(ui)} />

  <section class="min-h-[calc(100dvh-8rem)] flex items-start sm:items-center justify-center px-5 sm:px-6 py-10 sm:py-16 bg-noise">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <p class="section-label mb-3">{t.nav.cuenta}</p>
        <h1 class="font-titulos text-3xl sm:text-4xl text-blancoRoto mb-4">{t.account.recoverTitle}</h1>
        <div class="gold-line mx-auto"></div>
        <p class="mt-5 text-sm text-muted">{t.account.recoverIntro}</p>
      </div>

      <form id="recover-form" class="space-y-4" novalidate>
        <label class="block">
          <span class="field-label">{t.account.email} *</span>
          <input
            type="email"
            name="email"
            placeholder="tu@correo.com"
            required
            class="input-dark"
            autocomplete="email"
            inputmode="email"
          />
        </label>

        <button type="submit" id="recover-submit" class="btn-gold w-full">{t.account.recoverSubmit}</button>

        <p id="recover-error" role="alert" class="hidden text-sm text-red-400 text-center leading-relaxed"></p>
        <p id="recover-info" role="status" class="hidden text-sm text-oro-brillo text-center leading-relaxed"></p>
      </form>

      <p class="mt-8 text-center text-sm text-muted">
        <a href="/entrar" class="text-oro-brillo font-semibold hover:text-white transition-colors">{t.account.backToLogin}</a>
      </p>
    </div>
  </section>

  <style>
    .field-label {
      display: block;
      margin-bottom: 0.5rem;
      font-family: 'Space Grotesk', Inter, sans-serif;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #ffe28a;
    }
  </style>

  <script>
    import { sendPasswordReset } from '../lib/auth';

    const ui = JSON.parse(document.getElementById('recover-ui')?.textContent || '{}') as Record<
      string,
      string
    >;

    const form = document.getElementById('recover-form') as HTMLFormElement;
    const submit = document.getElementById('recover-submit') as HTMLButtonElement;
    const errorEl = document.getElementById('recover-error')!;
    const infoEl = document.getElementById('recover-info')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.classList.add('hidden');
      infoEl.classList.add('hidden');

      const email = String(new FormData(form).get('email') ?? '').trim();
      if (!email) {
        errorEl.textContent = ui.needEmail;
        errorEl.classList.remove('hidden');
        return;
      }

      submit.disabled = true;
      submit.textContent = ui.sending;

      const { error } = await sendPasswordReset(email);

      submit.disabled = false;
      submit.textContent = ui.submit;

      if (error) {
        errorEl.textContent = error.message === 'User not found' ? ui.notFound : ui.failed;
        errorEl.classList.remove('hidden');
        return;
      }

      // Misma respuesta exista o no la cuenta: no revelamos qué correos están dados de alta.
      infoEl.textContent = ui.sent;
      infoEl.classList.remove('hidden');
      form.reset();
    });
  </script>
</BaseLayout>
