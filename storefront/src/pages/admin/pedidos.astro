---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Pedidos">
  <div id="admin-loading" class="py-20 text-center text-sm text-white/80">Cargando pedidos…</div>

  <div id="orders-view" class="hidden">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
      <div>
        <p class="section-label mb-2">Operación</p>
        <h1 class="font-titulos text-3xl sm:text-4xl text-blancoRoto">Pedidos</h1>
      </div>
      <button
        type="button"
        id="refresh-orders"
        class="btn-outline !min-h-[44px] !px-5 !py-2 !text-xs self-start"
      >
        Actualizar
      </button>
    </div>

    <!-- Resumen por estatus -->
    <div id="status-summary" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 mb-8"></div>

    <!-- Filtros -->
    <div class="flex gap-2 overflow-x-auto pb-2 mb-8 -mx-4 px-4 sm:mx-0 sm:px-0 sm:flex-wrap scrollbar-none" id="filters"></div>

    <div class="space-y-4" id="orders-list"></div>
  </div>

  <style>
    .status-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      min-height: 38px;
      padding: 0.4rem 0.85rem;
      border: 2px solid rgba(255, 255, 255, 0.3);
      background: transparent;
      color: rgba(255, 255, 255, 0.85);
      font-family: 'Space Grotesk', Inter, sans-serif;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      white-space: nowrap;
      cursor: pointer;
    }

    .status-chip[aria-pressed='true'] {
      border-color: #ffe28a;
      color: #ffe28a;
      background: rgba(242, 201, 76, 0.1);
    }

    .order-card {
      border: 2px solid rgba(255, 255, 255, 0.15);
      background: #050505;
    }

    .event-input {
      width: 100%;
      min-height: 44px;
      padding: 0.6rem 0.8rem;
      background: #0b0b0b;
      border: 2px solid rgba(247, 223, 165, 0.28);
      color: #ffffff;
      font-size: 0.9375rem;
      outline: none;
    }

    .event-input:focus {
      border-color: #ffe28a;
    }

    .track-step {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      flex: 1;
      min-width: 0;
    }

    .track-dot {
      width: 12px;
      height: 12px;
      border-radius: 999px;
      border: 2px solid rgba(255, 255, 255, 0.35);
      flex: 0 0 12px;
    }

    .track-dot.is-done {
      background: #ffe28a;
      border-color: #ffe28a;
    }

    .track-dot.is-current {
      box-shadow: 0 0 0 4px rgba(242, 201, 76, 0.25);
    }

    .track-bar {
      height: 2px;
      flex: 1;
      background: rgba(255, 255, 255, 0.18);
      min-width: 4px;
    }

    .track-bar.is-done {
      background: #ffe28a;
    }

    @media (max-width: 640px) {
      .track-label {
        display: none;
      }
    }
  </style>

  <script>
    import { listOrders, updateOrderStatus, saveOrderNotes } from '../../lib/admin';
    import { TENANT_ID } from '../../lib/constants';
    import { safeUrl } from '../../lib/html';
    import {
      STATUS_FLOW,
      STATUS_LABEL,
      NEXT_STATUS,
      PAYMENT_STATUS_LABEL,
      PAYMENT_METHOD_LABEL,
      formatOrderMoney,
      formatOrderDateTime,
      type OrderStatus,
    } from '../../lib/orders';

    const FILTERS: Array<{ value: string; label: string }> = [
      { value: '', label: 'Todos' },
      ...STATUS_FLOW.map((s) => ({
        value: s,
        label: s === 'preparing' ? 'Producción' : s === 'ready' ? 'Listos' : STATUS_LABEL[s],
      })),
      { value: 'cancelled', label: 'Cancelados' },
      { value: 'returned', label: 'Devueltos' },
    ];

    let orders: any[] = [];
    let filter = '';
    let search = '';

    const esc = (v: unknown) =>
      String(v ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');

    function trackBar(status: OrderStatus) {
      const closed = ['cancelled', 'returned'].includes(status);
      const index = STATUS_FLOW.indexOf(status);

      return `
        <div class="flex items-center gap-1 mt-4 mb-1">
          ${STATUS_FLOW.map((step, i) => {
            const done = !closed && i <= index;
            return `
              <div class="track-step">
                <span class="track-dot ${done ? 'is-done' : ''} ${i === index && !closed ? 'is-current' : ''}"></span>
                <span class="track-label text-xs uppercase tracking-wider ${done ? 'text-blancoRoto' : 'text-white/80'} hidden xl:inline">
                  ${STATUS_LABEL[step]}
                </span>
                ${i < STATUS_FLOW.length - 1 ? `<span class="track-bar ${done && i < index ? 'is-done' : ''}"></span>` : ''}
              </div>`;
          }).join('')}
        </div>
        ${closed ? `<p class="text-xs uppercase tracking-wider text-red-400">${STATUS_LABEL[status]}</p>` : ''}`;
    }

    function itemsHtml(o: any) {
      return (o.order_items ?? [])
        .map(
          (i: any) => `
        <div class="flex items-start justify-between gap-3 py-2 border-b border-white/15 last:border-0">
          <div class="flex gap-3 min-w-0">
            <div class="w-12 h-14 shrink-0 bg-white border border-white/30 overflow-hidden">
              ${safeUrl(i.image_url) ? `<img src="${safeUrl(i.image_url)}" alt="" class="w-full h-full object-contain">` : ''}
            </div>
            <div class="min-w-0">
              <p class="text-sm text-blancoRoto">${esc(i.product_name ?? i.variant_name ?? 'Pieza')}</p>
              <p class="text-xs text-white/80">
                ${esc([i.size, i.color].filter(Boolean).join(' · '))} · x${i.quantity}
              </p>
            </div>
          </div>
          <p class="text-sm font-acentos text-oro-brillo whitespace-nowrap">
            ${formatOrderMoney(Number(i.unit_price) * Number(i.quantity))}
          </p>
        </div>`
        )
        .join('');
    }

    function orderCard(o: any) {
      const status = o.status as OrderStatus;
      const next = NEXT_STATUS[status] ?? [];
      const canShip = status === 'ready';
      const history = (o.order_status_history ?? []).slice().sort(
        (a: any, b: any) => new Date(a.created_at).getTime() - new Date(b.created_at).getTime()
      );

      return `
      <article class="order-card" data-order-card="${o.id}">
        <header class="flex flex-wrap items-start justify-between gap-4 p-5 border-b-2 border-white/25">
          <div class="min-w-0">
            <p class="font-acentos text-lg text-blancoRoto">
              ${esc(o.order_number ?? o.id.slice(0, 8))}
              ${!o.user_id ? '<span class="ml-2 align-middle text-[9px] uppercase tracking-[0.14em] border border-white/50 px-1.5 py-0.5 text-white/80">Invitado</span>' : ''}
            </p>
            <p class="text-sm text-white/80">
              ${esc(o.contact_name ?? 'Sin nombre')} · ${formatOrderDateTime(o.created_at)}
            </p>
            <p class="text-sm text-white/80">
              ${esc(o.contact_email ?? '')}${o.contact_phone ? ` · ${esc(o.contact_phone)}` : ''}
            </p>
          </div>
          <div class="text-right">
            <p class="font-acentos text-xl text-oro-brillo">${formatOrderMoney(Number(o.total_amount))}</p>
            <p class="text-xs uppercase tracking-wider text-white/80 mt-1">
              ${esc(PAYMENT_METHOD_LABEL[o.payment_method] ?? o.payment_method ?? '')} ·
              ${esc(PAYMENT_STATUS_LABEL[o.payment_status] ?? o.payment_status ?? '')}
            </p>
          </div>
        </header>

        <div class="grid lg:grid-cols-2 gap-0 lg:gap-6">
          <div class="p-5 border-b-2 lg:border-b-0 border-white/25">
            <p class="text-xs uppercase tracking-[0.18em] text-white/80 mb-2">Piezas</p>
            ${itemsHtml(o)}

            <p class="text-xs uppercase tracking-[0.18em] text-white/80 mt-4 mb-1">Envío</p>
            <p class="text-sm text-white/80 leading-relaxed">
              ${esc(o.shipping_street ?? '—')}${o.shipping_colonia ? ', ' + esc(o.shipping_colonia) : ''}<br>
              ${esc(o.shipping_city ?? '')} ${esc(o.shipping_state ?? '')} ${esc(o.shipping_postal_code ?? '')}
              ${o.shipping_references ? `<br><span class="text-white/80">Ref: ${esc(o.shipping_references)}</span>` : ''}
            </p>
            ${o.notes ? `<p class="mt-3 text-sm text-blancoRoto"><span class="text-white/80">Nota del cliente:</span> ${esc(o.notes)}</p>` : ''}
          </div>

          <div class="p-5">
            <p class="text-xs uppercase tracking-[0.18em] text-white/80 mb-2">Seguimiento</p>
            ${trackBar(status)}

            <ol class="mt-3 space-y-2">
              ${history
                .map(
                  (h: any) => `
                <li class="flex items-start gap-2 text-sm">
                  <span class="w-1.5 h-1.5 rounded-full bg-oro-brillo mt-2 shrink-0"></span>
                  <span class="text-white/80">
                    <span class="text-blancoRoto">${esc(STATUS_LABEL[h.status as OrderStatus] ?? h.status)}</span>
                    · ${formatOrderDateTime(h.created_at)}
                    ${h.notes ? `<br><span class="text-xs text-white/80">${esc(h.notes)}</span>` : ''}
                  </span>
                </li>`
                )
                .join('')}
            </ol>

            ${
              o.tracking_number
                ? `<p class="mt-3 text-sm text-blancoRoto">Guía: ${esc(o.carrier ?? '')} ${esc(o.tracking_number)}</p>`
                : ''
            }

            <p class="text-xs uppercase tracking-[0.18em] text-white/80 mt-4 mb-2">Notas internas</p>
            <textarea
              data-admin-notes="${o.id}"
              rows="2"
              class="event-input"
              placeholder="Diseño pendiente, cliente pidió cambio…"
            >${esc(o.admin_notes ?? '')}</textarea>
            <button type="button" data-save-notes="${o.id}"
              class="mt-2 text-xs uppercase tracking-wider text-oro-brillo hover:text-white py-2">
              Guardar nota
            </button>
          </div>
        </div>

        ${
          next.length > 0 || canShip
            ? `<footer class="p-5 border-t-2 border-white/25">
                 ${
                   canShip
                     ? `<div class="grid sm:grid-cols-3 gap-2 mb-3">
                          <input data-carrier="${o.id}" class="event-input" placeholder="Paquetería" value="${esc(o.carrier ?? '')}" />
                          <input data-tracking="${o.id}" class="event-input sm:col-span-2" placeholder="Número de guía" value="${esc(o.tracking_number ?? '')}" />
                        </div>`
                     : ''
                 }
                 <div class="flex flex-wrap gap-2">
                   ${next
                     .map((s) => {
                       const danger = s === 'cancelled' || s === 'returned';
                       return `<button type="button" data-order="${o.id}" data-status="${s}"
                         class="min-h-[44px] px-4 font-acentos text-xs uppercase tracking-[0.12em] border-2 transition-colors ${
                           danger
                             ? 'border-red-400/60 text-red-400 hover:bg-red-400/10'
                             : 'border-oro-brillo text-oro-brillo hover:bg-oro-brillo hover:text-negro-profundo'
                         }">
                         Mover a ${STATUS_LABEL[s]}
                       </button>`;
                     })
                     .join('')}
                 </div>
               </footer>`
            : ''
        }
      </article>`;
    }

    function renderSummary() {
      const counts = new Map<string, number>();
      for (const o of orders) counts.set(o.status, (counts.get(o.status) ?? 0) + 1);

      const highlights = [
        { status: 'pending', label: 'Pago pendiente' },
        { status: 'confirmed', label: 'Por diseñar' },
        { status: 'design', label: 'En diseño' },
        { status: 'preparing', label: 'En producción' },
        { status: 'ready', label: 'Listos' },
      ];

      document.getElementById('status-summary')!.innerHTML = highlights
        .map(
          (h) => `
        <div class="card p-4">
          <p class="text-xs uppercase tracking-[0.16em] text-white/80 mb-1">${h.label}</p>
          <p class="font-acentos text-2xl text-oro-brillo">${counts.get(h.status) ?? 0}</p>
        </div>`
        )
        .join('');
    }

    function renderFilters() {
      document.getElementById('filters')!.innerHTML = FILTERS.map(
        (f) => `<button type="button" class="status-chip" data-filter="${f.value}" aria-pressed="${filter === f.value}">
                  ${f.label}
                </button>`
      ).join('');

      document.querySelectorAll<HTMLElement>('[data-filter]').forEach((btn) =>
        btn.addEventListener('click', () => {
          filter = btn.dataset.filter ?? '';
          renderFilters();
          renderList();
        })
      );
    }

    function renderList() {
      const container = document.getElementById('orders-list')!;
      const term = search.toLowerCase();

      const list = orders.filter((o) => {
        const byStatus = !filter || o.status === filter;
        if (!byStatus) return false;
        if (!term) return true;

        const haystack = [
          o.order_number,
          o.contact_name,
          o.contact_email,
          o.contact_phone,
          ...(o.order_items ?? []).map((i: any) => i.product_name),
        ]
          .join(' ')
          .toLowerCase();

        return haystack.includes(term);
      });

      if (list.length === 0) {
        container.innerHTML = `
          <div class="card p-10 text-center">
            <p class="text-base text-white/80">Sin pedidos para este filtro.</p>
          </div>`;
        return;
      }

      container.innerHTML = list.map(orderCard).join('');
      bindActions();
    }

    function bindActions() {
      document.querySelectorAll<HTMLElement>('[data-status]').forEach((btn) =>
        btn.addEventListener('click', async () => {
          const orderId = btn.dataset.order!;
          const status = btn.dataset.status! as OrderStatus;
          if (!confirm(`¿Mover el pedido a "${STATUS_LABEL[status]}"?`)) return;

          btn.textContent = 'Guardando…';
          (btn as HTMLButtonElement).disabled = true;

          try {
            await updateOrderStatus(orderId, status, {
              notes: `Movido a ${STATUS_LABEL[status]} desde el panel`,
            });
            await refresh();
          } catch (err: any) {
            alert(err?.message ?? 'No se pudo actualizar el pedido.');
            (btn as HTMLButtonElement).disabled = false;
          }
        })
      );

      document.querySelectorAll<HTMLElement>('[data-save-notes]').forEach((btn) =>
        btn.addEventListener('click', async () => {
          const orderId = btn.dataset.saveNotes!;
          const textarea = document.querySelector<HTMLTextAreaElement>(`[data-admin-notes="${orderId}"]`)!;
          await saveOrderNotes(orderId, textarea.value);
          btn.textContent = 'Guardado ✓';
          setTimeout(() => (btn.textContent = 'Guardar nota'), 1600);
        })
      );
    }

    async function refresh() {
      orders = await listOrders(TENANT_ID);
      renderSummary();
      renderList();
    }

    document.getElementById('refresh-orders')?.addEventListener('click', refresh);

    async function init() {
      const loading = document.getElementById('admin-loading')!;
      const view = document.getElementById('orders-view')!;

      try {
        await refresh();
        loading.classList.add('hidden');
        view.classList.remove('hidden');
        renderFilters();

        // Búsqueda rápida
        const searchInput = document.createElement('input');
        searchInput.type = 'search';
        searchInput.placeholder = 'Buscar folio, cliente o pieza…';
        searchInput.className = 'input-dark !min-h-[46px] mb-6 max-w-md';
        searchInput.addEventListener('input', () => {
          search = searchInput.value;
          renderList();
        });
        document.getElementById('filters')!.before(searchInput);
      } catch (err: any) {
        loading.textContent = err?.message ?? 'No se pudieron cargar los pedidos.';
      }
    }

    init();
  </script>
</AdminLayout>
