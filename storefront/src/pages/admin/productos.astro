---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Productos">
  <div id="admin-loading" class="py-20 text-center text-plata-metalico/40 text-sm">Cargando...</div>

  <div id="admin-denied" class="hidden py-20 text-center">
    <p class="section-label mb-4">Acceso restringido</p>
    <h1 class="font-titulos text-3xl text-blancoRoto mb-6">No tienes permisos de administrador</h1>
    <a href="/" class="btn-outline inline-block">Volver al inicio</a>
  </div>

  <div id="products-view" class="hidden">
    <div class="flex items-center justify-between mb-8">
      <div>
        <p class="section-label mb-2">Catálogo</p>
        <h1 class="font-titulos text-4xl text-blancoRoto">Productos</h1>
      </div>
      <button id="new-btn" class="btn-gold">+ Nuevo producto</button>
    </div>

    <!-- Formulario -->
    <div id="form-panel" class="hidden card p-6 mb-8">
      <h2 id="form-title" class="font-acentos text-sm uppercase tracking-[0.2em] text-oro-elegante mb-6">
        Nuevo producto
      </h2>

      <form id="product-form" class="grid sm:grid-cols-2 gap-4">
        <input name="name" placeholder="Nombre *" required class="input-dark sm:col-span-2" />
        <textarea name="description" placeholder="Descripción" rows="3" class="input-dark sm:col-span-2"></textarea>

        <input name="price" type="number" min="0" step="0.01" placeholder="Precio MXN *" required class="input-dark" />

        <select name="categoryId" class="input-dark">
          <option value="">Sin categoría</option>
        </select>

        <div class="sm:col-span-2">
          <label class="block text-[10px] uppercase tracking-[0.2em] text-plata-metalico/50 mb-3">
            Tallas
          </label>
          <div class="flex flex-wrap gap-2">
            {
              ['XS', 'S', 'M', 'L', 'XL', '2XL', '3XL', 'Unitalla'].map((s) => (
                <label class="flex items-center gap-2 border border-plata-metalico/20 px-3 py-2 cursor-pointer hover:border-oro-elegante/50 transition-colors">
                  <input type="checkbox" name="sizes" value={s} class="accent-oro-elegante" />
                  <span class="text-xs text-plata-claro font-acentos">{s}</span>
                </label>
              ))
            }
          </div>
        </div>

        <input name="stock" type="number" min="0" value="10" placeholder="Stock por talla" class="input-dark" />
        <input name="color" placeholder="Color" value="Negro" class="input-dark" />

        <div class="sm:col-span-2">
          <label class="block text-[10px] uppercase tracking-[0.2em] text-plata-metalico/50 mb-2">
            Imagen
          </label>
          <input id="image-input" type="file" accept="image/*" class="block text-xs text-plata-metalico/60 file:mr-4 file:py-2 file:px-4 file:border file:border-plata-metalico/20 file:bg-transparent file:text-xs file:text-plata-claro hover:file:border-oro-elegante file:cursor-pointer" />
          <div id="image-preview" class="hidden mt-3 w-24 h-30 bg-white overflow-hidden">
            <img class="w-full h-full object-contain" />
          </div>
        </div>

        <p id="form-error" class="hidden sm:col-span-2 text-xs text-red-400"></p>

        <div class="sm:col-span-2 flex gap-3 pt-2">
          <button type="submit" id="save-btn" class="btn-gold">Guardar producto</button>
          <button type="button" id="cancel-btn" class="btn-outline">Cancelar</button>
        </div>
      </form>
    </div>

    <!-- Tabla -->
    <div class="space-y-3" id="products-list"></div>
  </div>

  <script>
    import {
      isAdmin,
      listAllProducts,
      getCategories,
      createProduct,
      updateProduct,
      updateVariantStock,
      softDeleteProduct,
      uploadProductImage,
    } from '../../lib/admin';
    import { TENANT_ID } from '../../lib/constants';

    let products: any[] = [];

    function render(list: any[]) {
      const container = document.getElementById('products-list')!;
      if (list.length === 0) {
        container.innerHTML = `<p class="text-sm text-plata-metalico/40 py-10 text-center">Sin productos. Crea el primero.</p>`;
        return;
      }

      container.innerHTML = list
        .map((p) => {
          const stock = (p.product_variants ?? []).reduce((s: number, v: any) => s + (v.stock ?? 0), 0);
          const img = p.product_images?.[0]?.url;
          return `
          <div class="border border-plata-metalico/10 p-4 flex items-center gap-4" data-id="${p.id}">
            <div class="w-14 h-16 bg-white shrink-0 overflow-hidden">
              ${img ? `<img src="${img}" alt="" class="w-full h-full object-contain">` : ''}
            </div>
            <div class="flex-1 min-w-0">
              <p class="font-acentos text-sm text-plata-claro truncate">${p.name}</p>
              <p class="text-[11px] text-plata-metalico/50">
                ${p.categories?.name ?? 'Sin categoría'} · Stock: ${stock} · ${p.is_active ? 'Activo' : 'Inactivo'}
              </p>
            </div>
            <p class="font-acentos text-sm text-oro-elegante shrink-0">$${Number(p.base_price).toLocaleString('es-MX')}</p>
            <div class="flex gap-2 shrink-0">
              <button data-toggle="${p.id}" class="px-3 py-2 text-[10px] uppercase tracking-wider border border-plata-metalico/20 text-plata-metalico hover:border-oro-elegante hover:text-oro-elegante transition-colors">
                ${p.is_active ? 'Ocultar' : 'Activar'}
              </button>
              <button data-stock="${p.id}" class="px-3 py-2 text-[10px] uppercase tracking-wider border border-plata-metalico/20 text-plata-metalico hover:border-oro-elegante hover:text-oro-elegante transition-colors">
                Stock
              </button>
              <button data-delete="${p.id}" class="px-3 py-2 text-[10px] uppercase tracking-wider border border-red-500/20 text-red-400/70 hover:border-red-500 hover:text-red-400 transition-colors">
                Borrar
              </button>
            </div>
          </div>`;
        })
        .join('');

      container.querySelectorAll('[data-toggle]').forEach((el) =>
        el.addEventListener('click', async () => {
          const id = (el as HTMLElement).dataset.toggle!;
          const p = products.find((x) => x.id === id);
          await updateProduct(id, { is_active: !p.is_active });
          await refresh();
        })
      );

      container.querySelectorAll('[data-stock]').forEach((el) =>
        el.addEventListener('click', async () => {
          const id = (el as HTMLElement).dataset.stock!;
          const p = products.find((x) => x.id === id);
          const input = prompt(
            `Stock para ${p.name} (${p.product_variants.length} variantes).\nIngresa el stock por talla:`,
            '10'
          );
          if (input === null) return;
          const val = Number(input);
          if (isNaN(val)) return;

          for (const v of p.product_variants) {
            await updateVariantStock(v.id, val);
          }
          await refresh();
        })
      );

      container.querySelectorAll('[data-delete]').forEach((el) =>
        el.addEventListener('click', async () => {
          const id = (el as HTMLElement).dataset.delete!;
          if (!confirm('¿Desactivar este producto? (soft delete)')) return;
          await softDeleteProduct(id);
          await refresh();
        })
      );
    }

    async function refresh() {
      products = await listAllProducts(TENANT_ID);
      render(products);
    }

    async function init() {
      const loading = document.getElementById('admin-loading')!;
      const denied = document.getElementById('admin-denied')!;
      const view = document.getElementById('products-view')!;

      if (!(await isAdmin())) {
        loading.classList.add('hidden');
        denied.classList.remove('hidden');
        return;
      }

      loading.classList.add('hidden');
      view.classList.remove('hidden');

      // Categorías
      const cats = await getCategories(TENANT_ID);
      document.querySelectorAll('select[name="categoryId"]').forEach((sel) => {
        (sel as HTMLSelectElement).innerHTML =
          `<option value="">Sin categoría</option>` +
          cats.map((c: any) => `<option value="${c.id}">${c.name}</option>`).join('');
      });

      await refresh();

      // Panel
      const panel = document.getElementById('form-panel')!;
      document.getElementById('new-btn')!.addEventListener('click', () =>
        panel.classList.toggle('hidden')
      );
      document.getElementById('cancel-btn')!.addEventListener('click', () =>
        panel.classList.add('hidden')
      );

      // Preview imagen
      const fileInput = document.getElementById('image-input') as HTMLInputElement;
      fileInput?.addEventListener('change', () => {
        const file = fileInput.files?.[0];
        const preview = document.getElementById('image-preview')!;
        if (!file) {
          preview.classList.add('hidden');
          return;
        }
        preview.querySelector('img')!.src = URL.createObjectURL(file);
        preview.classList.remove('hidden');
      });

      // Submit
      const form = document.getElementById('product-form') as HTMLFormElement;
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = document.getElementById('save-btn') as HTMLButtonElement;
        const errorEl = document.getElementById('form-error')!;
        btn.disabled = true;
        btn.textContent = 'Guardando...';
        errorEl.classList.add('hidden');

        try {
          const fd = new FormData(form);
          const sizes = fd.getAll('sizes').map(String);
          if (sizes.length === 0) sizes.push('Unitalla');

          const name = String(fd.get('name'));

          let imageUrl: string | null = null;
          const file = fileInput.files?.[0];
          if (file) {
            const slugHint = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
            imageUrl = await uploadProductImage(file, slugHint);
          }

          await createProduct(TENANT_ID, {
            name,
            description: String(fd.get('description') ?? ''),
            price: Number(fd.get('price')),
            categoryId: (fd.get('categoryId') as string) || null,
            sizes,
            stockPerSize: Number(fd.get('stock') || 10),
            color: String(fd.get('color') || 'Negro'),
            imageUrl,
          });

          form.reset();
          document.getElementById('image-preview')!.classList.add('hidden');
          panel.classList.add('hidden');
          await refresh();
        } catch (err: any) {
          errorEl.textContent = err?.message ?? 'Error al guardar';
          errorEl.classList.remove('hidden');
        } finally {
          btn.disabled = false;
          btn.textContent = 'Guardar producto';
        }
      });
    }

    init();
  </script>
</AdminLayout>
