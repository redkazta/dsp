---
/**
 * /admin/configuracion — ajustes reales del panel.
 *
 *  · Mi cuenta: nombre, teléfono, correo (solo lectura) y contraseña.
 *  · Tienda (ERP): envío gratis, costo de envío, correo de contacto y umbral
 *    de stock bajo. Se guardan en `store_settings` y el checkout los usa.
 */
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { createSupabaseServerClient } from '../../lib/supabase-server';
import { getStoreSettings } from '../../lib/settings';

const user = Astro.locals.user;
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);

const [{ data: profile }, settings] = await Promise.all([
  user
    ? supabase
        .from('customer_profiles')
        .select('first_name, last_name, full_name, phone')
        .eq('id', user.id)
        .maybeSingle()
    : Promise.resolve({ data: null }),
  getStoreSettings(),
]);

const email = user?.email ?? Astro.locals.email ?? '';
const firstName = profile?.first_name ?? Astro.locals.firstName ?? '';
const lastName = profile?.last_name ?? '';
const phone = profile?.phone ?? Astro.locals.phone ?? '';
---

<AdminLayout title="Configuración">
  <header class="mb-8">
    <p class="section-label mb-1.5">Panel</p>
    <h1 class="font-titulos text-3xl sm:text-4xl text-blancoRoto leading-none">Configuración</h1>
    <p class="text-sm text-white/60 mt-2">
      Tu cuenta de administrador y los valores con los que opera la tienda.
    </p>
  </header>

  <div class="grid lg:grid-cols-2 gap-5 items-start">
    <!-- Mi cuenta -->
    <section class="card p-5 sm:p-6">
      <h2 class="font-acentos text-xs uppercase tracking-[0.2em] text-oro-brillo mb-5">
        Mi cuenta
      </h2>

      <form id="account-form" class="space-y-3.5">
        <div class="grid sm:grid-cols-2 gap-3">
          <label class="block">
            <span class="field-label">Nombre</span>
            <input name="first_name" class="input-dark" value={firstName} autocomplete="given-name" />
          </label>
          <label class="block">
            <span class="field-label">Apellido</span>
            <input name="last_name" class="input-dark" value={lastName} autocomplete="family-name" />
          </label>
        </div>

        <label class="block">
          <span class="field-label">Teléfono</span>
          <input name="phone" class="input-dark" value={phone} autocomplete="tel" inputmode="tel" />
        </label>

        <label class="block">
          <span class="field-label">Correo</span>
          <input class="input-dark opacity-60 cursor-not-allowed" value={email} readonly tabindex="-1" />
          <span class="mt-1 block text-[11px] text-white/45">
            El correo de acceso se cambia desde soporte para no perder el historial.
          </span>
        </label>

        <div class="flex flex-wrap items-center gap-3 pt-1">
          <button type="submit" class="btn-gold !min-h-[42px] !px-5 !py-2 !text-xs">
            Guardar cambios
          </button>
          <span id="account-status" class="text-sm text-oro-brillo"></span>
        </div>
      </form>

      <div class="mt-6 pt-5 border-t border-white/15 flex flex-wrap gap-2">
        <button
          type="button"
          id="change-password"
          class="btn-outline !min-h-[42px] !px-4 !py-2 !text-xs"
        >
          Cambiar contraseña
        </button>
        <button
          type="button"
          data-admin-logout
          class="!min-h-[42px] px-4 py-2 text-[11px] uppercase tracking-wider border-2 border-white/25 text-white/70 hover:border-red-400 hover:text-red-400 transition-colors"
        >
          Cerrar sesión
        </button>
        <p id="password-status" class="text-xs text-white/60 self-center"></p>
      </div>
    </section>

    <!-- Tienda / ERP -->
    <section class="card p-5 sm:p-6">
      <h2 class="font-acentos text-xs uppercase tracking-[0.2em] text-oro-brillo mb-5">
        Tienda
      </h2>

      <form id="store-form" class="space-y-3.5">
        <div class="grid sm:grid-cols-2 gap-3">
          <label class="block">
            <span class="field-label">Envío gratis desde (USD)</span>
            <input
              name="freeShippingThreshold"
              type="number"
              min="0"
              step="0.01"
              class="input-dark"
              value={settings.freeShippingThreshold}
            />
          </label>
          <label class="block">
            <span class="field-label">Costo de envío (USD)</span>
            <input
              name="standardShipping"
              type="number"
              min="0"
              step="0.01"
              class="input-dark"
              value={settings.standardShipping}
            />
          </label>
        </div>

        <label class="block">
          <span class="field-label">Correo de contacto</span>
          <input
            name="contactEmail"
            type="email"
            class="input-dark"
            value={settings.contactEmail}
            autocomplete="email"
          />
          <span class="mt-1 block text-[11px] text-white/45">
            Destino de los mensajes del formulario y de las respuestas a los correos.
          </span>
        </label>

        <label class="block">
          <span class="field-label">Aviso de stock bajo (piezas)</span>
          <input
            name="lowStockThreshold"
            type="number"
            min="0"
            max="999"
            step="1"
            class="input-dark"
            value={settings.lowStockThreshold}
          />
          <span class="mt-1 block text-[11px] text-white/45">
            El dashboard marca las variantes con esta cantidad o menos.
          </span>
        </label>

        <div class="flex flex-wrap items-center gap-3 pt-1">
          <button type="submit" class="btn-gold !min-h-[42px] !px-5 !py-2 !text-xs">
            Guardar tienda
          </button>
          <span id="store-status" class="text-sm text-oro-brillo"></span>
        </div>
      </form>

      <p class="mt-6 pt-5 border-t border-white/15 text-[11px] text-white/45 leading-relaxed">
        Los envíos se cobran al pagar con estos valores. Si cambias el costo, aplica a los
        pedidos nuevos; los ya creados conservan su total.
      </p>
    </section>
  </div>

  <style>
    .field-label {
      display: block;
      margin-bottom: 0.4rem;
      font-family: 'Space Grotesk', Inter, sans-serif;
      font-size: 0.7rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #ffe28a;
    }
  </style>

  <script>
    import { updateProfile } from '../../lib/auth';
    import { supabase } from '../../lib/supabase';

    // ---------- Mi cuenta ----------
    const accountForm = document.getElementById('account-form') as HTMLFormElement | null;
    const accountStatus = document.getElementById('account-status');

    accountForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(accountForm);
      const submit = accountForm.querySelector('button[type="submit"]') as HTMLButtonElement;

      submit.disabled = true;
      if (accountStatus) accountStatus.textContent = '';

      const { error } = await updateProfile({
        first_name: String(data.get('first_name') ?? '').trim(),
        last_name: String(data.get('last_name') ?? '').trim(),
        phone: String(data.get('phone') ?? '').trim(),
      });

      submit.disabled = false;

      if (accountStatus) {
        accountStatus.textContent = error ? 'No se pudo guardar.' : 'Guardado ✓';
        accountStatus.className = error ? 'text-sm text-red-400' : 'text-sm text-oro-brillo';
      }
    });

    // ---------- Contraseña ----------
    document.getElementById('change-password')?.addEventListener('click', async () => {
      const status = document.getElementById('password-status');
      const email = document.querySelector<HTMLInputElement>('#account-form input[readonly]')?.value ?? '';

      if (!email) return;
      if (status) status.textContent = 'Enviando…';

      const { error } = await supabase.auth.resetPasswordForEmail(email, {
        redirectTo: `${window.location.origin}/nueva-password`,
      });

      if (status) {
        status.textContent = error
          ? 'No se pudo enviar el correo.'
          : `Te enviamos un enlace a ${email}.`;
        status.className = error ? 'text-xs text-red-400' : 'text-xs text-oro-brillo';
      }
    });

    // ---------- Tienda ----------
    const storeForm = document.getElementById('store-form') as HTMLFormElement | null;
    const storeStatus = document.getElementById('store-status');

    storeForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(storeForm);
      const submit = storeForm.querySelector('button[type="submit"]') as HTMLButtonElement;

      submit.disabled = true;
      if (storeStatus) storeStatus.textContent = '';

      try {
        const res = await fetch('/api/admin/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            freeShippingThreshold: Number(data.get('freeShippingThreshold')),
            standardShipping: Number(data.get('standardShipping')),
            contactEmail: String(data.get('contactEmail') ?? '').trim(),
            lowStockThreshold: Number(data.get('lowStockThreshold')),
          }),
        });

        const payload = await res.json().catch(() => ({}));

        if (!res.ok) throw new Error(payload?.error ?? 'No se pudo guardar.');

        if (storeStatus) {
          storeStatus.textContent = 'Guardado ✓';
          storeStatus.className = 'text-sm text-oro-brillo';
        }
      } catch (err: any) {
        if (storeStatus) {
          storeStatus.textContent = err?.message ?? 'No se pudo guardar.';
          storeStatus.className = 'text-sm text-red-400';
        }
      } finally {
        submit.disabled = false;
      }
    });
  </script>
</AdminLayout>
