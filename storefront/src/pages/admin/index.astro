---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { localize } from '../../lib/routes';

const { lang } = Astro.locals;
---

<AdminLayout title="Dashboard">
  <div id="admin-loading" class="py-20 text-center text-white/80 text-sm">Cargando...</div>

  <div id="admin-dashboard" class="hidden">
    <div class="mb-10">
      <p class="section-label mb-2">Panel</p>
      <h1 class="font-titulos text-4xl text-blancoRoto">Dashboard</h1>
    </div>

    <div id="stats" class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-12"></div>

    <div class="grid lg:grid-cols-2 gap-8 items-start">
      <section>
        <h2 class="font-acentos text-xs uppercase tracking-[0.25em] text-oro-brillo mb-5">
          Pedidos recientes
        </h2>
        <div id="recent-orders" class="space-y-3"></div>
      </section>

      <section>
        <h2 class="font-acentos text-xs uppercase tracking-[0.25em] text-oro-brillo mb-5">
          Accesos rápidos
        </h2>
        <!-- 6 tarjetas = dos filas exactas de tres: nada se cae abajo. -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
          <a href="/admin/productos" class="card h-full flex flex-col justify-center p-4 sm:p-5 hover:border-oro-brillo/60 transition-colors">
            <p class="font-acentos text-sm text-white mb-1">Productos</p>
            <p class="text-xs text-white/80 leading-snug">Precios, stock y fotos</p>
          </a>
          <a href="/admin/pedidos" class="card h-full flex flex-col justify-center p-4 sm:p-5 hover:border-oro-brillo/60 transition-colors">
            <p class="font-acentos text-sm text-white mb-1">Pedidos</p>
            <p class="text-xs text-white/80 leading-snug">Estatus y envíos</p>
          </a>
          <a href="/admin/mensajes" class="card relative h-full flex flex-col justify-center p-4 sm:p-5 hover:border-oro-brillo/60 transition-colors">
            <p class="font-acentos text-sm text-white mb-1">Mensajes</p>
            <p class="text-xs text-white/80 leading-snug">Formulario de contacto</p>
            <span id="new-messages-badge" class="hidden absolute top-3 right-3 min-w-[20px] h-5 px-1.5 inline-flex items-center justify-center bg-oro-brillo text-negro-profundo text-[11px] font-bold"></span>
          </a>
          <a href={localize(lang, 'shop')} target="_blank" rel="noopener" class="card h-full flex flex-col justify-center p-4 sm:p-5 hover:border-oro-brillo/60 transition-colors">
            <p class="font-acentos text-sm text-white mb-1">Ver tienda</p>
            <p class="text-xs text-white/80 leading-snug">Como cliente</p>
          </a>
          <a href="/cuenta" class="card h-full flex flex-col justify-center p-4 sm:p-5 hover:border-oro-brillo/60 transition-colors">
            <p class="font-acentos text-sm text-white mb-1">Mi cuenta</p>
            <p class="text-xs text-white/80 leading-snug">Perfil y pedidos</p>
          </a>
          <a href="/admin/configuracion" class="card h-full flex flex-col justify-center p-4 sm:p-5 hover:border-oro-brillo/60 transition-colors">
            <p class="font-acentos text-sm text-white mb-1">Configuración</p>
            <p class="text-xs text-white/80 leading-snug">Integraciones y estado</p>
          </a>
        </div>

        <h2 class="font-acentos text-xs uppercase tracking-[0.25em] text-oro-brillo mt-8 mb-5">
          Stock bajo
        </h2>
        <div id="low-stock" class="space-y-2"></div>
      </section>
    </div>
  </div>

  <script>
    import { getDashboardStats, listOrders, listAllProducts, countNewContactMessages } from '../../lib/admin';
    import { escapeHtml } from '../../lib/html';
    import { TENANT_ID } from '../../lib/constants';
    import { STATUS_LABEL, formatOrderMoney, type OrderStatus } from '../../lib/orders';

    async function init() {
      const loading = document.getElementById('admin-loading')!;
      const dash = document.getElementById('admin-dashboard')!;

      const [stats, orders, products] = await Promise.all([
        getDashboardStats(TENANT_ID),
        listOrders(TENANT_ID),
        listAllProducts(TENANT_ID),
      ]);

      // Mensajes sin leer: no debe romper el dashboard si la tabla no existe aún.
      const newMessages = await countNewContactMessages(TENANT_ID).catch(() => 0);

      loading.classList.add('hidden');
      dash.classList.remove('hidden');

      // Badge de mensajes nuevos en el acceso rápido.
      const msgBadge = document.getElementById('new-messages-badge');
      if (msgBadge && newMessages > 0) {
        msgBadge.textContent = String(newMessages);
        msgBadge.classList.remove('hidden');
      }

      document.getElementById('stats')!.innerHTML = [
        { label: 'Ventas del mes', value: formatOrderMoney(stats.monthRevenue) },
        { label: 'Pago pendiente', value: String(stats.pendingOrders) },
        { label: 'En producción', value: String(stats.inProduction) },
        { label: 'Listos para enviar', value: String(stats.readyOrders) },
      ]
        .map(
          (s) => `
        <div class="card p-5">
          <p class="text-xs uppercase tracking-[0.16em] text-white/80 mb-2">${s.label}</p>
          <p class="font-acentos text-2xl text-oro-brillo">${s.value}</p>
        </div>`
        )
        .join('');

      document.getElementById('recent-orders')!.innerHTML =
        orders.length === 0
          ? `<p class="text-sm text-white/80">Aún no hay pedidos.</p>`
          : orders
              .slice(0, 6)
              .map(
                (o: any) => `
          <a href="/admin/pedidos?order=${encodeURIComponent(o.id)}" class="flex items-center justify-between gap-4 card p-4 hover:border-oro-brillo transition-colors">
            <div class="min-w-0">
              <p class="font-acentos text-base text-blancoRoto">${o.order_number ?? o.id.slice(0, 8)}</p>
              <p class="text-sm text-white/80 truncate">${o.contact_name ?? ''}</p>
              <p class="text-xs uppercase tracking-wider text-oro-brillo">${STATUS_LABEL[o.status as OrderStatus] ?? o.status}</p>
            </div>
            <p class="font-acentos text-base text-oro-brillo whitespace-nowrap">${formatOrderMoney(Number(o.total_amount))}</p>
          </a>`
              )
              .join('');

      // Stock bajo: variantes con 5 piezas o menos (se ordena por urgencia)
      const lowStock = products
        .flatMap((p: any) =>
          (p.product_variants ?? []).map((v: any) => ({
            productId: p.id,
            product: p.name,
            variant: v.name ?? v.size ?? 'Unitalla',
            stock: Number(v.stock ?? 0),
          }))
        )
        .filter((v: any) => v.stock <= 5 && v.stock < 900) // 999 = sin límite real
        .sort((a: any, b: any) => a.stock - b.stock)
        .slice(0, 6);

      document.getElementById('low-stock')!.innerHTML =
        lowStock.length === 0
          ? `<p class="text-sm text-white/70">Todo el inventario está por encima de 5 piezas.</p>`
          : lowStock
              .map(
                (v: any) => `
          <a href="/admin/productos/${v.productId}" class="flex items-center justify-between gap-3 card p-3 hover:border-oro-brillo transition-colors">
            <span class="min-w-0">
              <span class="block text-sm text-white truncate">${escapeHtml(v.product)}</span>
              <span class="block text-xs text-white/70">${escapeHtml(v.variant)}</span>
            </span>
            <span class="font-acentos text-sm ${v.stock === 0 ? 'text-red-400' : 'text-oro-brillo'} whitespace-nowrap">${v.stock} pza</span>
          </a>`
              )
              .join('');
    }

    init();
  </script>
</AdminLayout>
