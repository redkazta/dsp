---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Dashboard">
  <div id="admin-loading" class="py-20 text-center text-plata-metalico/75 text-sm">Cargando...</div>

  <div id="admin-dashboard" class="hidden">
    <div class="mb-10">
      <p class="section-label mb-2">Panel</p>
      <h1 class="font-titulos text-4xl text-blancoRoto">Dashboard</h1>
    </div>

    <div id="stats" class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-12"></div>

    <div class="grid lg:grid-cols-2 gap-8">
      <section>
        <h2 class="font-acentos text-[11px] uppercase tracking-[0.25em] text-oro-elegante mb-5">
          Pedidos recientes
        </h2>
        <div id="recent-orders" class="space-y-3"></div>
      </section>

      <section>
        <h2 class="font-acentos text-[11px] uppercase tracking-[0.25em] text-oro-elegante mb-5">
          Accesos rápidos
        </h2>
        <div class="grid grid-cols-2 gap-3">
          <a href="/admin/productos" class="card p-6 hover:border-oro-elegante/40 transition-colors">
            <p class="font-acentos text-sm text-plata-claro mb-1">Productos</p>
            <p class="text-xs text-plata-metalico/80">Crear y editar</p>
          </a>
          <a href="/admin/pedidos" class="card p-6 hover:border-oro-elegante/40 transition-colors">
            <p class="font-acentos text-sm text-plata-claro mb-1">Pedidos</p>
            <p class="text-xs text-plata-metalico/80">Estatus y envíos</p>
          </a>
        </div>
      </section>
    </div>
  </div>

  <script>
    import { getDashboardStats, listOrders } from '../../lib/admin';
    import { TENANT_ID } from '../../lib/constants';
    import { STATUS_LABEL, formatOrderMoney, type OrderStatus } from '../../lib/orders';

    async function init() {
      const loading = document.getElementById('admin-loading')!;
      const dash = document.getElementById('admin-dashboard')!;

      const [stats, orders] = await Promise.all([
        getDashboardStats(TENANT_ID),
        listOrders(TENANT_ID),
      ]);

      loading.classList.add('hidden');
      dash.classList.remove('hidden');

      document.getElementById('stats')!.innerHTML = [
        { label: 'Ventas del mes', value: formatOrderMoney(stats.monthRevenue) },
        { label: 'Pago pendiente', value: String(stats.pendingOrders) },
        { label: 'En producción', value: String(stats.inProduction) },
        { label: 'Listos para enviar', value: String(stats.readyOrders) },
      ]
        .map(
          (s) => `
        <div class="card p-5">
          <p class="text-[11px] uppercase tracking-[0.16em] text-plata-metalico/85 mb-2">${s.label}</p>
          <p class="font-acentos text-2xl text-oro-elegante">${s.value}</p>
        </div>`
        )
        .join('');

      document.getElementById('recent-orders')!.innerHTML =
        orders.length === 0
          ? `<p class="text-sm text-plata-metalico/85">Aún no hay pedidos.</p>`
          : orders
              .slice(0, 6)
              .map(
                (o: any) => `
          <a href="/admin/pedidos" class="flex items-center justify-between gap-4 card p-4 hover:border-oro-elegante transition-colors">
            <div class="min-w-0">
              <p class="font-acentos text-base text-blancoRoto">${o.order_number ?? o.id.slice(0, 8)}</p>
              <p class="text-sm text-plata-metalico/85 truncate">${o.contact_name ?? ''}</p>
              <p class="text-xs uppercase tracking-wider text-oro-elegante">${STATUS_LABEL[o.status as OrderStatus] ?? o.status}</p>
            </div>
            <p class="font-acentos text-base text-oro-elegante whitespace-nowrap">${formatOrderMoney(Number(o.total_amount))}</p>
          </a>`
              )
              .join('');
    }

    init();
  </script>
</AdminLayout>
