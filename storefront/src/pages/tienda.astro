---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ProductList from '../components/product/ProductList.astro';
import { getProducts, getCategories, TENANT_SLUG } from '../lib/supabase';
import { getCopy, categoryName, type Lang } from '../lib/i18n';

const lang = (Astro.locals.lang ?? 'es') as Lang;
const t = getCopy(lang);

const categoryParam = Astro.url.searchParams.get('category') ?? undefined;
const search = Astro.url.searchParams.get('q') ?? '';
const sortParam = Astro.url.searchParams.get('sort') ?? 'newest';
const sort = ['newest', 'price-asc', 'price-desc', 'name-asc'].includes(sortParam)
  ? (sortParam as 'newest' | 'price-asc' | 'price-desc' | 'name-asc')
  : 'newest';

const PRICE_BANDS = [
  { value: '', label: t.shop.priceAll, min: undefined, max: undefined },
  { value: '0-50', label: `${t.shop.priceUpTo} $50`, min: 0, max: 50 },
  { value: '50-100', label: '$50 – $100', min: 50, max: 100 },
  { value: '100-200', label: '$100 – $200', min: 100, max: 200 },
  { value: '200-', label: `${t.shop.priceFrom} $200`, min: 200, max: undefined },
];

const priceParam = Astro.url.searchParams.get('precio') ?? '';
const priceBand = PRICE_BANDS.find((b) => b.value === priceParam) ?? PRICE_BANDS[0];

let products: any[] = [];
let categories: any[] = [];
let errorMessage: string | null = null;

/** Acepta id (UUID) o slug de categoría: /tienda?category=jeans */
let categoryId = categoryParam;

const baseCategories = await getCategories(TENANT_SLUG);
const categoryList: any[] = baseCategories.data ?? [];

// Si llega un slug, se traduce al id para que la consulta y los chips coincidan.
if (categoryParam) {
  const match = categoryList.find(
    (c: any) => c.id === categoryParam || c.slug === categoryParam
  );
  categoryId = match?.id ?? categoryParam;
}

const [productsResult] = await Promise.all([
  getProducts(TENANT_SLUG, {
    page: 1,
    limit: 48,
    categoryId,
    search: search || undefined,
    sort,
    minPrice: priceBand.min,
    maxPrice: priceBand.max,
  }),
]);

if (productsResult.error) {
  errorMessage = productsResult.error;
} else {
  products = productsResult.data ?? [];
}

categories = categoryList;

const sortOptions = [
  { value: 'newest', label: t.shop.sortNewest },
  { value: 'price-asc', label: t.shop.sortPriceAsc },
  { value: 'price-desc', label: t.shop.sortPriceDesc },
  { value: 'name-asc', label: t.shop.sortNameAsc },
];

const shopPath = localize(lang, 'shop');

const buildUrl = (overrides: Record<string, string | undefined>) => {
  const params = new URLSearchParams();
  const base: Record<string, string | undefined> = {
    category: categoryId,
    q: search || undefined,
    sort,
    precio: priceBand.value || undefined,
    ...overrides,
  };
  for (const [k, v] of Object.entries(base)) {
    if (v) params.set(k, v);
  }
  const qs = params.toString();
  return `${shopPath}${qs ? `?${qs}` : ''}`;
};
import { localize } from '../lib/routes';
---

<BaseLayout
  title={t.shop.metaTitle}
  description={t.shop.metaDescription}
>
  <!-- Todo lo que cambia al filtrar u ordenar. El JS lo reemplaza por fetch
       sin recargar la página. -->
  <div id="shop-live" data-shop-query={Astro.url.search}>
  <!-- Encabezado compacto: solo título, número de piezas y carrito -->
  <section class="relative border-b border-white/20 overflow-hidden">
    <div class="absolute inset-0 bg-noise"></div>
    <div class="absolute -top-24 right-0 w-[420px] h-[420px] rounded-full bg-oro-brillo/5 blur-[110px] pointer-events-none"></div>

    <div class="relative page-container py-3 sm:py-3.5">
      <div class="flex items-end justify-between gap-4">
        <div class="min-w-0">
          <h1 class="font-titulos text-2xl sm:text-3xl lg:text-4xl text-blancoRoto leading-none truncate">
            {categoryId ? categoryName(lang, categories.find((c: any) => c.id === categoryId)) ?? t.shop.allPieces : t.shop.allPieces}
          </h1>
          <p class="mt-1.5 text-sm text-white/70">
            {products.length} {products.length === 1 ? t.shop.productOne : t.shop.productMany}
            {search ? ` ${t.shop.forQuery} “${search}”` : ''}
          </p>
        </div>

        <a href={localize(lang, 'cart')} class="btn-outline !min-h-[34px] !px-3 !py-1.5 !text-[11px] shrink-0">{t.shop.viewCart}</a>
      </div>
    </div>
  </section>

  <!-- Barra de filtros -->
  <section class="sticky top-16 sm:top-20 z-40 bg-negro-profundo/95 backdrop-blur-xl border-b-2 border-white/25">
    <div class="page-container">
      <div class="flex flex-col lg:flex-row lg:items-center gap-2 py-1.5">
        <!-- Chips de categoría -->
        <div class="flex items-center gap-1.5 overflow-x-auto pb-0.5 lg:pb-0 -mx-5 px-5 sm:mx-0 sm:px-0 scrollbar-none">
          <a
            href={buildUrl({ category: undefined })}
            data-live
            class:list={[
              'shrink-0 px-3 py-1.5 min-h-[34px] inline-flex items-center font-acentos text-[11px] uppercase tracking-[0.16em] border-2 transition-colors duration-300',
              !categoryId
                ? 'border-oro-brillo text-oro-brillo bg-oro-brillo/10'
                : 'border-white/40 text-white/80 hover:border-oro-brillo hover:text-oro-brillo',
            ]}
          >
            {t.shop.allChips}
          </a>
          {
            categories.map((cat: any) => (
              <a
                href={buildUrl({ category: cat.id })}
                data-live
                class:list={[
                  'shrink-0 px-3 py-1.5 min-h-[34px] inline-flex items-center font-acentos text-[11px] uppercase tracking-[0.16em] border-2 transition-colors duration-300',
                  categoryId === cat.id
                    ? 'border-oro-brillo text-oro-brillo bg-oro-brillo/10'
                    : 'border-white/40 text-white/80 hover:border-oro-brillo hover:text-oro-brillo',
                ]}
              >
                {categoryName(lang, cat)}
              </a>
            ))
          }
        </div>

        <div class="flex-1"></div>

        <!-- Buscar + precio + ordenar -->
        <div class="flex flex-col sm:flex-row gap-2 lg:shrink-0">
          <form method="get" class="flex" data-search>
            <input
              type="search"
              name="q"
              value={search}
              placeholder={t.shop.searchPlaceholder}
              class="input-dark text-xs !min-h-[34px] !py-1.5 w-full sm:w-44"
            />
            {categoryId && <input type="hidden" name="category" value={categoryId} />}
            <input type="hidden" name="sort" value={sort} />
            {priceBand.value && <input type="hidden" name="precio" value={priceBand.value} />}
          </form>

          <!-- Precio: enlaces compartibles (?precio=700-1200) -->
          <details class="relative">
            <summary class="input-dark text-xs !min-h-[34px] !py-1.5 pr-7 cursor-pointer flex items-center select-none">
              {priceBand.label}
            </summary>
            <div class="absolute right-0 top-full mt-2 z-50 min-w-[230px] bg-negro-carbono border-2 border-white/30 p-2">
              {
                PRICE_BANDS.map((band) => (
                  <a
                    href={buildUrl({ precio: band.value || undefined })}
                    data-live
                    class:list={[
                      'block px-3 py-2 text-sm transition-colors',
                      band.value === priceBand.value
                        ? 'text-oro-brillo bg-oro-brillo/10'
                        : 'text-white/80 hover:text-oro-brillo',
                    ]}
                  >
                    {band.label}
                  </a>
                ))
              }
            </div>
          </details>

          <form method="get" class="flex">
            <select
              name="sort"
              data-sort
              class="input-dark text-xs !min-h-[34px] !py-1.5 pr-7 cursor-pointer"
            >
              {
                sortOptions.map((opt) => (
                  <option value={opt.value} selected={sort === opt.value}>
                    {opt.label}
                  </option>
                ))
              }
            </select>
            {categoryId && <input type="hidden" name="category" value={categoryId} />}
            {search && <input type="hidden" name="q" value={search} />}
            {priceBand.value && <input type="hidden" name="precio" value={priceBand.value} />}
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Grid -->
  <section class="page-container py-3 sm:py-4 lg:py-5">
    {
      errorMessage ? (
        <div class="max-w-xl mx-auto text-center py-20">
          <div class="w-12 h-12 mx-auto mb-6 border border-red-500/40 flex items-center justify-center">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f87171" stroke-width="1.5">
              <path d="M12 9v4M12 17h.01" /><circle cx="12" cy="12" r="9" />
            </svg>
          </div>
          <h2 class="font-titulos text-2xl text-blancoRoto mb-3">{t.shop.loadErrorTitle}</h2>
          <p class="text-base text-white/80 mb-6">
            {t.shop.loadErrorText}
          </p>
          <pre class="text-left text-xs text-red-300 bg-negro-carbono border-2 border-red-400/40 p-4 overflow-x-auto">
            {errorMessage}
          </pre>
        </div>
      ) : products.length === 0 ? (
        <div class="max-w-md mx-auto text-center py-16 sm:py-24">
          <p class="font-titulos text-3xl text-blancoRoto mb-3">{t.shop.emptyTitle}</p>
          <p class="text-base text-white/80 mb-8">
            {search
              ? `${t.shop.emptyForQuery} “${search}”.`
              : t.shop.emptyCollection}
          </p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href={localize(lang, 'shop')} class="btn-gold">{t.shop.seeAll}</a>
            <a href="/" class="btn-outline">{t.shop.goHome}</a>
          </div>
        </div>
      ) : (
        <ProductList products={products} compact />
      )
    }
  </section>
  </div>
</BaseLayout>

<script>
  const liveRoot = () => document.getElementById('shop-live');

  let controller: AbortController | null = null;

  /** Skeletons con la forma de las tarjetas mientras llega el HTML nuevo. */
  function paintSkeleton() {
    const grid = liveRoot()?.querySelector<HTMLElement>('[data-shop-grid]');
    if (!grid) return;

    grid.innerHTML = Array.from({ length: 10 })
      .map(
        () => `
        <div class="product-card-wrap">
          <div class="product-frame shimmer" style="border:2px solid rgba(255,255,255,0.25)"></div>
          <div class="pt-3 space-y-2">
            <div class="shimmer h-3 w-3/4"></div>
            <div class="shimmer h-3 w-1/3"></div>
          </div>
        </div>`
      )
      .join('');
  }

  /**
   * Cambia filtros/orden sin recargar: pide la misma página y sustituye
   * solo `#shop-live`. El servidor sigue mandando (mismos precios, mismo
   * stock y mismos enlaces compartibles).
   */
  async function shopNavigate(target: string | URL, push = true) {
    const root = liveRoot();
    const url = new URL(String(target), location.href);

    if (!root) {
      location.href = url.href;
      return;
    }

    controller?.abort();
    controller = new AbortController();

    root.setAttribute('aria-busy', 'true');
    paintSkeleton();

    try {
      // `_` evita que un proxy o el navegador devuelvan HTML de otro filtro:
      // cada navegación en vivo pide una respuesta limpia.
      const fetchUrl = new URL(url.href);
      fetchUrl.searchParams.set('_', String(Date.now()));

      const res = await fetch(fetchUrl.href, {
        signal: controller.signal,
        credentials: 'same-origin',
        cache: 'no-store',
        headers: { Accept: 'text/html' },
      });

      if (!res.ok) throw new Error(String(res.status));

      const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
      const fresh = doc.getElementById('shop-live');

      if (!fresh) throw new Error('sin contenido');

      // Si el HTML recibido no corresponde a la URL pedida (caché de un proxy
      // o una respuesta vieja), se recarga de verdad en vez de pintar otra
      // categoría con la URL equivocada.
      if (fresh.getAttribute('data-shop-query') !== url.search) {
        location.href = url.href;
        return;
      }

      root.innerHTML = fresh.innerHTML;

      if (push) history.pushState({ shop: true }, '', url.href);

      document.dispatchEvent(new CustomEvent('reflect:refresh'));
    } catch (err: any) {
      if (err?.name === 'AbortError') return;
      location.href = url.href;
    } finally {
      root.removeAttribute('aria-busy');
    }
  }

  // Categorías y bandas de precio.
  document.addEventListener('click', (e) => {
    const link = (e.target as Element)?.closest?.('a[data-live]') as HTMLAnchorElement | null;
    if (!link) return;
    if (e.metaKey || e.ctrlKey || e.shiftKey || (e as MouseEvent).button !== 0) return;

    e.preventDefault();
    link.closest('details')?.removeAttribute('open');
    void shopNavigate(link.href);
  });

  // Orden.
  document.addEventListener('change', (e) => {
    const select = (e.target as Element)?.closest?.('select[data-sort]') as HTMLSelectElement | null;
    if (!select) return;

    const url = new URL(location.href);
    url.searchParams.set('sort', select.value);
    void shopNavigate(url);
  });

  // Buscar (Enter o botón).
  document.addEventListener('submit', (e) => {
    const form = e.target as HTMLFormElement | null;
    if (!form?.matches?.('form[data-search]')) return;

    e.preventDefault();

    const q = String(new FormData(form).get('q') ?? '').trim();
    const url = new URL(location.href);
    if (q) url.searchParams.set('q', q);
    else url.searchParams.delete('q');

    void shopNavigate(url);
  });

  // Atrás/adelante: se repinta sin recargar.
  window.addEventListener('popstate', () => void shopNavigate(location.href, false));

  // Cierra el desplegable de precio al tocar fuera.
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLDetailsElement>('details[open]').forEach((d) => {
      if (!d.contains(e.target as Node)) d.removeAttribute('open');
    });
  });
</script>
