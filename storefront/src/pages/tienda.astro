---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductList from '../components/product/ProductList.astro';
import { getProducts, getCategories } from '../lib/supabase';

// Tenant por query param (temporal hasta tener subdominios)
const tenantId = Astro.url.searchParams.get('tenant') ?? 'dinerosobreproblemas';

const [productsResult, categoriesResult] = await Promise.all([
  getProducts(tenantId, { page: 1, limit: 12 }),
  getCategories(tenantId),
]);

const products = productsResult.data ?? [];
const categories = categoriesResult.data ?? [];
---

<BaseLayout
  title="Catálogo | Dinero Sobre Problemas"
  description="Explora nuestra colección de streetwear premium."
>
  <div class="max-w-7xl mx-auto px-6 py-12">
    <div class="flex flex-col md:flex-row gap-10">
      <!-- Filtros -->
      <aside class="w-full md:w-64 shrink-0">
        <div class="card p-6">
          <h3 class="font-titulos text-oro-elegante text-xl mb-6">Filtros</h3>

          <div class="mb-8">
            <h4 class="font-acentos text-plata-claro text-sm uppercase tracking-wider mb-3">
              Categorías
            </h4>
            <ul class="space-y-2">
              {
                categories.length === 0 && (
                  <li class="text-plata-metalico/50 text-sm">Sin categorías</li>
                )
              }
              {categories.map((category) => (
                <li>
                  <a
                    href={`/tienda?tenant=${tenantId}&category=${category.id}`}
                    class="text-plata-metalico hover:text-oro-elegante transition-colors text-sm"
                  >
                    {category.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="mb-8">
            <h4 class="font-acentos text-plata-claro text-sm uppercase tracking-wider mb-3">
              Precio
            </h4>
            <div class="flex gap-2">
              <input
                type="number"
                placeholder="Mín"
                class="w-full bg-negro-profundo border border-plata-metalico/30 rounded px-3 py-2 text-plata-claro text-sm focus:border-oro-elegante outline-none"
              />
              <input
                type="number"
                placeholder="Máx"
                class="w-full bg-negro-profundo border border-plata-metalico/30 rounded px-3 py-2 text-plata-claro text-sm focus:border-oro-elegante outline-none"
              />
            </div>
          </div>

          <button class="btn-primary w-full text-sm">Aplicar</button>
        </div>
      </aside>

      <!-- Catálogo -->
      <div class="flex-1">
        <div class="flex justify-between items-center mb-8">
          <h1 class="font-titulos text-3xl text-blancoRoto">Catálogo</h1>
          <select
            class="bg-negro-carbono border border-plata-metalico/30 rounded px-4 py-2 text-plata-claro text-sm focus:border-oro-elegante outline-none"
          >
            <option>Más recientes</option>
            <option>Precio: Bajo a Alto</option>
            <option>Precio: Alto a Bajo</option>
            <option>Nombre A-Z</option>
          </select>
        </div>

        <ProductList products={products} />
      </div>
    </div>
  </div>
</BaseLayout>
