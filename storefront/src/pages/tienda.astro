---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ProductList from '../components/product/ProductList.astro';
import { getProducts, getCategories, TENANT_SLUG } from '../lib/supabase';

const categoryId = Astro.url.searchParams.get('category') ?? undefined;
const search = Astro.url.searchParams.get('q') ?? '';
const sortParam = Astro.url.searchParams.get('sort') ?? 'newest';
const sort = ['newest', 'price-asc', 'price-desc', 'name-asc'].includes(sortParam)
  ? (sortParam as 'newest' | 'price-asc' | 'price-desc' | 'name-asc')
  : 'newest';

let products: any[] = [];
let categories: any[] = [];
let errorMessage: string | null = null;

try {
  const [productsResult, categoriesResult] = await Promise.all([
    getProducts(TENANT_SLUG, { page: 1, limit: 48, categoryId, search: search || undefined, sort }),
    getCategories(TENANT_SLUG),
  ]);

  if (productsResult.error) {
    errorMessage = productsResult.error;
  } else {
    products = productsResult.data ?? [];
  }
  categories = categoriesResult.data ?? [];
} catch (err: any) {
  errorMessage = err?.message ?? String(err);
}

const sortOptions = [
  { value: 'newest', label: 'Más recientes' },
  { value: 'price-asc', label: 'Precio: menor a mayor' },
  { value: 'price-desc', label: 'Precio: mayor a menor' },
  { value: 'name-asc', label: 'Nombre A-Z' },
];

const buildUrl = (overrides: Record<string, string | undefined>) => {
  const params = new URLSearchParams();
  const base = { category: categoryId, q: search || undefined, sort, ...overrides };
  for (const [k, v] of Object.entries(base)) {
    if (v) params.set(k, v);
  }
  const qs = params.toString();
  return `/tienda${qs ? `?${qs}` : ''}`;
};
---

<BaseLayout
  title="Tienda | Dinero Sobre Problemas"
  description="Catálogo completo de playeras ¡D$P!. Siete acabados, tallas S a XL, envío a todo México."
>
  <!-- Encabezado -->
  <section class="relative border-b border-white/30 overflow-hidden">
    <div class="absolute inset-0 bg-noise"></div>
    <div class="absolute -top-24 right-0 w-[420px] h-[420px] rounded-full bg-oro-brillo/5 blur-[110px] pointer-events-none"></div>

    <div class="relative page-container pt-8 sm:pt-10 pb-10 lg:pt-14 lg:pb-16">
      <nav class="mb-6 sm:mb-8">
        <ol class="flex items-center gap-2 font-acentos text-xs uppercase tracking-[0.2em] text-white/80">
          <li><a href="/" class="hover:text-oro-brillo transition-colors">Inicio</a></li>
          <li>/</li>
          <li class="text-oro-brillo">Tienda</li>
        </ol>
      </nav>

      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
        <div>
          <p class="section-label mb-4">Colección</p>
          <h1 class="font-titulos text-4xl sm:text-5xl lg:text-6xl text-blancoRoto leading-none mb-4">
            {categoryId ? categories.find((c: any) => c.id === categoryId)?.name ?? 'Tienda' : 'Todas las piezas'}
          </h1>
          <p class="text-base text-white/80">
            {products.length} {products.length === 1 ? 'producto' : 'productos'}
            {search ? ` para “${search}”` : ''}
          </p>
        </div>

        <div class="flex items-center gap-3">
          <a href="/carrito" class="btn-outline">Ver carrito</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Barra de filtros -->
  <section class="sticky top-16 sm:top-20 z-40 bg-negro-profundo/95 backdrop-blur-xl border-b-2 border-white/25">
    <div class="page-container">
      <div class="flex flex-col lg:flex-row lg:items-center gap-5 py-4">
        <!-- Chips de categoría -->
        <div class="flex items-center gap-2 overflow-x-auto pb-1 lg:pb-0 -mx-5 px-5 sm:mx-0 sm:px-0 scrollbar-none">
          <a
            href={buildUrl({ category: undefined })}
            class:list={[
              'shrink-0 px-4 py-2.5 min-h-[44px] inline-flex items-center font-acentos text-xs uppercase tracking-[0.2em] border-2 transition-colors duration-300',
              !categoryId
                ? 'border-oro-brillo text-oro-brillo bg-oro-brillo/10'
                : 'border-white/40 text-white/80 hover:border-oro-brillo hover:text-oro-brillo',
            ]}
          >
            Todas
          </a>
          {
            categories.map((cat: any) => (
              <a
                href={buildUrl({ category: cat.id })}
                class:list={[
                  'shrink-0 px-4 py-2.5 min-h-[44px] inline-flex items-center font-acentos text-xs uppercase tracking-[0.2em] border-2 transition-colors duration-300',
                  categoryId === cat.id
                    ? 'border-oro-brillo text-oro-brillo bg-oro-brillo/10'
                    : 'border-white/40 text-white/80 hover:border-oro-brillo hover:text-oro-brillo',
                ]}
              >
                {cat.name}
              </a>
            ))
          }
        </div>

        <div class="flex-1"></div>

        <!-- Buscar + ordenar -->
        <div class="flex flex-col sm:flex-row gap-3 lg:shrink-0">
          <form method="get" class="flex">
            <input
              type="search"
              name="q"
              value={search}
              placeholder="Buscar..."
              class="input-dark text-sm !min-h-[48px] w-full sm:w-56"
            />
            {categoryId && <input type="hidden" name="category" value={categoryId} />}
            <input type="hidden" name="sort" value={sort} />
          </form>

          <form method="get" class="flex">
            <select
              name="sort"
              data-autosubmit
              class="input-dark text-sm !min-h-[48px] pr-8 cursor-pointer"
            >
              {
                sortOptions.map((opt) => (
                  <option value={opt.value} selected={sort === opt.value}>
                    {opt.label}
                  </option>
                ))
              }
            </select>
            {categoryId && <input type="hidden" name="category" value={categoryId} />}
            {search && <input type="hidden" name="q" value={search} />}
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Grid -->
  <section class="page-container py-10 sm:py-12 lg:py-16">
    {
      errorMessage ? (
        <div class="max-w-xl mx-auto text-center py-20">
          <div class="w-12 h-12 mx-auto mb-6 border border-red-500/40 flex items-center justify-center">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f87171" stroke-width="1.5">
              <path d="M12 9v4M12 17h.01" /><circle cx="12" cy="12" r="9" />
            </svg>
          </div>
          <h2 class="font-titulos text-2xl text-blancoRoto mb-3">No pudimos cargar el catálogo</h2>
          <p class="text-base text-white/80 mb-6">
            Revisa la conexión con Supabase o las variables de entorno.
          </p>
          <pre class="text-left text-xs text-red-300 bg-negro-carbono border-2 border-red-400/40 p-4 overflow-x-auto">
            {errorMessage}
          </pre>
        </div>
      ) : products.length === 0 ? (
        <div class="max-w-md mx-auto text-center py-16 sm:py-24">
          <p class="font-titulos text-3xl text-blancoRoto mb-3">Sin resultados</p>
          <p class="text-base text-white/80 mb-8">
            {search
              ? `No encontramos piezas para “${search}”.`
              : 'Todavía no hay productos publicados en esta colección.'}
          </p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href="/tienda" class="btn-gold">Ver todo</a>
            <a href="/" class="btn-outline">Ir al inicio</a>
          </div>
        </div>
      ) : (
        <ProductList products={products} />
      )
    }
  </section>
</BaseLayout>

<script>
  // Enviar el formulario al cambiar el orden
  document.querySelectorAll<HTMLSelectElement>('select[data-autosubmit]').forEach((sel) => {
    sel.addEventListener('change', () => sel.form?.submit());
  });
</script>
