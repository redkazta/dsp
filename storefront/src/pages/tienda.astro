---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ProductList from '../components/product/ProductList.astro';
import { getProducts, getCategories, TENANT_SLUG } from '../lib/supabase';

const categoryId = Astro.url.searchParams.get('category') ?? undefined;
const search = Astro.url.searchParams.get('q') ?? undefined;

let products: any[] = [];
let categories: any[] = [];

try {
  const [productsResult, categoriesResult] = await Promise.all([
    getProducts(TENANT_SLUG, { page: 1, limit: 24, categoryId, search }),
    getCategories(TENANT_SLUG),
  ]);
  products = productsResult.data ?? [];
  categories = categoriesResult.data ?? [];
} catch {
  products = [];
  categories = [];
}
const activeCategory = categoryId ?? null;
---

<BaseLayout
  title="Catálogo | Dinero Sobre Problemas"
  description="Explora la colección completa de streetwear premium. Piezas atemporales diseñadas en México."
>
  <!-- Header de página -->
  <section class="border-b border-plata-metalico/10 bg-noise">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10 py-16 lg:py-20">
      <nav class="mb-6">
        <ol class="flex items-center gap-2 font-acentos text-[10px] uppercase tracking-[0.2em] text-plata-metalico/40">
          <li><a href="/" class="hover:text-oro-elegante transition-colors">Inicio</a></li>
          <li>/</li>
          <li class="text-oro-elegante">Tienda</li>
        </ol>
      </nav>
      <h1 class="font-titulos text-5xl lg:text-6xl text-blancoRoto mb-4">Catálogo</h1>
      <p class="text-plata-metalico/60 max-w-xl">
        {products.length} {products.length === 1 ? 'pieza disponible' : 'piezas disponibles'}
      </p>
    </div>
  </section>

  <div class="max-w-[1400px] mx-auto px-6 lg:px-10 py-12 lg:py-16">
    <div class="flex flex-col lg:flex-row gap-12">
      <!-- Sidebar -->
      <aside class="w-full lg:w-56 shrink-0">
        <div class="lg:sticky lg:top-28">
          <!-- Buscar -->
          <div class="mb-10">
            <h4 class="section-label mb-4">Buscar</h4>
            <form method="get">
              <input
                type="search"
                name="q"
                value={search ?? ''}
                placeholder="Nombre del producto..."
                class="input-dark text-sm"
              />
            </form>
          </div>

          <!-- Categorías -->
          <div class="mb-10">
            <h4 class="section-label mb-4">Categorías</h4>
            <ul class="space-y-1">
              <li>
                <a
                  href="/tienda"
                  class:list={[
                    'block py-2 text-sm transition-colors duration-300',
                    !activeCategory ? 'text-oro-elegante' : 'text-plata-metalico/70 hover:text-oro-elegante',
                  ]}
                >
                  Todas
                </a>
              </li>
              {
                categories.map((cat) => (
                  <li>
                    <a
                      href={`/tienda?category=${cat.id}`}
                      class:list={[
                        'block py-2 text-sm transition-colors duration-300',
                        activeCategory === cat.id
                          ? 'text-oro-elegante'
                          : 'text-plata-metalico/70 hover:text-oro-elegante',
                      ]}
                    >
                      {cat.name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Ordenar -->
          <div>
            <h4 class="section-label mb-4">Ordenar</h4>
            <select class="input-dark text-sm">
              <option>Más recientes</option>
              <option>Precio: menor a mayor</option>
              <option>Precio: mayor a menor</option>
              <option>Nombre A-Z</option>
            </select>
          </div>
        </div>
      </aside>

      <!-- Productos -->
      <div class="flex-1">
        <ProductList products={products} />
      </div>
    </div>
  </div>
</BaseLayout>
