---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getCopy, type Lang } from '../lib/i18n';

const lang = (Astro.locals.lang ?? 'es') as Lang;
const t = getCopy(lang);
const page = t.legal.contact;

// Textos del script del navegador (el asunto del correo y el aviso).
const ui = {
  subject: page.subject,
  name: page.name,
  email: 'Email',
  opening: page.opening,
};
---

<BaseLayout
  title={t.content.contactMetaTitle}
  description={t.content.contactMetaDescription}
>
  <script type="application/json" id="contact-ui" set:html={JSON.stringify(ui)} />

  <section class="max-w-5xl mx-auto px-6 py-16 lg:py-24">
    <div class="text-center mb-16">
      <p class="section-label mb-4">{page.label}</p>
      <h1 class="font-titulos text-4xl lg:text-5xl text-blancoRoto mb-4">{page.title}</h1>
      <div class="gold-line mx-auto"></div>
    </div>

    <div class="grid lg:grid-cols-2 gap-12">
      <!-- Formulario -->
      <form id="contact-form" class="space-y-4">
        <input name="name" placeholder={page.name} required class="input-dark" />
        <input name="email" type="email" placeholder="Email" required class="input-dark" />
        <input name="subject" placeholder={page.subject} required class="input-dark" />
        <textarea name="message" placeholder={page.message} rows="5" required class="input-dark"></textarea>

        <button type="submit" id="send-btn" class="btn-gold w-full">{page.send}</button>
        <p id="form-msg" class="hidden text-xs text-center"></p>
      </form>

      <!-- Info -->
      <div class="space-y-8">
        <div>
          <h2 class="font-acentos text-[11px] uppercase tracking-[0.25em] text-oro-brillo mb-3">
            {page.emailLabel}
          </h2>
          <a
            href="mailto:hola@dinerosobreproblemas.com"
            class="text-white hover:text-oro-brillo transition-colors"
          >
            hola@dinerosobreproblemas.com
          </a>
        </div>

        <div>
          <h2 class="font-acentos text-[11px] uppercase tracking-[0.25em] text-oro-brillo mb-3">
            {page.social}
          </h2>
          <ul class="space-y-2">
            <li>
              <a href="https://www.instagram.com/somos_dsp" target="_blank" rel="noopener noreferrer" class="text-white/80 hover:text-oro-brillo transition-colors">
                Instagram — @somos_dsp
              </a>
            </li>
            <li>
              <a href="https://www.tiktok.com/@somosdsp" target="_blank" rel="noopener noreferrer" class="text-white/80 hover:text-oro-brillo transition-colors">
                TikTok — @somosdsp
              </a>
            </li>
          </ul>
        </div>

        <div>
          <h2 class="font-acentos text-[11px] uppercase tracking-[0.25em] text-oro-brillo mb-3">
            {page.customTitle}
          </h2>
          <p class="text-sm text-white/80 leading-relaxed">{page.customText}</p>
        </div>

        <div>
          <h2 class="font-acentos text-[11px] uppercase tracking-[0.25em] text-oro-brillo mb-3">
            {page.responseTitle}
          </h2>
          <p class="text-sm text-white/80">{page.responseText}</p>
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const btn = document.getElementById('send-btn') as HTMLButtonElement;
    const msg = document.getElementById('form-msg')!;

    /** Textos resueltos en servidor. */
    const ui = JSON.parse(document.getElementById('contact-ui')?.textContent || '{}') as Record<
      string,
      string
    >;

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const subject = encodeURIComponent(`${ui.subject}: ${data.get('subject')}`);
      const body = encodeURIComponent(
        `${ui.name}: ${data.get('name')}\n${ui.email}: ${data.get('email')}\n\n${data.get('message')}`
      );

      window.location.href = `mailto:hola@dinerosobreproblemas.com?subject=${subject}&body=${body}`;

      msg.textContent = ui.opening;
      msg.className = 'text-xs text-center text-oro-brillo';
      btn.disabled = true;
      setTimeout(() => {
        btn.disabled = false;
      }, 3000);
    });
  </script>
</BaseLayout>
