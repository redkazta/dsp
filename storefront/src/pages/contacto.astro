---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contacto | Dinero Sobre Problemas"
  description="Escríbenos. Respondemos en menos de 24 horas."
>
  <section class="max-w-5xl mx-auto px-6 py-16 lg:py-24">
    <div class="text-center mb-16">
      <p class="section-label mb-4">Contacto</p>
      <h1 class="font-titulos text-4xl lg:text-5xl text-blancoRoto mb-4">Hablemos</h1>
      <div class="gold-line mx-auto"></div>
    </div>

    <div class="grid lg:grid-cols-2 gap-12">
      <!-- Formulario -->
      <form id="contact-form" class="space-y-4">
        <input name="name" placeholder="Nombre" required class="input-dark" />
        <input name="email" type="email" placeholder="Email" required class="input-dark" />
        <input name="subject" placeholder="Asunto" required class="input-dark" />
        <textarea name="message" placeholder="Mensaje" rows="5" required class="input-dark"></textarea>

        <button type="submit" id="send-btn" class="btn-gold w-full">Enviar mensaje</button>
        <p id="form-msg" class="hidden text-xs text-center"></p>
      </form>

      <!-- Info -->
      <div class="space-y-8">
        <div>
          <h2 class="font-acentos text-[11px] uppercase tracking-[0.25em] text-oro-elegante mb-3">
            Email
          </h2>
          <a
            href="mailto:hola@dinerosobreproblemas.com"
            class="text-plata-claro hover:text-oro-elegante transition-colors"
          >
            hola@dinerosobreproblemas.com
          </a>
        </div>

        <div>
          <h2 class="font-acentos text-[11px] uppercase tracking-[0.25em] text-oro-elegante mb-3">
            Redes
          </h2>
          <ul class="space-y-2">
            <li>
              <a href="https://www.instagram.com/somos_dsp" target="_blank" rel="noopener noreferrer" class="text-plata-metalico/70 hover:text-oro-elegante transition-colors">
                Instagram — @somos_dsp
              </a>
            </li>
            <li>
              <a href="https://www.tiktok.com/@somosdsp" target="_blank" rel="noopener noreferrer" class="text-plata-metalico/70 hover:text-oro-elegante transition-colors">
                TikTok — @somosdsp
              </a>
            </li>
          </ul>
        </div>

        <div>
          <h2 class="font-acentos text-[11px] uppercase tracking-[0.25em] text-oro-elegante mb-3">
            Pedidos especiales
          </h2>
          <p class="text-sm text-plata-metalico/60 leading-relaxed">
            Para jeans personalizados y piezas a medida, escríbenos por DM
            en Instagram con tu talla y diseño deseado.
          </p>
        </div>

        <div>
          <h2 class="font-acentos text-[11px] uppercase tracking-[0.25em] text-oro-elegante mb-3">
            Tiempo de respuesta
          </h2>
          <p class="text-sm text-plata-metalico/60">Menos de 24 horas hábiles.</p>
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const btn = document.getElementById('send-btn') as HTMLButtonElement;
    const msg = document.getElementById('form-msg')!;

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const subject = encodeURIComponent(`Contacto: ${data.get('subject')}`);
      const body = encodeURIComponent(
        `Nombre: ${data.get('name')}\nEmail: ${data.get('email')}\n\n${data.get('message')}`
      );

      window.location.href = `mailto:hola@dinerosobreproblemas.com?subject=${subject}&body=${body}`;

      msg.textContent = 'Abriendo tu cliente de correo...';
      msg.className = 'text-xs text-center text-oro-elegante';
      btn.disabled = true;
      setTimeout(() => {
        btn.disabled = false;
      }, 3000);
    });
  </script>
</BaseLayout>
