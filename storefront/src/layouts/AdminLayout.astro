---
/**
 * AdminLayout.astro - Layout del panel de administración
 * Sidebar oscuro con navegación y check de permisos.
 */
import '../styles/global.css';

export interface Props {
  title?: string;
}

const { title = 'Panel' } = Astro.props;

const nav = [
  { href: '/admin', label: 'Dashboard', icon: 'M3 12h7V3H3v9Zm11 9h7v-9h-7v9ZM3 21h7v-6H3v6Zm11-12h7V3h-7v6Z' },
  { href: '/admin/productos', label: 'Productos', icon: 'M4 7h16v13H4zM4 7l2-4h12l2 4M9 11h6' },
  { href: '/admin/pedidos', label: 'Pedidos', icon: 'M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4ZM3 6h18M16 10a4 4 0 0 1-8 0' },
];
---

<!doctype html>
<html lang="es-MX" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Admin DSP</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen bg-negro-profundo text-blancoRoto font-cuerpo">
    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside class="hidden lg:flex flex-col w-60 shrink-0 border-r-2 border-white/25 bg-negro-carbono">
        <a href="/admin" class="px-6 py-6 border-b-2 border-white/25 block">
          <span class="font-titulos text-base tracking-[0.15em] text-blancoRoto block leading-none">DINERO</span>
          <span class="font-acentos text-[8px] uppercase tracking-[0.4em] text-oro-brillo">Admin</span>
        </a>

        <nav class="flex-1 p-4 space-y-1">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="flex items-center gap-3 px-4 py-3 min-h-[48px] text-base text-white/80 hover:text-oro-brillo hover:bg-negro-profundo transition-colors"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d={item.icon} />
                </svg>
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="p-4 border-t-2 border-white/25 space-y-2">
          <a href="/" class="block px-4 py-2 text-sm text-white/80 hover:text-oro-brillo transition-colors">
            ← Ver tienda
          </a>
          <button
            id="admin-logout"
            class="w-full text-left px-4 py-2 text-sm text-white/80 hover:text-red-400 transition-colors"
          >
            Cerrar sesión
          </button>
        </div>
      </aside>

      <!-- Mobile nav -->
      <div class="lg:hidden fixed bottom-0 left-0 right-0 z-50 bg-negro-carbono border-t-2 border-white/25 flex">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class="flex-1 flex flex-col items-center justify-center gap-1 py-3 min-h-[56px] text-xs uppercase tracking-wider text-blancoRoto hover:text-oro-brillo transition-colors"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d={item.icon} />
              </svg>
              {item.label}
            </a>
          ))
        }
      </div>

      <!-- Content -->
      <main class="flex-1 min-w-0 px-4 sm:px-6 lg:px-10 py-8 sm:py-10 pb-28 lg:pb-10 max-w-[1400px]">
        <slot />
      </main>
    </div>

    <script>
      // Red de seguridad de navegador: si después de 8s el script de la página
      // no arrancó (bundle viejo en caché), se ofrece recargar.
      window.addEventListener('load', () => {
        const view = document.getElementById('admin-loading');
        if (!view) return;

        setTimeout(() => {
          if (view.isConnected && !view.classList.contains('hidden')) {
            view.textContent = 'No pudimos cargar el panel. Recarga la página.';
          }
        }, 8000);
      });
    </script>

    <script>
      import { signOut } from '../lib/auth';

      document.getElementById('admin-logout')?.addEventListener('click', async () => {
        await signOut();
        window.location.href = '/entrar';
      });
    </script>
  </body>
</html>
