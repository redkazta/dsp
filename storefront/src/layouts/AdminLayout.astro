---
/**
 * AdminLayout.astro — marco del panel.
 *
 * - Logo de la marca arriba a la izquierda (el mismo de la tienda).
 * - Navegación principal con acceso a Configuración.
 * - Abajo: ver tienda como cliente, mi cuenta y cerrar sesión.
 * - En móvil: barra superior con logo y salida + pestañas inferiores.
 */
import '../styles/global.css';

export interface Props {
  title?: string;
}

const { title = 'Panel' } = Astro.props;

const nav = [
  { href: '/admin', label: 'Dashboard', icon: 'M3 12h7V3H3v9Zm11 9h7v-9h-7v9ZM3 21h7v-6H3v6Zm11-12h7V3h-7v6Z' },
  { href: '/admin/productos', label: 'Productos', icon: 'M4 7h16v13H4zM4 7l2-4h12l2 4M9 11h6' },
  { href: '/admin/pedidos', label: 'Pedidos', icon: 'M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4ZM3 6h18M16 10a4 4 0 0 1-8 0' },
  { href: '/admin/mensajes', label: 'Mensajes', icon: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z' },
  { href: '/admin/configuracion', label: 'Configuración', icon: 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z' },
];
---

<!doctype html>
<html lang="es-MX" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Admin DSP</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen bg-negro-profundo text-blancoRoto font-cuerpo">
    <div class="flex min-h-screen">
      <!-- Sidebar (desktop) -->
      <aside class="hidden lg:flex flex-col w-60 shrink-0 border-r-2 border-white/25 bg-negro-carbono">
        <a href="/admin" class="flex items-center gap-3 px-5 py-5 border-b-2 border-white/25">
          <img
            src="/img/logo/DSP.jpg"
            alt="¡D$P!"
            width="40"
            height="40"
            class="w-10 h-10 shrink-0 object-contain border border-white/40 bg-black"
          />
          <span class="min-w-0">
            <span class="font-titulos text-sm tracking-[0.15em] text-blancoRoto block leading-none">DINERO</span>
            <span class="font-acentos text-[8px] uppercase tracking-[0.4em] text-oro-brillo">Admin</span>
          </span>
        </a>

        <nav class="flex-1 p-3 space-y-1 overflow-y-auto">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="flex items-center gap-3 px-3.5 py-3 min-h-[48px] text-base text-white/80 hover:text-oro-brillo hover:bg-negro-profundo transition-colors"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0">
                  <path d={item.icon} />
                </svg>
                <span class="truncate">{item.label}</span>
              </a>
            ))
          }
        </nav>

        <!-- Acciones del panel -->
        <div class="p-3 border-t-2 border-white/25 space-y-0.5">
          <a
            href="/tienda"
            target="_blank"
            rel="noopener"
            class="flex items-center gap-3 px-3.5 py-2.5 min-h-[42px] text-sm text-white/70 hover:text-oro-brillo transition-colors"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 9h18M3 9l2-5h14l2 5M5 9v11h14V9" />
            </svg>
            Ver la tienda
          </a>
          <a
            href="/cuenta"
            class="flex items-center gap-3 px-3.5 py-2.5 min-h-[42px] text-sm text-white/70 hover:text-oro-brillo transition-colors"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" />
            </svg>
            Mi cuenta
          </a>
          <button
            type="button"
            data-admin-logout
            class="w-full flex items-center gap-3 px-3.5 py-2.5 min-h-[42px] text-sm text-white/70 hover:text-red-400 transition-colors text-left"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" />
            </svg>
            Cerrar sesión
          </button>
        </div>
      </aside>

      <div class="flex-1 min-w-0 flex flex-col">
        <!-- Barra superior (móvil) -->
        <div class="lg:hidden sticky top-0 z-40 flex items-center justify-between gap-3 px-4 py-2.5 bg-negro-profundo/95 backdrop-blur-xl border-b-2 border-white/25">
          <a href="/admin" class="flex items-center gap-2.5 min-w-0">
            <img
              src="/img/logo/DSP.jpg"
              alt="¡D$P!"
              width="32"
              height="32"
              class="w-8 h-8 shrink-0 object-contain border border-white/40 bg-black"
            />
            <span class="font-acentos text-[9px] uppercase tracking-[0.3em] text-oro-brillo truncate">
              Admin
            </span>
          </a>
          <div class="flex items-center gap-4 shrink-0">
            <a href="/tienda" target="_blank" rel="noopener" class="text-[10px] uppercase tracking-[0.14em] text-white/70">
              Tienda
            </a>
            <button type="button" data-admin-logout class="text-[10px] uppercase tracking-[0.14em] text-white/70">
              Salir
            </button>
          </div>
        </div>

        <!-- Contenido -->
        <main class="flex-1 min-w-0 px-4 sm:px-6 lg:px-10 py-6 sm:py-8 pb-28 lg:pb-10 max-w-[1400px] w-full">
          <slot />
        </main>
      </div>
    </div>

    <!-- Pestañas (móvil) -->
    <nav class="lg:hidden fixed bottom-0 left-0 right-0 z-50 bg-negro-carbono border-t-2 border-white/25 flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="flex-1 flex flex-col items-center justify-center gap-1 py-2 min-h-[58px] text-[9px] uppercase tracking-[0.08em] text-blancoRoto hover:text-oro-brillo transition-colors"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d={item.icon} />
            </svg>
            <span class="truncate max-w-full px-0.5">{item.label}</span>
          </a>
        ))
      }
    </nav>

    <script>
      // Red de seguridad de navegador: si después de 8s el script de la página
      // no arrancó (bundle viejo en caché), se ofrece recargar.
      window.addEventListener('load', () => {
        const view = document.getElementById('admin-loading');
        if (!view) return;

        setTimeout(() => {
          if (view.isConnected && !view.classList.contains('hidden')) {
            view.textContent = 'No pudimos cargar el panel. Recarga la página.';
          }
        }, 8000);
      });
    </script>

    <script>
      import { signOut } from '../lib/auth';

      document.querySelectorAll('[data-admin-logout]').forEach((btn) =>
        btn.addEventListener('click', async () => {
          await signOut();
          window.location.href = '/entrar';
        })
      );
    </script>
  </body>
</html>
