---
/**
 * BaseLayout.astro - Layout principal
 * Dinero Sobre Problemas · Estética editorial, negro/oro/plata
 */
import '../styles/global.css';
import '../styles/animated-logo.css';
import StoreDrawer from '../components/store/StoreDrawer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { getCopy, LANG_TOGGLE_LABEL, LOCALE, type Lang } from '../lib/i18n';
import { localize, translateUrl } from '../lib/routes';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Home: una sola pantalla, sin footer ni badges para no generar scroll. */
  homeScreen?: boolean;
}

// Idioma resuelto en el middleware (cookie dsp_lang o Accept-Language).
const lang = (Astro.locals.lang ?? 'es') as Lang;
const t = getCopy(lang);

const {
  title = t.meta.home.title,
  description = t.meta.home.description,
  image = '/img/camisas/camisa-dsp-2-01-frente.jpg',
  homeScreen = false,
} = Astro.props;

// La URL que ve el visitante manda para el canonical: en `/contact` no debe
// apuntar a `/contacto` aunque el render interno venga de un rewrite.
const publicPathname = (Astro as any).originPathname ?? Astro.url.pathname;
const canonical = new URL(publicPathname, Astro.site ?? Astro.url.origin).toString();

// hreflang: la misma página en los dos idiomas. La URL del idioma actual manda
// (no se duplica el canonical), y `x-default` apunta al español.
const esPath = lang === 'es' ? publicPathname : translateUrl('es', publicPathname);
const enPath = lang === 'en' ? publicPathname : translateUrl('en', publicPathname);
const esUrl = new URL(esPath, Astro.site ?? Astro.url.origin).toString();
const enUrl = new URL(enPath, Astro.site ?? Astro.url.origin).toString();

// Para el enlace del idioma: volver a la MISMA página en el otro idioma
// (/tienda → /shop, /producto/x → /product/x), no al inicio.
const langNext = lang === 'es' ? 'en' : 'es';
const langReturnTo = translateUrl(langNext, Astro.url.pathname + Astro.url.search);
const langToggleHref = `/api/lang?lang=${langNext}&next=${encodeURIComponent(langReturnTo)}`;
const langToggleLabel = LANG_TOGGLE_LABEL[lang];

const navLinks = [
  { href: localize(lang, 'shop'), label: t.nav.tienda },
  { href: localize(lang, 'about'), label: t.nav.nosotros },
];

const isAuth = Astro.locals.isAuthenticated;
const firstName = Astro.locals.firstName;
const isStaff = Astro.locals.isStaff;
const accountHref = isAuth ? '/cuenta' : localize(lang, 'login');

// Favoritos para el primer HTML (sin "Cargando…" y sin parpadeo).
// Solo lectura con la sesión del visitante: RLS decide qué puede ver.
type DrawerWish = {
  productId: string;
  slug: string | null;
  name: string;
  price: number;
  image: string | null;
};

let drawerWishlist: DrawerWish[] = [];

if (isAuth && Astro.locals.user) {
  try {
    const { createSupabaseServerClient } = await import('../lib/supabase-server');
    const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
    const { data } = await supabase
      .from('wishlist_items')
      .select('product_id, product_slug, product_name, price, image_url')
      .eq('user_id', Astro.locals.user.id)
      .order('created_at', { ascending: false })
      .limit(30);

    drawerWishlist = (data ?? [])
      .filter(
        (row: any, index: number, all: any[]) =>
          all.findIndex((other) => other.product_id === row.product_id) === index
      )
      .map((row: any) => ({
        productId: row.product_id,
        slug: row.product_slug,
        name: row.product_name ?? '',
        price: Number(row.price ?? 0),
        image: row.image_url,
      }));
  } catch {
    drawerWishlist = [];
  }
}

const announcements = [...t.announcements];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ClothingStore',
  name: t.brand,
  url: Astro.site,
  logo: new URL('/img/logo/DSP.jpg', Astro.site ?? Astro.url.origin).toString(),
  image: new URL('/img/camisas/camisa-dsp-2-01-frente.jpg', Astro.site ?? Astro.url.origin).toString(),
  currenciesAccepted: 'USD',
  paymentAccepted: t.trust.secureText,
  email: 'support@dinerosobreproblemas.com',
  sameAs: ['https://www.instagram.com/dinerosobreproblemas/'],
};
---

<!doctype html>
<html lang={lang} class="dark" data-auth={isAuth ? '1' : '0'} data-lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#000000" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="9vg0e3aFgw6r_ZeKvXzVRruULlWTkwhMjmQQHIguAM4" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es-MX" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.brand} />
    <meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site ?? Astro.url.origin).toString()} />
    <meta property="og:image:alt" content={t.brand} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_MX'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site ?? Astro.url.origin).toString()} />

    <!-- Fuentes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,700;1,400&family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline define:vars={{ locale: LOCALE[lang], lang }}>
      // Fechas y números en el idioma activo desde el primer render.
      window.__DSP_LOCALE__ = locale;
      window.__DSP_LANG__ = lang;
    </script>
  </head>

  <body class="min-h-screen flex flex-col bg-negro-profundo" data-home={homeScreen ? '1' : '0'}>
    <!-- Barra de anuncios rotativa -->
    <div class="bg-oro-brillo text-negro-profundo overflow-hidden" id="announcement-bar">
      <div class="relative h-9 flex items-center justify-center">
        {
          announcements.map((text, i) => (
            <p
              class="announcement-slide absolute inset-0 flex items-center justify-center px-4 font-acentos text-[10px] sm:text-[11px] uppercase tracking-[0.14em] sm:tracking-[0.28em] text-center font-semibold transition-opacity duration-700"
              data-index={i}
            >
              {text}
            </p>
          ))
        }
      </div>
    </div>

    <!-- Header -->
    <header class="sticky top-0 z-50 bg-negro-profundo/95 backdrop-blur-xl border-b-2 border-white/25">
      <div class="page-container">
        <!-- Grid de 3 columnas iguales: logo a la izquierda, menú al centro exacto,
             acciones a la derecha. Así el menú queda centrado sin importar si hay
             sesión (la píldora de perfil es ancha). -->
        <div class="grid grid-cols-[auto_1fr_auto] lg:grid-cols-3 items-center h-20 sm:h-24">
          <div class="flex items-center gap-1">
            <!-- Mobile menu -->
            <button
              id="menu-toggle"
              class="lg:hidden -ml-3 p-2.5 min-w-[44px] min-h-[44px] text-blancoRoto hover:text-oro-brillo transition-colors"
              aria-label={t.nav.menu}
              aria-expanded="false"
              aria-controls="mobile-menu"
            >
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 7h16M4 12h16M4 17h16" />
              </svg>
            </button>

            <!-- Logo giratorio (único). En móvil solo gira sobre su eje; en desktop
                 gira y se mece de lado a lado. -->
            <a
              href="/"
              class="header-spinner"
              aria-label={`${t.brand} — ${t.header.home}`}
            >
              <img
                src="/img/logo/DSP.jpg"
                alt="¡D$P!"
                class="logo-animated header-spinner-img"
              />
            </a>
          </div>

          <!-- Nav desktop (Tienda / Nosotros), centrado -->
          <nav class="hidden lg:flex items-center justify-center gap-8 xl:gap-10">
            {
              navLinks.map((link) => (
                <a
                  href={link.href}
                  class="relative font-acentos text-xs uppercase tracking-[0.25em] text-blancoRoto hover:text-oro-brillo transition-colors duration-300 group"
                >
                  {link.label}
                  <span class="absolute -bottom-1.5 left-0 h-0.5 w-0 bg-oro-brillo transition-[width] duration-300 group-hover:w-full" />
                </a>
              ))
            }
          </nav>

          <!-- Acciones (derecha) -->
          <div class="flex items-center justify-end gap-1.5 sm:gap-2.5">
            <button
              type="button"
              id="search-open"
              aria-label={t.header.search}
              aria-haspopup="dialog"
              aria-controls="search-dialog"
              aria-expanded="false"
              class="header-icon"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
              </svg>
            </button>

            <StoreDrawer wishlist={drawerWishlist} />

            {
              isAuth ? (
                <div class="relative" id="profile-dropdown">
                  <button
                    type="button"
                    id="profile-trigger"
                    class="profile-pill"
                    aria-label={`${t.header.accountMenu}: ${firstName ?? ''}`}
                    aria-expanded="false"
                    aria-haspopup="menu"
                  >
                    <span class="profile-avatar" aria-hidden="true">
                      {firstName?.charAt(0).toUpperCase() ?? 'D'}
                    </span>
                    <span class="profile-text">
                      <span class="profile-hello">{t.header.welcome}, {firstName ?? ''}</span>
                      <span class="profile-action">{t.header.viewAccount}</span>
                      <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="profile-chevron"
                        aria-hidden="true"
                      >
                        <path d="m6 9 6 6 6-6" />
                      </svg>
                    </span>
                  </button>

                  <div id="profile-menu" class="profile-menu hidden" role="menu">
                    <a href="/cuenta" class="profile-menu-item" role="menuitem">
                      <svg class="profile-menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" />
                      </svg>
                      {t.header.myAccount}
                    </a>
                    <a href="/cuenta#pedidos" class="profile-menu-item" role="menuitem">
                      <svg class="profile-menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" /><path d="M3 6h18M16 10a4 4 0 0 1-8 0" />
                      </svg>
                      {t.header.myOrders}
                    </a>
                    <a href={localize(lang, 'favorites')} class="profile-menu-item" role="menuitem">
                      <svg class="profile-menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1L12 21l7.7-7.6 1.1-1a5.5 5.5 0 0 0 0-7.8Z" />
                      </svg>
                      {t.nav.favoritos}
                    </a>
                    <a href={localize(lang, 'cart')} class="profile-menu-item" role="menuitem">
                      <svg class="profile-menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" /><path d="M3 6h18M16 10a4 4 0 0 1-8 0" />
                      </svg>
                      {t.nav.carrito}
                    </a>
                    <a href="/checkout" class="profile-menu-item" role="menuitem">
                      <svg class="profile-menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <rect x="2" y="5" width="20" height="14" rx="2" /><path d="M2 10h20" />
                      </svg>
                      {t.header.checkout}
                    </a>
                    {isStaff && (
                      <a href="/admin" class="profile-menu-item" role="menuitem">
                        <svg class="profile-menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <path d="M12 2 4 6v6c0 5 3.4 9.3 8 10 4.6-.7 8-5 8-10V6l-8-4Z" />
                        </svg>
                        {t.header.admin}
                      </a>
                    )}
                    <span class="profile-menu-divider" aria-hidden="true"></span>
                    <button type="button" id="btn-signout" class="profile-menu-item" role="menuitem">
                      <svg class="profile-menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><path d="m16 17 5-5-5-5M21 12H9" />
                      </svg>
                      {t.header.logout}
                    </button>
                  </div>
                </div>
              ) : (
                <a href={accountHref} aria-label={t.header.login} class="header-icon sm:hidden">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" />
                  </svg>
                </a>
              )
            }

            <!-- Toggle de idioma: ÚLTIMO elemento del header, al extremo derecho.
                 Es un enlace (GET) porque Astro bloquea POST cross-site tras el
                 rewrite de Vercel. -->
            <a
              href={langToggleHref}
              class="lang-toggle"
              aria-label={t.header.language}
              title={t.header.language}
              hreflang={lang === 'es' ? 'en' : 'es'}
            >
              {langToggleLabel}
            </a>
          </div>
        </div>
      </div>

      <!-- Nav mobile -->
      <nav id="mobile-menu" class="hidden lg:hidden border-t-2 border-white/25 bg-negro-profundo">
        <div class="page-container py-2 flex flex-col">
          <a
            href={accountHref}
            class="py-4 min-h-[56px] flex items-center gap-3 font-acentos text-sm uppercase tracking-[0.22em] text-oro-brillo border-b border-white/15"
          >
            <span class="profile-avatar sm:hidden" aria-hidden="true">
              {isAuth ? firstName?.charAt(0).toUpperCase() : 'D'}
            </span>
            {isAuth ? `${t.header.welcome}, ${firstName ?? ''}` : t.header.login}
          </a>
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="py-4 min-h-[52px] flex items-center font-acentos text-sm uppercase tracking-[0.22em] text-blancoRoto hover:text-oro-brillo transition-colors border-b border-white/15"
              >
                {link.label}
              </a>
            ))
          }
          <button
            type="button"
            data-open-drawer="wishlist"
            class="py-4 min-h-[52px] flex items-center justify-between gap-3 font-acentos text-sm uppercase tracking-[0.22em] text-blancoRoto hover:text-oro-brillo transition-colors border-b border-white/15"
          >
            <span>{t.nav.favoritos}</span>
            <span id="mobile-wish-count" class="header-badge !static !border-0 hidden"></span>
          </button>
          <button
            type="button"
            data-open-drawer="cart"
            class="py-4 min-h-[52px] flex items-center justify-between gap-3 font-acentos text-sm uppercase tracking-[0.22em] text-blancoRoto hover:text-oro-brillo transition-colors border-b border-white/15"
          >
            <span>{t.nav.carrito}</span>
            <span id="mobile-cart-count" class="header-badge !static !border-0 hidden"></span>
          </button>
          <button
            type="button"
            id="mobile-search-open"
            class="py-4 min-h-[52px] flex items-center font-acentos text-sm uppercase tracking-[0.22em] text-blancoRoto hover:text-oro-brillo transition-colors"
          >
            {t.nav.buscar}
          </button>
        </div>
      </nav>
    </header>

    <!-- Main -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Buscador global (⌘K / Ctrl+K) -->
    <div id="search-dialog" class="search-dialog hidden" role="dialog" aria-modal="true" aria-label={t.header.search}
      data-empty={t.common.noResults}
      data-product-base={lang === 'en' ? '/product' : '/producto'}>
      <button type="button" id="search-backdrop" class="search-backdrop" aria-label={t.header.close}></button>
      <div class="search-panel">
        <div class="search-field">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
          </svg>
          <input
            id="search-input"
            type="search"
            placeholder={t.search.placeholder}
            autocomplete="off"
            aria-controls="search-results"
            aria-label={t.header.search}
          />
          <kbd class="search-kbd">esc</kbd>
        </div>
        <div id="search-results" class="search-results" role="listbox" aria-live="polite"></div>
        <p id="search-hint" class="search-hint">{t.search.hint}</p>
      </div>
    </div>

    <!-- Footer -->
    <footer class="site-footer border-t-2 border-white/25 bg-negro-profundo">
      <div class="page-container py-12 sm:py-16 lg:py-20">
        <div class="grid gap-10 sm:gap-12 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
          <!-- Marca -->
          <div class="sm:col-span-2">
            <h3 class="font-titulos text-xl sm:text-2xl text-blancoRoto mb-3">{t.brand}</h3>
            <div class="gold-line mb-5" style="margin-left: 0"></div>
            <p class="text-base text-muted leading-relaxed max-w-md mb-6">
              {t.brandTagline}<br />{t.brandTagline2}
            </p>
            <!-- Redes -->
            <div class="flex gap-3">
              {
                [
                  { name: 'Instagram', href: 'https://www.instagram.com/dinerosobreproblemas/', d: 'M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2Zm0 3.4a6.4 6.4 0 1 0 0 12.8 6.4 6.4 0 0 0 0-12.8Zm0 10.6a4.2 4.2 0 1 1 0-8.4 4.2 4.2 0 0 1 0 8.4Zm6.6-10.9a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z' },
                ].map((s) => (
                  <a
                    href={s.href}
                    aria-label={s.name}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-11 h-11 border-2 border-white/30 flex items-center justify-center text-blancoRoto hover:border-oro-brillo hover:text-oro-brillo transition-colors duration-300"
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d={s.d} />
                    </svg>
                  </a>
                ))
              }
            </div>
          </div>

          <!-- Tienda -->
          <div>
            <h4 class="section-label mb-5">{t.footer.tienda}</h4>
            <ul class="space-y-3">
              {
                [
                  { href: localize(lang, 'shop'), label: t.footer.catalogue },
                  { href: localize(lang, 'about'), label: t.footer.about },
                  { href: localize(lang, 'contact'), label: t.footer.contact },
                  { href: localize(lang, 'sizes'), label: t.footer.sizes },
                ].map((l) => (
                  <li>
                    <a href={l.href} class="text-base text-muted hover:text-oro-brillo transition-colors duration-300">
                      {l.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Ayuda -->
          <div>
            <h4 class="section-label mb-5">{t.footer.help}</h4>
            <ul class="space-y-3">
              {
                [
                  { href: localize(lang, 'shipping'), label: t.footer.shipping },
                  { href: localize(lang, 'returns'), label: t.footer.returns },
                  { href: localize(lang, 'privacy'), label: t.footer.privacy },
                  { href: localize(lang, 'terms'), label: t.footer.terms },
                ].map((l) => (
                  <li>
                    <a href={l.href} class="text-base text-muted hover:text-oro-brillo transition-colors duration-300">
                      {l.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>

      <!-- Barra inferior -->
      <div class="border-t-2 border-white/25">
        <div class="page-container py-5 sm:py-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-center">
          <p class="text-[11px] sm:text-xs text-white/80 font-acentos tracking-wider">
            © {new Date().getFullYear()} {t.brand.toUpperCase()} · {t.footer.rights}
          </p>
          <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-xs text-white/80 font-acentos tracking-wider">
            <a href={localize(lang, 'privacy')} class="py-1 hover:text-oro-brillo transition-colors">{t.footer.privacy}</a>
            <a href={localize(lang, 'terms')} class="py-1 hover:text-oro-brillo transition-colors">{t.footer.terms}</a>
            <a href={localize(lang, 'shipping')} class="py-1 hover:text-oro-brillo transition-colors">{t.footer.shipping}</a>
            <a href={localize(lang, 'contact')} class="py-1 hover:text-oro-brillo transition-colors">{t.footer.contact}</a>
          </div>
          <!-- Métodos de pago -->
          <div class="flex items-center gap-2">
            {
              ['VISA', 'MC', 'AMEX', 'OXXO'].map((m) => (
                <span class="px-2.5 py-1 border-2 border-white/30 text-[10px] font-acentos tracking-wider text-white/80">
                  {m}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </footer>

    <script>
      import { escapeHtml, safeUrl } from '../lib/html';
      import { route } from '../lib/routes';

      // ---------- Menú móvil ----------
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');

      if (toggle && menu) {
        const setOpen = (open: boolean) => {
          menu.classList.toggle('hidden', !open);
          toggle.setAttribute('aria-expanded', String(open));
          document.body.style.overflow = open ? 'hidden' : '';
        };

        toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));

        menu.querySelectorAll('a').forEach((a) =>
          a.addEventListener('click', () => setOpen(false))
        );

        window
          .matchMedia('(min-width: 1024px)')
          .addEventListener('change', (e) => e.matches && setOpen(false));
      }

      // ---------- Anuncios rotativos ----------
      const slides = document.querySelectorAll<HTMLElement>('.announcement-slide');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (slides.length > 1 && !reduceMotion) {
        let current = 0;
        slides.forEach((s, i) => (s.style.opacity = i === 0 ? '1' : '0'));
        setInterval(() => {
          slides[current].style.opacity = '0';
          current = (current + 1) % slides.length;
          slides[current].style.opacity = '1';
        }, 3500);
      }

      // ---------- Perfil ----------
      const profileTrigger = document.getElementById('profile-trigger');
      const profileMenu = document.getElementById('profile-menu');

      if (profileTrigger && profileMenu) {
        const toggleProfileMenu = () => {
          const isOpen = profileTrigger.getAttribute('aria-expanded') === 'true';
          profileTrigger.setAttribute('aria-expanded', String(!isOpen));
          profileMenu.classList.toggle('hidden', isOpen);
        };

        profileTrigger.addEventListener('click', (e) => {
          e.preventDefault();
          toggleProfileMenu();
        });

        document.addEventListener('click', (e) => {
          if (!profileTrigger.contains(e.target as Node) && !profileMenu.contains(e.target as Node)) {
            profileTrigger.setAttribute('aria-expanded', 'false');
            profileMenu.classList.add('hidden');
          }
        });
      }

      const signoutBtn = document.getElementById('btn-signout');
      if (signoutBtn) {
        signoutBtn.addEventListener('click', async () => {
          try {
            const { supabase } = await import('../lib/supabase');
            await supabase.auth.signOut();

            // La wishlist vuelve a modo visitante SIN copiar la lista de la
            // cuenta al navegador: si no tenía favoritos propios, ve vacío.
            const { endWishlistSession } = await import('../lib/wishlist');
            endWishlistSession();

            window.location.href = route('login');
          } catch (error) {
            console.error('Error signing out:', error);
          }
        });
      }

      // ---------- Carrito y favoritos desde el menú móvil ----------
      // Abren el mismo panel lateral que los iconos del header.
      // Delegación en `document`: funciona aunque el menú se repinte.
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-open-drawer]');
        if (!btn) return;
        e.preventDefault();
        const tab = (btn.dataset.openDrawer as 'cart' | 'wishlist') ?? 'cart';
        window.dispatchEvent(new CustomEvent('store:open', { detail: { tab } }));
      });

      // Contadores del menú móvil
      const mobileCartCount = document.getElementById('mobile-cart-count');
      const mobileWishCount = document.getElementById('mobile-wish-count');

      const paintMobileCounts = async () => {
        const { cartCount } = await import('../lib/cart');
        const n = cartCount();
        if (mobileCartCount) {
          mobileCartCount.textContent = String(n);
          mobileCartCount.classList.toggle('hidden', n === 0);
        }
      };

      window.addEventListener('cart:updated', paintMobileCounts);
      window.addEventListener('wishlist:updated', (e) => {
        const n = ((e as CustomEvent<any[]>).detail ?? []).length;
        if (mobileWishCount) {
          mobileWishCount.textContent = String(n);
          mobileWishCount.classList.toggle('hidden', n === 0);
        }
      });
      void paintMobileCounts();

      // Cambios de carrito hechos en otra pestaña: símbolo y contador al día.
      void import('../lib/cart').then(({ startCartSync }) => startCartSync());

      // ---------- Buscador global ----------
      const openSearch = document.getElementById('search-open');
      const mobileSearchOpen = document.getElementById('mobile-search-open');
      const searchDialog = document.getElementById('search-dialog');
      const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
      const searchResults = document.getElementById('search-results');
      const searchHint = document.getElementById('search-hint');
      const searchBackdrop = document.getElementById('search-backdrop');
      let searchTimer: number | undefined;

      // El script va compilado: los textos y la base de la URL vienen del
      // marcado (donde sí hay idioma), no de variables de frontmatter.
      const searchEmptyLabel = searchDialog?.dataset.empty ?? '';
      const productBase = searchDialog?.dataset.productBase ?? '/producto';

      function setSearchOpen(open: boolean) {
        if (!searchDialog) return;
        searchDialog.classList.toggle('hidden', !open);
        document.body.style.overflow = open ? 'hidden' : '';
        openSearch?.setAttribute('aria-expanded', String(open));

        if (open) requestAnimationFrame(() => searchInput?.focus());
        else openSearch?.focus();
      }

      function renderSearchResults(payload: { results?: any[] }) {
        if (!searchResults || !searchHint) return;
        const items = payload.results ?? [];

        if (items.length === 0) {
          searchResults.innerHTML = '';
          searchHint.textContent = searchEmptyLabel;
          return;
        }

        searchHint.textContent = '';
        searchResults.innerHTML = items
          .map((p) => {
            const img = safeUrl(p.image);
            return `
          <a href="${productBase}/${encodeURIComponent(p.slug ?? p.id)}" role="option" class="search-item">
            <span class="search-thumb">${img ? `<img src="${img}" alt="" loading="lazy">` : ''}</span>
            <span class="min-w-0 flex-1">
              <span class="search-item-name">${escapeHtml(p.name)}</span>
              <span class="search-item-cat">${escapeHtml(p.category ?? 'Pieza')}</span>
            </span>
            <span class="search-item-price">$${Number(p.price).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
          </a>`;
          })
          .join('');
      }

      async function runSearch(q: string) {
        if (!searchHint || !searchResults) return;
        if (q.trim().length < 2) {
          searchResults.innerHTML = '';
          searchHint.textContent = 'Escribe al menos 2 letras.';
          return;
        }

        searchHint.textContent = 'Buscando…';

        try {
          const res = await fetch(`/api/search?q=${encodeURIComponent(q)}`);
          renderSearchResults(await res.json());
        } catch {
          searchHint.textContent = 'No pudimos buscar. Intenta de nuevo.';
        }
      }

      openSearch?.addEventListener('click', () => setSearchOpen(true));
      mobileSearchOpen?.addEventListener('click', () => {
        toggle?.click();
        setSearchOpen(true);
      });
      searchBackdrop?.addEventListener('click', () => setSearchOpen(false));

      searchInput?.addEventListener('input', () => {
        window.clearTimeout(searchTimer);
        const q = searchInput.value;
        searchTimer = window.setTimeout(() => runSearch(q), 220);
      });

      searchInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const q = searchInput.value.trim();
          if (q) window.location.href = `/tienda?q=${encodeURIComponent(q)}`;
        }
      });

      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          setSearchOpen(searchDialog?.classList.contains('hidden') ?? false);
        }
        if (e.key === 'Escape' && searchDialog && !searchDialog.classList.contains('hidden')) {
          setSearchOpen(false);
        }
      });
    </script>

    <CookieConsent />
  </body>
</html>

