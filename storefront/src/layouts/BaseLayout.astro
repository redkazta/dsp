---
/**
 * BaseLayout.astro - Layout principal
 * Dinero Sobre Problemas · Estética editorial, negro/oro/plata
 */
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Dinero Sobre Problemas | Streetwear Reflective Premium',
  description = 'Camisas reflectivas, hoodies y piezas atemporales. Diseño callejero con energía de lujo.',
  image = '/og-image.jpg',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();

const navLinks = [
  { href: '/tienda', label: 'Tienda' },
  { href: '/nosotros', label: 'Nosotros' },
];

const announcements = [
  'Envío gratis en pedidos superiores a $1,500 MXN',
  'Drop Reflective disponible por tiempo limitado',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ClothingStore',
  name: 'Dinero Sobre Problemas',
  url: Astro.site,
  logo: new URL('/favicon.svg', Astro.site ?? Astro.url.origin).toString(),
  currenciesAccepted: 'MXN',
  paymentAccepted: 'Tarjeta de crédito, débito',
};
---

<!doctype html>
<html lang="es-MX" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0A0A0A" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dinero Sobre Problemas" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site ?? Astro.url.origin).toString()} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Fuentes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,700;1,400&family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="min-h-screen flex flex-col bg-negro-profundo">
    <!-- Barra de anuncios rotativa -->
    <div class="bg-oro-elegante text-negro-profundo overflow-hidden" id="announcement-bar">
      <div class="relative h-8 flex items-center justify-center">
        {
          announcements.map((text, i) => (
            <p
              class="announcement-slide absolute inset-0 flex items-center justify-center font-acentos text-[10px] uppercase tracking-[0.3em] transition-opacity duration-700"
              data-index={i}
            >
              {text}
            </p>
          ))
        }
      </div>
    </div>

    <!-- Header -->
    <header
      class="sticky top-0 z-50 bg-negro-profundo/85 backdrop-blur-xl border-b border-plata-metalico/10"
    >
      <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
        <div class="flex items-center justify-between h-20">
          <!-- Mobile menu -->
          <button
            id="menu-toggle"
            class="lg:hidden text-plata-claro hover:text-oro-elegante transition-colors"
            aria-label="Abrir menú"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </button>

          <!-- Logo -->
          <a href="/" class="group flex flex-col items-center lg:items-start shrink-0">
            <span class="font-titulos text-lg lg:text-xl tracking-[0.15em] text-blancoRoto leading-none group-hover:text-oro-elegante transition-colors">
              DINERO
            </span>
            <span class="font-acentos text-[8px] lg:text-[9px] uppercase tracking-[0.45em] text-oro-elegante">
              Sobre Problemas
            </span>
          </a>

          <!-- Nav desktop -->
          <nav class="hidden lg:flex items-center gap-10">
            {
              navLinks.map((link) => (
                <a
                  href={link.href}
                  class="relative font-acentos text-[11px] uppercase tracking-[0.25em] text-plata-metalico hover:text-oro-elegante transition-colors duration-300 group"
                >
                  {link.label}
                  <span class="absolute -bottom-1 left-0 h-px w-0 bg-oro-elegante transition-all duration-400 group-hover:w-full" />
                </a>
              ))
            }
          </nav>

          <!-- Acciones -->
          <div class="flex items-center gap-5">
            <a href="/tienda" aria-label="Buscar" class="text-plata-metalico hover:text-oro-elegante transition-colors">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
              </svg>
            </a>
            <a href="/cuenta" aria-label="Mi cuenta" class="hidden sm:block text-plata-metalico hover:text-oro-elegante transition-colors">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" />
              </svg>
            </a>
            <a href="/carrito" aria-label="Carrito" class="relative text-plata-metalico hover:text-oro-elegante transition-colors">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
                <path d="M3 6h18M16 10a4 4 0 0 1-8 0" />
              </svg>
              <span
                id="cart-count"
                class="absolute -top-2 -right-2 min-w-[16px] h-4 px-1 bg-oro-elegante text-negro-profundo text-[9px] font-bold rounded-full items-center justify-center hidden"
              >
                0
              </span>
            </a>
          </div>
        </div>
      </div>

      <!-- Nav mobile -->
      <nav id="mobile-menu" class="hidden lg:hidden border-t border-plata-metalico/10 bg-negro-profundo">
        <div class="px-6 py-3 flex flex-col gap-1">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="py-3 font-acentos text-xs uppercase tracking-[0.25em] text-plata-metalico hover:text-oro-elegante transition-colors border-b border-plata-metalico/5"
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </nav>
    </header>

    <!-- Main -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Trust badges -->
    <section class="border-t border-plata-metalico/10 bg-negro-carbono">
      <div class="max-w-[1400px] mx-auto px-6 lg:px-10 py-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          [
            { t: 'Envío express', d: '24-48h en zona metropolitana', icon: 'M5 12h14M12 5l7 7-7 7' },
            { t: 'Pago seguro', d: 'Tarjetas de crédito y débito', icon: 'M12 2 4 6v6c0 5 3.5 9 8 10 4.5-1 8-5 8-10V6Z' },
            { t: 'Devoluciones', d: '30 días sin preguntas', icon: 'M3 12a9 9 0 1 0 3-6.7M3 4v5h5' },
            { t: 'Atención 1:1', d: 'WhatsApp y DM abiertos', icon: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z' },
          ].map((item) => (
            <div class="flex items-start gap-4">
              <div class="shrink-0 w-10 h-10 border border-oro-elegante/30 flex items-center justify-center">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d={item.icon} />
                </svg>
              </div>
              <div>
                <h4 class="font-acentos text-[11px] uppercase tracking-[0.2em] text-plata-claro mb-1">{item.t}</h4>
                <p class="text-xs text-plata-metalico/60 leading-relaxed">{item.d}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-plata-metalico/10 bg-negro-profundo">
      <div class="max-w-[1400px] mx-auto px-6 lg:px-10 py-16 lg:py-20">
        <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
          <!-- Marca -->
          <div class="lg:col-span-2">
            <h3 class="font-titulos text-2xl text-blancoRoto mb-3">Dinero Sobre Problemas</h3>
            <div class="gold-line mb-5" style="margin-left: 0"></div>
            <p class="text-sm text-plata-metalico/70 leading-relaxed max-w-md mb-6">
              Streetwear artesanal prensado a mano, una pieza a la vez.
              Diseño callejero con energía de lujo.
            </p>
            <!-- Redes -->
            <div class="flex gap-3">
              {
                [
                  { name: 'Instagram', href: 'https://www.instagram.com/somos_dsp', d: 'M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2Zm0 3.4a6.4 6.4 0 1 0 0 12.8 6.4 6.4 0 0 0 0-12.8Zm0 10.6a4.2 4.2 0 1 1 0-8.4 4.2 4.2 0 0 1 0 8.4Zm6.6-10.9a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z' },
                  { name: 'TikTok', href: 'https://www.tiktok.com/@somosdsp', d: 'M16.6 5.8a4.3 4.3 0 0 1-2.5-3.8h-3v13.1a2.6 2.6 0 1 1-1.9-2.5v-3.1a5.7 5.7 0 1 0 4.9 5.6V9.4a7.2 7.2 0 0 0 4.2 1.3V7.6a4.2 4.2 0 0 1-1.7-1.8Z' },
                  { name: 'Facebook', href: 'https://facebook.com', d: 'M14 9h2.5l.5-3H14V4.5c0-.9.3-1.5 1.6-1.5H17V.2C16.6.1 15.6 0 14.5 0 12 0 10.3 1.5 10.3 4.2V6H8v3h2.3v9H14V9Z' },
                ].map((s) => (
                  <a
                    href={s.href}
                    aria-label={s.name}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-10 h-10 border border-plata-metalico/20 flex items-center justify-center text-plata-metalico hover:border-oro-elegante hover:text-oro-elegante transition-colors duration-300"
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d={s.d} />
                    </svg>
                  </a>
                ))
              }
            </div>
          </div>

          <!-- Tienda -->
          <div>
            <h4 class="section-label mb-5">Tienda</h4>
            <ul class="space-y-3">
              {
                [
                  { href: '/tienda', label: 'Catálogo' },
                  { href: '/nosotros', label: 'Nosotros' },
                  { href: '/contacto', label: 'Contacto' },
                  { href: '/tallas', label: 'Guía de tallas' },
                ].map((l) => (
                  <li>
                    <a href={l.href} class="text-sm text-plata-metalico/70 hover:text-oro-elegante transition-colors duration-300">
                      {l.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Ayuda -->
          <div>
            <h4 class="section-label mb-5">Ayuda</h4>
            <ul class="space-y-3">
              {
                [
                  { href: '/envios', label: 'Envíos' },
                  { href: '/devoluciones', label: 'Devoluciones' },
                  { href: '/privacidad', label: 'Privacidad' },
                  { href: '/terminos', label: 'Términos' },
                ].map((l) => (
                  <li>
                    <a href={l.href} class="text-sm text-plata-metalico/70 hover:text-oro-elegante transition-colors duration-300">
                      {l.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>

      <!-- Barra inferior -->
      <div class="border-t border-plata-metalico/10">
        <div class="max-w-[1400px] mx-auto px-6 lg:px-10 py-6 flex flex-col sm:flex-row justify-between items-center gap-4">
          <p class="text-[11px] text-plata-metalico/40 font-acentos tracking-wider">
            © {new Date().getFullYear()} DINERO SOBRE PROBLEMAS · Todos los derechos reservados
          </p>
          <div class="flex flex-wrap items-center justify-center gap-4 text-[11px] text-plata-metalico/40 font-acentos tracking-wider">
            <a href="/privacidad" class="hover:text-oro-elegante transition-colors">Privacidad</a>
            <a href="/terminos" class="hover:text-oro-elegante transition-colors">Términos</a>
            <a href="/envios" class="hover:text-oro-elegante transition-colors">Envíos</a>
            <a href="/contacto" class="hover:text-oro-elegante transition-colors">Contacto</a>
          </div>
          <!-- Métodos de pago -->
          <div class="flex items-center gap-3">
            {
              ['VISA', 'MC', 'AMEX', 'OXXO'].map((m) => (
                <span class="px-2 py-1 border border-plata-metalico/15 text-[9px] font-acentos tracking-wider text-plata-metalico/50">
                  {m}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </footer>

    <script>
      // Menú mobile
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));

      // Anuncios rotativos
      const slides = document.querySelectorAll<HTMLElement>('.announcement-slide');
      if (slides.length > 1) {
        let current = 0;
        slides.forEach((s, i) => (s.style.opacity = i === 0 ? '1' : '0'));
        setInterval(() => {
          slides[current].style.opacity = '0';
          current = (current + 1) % slides.length;
          slides[current].style.opacity = '1';
        }, 3500);
      }

      // Contador del carrito desde localStorage
      try {
        const cart = JSON.parse(localStorage.getItem('dsp_cart') || '[]');
        const badge = document.getElementById('cart-count');
        if (badge && cart.length > 0) {
          badge.textContent = String(cart.reduce((n: number, i: any) => n + (i.qty || 1), 0));
          badge.classList.remove('hidden');
          badge.classList.add('flex');
        }
      } catch {}
    </script>
  </body>
</html>
