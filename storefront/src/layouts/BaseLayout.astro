</footer>

    <script>
      // Menú mobile con estado accesible
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');

      if (toggle && menu) {
        const setOpen = (open: boolean) => {
          menu.classList.toggle('hidden', !open);
          toggle.setAttribute('aria-expanded', String(open));
          document.body.style.overflow = open ? 'hidden' : '';
        };

        toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));

        // Cierra al navegar
        menu.querySelectorAll('a').forEach((a) =>
          a.addEventListener('click', () => setOpen(false))
        );

        // Cierra al pasar a desktop
        window
          .matchMedia('(min-width: 1024px)')
          .addEventListener('change', (e) => e.matches && setOpen(false));
      }

      // Perfil dropdown
      const profileTrigger = document.getElementById('profile-trigger');
      const profileMenu = document.querySelector('.profile-menu');

      if (profileTrigger && profileMenu) {
        const toggleProfileMenu = () => {
          const isOpen = profileTrigger.getAttribute('aria-expanded') === 'true';
          profileTrigger.setAttribute('aria-expanded', String(!isOpen));
          profileMenu.classList.toggle('hidden', isOpen);
        };

        profileTrigger.addEventListener('click', (e) => {
          e.preventDefault();
          toggleProfileMenu();
        });

        // Cierra al hacer click fuera
        document.addEventListener('click', (e) => {
          if (!profileTrigger.contains(e.target as Node) && !profileMenu.contains(e.target as Node)) {
            profileTrigger.setAttribute('aria-expanded', 'false');
            profileMenu.classList.add('hidden');
          }
        });

        // Cierra al presionar Escape
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && profileTrigger.getAttribute('aria-expanded') === 'true') {
            profileTrigger.setAttribute('aria-expanded', 'false');
            profileMenu.classList.add('hidden');
          }
        });
      }

      // Header wishlist y carrito - conectar con StoreDrawer
      const headerWishlist = document.getElementById('header-wishlist');
      const headerCart = document.getElementById('header-cart');

      if (headerWishlist) {
        headerWishlist.addEventListener('click', () => {
          const event = new CustomEvent('store:open', { detail: { tab: 'wishlist' } });
          document.dispatchEvent(event);
        });
      }

      if (headerCart) {
        headerCart.addEventListener('click', () => {
          const event = new CustomEvent('store:open', { detail: { tab: 'cart' } });
          document.dispatchEvent(event);
        });
      }

      // Actualizar contadores en el header
      const updateHeaderCounts = () => {
        const wishCount = document.getElementById('wish-count');
        const cartCount = document.getElementById('cart-count');
        const headerWishCount = document.getElementById('header-wish-count');
        const headerCartCount = document.getElementById('header-cart-count');

        if (wishCount && headerWishCount) {
          headerWishCount.textContent = wishCount.textContent;
          headerWishCount.classList.toggle('hidden', wishCount.textContent === '0');
        }

        if (cartCount && headerCartCount) {
          headerCartCount.textContent = cartCount.textContent;
          headerCartCount.classList.toggle('hidden', cartCount.textContent === '0');
        }
      };

      // Actualizar contadores cuando cambien
      document.addEventListener('wishlist:updated', updateHeaderCounts);
      document.addEventListener('cart:updated', updateHeaderCounts);

      // Inicializar contadores
      updateHeaderCounts();

      // Sign out button
      const signoutBtn = document.getElementById('btn-signout');
      if (signoutBtn) {
        signoutBtn.addEventListener('click', async () => {
          try {
            const { supabase } = await import('../../lib/supabase');
            await supabase.auth.signOut();
            window.location.href = '/entrar';
          } catch (error) {
            console.error('Error signing out:', error);
          }
        });
      }

      // Anuncios rotativos
      const slides = document.querySelectorAll<HTMLElement>('.announcement-slide');
      if (slides.length > 1) {
        let current = 0;
        slides.forEach((s, i) => (s.style.opacity = i === 0 ? '1' : '0'));
        setInterval(() => {
          slides[current].style.opacity = '0';
          current = (current + 1) % slides.length;
          slides[current].style.opacity = '1';
        }, 3500);
      }
    </script>
</body>
</html>