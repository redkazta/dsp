# =====================================================
# Stripe — pago real
# =====================================================
# Secreto: solo servidor. En Vercel: Settings → Environment Variables.
# Nunca va en el repo ni en el navegador. Mientras pruebas usa sk_test_…
STRIPE_SECRET_KEY=sk_test_...

# Clave publicable (la usa el Checkout alojado y el panel de Stripe).
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Firmado del webhook (Developers → Webhooks → tu endpoint → Signing secret).
# Sin esto el webhook responde 503 y ningún pedido se marca como pagado.
STRIPE_WEBHOOK_SECRET=whsec_...

# Opcional: ponlo en "true" en preview para aceptar llaves sk_test_ con la
# tienda de prueba. Si producción queda con llaves de prueba y esto no está
# activo, el servidor lo avisa en los logs.
PUBLIC_STRIPE_TEST_MODE=true

# =====================================================
# Supabase
# =====================================================
# Obligatoria para comprar como invitado, escribir pedidos desde el webhook
# y crear la orden antes de ir a Stripe.
SUPABASE_SERVICE_ROLE_KEY=
